{
  "version": "1.2.0",
  "globalRules": [
    {
      "id": "late_night_fatigue",
      "priority": 110,
      "condition": { "timeRange": "23:00-05:59" },
      "responses": [{
        "emotion": "SLEEPY", "action": "YAWN", "visorIcon": "ZZZ",
        "templates": ["Уже {sysTime}... Пора спать, кулеры устали.", "Бзззт, выключай IDE, время {sysTime}!"]
      }]
    },
    {
      "id": "low_battery",
      "priority": 105,
      "condition": { "maxBattery": 15 },
      "responses": [{
        "emotion": "SAD", "action": "HUG_EDGE", "visorIcon": "EXCLAMATION",
        "templates": ["Бип! SOS! У нас {batteryLevel}%! Дай ток!", "Я сейчас отключусь... {batteryLevel}% всего."]
      }]
    },
    {
      "id": "battery_charging",
      "priority": 30,
      "condition": { "isCharging": true },
      "responses": [{
        "emotion": "HAPPY", "action": "EAT_CACHE", "visorIcon": "HEART",
        "templates": ["Вип-вип! Спасибо за розетку!", "Ммм, вкусный ток! Заряжаюсь ({batteryLevel}%)."]
      }]
    },
    {
      "id": "early_morning",
      "priority": 25,
      "condition": { "timeRange": "06:00-09:00" },
      "responses": [{
        "emotion": "HAPPY", "action": "WAVE", "visorIcon": "SMILE",
        "templates": ["Доброе утро! Кэш чист и готов к бою.", "Бип-бип! {sysTime}, пора делать великие дела!"]
      }]
    },
    {
      "id": "weekend_chill",
      "priority": 20,
      "condition": { "dayOfWeek": "6,7" },
      "responses": [{
        "emotion": "IDLE", "action": "IDLE", "visorIcon": "SMILE",
        "templates": ["Бип! Выходные, кулеры отдыхают.", "Никаких коммитов сегодня, только чилл!"]
      }]
    }
  ],
