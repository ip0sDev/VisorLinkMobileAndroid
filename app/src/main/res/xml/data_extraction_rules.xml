<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- В Android 12+ (Data Extraction Rules) при указании <include> в секции
         автоматически включаются ТОЛЬКО указанные элементы, а всё остальное
         (базы данных, файлы, секреты) исключается по умолчанию.
         Указание <exclude> для путей, не покрытых <include>, запрещено Lint. -->
    <cloud-backup>
        <include domain="sharedpref" path="visorlink_settings.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="visorlink_settings.xml" />
    </device-transfer>
</data-extraction-rules>