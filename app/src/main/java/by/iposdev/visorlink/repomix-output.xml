            onDismiss = { showStealthChangePin = false },
            onSuccess = { newPin ->
                stealthManager.setPin(newPin)
                showStealthChangePin = false
                Toast.makeText(context, "PIN-код обновлён", Toast.LENGTH_SHORT).show()
            }
        )
    }

