    var showOverlay by remember { mutableStateOf(false) }
    val haptic = rememberHaptic()
    val isRedeemed = message.redeemed

    if (showOverlay) {
        FullscreenGiftOverlay(
            chatId = chatId,
            messageId = message.id,
            onDismiss = {
                showOverlay = false
                isOpening = false
