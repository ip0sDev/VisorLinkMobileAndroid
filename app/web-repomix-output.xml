// src/components/Sidebar.jsx
import { useEffect, useState, useMemo, memo, useCallback } from 'react';
import { createPortal } from 'react-dom';
import { db } from '../firebase/config';
import { useAuth } from '../contexts/AuthContext';
import { useI18n } from '../contexts/I18nContext';
import { collection, query, where, orderBy, onSnapshot } from 'firebase/firestore';
import { formatDistanceToNow } from 'date-fns';
import { useOnlineStatus } from '../hooks/useOnlineStatus';
import { useUserProfile } from '../hooks/useUserProfile';
import { useFeatureFlags } from '../hooks/useFeatureFlags';
import NewChatModal from './NewChatModal';
import SettingsModal from './SettingsModal';
import CreateChatModal from './CreateChatModal';
import JoinByTagModal from './JoinByTagModal';
import LangToggle from './LangToggle';

import logoImg from '../assets/hero.svg';

export const SAVED_MESSAGES_ID = '__saved__';
export const FEED_ID = '__feed__';

const AvatarWithStatus = memo(function AvatarWithStatus({ name, avatarUrl, uid, size = 'md', showStatus = true }) {
  const online  = useOnlineStatus(showStatus ? uid : null);
  const profile = useUserProfile(uid);

  const resolvedAvatar = avatarUrl || profile?.avatarUrl || null;
  const resolvedName   = name || profile?.displayName || '?';

  return (
    <div className={`avatar-wrap ${size}`}>
      <div
        className={`avatar ${size === 'sm' ? 'sm' : ''}`}
        style={resolvedAvatar ? { background: 'none', padding: 0 } : {}}
      >
        {resolvedAvatar
          ? <img
              src={resolvedAvatar}
              alt={resolvedName}
              style={{ width: '100%', height: '100%', objectFit: 'cover', borderRadius: '50%' }}
            />
          : resolvedName[0]?.toUpperCase()
        }
      </div>
      {showStatus && online && <span className="avatar-dot" />}
    </div>
  );
});

const GroupAvatar = memo(function GroupAvatar({ name, avatarUrl, type, size = 'sm' }) {
  return (
    <div className={`avatar-wrap ${size}`}>
      <div
        className={`avatar ${size === 'sm' ? 'sm' : ''} avatar-group`}
        style={avatarUrl ? { background: 'none', padding: 0 } : {}}
      >
        {avatarUrl
          ? <img
              src={avatarUrl}
              alt={name}
              style={{ width: '100%', height: '100%', objectFit: 'cover', borderRadius: '50%' }}
            />
          : <span style={{ fontSize: size === 'sm' ? 13 : 16 }}>
              {type === 'channel' ? '📢' : '👥'}
            </span>
        }
      </div>
    </div>
  );
});

const ChatItem = memo(function ChatItem({
  chat,
  isActive,
  onSelectChat,
  onViewProfile,
  getUnreadCount,
  getChatDisplay,
  t
}) {
  const ts       = chat.lastMessageAt?.toDate?.();
  const unread   = getUnreadCount(chat);
  const display  = getChatDisplay(chat);

  const previewText = typeof chat.lastMessage === 'string'
    ? chat.lastMessage
    : chat.lastMessage?.text;

  const handleKeyDown = (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      onSelectChat(chat.id);
    }
  };

  return (
    <div
      className={`chat-item ${isActive ? 'active' : ''}`}
      onClick={() => onSelectChat(chat.id)}
      onKeyDown={handleKeyDown}
      role="button"
      tabIndex="0"
      aria-label={display.name}
    >
      <div
        onClick={e => {
          e.stopPropagation();
          if (display.isDirect) onViewProfile?.(display.uid);
        }}
      >
        {display.isDirect
          ? <AvatarWithStatus
              name={display.name}
              avatarUrl={display.avatarUrl}
              uid={display.uid}
              size="sm"
            />
          : <GroupAvatar
              name={display.name}
              avatarUrl={display.avatarUrl}
              type={display.type}
              size="sm"
            />
        }
      </div>

      <div className="chat-item-info">
        <div className="chat-item-top">
          <span className="chat-item-name">
            {display.name}
            {!display.isDirect && (
              <span className="chat-type-badge">
                {display.type === 'channel' ? '📢' : '👥'}
              </span>
            )}
          </span>
          {ts && (
            <span className="chat-item-time">
              {formatDistanceToNow(ts, { addSuffix: false })}
            </span>
          )}
        </div>
        <div className="chat-item-preview">
           {previewText || <span className="muted">{t('sidebar.noMessages')}</span>}
        </div>
      </div>

      {unread > 0 && !isActive && (
        <span className="unread-badge">{unread > 99 ? '99+' : unread}</span>
      )}
    </div>
  );
});

export default function Sidebar({ activeChatId, onSelectChat, onViewProfile }) {
  const { userData } = useAuth();
  const { t } = useI18n();
  const { isFeedEnabled } = useFeatureFlags();

  const [directChats, setDirectChats] = useState([]);
  const [groupChats,  setGroupChats]  = useState([]);

  const [showNewMenu,    setShowNewMenu]    = useState(false);
  const [showNewDirect,  setShowNewDirect]  = useState(false);
  const [showCreateChat, setShowCreateChat] = useState(false);
  const [showJoinTag,    setShowJoinTag]    = useState(false);
  const [showSettings,   setShowSettings]   = useState(false);

  useEffect(() => {
    if (!userData?.uid) return;
    const q = query(
      collection(db, 'chats'),
      where('participants', 'array-contains', userData.uid),
      orderBy('lastMessageAt', 'desc')
    );
    const unsub = onSnapshot(q, snap => {
      setDirectChats(snap.docs.map(d => ({ id: d.id, ...d.data({ serverTimestamps: 'estimate' }) })));
    }, err => console.error('Direct chats error:', err));
    return unsub;
  }, [userData?.uid]);

  useEffect(() => {
    if (!userData?.uid) return;
    const q = query(
      collection(db, 'chats'),
      where('memberIds', 'array-contains', userData.uid),
      orderBy('lastMessageAt', 'desc')
    );
    const unsub = onSnapshot(q, snap => {
      setGroupChats(snap.docs.map(d => ({ id: d.id, ...d.data({ serverTimestamps: 'estimate' }) })));
    }, err => console.error('Group chats error:', err));
    return unsub;
  }, [userData?.uid]);

  const allChats = useMemo(() => {
    const combined = [...directChats, ...groupChats];
    const map = new Map();
    for (const chat of combined) {
      if (!map.has(chat.id)) {
        map.set(chat.id, chat);
      }
    }
    return Array.from(map.values()).sort((a, b) => {
      const ta = a.lastMessageAt?.toMillis?.() || 0;
      const tb = b.lastMessageAt?.toMillis?.() || 0;
      return tb - ta;
    });
  }, [directChats, groupChats]);

  const getUnreadCount = useCallback((chat) => {
    return chat.unreadCount?.[userData?.uid] || 0;
  }, [userData?.uid]);

  const getChatDisplay = useCallback((chat) => {
    if (chat.type === 'direct' || !chat.type) {
      const otherId = chat.participants?.find(p => p !== userData?.uid);
      const other = chat.participantData?.[otherId] || { displayName: t('general.unknown'), username: 'unknown' };
      return {
        isDirect: true,
        name: other.displayName,
        uid: otherId,
        avatarUrl: other.avatarUrl || null,
      };
    }
    return {
      isDirect: false,
      name: chat.name,
      uid: null,
      avatarUrl: chat.avatarUrl || null,
      type: chat.type,
    };
  }, [userData?.uid, t]);

  const isSavedActive = activeChatId === SAVED_MESSAGES_ID;
  const isFeedActive = activeChatId === FEED_ID;

  return (
    <aside className="sidebar">
      {/* Header */}
      <div className="sidebar-header">
        <div className="sidebar-brand">
          <img
            src={logoImg}
            alt="VisorLink Logo"
            className="logo-mark"
            style={{ width: '22px', height: '22px', objectFit: 'contain' }}
          />
          <span className="logo-text">VisorLink</span>
        </div>

        <div style={{ display: 'flex', gap: 6, position: 'relative' }}>
          <LangToggle />
          <button
            className="icon-btn"
            onClick={() => setShowNewMenu(v => !v)}
            title="New"
            aria-label={t('sidebar.newMessage')}
            aria-expanded={showNewMenu}
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <path d="M12 5v14M5 12h14"/>
            </svg>
          </button>

          {showNewMenu && (
            <div className="new-menu" onClick={() => setShowNewMenu(false)}>
              <button onClick={() => setShowNewDirect(true)}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                </svg>
                {t('sidebar.newMessage')}
              </button>
              <button onClick={() => setShowCreateChat(true)}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
                </svg>
                {t('sidebar.newGroup')}
              </button>
              <button onClick={() => setShowJoinTag(true)}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <circle cx="11" cy="11" r="8"/>
