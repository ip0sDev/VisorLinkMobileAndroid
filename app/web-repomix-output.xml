.auth-page::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 50% at 20% 50%, var(--accent-glow) 0%, transparent 60%), radial-gradient(ellipse 40% 60% at 80% 30%, var(--accent-glow2) 0%, transparent 60%); pointer-events: none; animation: ambient-shift 8s ease-in-out infinite alternate; }
