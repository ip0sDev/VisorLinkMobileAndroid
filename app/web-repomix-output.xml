<file path="src/App.css">
/* App.css — Biolume Neomorphic Teal / Exthru
   Legacy Vite homepage aliases (not used in chat app).
   Real design tokens live in index.css.
*/

:root {
  --accent-bg:     rgba(45, 168, 154, 0.08);
  --accent-border: rgba(45, 168, 154, 0.35);
  --text-h:        var(--text);
  --social-bg:     var(--surface2);
  --shadow:        var(--neo-shadow-btn);
}

.counter {
  font-size: 16px;
  padding: 5px 10px;
  border-radius: 8px;
  color: var(--accent);
  background: var(--accent-bg);
  border: 1px solid transparent;
  transition: border-color 0.3s;
  margin-bottom: 24px;
  box-shadow: var(--neo-shadow-sm);

  &:hover {
    border-color: var(--accent-border);
    box-shadow: 0 0 10px var(--accent-glow), var(--neo-shadow-sm);
  }
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
}

.hero {
  position: relative;

  .base,
  .framework,
  .vite {
    inset-inline: 0;
    margin: 0 auto;
  }

  .base {
    width: 170px;
    position: relative;
    z-index: 0;
  }

  .framework,
  .vite {
    position: absolute;
  }

  .framework {
    z-index: 1;
    top: 34px;
    height: 28px;
    transform: perspective(2000px) rotateZ(300deg) rotateX(44deg) rotateY(39deg)
      scale(1.4);
  }

  .vite {
    z-index: 0;
    top: 107px;
    height: 26px;
    width: auto;
    transform: perspective(2000px) rotateZ(300deg) rotateX(40deg) rotateY(39deg)
      scale(0.8);
  }
}

#center {
  display: flex;
  flex-direction: column;
  gap: 25px;
  place-content: center;
  place-items: center;
  flex-grow: 1;

  @media (max-width: 1024px) {
    padding: 32px 20px 24px;
    gap: 18px;
  }
}

#next-steps {
  display: flex;
  border-top: 1px solid var(--border);
  text-align: left;

  & > div {
    flex: 1 1 0;
    padding: 32px;
    @media (max-width: 1024px) {
      padding: 24px 20px;
    }
  }

  .icon {
    margin-bottom: 16px;
    width: 22px;
    height: 22px;
  }

  @media (max-width: 1024px) {
    flex-direction: column;
    text-align: center;
  }
}

#docs {
  border-right: 1px solid var(--border);

  @media (max-width: 1024px) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
}

#next-steps ul {
  list-style: none;
  padding: 0;
  display: flex;
  gap: 8px;
  margin: 32px 0 0;

  .logo {
    height: 18px;
  }

  a {
    color: var(--text-h);
    font-size: 16px;
    border-radius: 8px;
    background: var(--social-bg);
    box-shadow: var(--neo-shadow-btn);
    display: flex;
    padding: 6px 12px;
    align-items: center;
    gap: 8px;
    text-decoration: none;
