  transition: background 0.15s, color 0.15s;
}
.feed-action-btn:hover {
  background: var(--surface2);
  color: var(--accent);
}
/* --- Стили для Вкладок Сайдбара --- */
.sidebar-nav-tabs {
  display: flex;
  padding: 10px 14px;
  gap: 8px;
  border-bottom: 1px solid var(--border);
