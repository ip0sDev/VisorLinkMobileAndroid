// ─────────────────────────────────────────────────────────
// CREATE STICKER PACK
// ─────────────────────────────────────────────────────────
exports.createStickerPack = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { name, emoji = '📦' } = request.data;

  if (!name || name.trim().length < 1)
    throw new HttpsError('invalid-argument', 'Pack name required');
  if (name.trim().length > 32)
    throw new HttpsError('invalid-argument', 'Pack name max 32 characters');
  if (emoji && emoji.trim().length > 16)
    throw new HttpsError('invalid-argument', 'Emoji max 16 characters');

  const userPacksRef = db.collection('users').doc(uid)
    .collection('stickerData').doc('packs');
  const userPacksSnap = await userPacksRef.get();
  const existingIds = userPacksSnap.exists ? (userPacksSnap.data().packIds || []) : [];
  if (existingIds.length >= 50)
    throw new HttpsError('resource-exhausted', 'Max 50 sticker packs per user');

  const userDoc = await db.collection('users').doc(uid).get();
  if (!userDoc.exists) throw new HttpsError('not-found', 'User not found');

  const packRef = db.collection('stickerPacks').doc();
  const batch = db.batch();

  batch.set(packRef, {
    name: name.trim(),
    emoji: emoji.trim() || '📦',
    authorId: uid,
    authorName: userDoc.data().displayName || userDoc.data().username || '',
    createdAt: FieldValue.serverTimestamp(),
    stickerCount: 0,
  });

  batch.set(userPacksRef, { packIds: FieldValue.arrayUnion(packRef.id) }, { merge: true });

  await batch.commit();
  return { success: true, packId: packRef.id };
});

