const BANNER_KEY = 'visorlink_app_banner_dismissed';

export default function Chat() {
  const { user } = useAuth();
  const { t } = useI18n();
  const [activeChatId,   setActiveChatId]   = useState(null);
  const [activeChatData, setActiveChatData] = useState(null);
  const [viewingProfileUid, setViewingProfileUid] = useState(null);
  const [showBanner,     setShowBanner]     = useState(false);

  usePresence(user?.uid);

  useEffect(() => {
    const dismissed = localStorage.getItem(BANNER_KEY);
    if (!dismissed) {
      const timer = setTimeout(() => setShowBanner(true), 800);
      return () => clearTimeout(timer);
    }
  }, []);

  function handleDismissBanner() {
    setShowBanner(false);
    localStorage.setItem(BANNER_KEY, '1');
  }

  // Load chat data only for real chats (not Saved Messages or Feed)
  useEffect(() => {
    if (!activeChatId || activeChatId === SAVED_MESSAGES_ID || activeChatId === FEED_ID) {
      setActiveChatData(null);
      return;
    }
    const unsub = onSnapshot(doc(db, 'chats', activeChatId), snap => {
      if (snap.exists()) setActiveChatData({ id: snap.id, ...snap.data({ serverTimestamps: 'estimate' }) });
    });
    return unsub;
  }, [activeChatId]);

  const handleStartChat = useCallback(() => {
    setViewingProfileUid(null);
  }, []);

  const handleSelectChat = useCallback((chatId) => {
    setActiveChatId(chatId);
  }, []);

  const isSaved = activeChatId === SAVED_MESSAGES_ID;
  const isFeed = activeChatId === FEED_ID;

  // ── Dynamic Page Title ──────────────────────────────────
  useEffect(() => {
    if (isSaved) {
      document.title = `${t('saved.title')} | VisorLink`;
    } else if (isFeed) {
      document.title = `${t('feed.title')} | VisorLink`;
    } else if (activeChatData) {
      const isDirect = !activeChatData.type || activeChatData.type === 'direct';
      if (isDirect) {
        const otherId = activeChatData.participants?.find(p => p !== user?.uid);
        const other = activeChatData.participantData?.[otherId];
        const name = other?.displayName || t('general.unknown');
        document.title = `${name} | VisorLink`;
      } else {
        document.title = `${activeChatData.name} | VisorLink`;
      }
    } else {
      document.title = 'VisorLink';
    }
  }, [activeChatId, activeChatData, isSaved, isFeed, user?.uid, t]);

  return (
    <div className="app-layout">
      <Sidebar
        activeChatId={activeChatId}
        onSelectChat={setActiveChatId}
        onViewProfile={setViewingProfileUid}
      />

      {isFeed
        ? <FeedWindow
            onViewProfile={setViewingProfileUid}
            onSelectChat={handleSelectChat}
          />
        : isSaved
          ? <SavedMessagesWindow
              onViewProfile={setViewingProfileUid}
              onSelectChat={handleSelectChat}
            />
          : <ChatWindow
              chatId={activeChatId}
              chatData={activeChatData}
              onViewProfile={setViewingProfileUid}
              onSelectChat={handleSelectChat}
            />
      }

      {viewingProfileUid && (
        <ProfileView
          uid={viewingProfileUid}
          onClose={() => setViewingProfileUid(null)}
          onStartChat={() => handleStartChat(viewingProfileUid)}
        />
      )}
      {showBanner && <MobileAppBanner onClose={handleDismissBanner} />}
    </div>
  );
}
