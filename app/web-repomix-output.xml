  async function loadBots() {
    setBotsLoading(true);
    try {
      const res = await getUserBotsFn();
      setBots(res.data.bots || []);
    } catch (e) { console.error(e); }
    setBotsLoading(false);
  }

  useEffect(() => {
    if (tab === 'bots' && botMode === 'list') loadBots();
  }, [tab, botMode]);

  function handleUsernameChange(val) {
    setNewUsername(val);
    setUsernameStatus(null);
    setUsernameMsg('');
    clearTimeout(usernameTimer.current);

    const clean = val.toLowerCase().trim();
    if (clean === userData?.username) return;
    if (clean.length < 3) {
      setUsernameStatus('invalid');
      setUsernameMsg('Min 3 characters');
      return;
    }
    if (!/^[a-zA-Z0-9_]+$/.test(clean)) {
      setUsernameStatus('invalid');
      setUsernameMsg('Letters, numbers, underscores only');
      return;
    }

    setUsernameStatus('checking');
    usernameTimer.current = setTimeout(async () => {
      try {
        const res = await checkUsernameFn({ username: clean });
        if (res.data.available) {
          setUsernameStatus('available');
          setUsernameMsg(t('settings.available') || 'Available');
        } else {
          setUsernameStatus('taken');
          setUsernameMsg(res.data.reason || (t('settings.taken') || 'Taken'));
        }
      } catch { setUsernameStatus(null); }
    }, 500);
  }

  async function handleAvatarUpload(e) {
    const file = e.target.files[0];
    if (!file) return;
    setUploadingAvatar(true);
    setError('');
    try {
      const mediaId = await uploadToCdn(file, false, `avatar_${user.uid}_${Date.now()}`);
      const url = getPublicCdnUrl(mediaId);
      await updateDoc(doc(db, 'users', user.uid), { avatarUrl: url });
      setAvatarUrl(url);
    } catch (err) { setError(err.message); }
    setUploadingAvatar(false);
    e.target.value = '';
  }

  async function handleSaveProfile() {
    setSaving(true); setError(''); setSuccess('');
    try {
      await updateProfileFn({ displayName, bio });
      setSuccess(t('settings.saved') || 'Saved!');
      setTimeout(() => setSuccess(''), 3000);
    } catch (err) { setError(err.message); }
    setSaving(false);
  }

  async function handleAddInterest(e) {
    e.preventDefault();
    if (!newInterest.trim()) return;
    const cleanTag = newInterest.trim().toLowerCase().replace(/^#/, '');
    if (interests.includes(cleanTag)) {
        setNewInterest('');
        return;
    }
    const updated = [...interests, cleanTag];
    setInterests(updated);
    setNewInterest('');
    try {
      await updateDoc(doc(db, 'users', user.uid), { interests: updated });
    } catch (err) { console.error(err); }
  }

  async function handleRemoveInterest(tagToRemove) {
    const updated = interests.filter(t => t !== tagToRemove);
    setInterests(updated);
    try {
      await updateDoc(doc(db, 'users', user.uid), { interests: updated });
    } catch (err) { console.error(err); }
  }

  async function handleBuyPro(useTrial = false) {
    setSaving(true); setError(''); setSuccess('');
    try {
      await buyProFn({ useTrial });
      setSuccess(useTrial ? 'Пробный PRO активирован! 🎉' : 'PRO успешно активирован! 🎉');
      setTimeout(() => setSuccess(''), 3000);
    } catch (err) { setError(err.message); }
    setSaving(false);
  }

  async function handleToggleShowStreak() {
    const newVal = !showStreak;
    setShowStreak(newVal);
    await updateDoc(doc(db, 'users', user.uid), { showStreak: newVal });
  }

  async function handleSaveUsername() {
    if (newUsername.toLowerCase() === userData?.username) return;
    if (usernameStatus !== 'available') return;
    setSaving(true); setError(''); setSuccess('');
    try {
      await changeUsernameFn({ newUsername, displayName });
      setSuccess(t('settings.saved') || 'Saved!');
      setUsernameStatus(null);
      setUsernameMsg('');
      setTimeout(() => setSuccess(''), 3000);
    } catch (err) { setError(err.message); }
    setSaving(false);
