import { useState } from 'react';
import { useI18n } from '../contexts/I18nContext';

// ── Single grid cell ───────────────────────────────────────
function AlbumCell({ img, globalIndex, revealedIds, onReveal, onLightbox }) {
  const { t } = useI18n();
  const itemKey = `${img.messageId}_${globalIndex}`;
  const isRevealed = !img.spoiler || revealedIds?.has(itemKey);

  function handleClick(e) {
    e.stopPropagation();
    if (!img.spoiler || isRevealed) {
      onLightbox(globalIndex);
    } else {
      onReveal?.(itemKey);
    }
  }

  return (
    <div
      className={`album-cell ${img.spoiler && !isRevealed ? 'album-cell-hidden' : ''}`}
      onClick={handleClick}
    >
      <img src={img.url} alt="" draggable={false} />
      {img.spoiler && !isRevealed && (
        <div className="album-cell-spoiler">
          <span>🙈</span>
          <span className="album-cell-hint">{t('spoiler.hint')}</span>
        </div>
      )}
      {img.spoiler && (
        <div className="album-cell-badge">{t('spoiler.badge')}</div>
      )}
    </div>
  );
}

// ── Album grid layouts ─────────────────────────────────────
function AlbumGrid({ images, messageId, revealedIds, onReveal, onLightbox }) {
  const count = images.length;
  // Tag each image with its messageId for spoiler key
  const imgs = images.map(img => ({ ...img, messageId }));

  if (count === 1) {
    return (
      <div className="album-grid album-1">
        <AlbumCell img={imgs[0]} globalIndex={0} revealedIds={revealedIds} onReveal={onReveal} onLightbox={onLightbox} />
      </div>
    );
  }
  if (count === 2) {
    return (
      <div className="album-grid album-2">
        {imgs.map((img, i) => <AlbumCell key={i} img={img} globalIndex={i} revealedIds={revealedIds} onReveal={onReveal} onLightbox={onLightbox} />)}
      </div>
    );
  }
  if (count === 3) {
    return (
      <div className="album-grid album-3">
        <AlbumCell img={imgs[0]} globalIndex={0} revealedIds={revealedIds} onReveal={onReveal} onLightbox={onLightbox} />
        <div className="album-col">
          <AlbumCell img={imgs[1]} globalIndex={1} revealedIds={revealedIds} onReveal={onReveal} onLightbox={onLightbox} />
          <AlbumCell img={imgs[2]} globalIndex={2} revealedIds={revealedIds} onReveal={onReveal} onLightbox={onLightbox} />
        </div>
      </div>
    );
  }
  if (count === 4) {
    return (
      <div className="album-grid album-4">
        {imgs.map((img, i) => <AlbumCell key={i} img={img} globalIndex={i} revealedIds={revealedIds} onReveal={onReveal} onLightbox={onLightbox} />)}
      </div>
    );
  }
  // 5-10: 2 cols first row, rest below with +N overlay on last if >6
  const VISIBLE = 6;
  const shown = imgs.slice(0, VISIBLE);
  const hidden = imgs.length - VISIBLE;

  return (
    <div className="album-grid album-n">
      {shown.map((img, i) => {
        const isLast = i === VISIBLE - 1 && hidden > 0;
        return (
          <div key={i} className="album-cell-wrap">
            <AlbumCell img={img} globalIndex={i} revealedIds={revealedIds} onReveal={onReveal} onLightbox={onLightbox} />
            {isLast && (
              <div className="album-more-overlay" onClick={(e) => { e.stopPropagation(); onLightbox(i); }}>
                +{hidden + 1}
              </div>
            )}
          </div>
        );
      })}
    </div>
  );
}

// ── Full-screen lightbox ───────────────────────────────────
function AlbumLightbox({ images, startIndex, onClose }) {
  const [current, setCurrent] = useState(startIndex);

  function prev(e) { e.stopPropagation(); setCurrent(i => Math.max(0, i - 1)); }
  function next(e) { e.stopPropagation(); setCurrent(i => Math.min(images.length - 1, i + 1)); }

  function handleKey(e) {
    if (e.key === 'ArrowLeft') setCurrent(i => Math.max(0, i - 1));
    if (e.key === 'ArrowRight') setCurrent(i => Math.min(images.length - 1, i + 1));
    if (e.key === 'Escape') onClose();
  }

  return (
    <div className="album-lightbox" onClick={onClose} onKeyDown={handleKey} tabIndex={0} autoFocus>
      <button className="album-lb-close" onClick={onClose}>✕</button>

      {current > 0 && (
        <button className="album-lb-nav album-lb-prev" onClick={prev}>‹</button>
      )}

      <div className="album-lb-img-wrap" onClick={e => e.stopPropagation()}>
        <img src={images[current].url} alt="" draggable={false} />
      </div>

      {current < images.length - 1 && (
        <button className="album-lb-nav album-lb-next" onClick={next}>›</button>
      )}

      <div className="album-lb-counter">{current + 1} / {images.length}</div>

      {images.length > 1 && (
        <div className="album-lb-strip" onClick={e => e.stopPropagation()}>
          {images.map((img, i) => (
            <div
              key={i}
              className={`album-lb-thumb ${i === current ? 'active' : ''}`}
              onClick={() => setCurrent(i)}
            >
              <img src={img.url} alt="" />
            </div>
          ))}
        </div>
      )}
    </div>
  );
}

// ── Main export: album message block ──────────────────────
export default function AlbumMessage({ message, revealedIds, onReveal }) {
  const [lightboxIndex, setLightboxIndex] = useState(null);
  const images = message.images || [];

  if (images.length === 0) return null;

  return (
    <>
      <AlbumGrid
        images={images}
        messageId={message.id}
        revealedIds={revealedIds}
        onReveal={onReveal}
        onLightbox={setLightboxIndex}
      />

      {message.caption && (
        <p className="album-caption">{message.caption}</p>
      )}

      {lightboxIndex !== null && (
        <AlbumLightbox
          images={images}
          startIndex={lightboxIndex}
          onClose={() => setLightboxIndex(null)}
        />
      )}
    </>
  );
}
