// src/hooks/useWallpaper.js
// Обои хранятся в Firestore:
//   /chats/{chatId}/wallpapers/{uid}  → { url, storagePath, setAt }
//
// Личные чаты: любой участник ставит свои обои (только он их видит)
// Группы / каналы: только owner ставит одни обои для всех

import { useEffect, useState } from 'react';
import { db } from '../firebase/config';
import { doc, onSnapshot, setDoc, serverTimestamp } from 'firebase/firestore';

export function useWallpaper(chatId, uid, chatType) {
  const [wallpaperUrl, setWallpaperUrl] = useState(null);

  useEffect(() => {
    if (!chatId || !uid) return;

    // Direct: у каждого своя запись по uid
    // Group/Channel: единая запись под ключом 'shared'
    const docId = (chatType === 'group' || chatType === 'channel') ? 'shared' : uid;

    const unsub = onSnapshot(
      doc(db, 'chats', chatId, 'wallpapers', docId),
      snap => {
        setWallpaperUrl(snap.exists() ? snap.data().url : null);
      }
    );
    return unsub;
  }, [chatId, uid, chatType]);

  return wallpaperUrl;
}

export async function saveWallpaper(chatId, uid, chatType, url, storagePath) {
  const docId = (chatType === 'group' || chatType === 'channel') ? 'shared' : uid;
  await setDoc(doc(db, 'chats', chatId, 'wallpapers', docId), {
    url,
    storagePath,
    setBy: uid,
    setAt: serverTimestamp(),
  });
}

export async function removeWallpaper(chatId, uid, chatType) {
  const { deleteDoc } = await import('firebase/firestore');
  const docId = (chatType === 'group' || chatType === 'channel') ? 'shared' : uid;
  await deleteDoc(doc(db, 'chats', chatId, 'wallpapers', docId));
}
