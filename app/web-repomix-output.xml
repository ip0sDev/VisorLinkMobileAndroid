.reply-bar-active { display: flex; align-items: center; gap: 10px; padding: 8px 16px; background: var(--surface); border-top: 1px solid var(--border); flex-shrink: 0; animation: slide-up 0.2s cubic-bezier(0.16,1,0.3,1); }
.reply-bar-line { width: 3px; height: 32px; background: var(--accent); border-radius: 3px; flex-shrink: 0; box-shadow: 0 0 8px var(--accent-glow); }
.reply-bar-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 1px; }
.reply-bar-name { font-size: 11px; font-weight: 600; color: var(--accent); font-family: var(--font-brand); }
