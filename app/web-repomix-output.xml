/* ==========================================================================
   FORGE — brutalist / hard-edge. Flat panels, hard offset shadows (no blur),
   zero border radius, monospace type. Surfaces still tint with --accent,
   just far more subtly, keeping the industrial concrete-and-metal mood.
   ========================================================================== */
[data-style="forge"] {
  --font-ui: 'JetBrains Mono', monospace;
  --font-brand: 'JetBrains Mono', monospace;
}

[data-style="forge"][data-theme="dark"] {
  --overlay-bg: rgba(0, 0, 0, 0.80);
  --modal-ambient: rgba(0, 0, 0, 0.65);

  --accent: #E50027;
  --accent-light: #FF3355;
