<file path="src/contexts/ThemeContext.jsx">
import { createContext, useContext, useEffect, useState } from 'react';

const ThemeContext = createContext();

export function ThemeProvider({ children }) {
  const [theme, setTheme] = useState(() => {
    // 1. Check localStorage first (user's explicit choice)
    const saved = localStorage.getItem('vl_theme');
    if (saved) return saved;
    // 2. Auto-detect from browser/OS preference
    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
      return 'light';
    }
    return 'dark';
  });

  // Listen to system theme changes (only if user hasn't set a preference)
  useEffect(() => {
    const mq = window.matchMedia('(prefers-color-scheme: dark)');
    const handler = (e) => {
      // Only auto-switch if the user hasn't explicitly chosen a theme
      const saved = localStorage.getItem('vl_theme_user_set');
      if (!saved) {
        setTheme(e.matches ? 'dark' : 'light');
      }
    };
    mq.addEventListener('change', handler);
    return () => mq.removeEventListener('change', handler);
  }, []);

  useEffect(() => {
    document.documentElement.setAttribute('data-theme', theme);
    localStorage.setItem('vl_theme', theme);
  }, [theme]);

  const toggle = () => {
    // Mark that user has explicitly chosen a theme
    localStorage.setItem('vl_theme_user_set', '1');
    setTheme(t => t === 'dark' ? 'light' : 'dark');
  };

  return (
    <ThemeContext.Provider value={{ theme, toggle }}>
      {children}
    </ThemeContext.Provider>
  );
}

export const useTheme = () => useContext(ThemeContext);
</file>

<file path="src/hooks/useCdn.js">
// src/hooks/useCdn.js
import { auth } from '../firebase/config';

export const CDN_URL = 'https://api.visorlink.org';

// Форматирование байт (например: 1.2 GB)
export function formatBytes(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

export async function getCdnStats() {
    try {
        const token = await auth.currentUser.getIdToken();
        const res = await fetch(`${CDN_URL}/user_stats`, {
            method: 'GET',
            headers: { 'Authorization': `Bearer ${token}` }
        });
        if (!res.ok) throw new Error('CDN offline');
        return await res.json();
    } catch (e) {
        return { status: 'offline', used_bytes: 0, quota_bytes: 2147483648, files_count: 0 };
    }
}

export async function getUserMediaList() {
    const token = await auth.currentUser.getIdToken();
    const res = await fetch(`${CDN_URL}/user_media`, {
        method: 'GET',
        headers: { 'Authorization': `Bearer ${token}` }
    });
    if (!res.ok) throw new Error('CDN offline');
    const data = await res.json();
    return data.media || [];
}

export async function deleteCdnMedia(mediaId) {
    const token = await auth.currentUser.getIdToken();
    const res = await fetch(`${CDN_URL}/f/${mediaId}`, {
        method: 'DELETE',
        headers: { 'Authorization': `Bearer ${token}` }
    });
    if (!res.ok) throw new Error('Delete failed');
    return await res.json();
}

export async function downloadAllCdnMedia() {
    const token = await auth.currentUser.getIdToken();
    const res = await fetch(`${CDN_URL}/download_all`, {
        method: 'GET',
        headers: { 'Authorization': `Bearer ${token}` }
    });
    if (!res.ok) throw new Error('Download failed');
    
    const blob = await res.blob();
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `visorlink_cloud_${new Date().toISOString().slice(0,10)}.zip`;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
}

export async function uploadToCdn(file, isVault = false, customName = null) {
    const token = await auth.currentUser.getIdToken();
    const zone = isVault ? 'vault' : 'public';

    const buffer = await file.arrayBuffer();
    const hashBuffer = await crypto.subtle.digest('SHA-256', buffer);
    const hashArray = Array.from(new Uint8Array(hashBuffer));
    const fileHash = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');

    const checkRes = await fetch(`${CDN_URL}/check_hash`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${token}` },
        body: JSON.stringify({ hash: fileHash, size: file.size })
    });

    if (checkRes.status === 413) throw new Error('Превышена квота хранилища');
    if (checkRes.status === 503) throw new Error('Сервер временно перегружен');

    const formData = new FormData();
    const fileName = customName || file.name || 'media_file';
    
    formData.append('file', file, fileName);
    formData.append('zone', zone);
    formData.append('hash', fileHash);
    formData.append('original_name', fileName);
    formData.append('mime_type', file.type || 'application/octet-stream');

    const res = await fetch(`${CDN_URL}/upload`, {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${token}` },
        body: formData
    });

    const data = await res.json();
    if (!res.ok) throw new Error(data.error || 'Ошибка загрузки CDN');

    return data.media_id;
}

export async function getCdnUrl(mediaId) {
    if (!mediaId) return null;
    const token = await auth.currentUser.getIdToken();
    return `${CDN_URL}/f/${mediaId}?token=${token}`;
}

export function getPublicCdnUrl(mediaId) {
    if (!mediaId) return null;
    return `${CDN_URL}/p/${mediaId}`;
}
</file>

