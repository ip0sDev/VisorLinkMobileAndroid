      setBotMode('list');
    } catch (e) { alert(e.message); }
    setSaving(false);
  }

  async function handleDeleteBot(botUid) {
    if (!window.confirm('Удалить бота навсегда? Это действие необратимо.')) return;
    setBotsLoading(true);
    try {
