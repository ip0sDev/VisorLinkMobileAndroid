});

// ─────────────────────────────────────────────────────────
// ON STICKER PACK DELETED
// ─────────────────────────────────────────────────────────
exports.onStickerPackDeleted = onDocumentDeleted(
  { document: 'stickerPacks/{packId}', region: 'europe-west1' },
  async (event) => {
    const packId = event.params.packId;
    const bucket = getStorage().bucket();

    const stickersSnap = await db
      .collection('stickerPacks').doc(packId)
      .collection('stickers').get();

    if (stickersSnap.empty) return;

    const BATCH_SIZE = 400;
    for (let i = 0; i < stickersSnap.docs.length; i += BATCH_SIZE) {
      const chunk = stickersSnap.docs.slice(i, i + BATCH_SIZE);
      const batch = db.batch();
      await Promise.all(chunk.map(async (doc) => {
        batch.delete(doc.ref);
        const { storagePath } = doc.data();
        if (storagePath) {
          try { await bucket.file(storagePath).delete(); } catch { /* уже удалён */ }
        }
      }));
      await batch.commit();
    }
  }
);

