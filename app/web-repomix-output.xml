// src/components/ChatWindow.jsx
import { useEffect, useRef, useState, useCallback, useMemo, memo } from 'react';
import { db, rtdb } from '../firebase/config';
import { useAuth } from '../contexts/AuthContext';
import { useI18n } from '../contexts/I18nContext';
import {
  collection, query, orderBy, onSnapshot, limit, startAfter,
  getDocs, serverTimestamp, doc, updateDoc, writeBatch
} from 'firebase/firestore';
import { ref as rtdbRef, onValue } from 'firebase/database';
import { getFunctions, httpsCallable } from 'firebase/functions';
import { useVoiceRecorder } from '../hooks/useVoiceRecorder';
import { useTyping, useTypingListener } from '../hooks/useTyping';
import { isToday, isYesterday, format } from 'date-fns';
import MessageBubble from './MessageBubble';
import StickerPicker from './StickerPicker';
import OnlineStatus from './OnlineStatus';
import GroupSettingsModal from './GroupSettingsModal';
import CommentsSheet from './CommentsSheet';
import ImageEditor from './ImageEditor';
import MultiImageEditor from './MultiImageEditor';
import WallpaperPicker from './WallpaperPicker';
import { useWallpaper } from '../hooks/useWallpaper';
import { useTheme } from '../contexts/ThemeContext';

import { useFeatureFlags } from '../hooks/useFeatureFlags';
import { uploadToCdn, getCdnStats } from '../hooks/useCdn';

const fn = getFunctions(undefined, 'europe-west1');
const sendAlbumFn = httpsCallable(fn, 'sendAlbum');
const bumpStreakFn = httpsCallable(fn, 'bumpStreak');
const allowBotMessagesFn = httpsCallable(fn, 'allowBotMessages');
const sendGiftFn = httpsCallable(fn, 'sendGift'); 

const PAGE_SIZE = 20;

const DateSeparator = memo(function DateSeparator({ date }) {
  const { t } = useI18n();
  let label;
  if (isToday(date))          label = t('date.today');
  else if (isYesterday(date)) label = t('date.yesterday');
  else                        label = format(date, 'MMMM d, yyyy');
  return <div className="date-separator"><span>{label}</span></div>;
});

const TypingIndicator = memo(function TypingIndicator() {
  return (
    <div className="typing-wrap">
      <div className="typing-bubble">
        <div className="typing-dot" />
        <div className="typing-dot" />
        <div className="typing-dot" />
      </div>
    </div>
  );
});

function withDateSeparators(messages) {
  const result = [];
  let lastDate = null;
  for (const msg of messages) {
    const ts = msg.createdAt?.toDate?.();
    if (ts) {
      const dayStr = format(ts, 'yyyy-MM-dd');
      if (dayStr !== lastDate) {
        result.push({ _type: 'separator', date: ts, key: `sep-${dayStr}` });
        lastDate = dayStr;
      }
    }
    result.push(msg);
  }
  return result;
}

export default function ChatWindow({ chatId, chatData, onViewProfile, onSelectChat }) {
  const { user, userData } = useAuth();
  const { t } = useI18n();
  const [authToken, setAuthToken] = useState('');

  const chatType  = chatData?.type || 'direct';
  const isDirect  = chatType === 'direct' || !chatType;
  const isGroup   = chatType === 'group';
  const isChannel = chatType === 'channel';

  const otherId   = isDirect ? chatData?.participants?.find(p => p !== user?.uid) : null;
  const otherUser = isDirect ? chatData?.participantData?.[otherId] : null;

  const { isNewServiceEnabled } = useFeatureFlags();
  const [pendingCdnFile, setPendingCdnMedia] = useState(null);
  const [cdnStatus, setCdnStatus] = useState('checking');
  
  const [messages,          setMessages]          = useState([]);
  const [text,              setText]              = useState('');
  const [showStickers,      setShowStickers]      = useState(false);
  const [uploading,         setUploading]         = useState(false);
  const [replyTo,           setReplyTo]           = useState(null);
  const [typingUsers,       setTypingUsers]       = useState([]);
  const [showGroupSettings, setShowGroupSettings] = useState(false);
  const [onlineCount,       setOnlineCount]       = useState(0);
  const [myMemberData,      setMyMemberData]      = useState(null);
  const [commentsPost,      setCommentsPost]      = useState(null);
  const [showWallpaper,     setShowWallpaper]     = useState(false);
  const [revealedIds,       setRevealedIds]       = useState(new Set());
  const [pendingImage,      setPendingImage]      = useState(null);
  const [pendingAlbum,      setPendingAlbum]      = useState(false);
  const [pendingAlbumFiles, setPendingAlbumFiles] = useState([]);
  const [loadingMore,       setLoadingMore]       = useState(false);
  const [hasMore,           setHasMore]           = useState(true);
  const [firstDoc,          setFirstDoc]          = useState(null);
  const [allowingBot,       setAllowingBot]       = useState(false);

  const items = useMemo(() => withDateSeparators(messages), [messages]);
  const [otherProfile, setOtherProfile] = useState(null);
  const wallpaperUrl = useWallpaper(chatId, user?.uid, chatType);
  const { theme } = useTheme();

  const bottomRef       = useRef(null);
  const imageInputRef   = useRef(null);
  const textareaRef     = useRef(null);
  const messagesAreaRef = useRef(null);
  const isFirstLoad     = useRef(true);

  const { recording, duration, startRecording, stopRecording, cancelRecording } = useVoiceRecorder();
  const { onTyping, onStopTyping } = useTyping(chatId, user?.uid);
  const { subscribe }              = useTypingListener(chatId, user?.uid);

  const isAppAdmin = userData?.isAdmin === true;

  useEffect(() => {
    user?.getIdToken().then(setAuthToken);
  }, [user]);

  useEffect(() => {
    if (isNewServiceEnabled) {
      getCdnStats()
        .then(s => setCdnStatus(s.status))
        .catch(() => setCdnStatus('offline'));
    }
  }, [isNewServiceEnabled]);

  const isBot = otherProfile?.isBot === true;
  const botBadge = otherProfile?.botBadge || 'unverified';
  const botAllowed = chatData?.botAllowed === true;

  async function handleAllowBot() {
    setAllowingBot(true);
    try { await allowBotMessagesFn({ chatId }); } catch (err) { console.error(err); }
    setAllowingBot(false);
  }

  useEffect(() => {
    if (isDirect || !chatId || !user?.uid) return;
    const unsub = onSnapshot(doc(db, 'chats', chatId, 'members', user.uid), snap => setMyMemberData(snap.exists() ? snap.data() : null));
    return unsub;
  }, [chatId, user?.uid, isDirect]);

  useEffect(() => {
    if (!isDirect || !otherId) return;
    const unsub = onSnapshot(doc(db, 'users', otherId), snapshot => { if (snapshot.exists()) setOtherProfile(snapshot.data()); });
    return unsub;
  }, [isDirect, otherId]);

  const otherAvatarUrl = otherProfile?.avatarUrl || otherUser?.avatarUrl || null;

  useEffect(() => {
    if (isDirect || !chatData?.memberIds?.length) return;
    const presenceRef = rtdbRef(rtdb, 'presence');
    const unsub = onValue(presenceRef, snap => {
      const data  = snap.val() || {};
      const count = chatData.memberIds.filter(uid => uid !== user?.uid && data[uid]?.online === true).length;
      setOnlineCount(count);
    });
    return unsub;
  }, [chatData?.memberIds, isDirect]);

  useEffect(() => {
    const unsub = subscribe(setTypingUsers);
    return unsub;
  }, [chatId]);

  useEffect(() => {
    if (!chatId) return;
    setMessages([]); setHasMore(true); setFirstDoc(null); isFirstLoad.current = true;
    const q = query(collection(db, 'chats', chatId, 'messages'), orderBy('createdAt', 'desc'), limit(PAGE_SIZE));
    const unsub = onSnapshot(q, snap => {
      const docs = snap.docs;
      if (docs.length < PAGE_SIZE) setHasMore(false);
      if (docs.length > 0)         setFirstDoc(docs[docs.length - 1]);
      const msgs = docs.map(d => ({ id: d.id, ...d.data({ serverTimestamps: 'estimate' }) })).reverse();
      setMessages(msgs);

      if (isFirstLoad.current) {
        isFirstLoad.current = false;
        setTimeout(() => { if (messagesAreaRef.current) messagesAreaRef.current.scrollTop = messagesAreaRef.current.scrollHeight; }, 50);
      } else {
        const area = messagesAreaRef.current;
        if (area) {
          const distFromBottom = area.scrollHeight - area.scrollTop - area.clientHeight;
          if (distFromBottom < 140) setTimeout(() => { area.scrollTo({ top: area.scrollHeight, behavior: 'smooth' }); }, 30);
        }
      }
    });
    return unsub;
  }, [chatId]);

  useEffect(() => {
    if (!chatId || !user?.uid || messages.length === 0 || isChannel) return;
    const unread = messages.filter(m => m.senderId !== user.uid && !m.readBy?.includes(user.uid) && !m.deleted);
    if (unread.length === 0) return;
    const batch = writeBatch(db);
    for (const msg of unread) batch.update(doc(db, 'chats', chatId, 'messages', msg.id), { readBy: [...(msg.readBy || []), user.uid] });
    batch.commit().catch(console.error);
  }, [messages, chatId, user?.uid, isChannel]);

  useEffect(() => { if (replyTo) textareaRef.current?.focus(); }, [replyTo]);

  async function loadMore() {
    if (!hasMore || loadingMore || !firstDoc || !chatId) return;
    setLoadingMore(true);
    const area = messagesAreaRef.current;
    const prevScrollHeight = area?.scrollHeight || 0;
    try {
      const q = query(collection(db, 'chats', chatId, 'messages'), orderBy('createdAt', 'desc'), startAfter(firstDoc), limit(PAGE_SIZE));
      const snap  = await getDocs(q);
      const docs  = snap.docs;
      if (docs.length < PAGE_SIZE) setHasMore(false);
      if (docs.length > 0)         setFirstDoc(docs[docs.length - 1]);
      const older = docs.map(d => ({ id: d.id, ...d.data({ serverTimestamps: 'estimate' }) })).reverse();
      setMessages(prev => [...older, ...prev]);
      requestAnimationFrame(() => { if (area) area.scrollTop = area.scrollHeight - prevScrollHeight; });
    } catch (e) { console.error(e); }
    setLoadingMore(false);
  }

  const scrollToMessage = useCallback((messageId) => {
    const el = document.getElementById(`msg-${messageId}`);
    if (!el) return;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.classList.add('msg-highlight');
    setTimeout(() => el.classList.remove('msg-highlight'), 1500);
  }, []);

  const canSend = useCallback(() => {
    if (isDirect)  return true;
    if (isChannel) return myMemberData?.role === 'admin' || myMemberData?.role === 'owner';
    if (isGroup) {
      if (!myMemberData)       return false;
      if (myMemberData.banned) return false;
      if (myMemberData.muted) {
        if (myMemberData.mutedUntil) {
          const until = myMemberData.mutedUntil?.toDate?.() || new Date(myMemberData.mutedUntil);
          if (new Date() > until) return true;
        }
        return false;
      }
      return true;
    }
    return true;
  }, [isDirect, isChannel, isGroup, myMemberData]);

  const canSendMedia = useCallback(() => {
    if (isDirect)  return true;
    if (isChannel) return myMemberData?.role === 'admin' || myMemberData?.role === 'owner';
    if (isGroup)   return !myMemberData?.mediaRestricted && canSend();
    return true;
  }, [isDirect, isChannel, isGroup, myMemberData, canSend]);

  const isAdminOrOwner = useCallback(() => { return myMemberData?.role === 'admin' || myMemberData?.role === 'owner'; }, [myMemberData]);

  function triggerStreak() {
    if (!userData) return;
    const last = userData.lastStreakUpdate?.toDate()?.getTime() || 0;
    if (Date.now() - last > 20 * 60 * 60 * 1000) bumpStreakFn().catch(() => {});
  }

  async function sendMsg(data) {
    onStopTyping();
    const replyData = replyTo ? {
      id: replyTo.id, text: replyTo.text || null, type: replyTo.type, url: replyTo.url || null, cdnMediaId: replyTo.cdnMediaId || null, senderUsername: replyTo.senderUsername,
      images: replyTo.images || null
    } : null;
    setReplyTo(null);

    const preview = data.type === 'text' ? data.text : data.type === 'image' ? t('msg.image') : data.type === 'video' ? '🎥 Видео' : data.type === 'gif' ? '🖼️ GIF' : data.type === 'voice' ? t('msg.voice') : t('msg.sticker');

    const textToExtract = data.text || data.caption || '';
    const tagsMatch = textToExtract.match(/#[a-zA-Zа-яА-ЯёЁ0-9_]+/g);
    const tags = tagsMatch ? Array.from(new Set(tagsMatch.map(t => t.slice(1).toLowerCase()))) : [];

    try {
      const batch = writeBatch(db);
      const msgRef = doc(collection(db, 'chats', chatId, 'messages'));

      batch.set(msgRef, {
        senderId:       user.uid,
        senderUsername: userData.username,
        senderIsAdmin:  userData.isAdmin === true,
        createdAt:      serverTimestamp(),
        replyTo:        replyData,
        reactions:      [],
        deleted:        false,
        readBy:         [user.uid],
        tags:           tags,
        ...(isChannel ? { commentsEnabled: true, commentsCount: 0 } : {}),
        ...data,
      });

      batch.update(doc(db, 'chats', chatId), { lastMessage: preview, lastMessageAt: serverTimestamp() });
      batch.update(doc(db, 'users', user.uid), { lastMessageAt: serverTimestamp() });
      await batch.commit();
      triggerStreak();
    } catch (err) { console.error("Error sending message:", err); }
  }

  async function sendText(e) {
    if (e) e.preventDefault();
    if (!text.trim() || !canSend()) return;
    const textToSend = text.trim();
    setText('');
    await sendMsg({ type: 'text', text: textToSend });
  }

  function handleTextChange(e) {
    setText(e.target.value);
    if (e.target.value) onTyping(); else onStopTyping();
  }

  async function handleImageSelect(e) {
    const files = Array.from(e.target.files);
    if (!files.length || !canSendMedia()) return;

    const file = files[0];
    const isVideoOrGif = file.type.startsWith('video/') || file.type === 'image/gif';

    if (isVideoOrGif && isNewServiceEnabled) {
      if (cdnStatus === 'offline') {
        alert(t('general.error') || 'Сервер хранилища сейчас недоступен.');
        e.target.value = '';
        return;
      }
      setPendingCdnMedia(file);
    } else {
      if (files.length > 1) { setPendingAlbumFiles(files); setPendingAlbum(true); } 
      else { setPendingImage({ file }); }
    }
    e.target.value = '';
  }

  async function uploadAndSendImage(file, spoiler) {
    setUploading(true);
    try {
      const mediaId = await uploadToCdn(file, false, file.name);
      await sendMsg({ type: 'image', cdnMediaId: mediaId, fileName: file.name, spoiler: spoiler || false });
      triggerStreak();
    } catch (err) { console.error(err); }
    setUploading(false);
  }
  
  async function uploadAndSendCdnMedia(file) {
    setUploading(true);
    try {
      const mediaId = await uploadToCdn(file, false, file.name);
      const type = file.type.startsWith('video/') ? 'video' : 'gif';
      await sendMsg({ type: type, cdnMediaId: mediaId, fileName: file.name });
      triggerStreak();
    } catch (err) { alert(`Ошибка: ${err.message}`); }
    setUploading(false);
  }

  async function uploadAndSendAlbum(items, caption) {
    setUploading(true);
    try {
      const uploaded = await Promise.all(items.map(async ({ file, spoiler }) => {
        const mediaId = await uploadToCdn(file, false, file.name);
        return { cdnMediaId: mediaId, fileName: file.name, spoiler };
      }));

      const replyData = replyTo ? { id: replyTo.id, text: replyTo.text || null, type: replyTo.type, url: replyTo.url || null, cdnMediaId: replyTo.cdnMediaId || null, senderUsername: replyTo.senderUsername } : null;
      setReplyTo(null);

      await sendAlbumFn({ chatId, images: uploaded, caption: caption || '', replyTo: replyData });
      try { await updateDoc(doc(db, 'users', user.uid), { lastMessageAt: serverTimestamp() }); } catch (e) { console.error(e); }
      triggerStreak();
    } catch (err) { console.error('Album send error:', err); }
    setUploading(false);
  }

  async function handleVoiceSend() {
    if (!canSendMedia()) return;
    const result = await stopRecording();
    if (!result) return;
    setUploading(true);
    try {
      const mediaId = await uploadToCdn(result.blob, false, `voice_${Date.now()}.webm`);
      await sendMsg({ type: 'voice', cdnMediaId: mediaId, duration: result.duration });
      triggerStreak();
    } catch (err) { console.error(err); }
    setUploading(false);
  }

  async function handleStickerSelect(sticker) {
    await sendMsg({ type: 'sticker', url: sticker.url, stickerId: sticker.id, packId: sticker.packId || null, packName: sticker.packName || null, packEmoji: sticker.packEmoji || null });
  }

  async function handleSendGift() {
    if (!window.confirm('Отправить подарок (PRO на 30 дней) в этот чат?')) return;
    setUploading(true);
    try {
      await sendGiftFn({ chatId });
    } catch (err) {
      alert(err.message);
    }
    setUploading(false);
  }

  function handleKeyDown(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendText(e); }
    if (e.key === 'Escape' && replyTo)     setReplyTo(null);
  }

  const handlePaste = useCallback(async (e) => {
    if (!canSendMedia()) return;
    const items     = Array.from(e.clipboardData?.items || []);
    const imageItem = items.find(i => i.type.startsWith('image/'));
    if (!imageItem) return;
    e.preventDefault();
    const file = imageItem.getAsFile();
    if (!file) return;
    setPendingImage({ file });
  }, [canSendMedia]);

  const handleRevealSpoiler = useCallback((id) => { setRevealedIds(prev => new Set([...prev, id])); }, []);

  function replyBarText(msg) {
    if (!msg) return '';
    if (msg.type === 'text')    return msg.text;
    if (msg.type === 'image')   return t('msg.image');
    if (msg.type === 'video')   return '🎥 Видео';
    if (msg.type === 'gif')     return '🖼️ GIF';
    if (msg.type === 'voice')   return t('msg.voice');
    if (msg.type === 'sticker') return t('msg.sticker');
    if (msg.type === 'gift')    return '🎁 Подарок';
    if (msg.type === 'album') {
      const n = msg.images?.length || 0;
      return msg.caption || `📷 ${n} photo${n !== 1 ? 's' : ''}`;
    }
    return 'Media';
  }

  function renderTopbar() {
    if (isDirect) {
      const displayName = otherProfile?.displayName || otherUser?.displayName || '';
      const initial     = displayName?.[0]?.toUpperCase() || '?';

      return (
        <>
          <div
            className="avatar sm"
            style={{ cursor: 'pointer', flexShrink: 0, ...(otherAvatarUrl ? { background: 'none', padding: 0 } : {}) }}
            onClick={() => onViewProfile?.(otherId)}
          >
            {otherAvatarUrl ? <img src={otherAvatarUrl} alt={displayName} style={{ width: '100%', height: '100%', borderRadius: '50%', objectFit: 'cover', display: 'block' }}/> : initial}
          </div>
          <div style={{ cursor: 'pointer', flex: 1, minWidth: 0, display: 'flex', flexDirection: 'column', justifyContent: 'center' }} onClick={() => onViewProfile?.(otherId)}>
            <div className="chat-topbar-name">
              {displayName}
              {otherProfile?.isAdmin === true && (
                <span className="vl-admin-badge" style={{ marginLeft: 8 }}>
                  <svg viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                  </svg>
                  VisorLink Admin
                </span>
              )}
              {isBot && (
                <span className={`bot-badge-inline bot-badge-${botBadge}`} title={botBadge.toUpperCase()}>
                  {botBadge === 'official' && (
                    <svg className="bot-badge-icon" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                  )}
                  {botBadge === 'visorlink' && (
                    <svg className="bot-badge-icon" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2L2 22h20L12 2zm0 4.5l6.5 13h-13L12 6.5z"/>
                    </svg>
                  )}
                  {botBadge === 'unverified' && (
                    <svg className="bot-badge-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                      <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
                      <line x1="12" y1="9" x2="12" y2="13"/>
                      <line x1="12" y1="17" x2="12.01" y2="17"/>
                    </svg>
                  )}
                  {botBadge === 'official' ? 'Official' : botBadge === 'visorlink' ? 'System' : 'Bot'}
                </span>
              )}
            </div>
            <div className="chat-topbar-sub">
              {typingUsers.length > 0
                ? <span className="online-status online" style={{ fontStyle: 'italic' }}>{t('chat.typing')}</span>
                : <OnlineStatus uid={otherId} />
              }
            </div>
          </div>
        </>
      );
    }

    return (
      <>
        <div
          className="avatar sm avatar-group"
          style={{ flexShrink: 0, ...(chatData?.avatarUrl ? { background: 'none', padding: 0 } : {}) }}
        >
          {chatData?.avatarUrl
            ? <img src={chatData.avatarUrl} alt="" style={{ width: '100%', height: '100%', borderRadius: '50%', objectFit: 'cover', display: 'block' }}/>
            : <span style={{ fontSize: 16 }}>{isChannel ? '📢' : '👥'}</span>
          }
        </div>
        <div style={{ flex: 1, minWidth: 0, cursor: 'pointer' }} onClick={() => setShowGroupSettings(true)}>
          <div className="chat-topbar-name" style={{ display: 'flex', alignItems: 'center' }}>
            {chatData?.name}
            {chatData?.badge && chatData.badge !== 'unverified' && (
              <span className={`bot-badge-inline bot-badge-${chatData.badge}`} title="Верифицированный канал" style={{ marginLeft: 6, fontSize: 10, padding: '2px 4px' }}>
                <svg className="bot-badge-icon" viewBox="0 0 24 24" fill="currentColor" style={{width: 10, height: 10}}>
                  <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                </svg>
              </span>
            )}
            {isChannel && <span className="topbar-type-tag">{t('general.type')}</span>}
            {isGroup   && <span className="topbar-type-tag">{t('general.group')}</span>}
          </div>
          <div className="chat-topbar-sub">
            {isGroup && typingUsers.length > 0
              ? <span className="online-status online" style={{ fontStyle: 'italic' }}>{t('chat.typing')}</span>
              : (
                <span className="online-status" style={{ color: 'var(--text3)' }}>
                  {chatData?.memberCount || 0} {t('chat.members')}
                  {isGroup && onlineCount > 0 && (
                    <span style={{ color: 'var(--success)', marginLeft: 6 }}>
                      · {onlineCount} {t('chat.online.count')}
                    </span>
                  )}
                </span>
              )
            }
          </div>
        </div>
      </>
    );
  }

  function getPlaceholder() {
    if (uploading)                       return t('msg.uploading');
    if (isChannel && !canSend())         return t('msg.onlyAdmins');
    if (isGroup && myMemberData?.muted)  return t('msg.muted');
    if (isGroup && myMemberData?.banned) return t('msg.banned');
    return t('msg.placeholder');
  }

  const sendDisabled = !canSend() || uploading || recording;

  const ignoreCust = userData?.settings?.ignoreCustomizations === true;
  const isOtherPro = otherProfile?.proUntil?.toDate()?.getTime() > Date.now() || otherProfile?.proUntil?.toDate()?.getFullYear() > 2090;
  const customParams = isOtherPro && !ignoreCust ? otherProfile?.customization : null;

  const effectiveWallpaper = wallpaperUrl || customParams?.bgUrl || null;
  const effectiveStyle = customParams?.style !== 'default' ? customParams?.style : undefined;
  const effectiveAccent = customParams?.accent !== 'default' ? customParams?.accent : undefined;
  const effectiveFont = customParams?.font === 'mono' ? 'var(--font-mono)' :
                        customParams?.font === 'serif' ? 'Georgia, "Times New Roman", serif' :
                        customParams?.font === 'rounded' ? '"Nunito", "Varela Round", system-ui, sans-serif' : undefined;

  const messageList = useMemo(() => items.map(item => {
    if (item._type === 'separator') {
      return <DateSeparator key={item.key} date={item.date} />;
    }
    return (
      <MessageBubble
          key={item.id}
          message={item}
          isOwn={item.senderId === user?.uid}
          onReply={setReplyTo}
          chatId={chatId}
          chatName={chatData?.name}
          noForwards={chatData?.settings?.noForwards === true}
          onScrollTo={scrollToMessage}
          otherUid={otherId}
          showReadReceipt={isDirect}
          reactionsEnabled={isDirect || isGroup || (isChannel && chatData?.settings?.allowReactions !== false)}
          isChannel={isChannel}
          onOpenComments={isChannel ? setCommentsPost : undefined}
          revealedIds={revealedIds}
          onRevealSpoiler={handleRevealSpoiler}
          onViewProfile={onViewProfile}
          onSelectChat={onSelectChat}
          authToken={authToken}
      />
    );
  }), [
    items, user?.uid, chatId, chatData?.name, chatData?.settings?.noForwards,
    chatData?.settings?.allowReactions, scrollToMessage, otherId, isDirect,
    isGroup, isChannel, setCommentsPost, revealedIds, handleRevealSpoiler,
    onViewProfile, onSelectChat, authToken
  ]);

  if (!chatId) {
    return (
      <div className="chat-window empty">
        <div className="chat-empty-state">
          <span className="logo-mark xl">⬡</span>
          <p>Select a conversation or start a new one</p>
        </div>
      </div>
    );
  }

  return (
    <div 
      className="chat-window" 
      onClick={() => setShowStickers(false)}
      data-style={effectiveStyle}
      data-accent={effectiveAccent}
      data-theme={effectiveStyle ? theme : undefined}
      style={{ fontFamily: effectiveFont }}
    >

      <div className="chat-topbar">
        {renderTopbar()}
        <div className="topbar-actions">
          {(isGroup || isChannel) && (
            <button
              className="icon-btn"
              onClick={() => setShowGroupSettings(true)}
              title={isChannel ? t('channel.settings') : t('group.settings')}
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
            </button>
          )}
          <button
            className={`icon-btn ${wallpaperUrl ? 'icon-btn-active' : ''}`}
            onClick={() => setShowWallpaper(true)}
            title={t('chat.wallpaper.set')}
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
          </button>
        </div>
      </div>

      <div
        className="messages-area"
        ref={messagesAreaRef}
        style={effectiveWallpaper ? { backgroundImage: `url(${effectiveWallpaper})`, backgroundSize: 'cover', backgroundPosition: 'center', backgroundAttachment: 'local' } : {}}
      >
        {hasMore && (
          <button className="load-more-btn" onClick={loadMore} disabled={loadingMore}>
            {loadingMore ? t('load.loading') : t('load.more')}
          </button>
        )}

        {isBot && (
          <div className={`bot-info-banner ${botBadge === 'unverified' ? 'unverified' : ''}`}>
            🤖 <strong>{t('bot.isBot')}</strong><br/>
            {botBadge === 'unverified' ? t('bot.unverifiedWarn') : t('bot.verifiedSafe')}
          </div>
        )}

        {messageList}

        {typingUsers.length > 0 && !isChannel && <TypingIndicator />}
        <div ref={bottomRef} />
      </div>

      {recording && (
        <div className="voice-recording-bar">
          <div className="voice-rec-dot" />
          <span className="voice-rec-label">{t('voice.recording')}</span>
          <span className="voice-rec-timer">
            {Math.floor(duration / 60)}:{String(duration % 60).padStart(2, '0')}
          </span>
          <button className="voice-cancel-btn" onClick={cancelRecording}>{t('voice.cancel')}</button>
          <button className="voice-send-btn-bar" onClick={handleVoiceSend}>{t('voice.send')}</button>
        </div>
      )}

      {replyTo && (
        <div className="reply-bar-active">
          <div className="reply-bar-line" />
          <div className="reply-bar-info">
            <span className="reply-bar-name">@{replyTo.senderUsername}</span>
            <span className="reply-bar-text">{replyBarText(replyTo)}</span>
          </div>
          {replyTo.type === 'album' && replyTo.images?.[0] && (
            <img src={replyTo.images[0].cdnMediaId && authToken ? `${CDN_URL}/f/${replyTo.images[0].cdnMediaId}?token=${authToken}` : replyTo.images[0].url} alt="" className="reply-thumb" style={{ opacity: replyTo.images[0].spoiler ? 0.35 : 1 }} />
          )}
          {(replyTo.type === 'image' || replyTo.type === 'video' || replyTo.type === 'gif') && (
            <img src={replyTo.cdnMediaId && authToken ? `${CDN_URL}/f/${replyTo.cdnMediaId}?token=${authToken}` : replyTo.url} alt="" className="reply-thumb" style={{ opacity: replyTo.spoiler ? 0.35 : 1 }} />
          )}
          <button className="reply-bar-close" onClick={() => setReplyTo(null)}>✕</button>
        </div>
      )}

      {isNewServiceEnabled && cdnStatus === 'offline' && (
        <div style={{ background: 'rgba(192, 57, 43, 0.85)', backdropFilter: 'blur(10px)', color: '#fff', fontSize: 11, padding: '6px 14px', textAlign: 'center', fontWeight: 600, letterSpacing: '0.04em', borderTop: '1px solid rgba(255,255,255,0.1)', zIndex: 15 }}>
          ⚠️ Сервер медиа (CDN) недоступен. Отправка видео и GIF приостановлена.
        </div>
      )}

      {isBot && botBadge === 'unverified' && !botAllowed ? (
        <div style={{ padding: '0 20px 20px', background: 'var(--acrylic-panel)' }}>
          <button className="bot-allow-btn" onClick={handleAllowBot} disabled={allowingBot}>
            {allowingBot ? t('general.loading') : t('bot.allowMessages')}
          </button>
        </div>
      ) : (
        <form className="message-form" onSubmit={sendText}>
          <input
            ref={imageInputRef}
            type="file"
            accept={isNewServiceEnabled ? "image/*,video/mp4,video/webm" : "image/*"}
            multiple
            style={{ display: 'none' }}
            onChange={handleImageSelect}
          />

          {canSend() && (
            <button type="button" className="tool-btn" onClick={e => { e.stopPropagation(); setShowStickers(v => !v); }} title={t('chat.stickers')}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/>
              </svg>
            </button>
          )}

          {canSendMedia() && (
            <button type="button" className="tool-btn" onClick={() => imageInputRef.current.click()} title={t('chat.attach')}>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/>
              </svg>
            </button>
          )}
          
          {isAppAdmin && (
            <button type="button" className="tool-btn" onClick={handleSendGift} title="Подарить PRO" disabled={uploading}>
              <span style={{ fontSize: 18, lineHeight: 1 }}>🎁</span>
            </button>
          )}

          <textarea
            ref={textareaRef}
            className="message-input"
            placeholder={getPlaceholder()}
            value={text}
            onChange={handleTextChange}
            onKeyDown={handleKeyDown}
            onPaste={handlePaste}
            rows={1}
            disabled={sendDisabled}
          />

          {!text.trim() && !recording && canSendMedia() && (
            <button type="button" className="send-btn send-btn-mic" onClick={startRecording} title={t('chat.voice.record')}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/>
              </svg>
            </button>
          )}

          {text.trim() && canSend() && (
            <button type="submit" className="send-btn" title={t('general.send')}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
                <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
            </button>
          )}

          {showStickers && <StickerPicker onSelect={handleStickerSelect} onClose={() => setShowStickers(false)} />}
        </form>
      )}

      {pendingCdnFile && (
        <div className="modal-overlay" onClick={() => setPendingCdnMedia(null)}>
          <div className="modal" onClick={e => e.stopPropagation()}>
            <div className="modal-header">
              <h3>Отправить медиа</h3>
              <button className="modal-close" onClick={() => setPendingCdnMedia(null)}>✕</button>
            </div>
            <p style={{textAlign: 'center', margin: '20px 0', color: 'var(--text2)'}}>
              Отправить файл: <br/><strong style={{color: 'var(--text)'}}>{pendingCdnFile.name}</strong> <br/>
              ({(pendingCdnFile.size / 1024 / 1024).toFixed(1)} МБ)?
            </p>
            <div style={{display: 'flex', gap: 10}}>
              <button className="btn-ghost" style={{flex: 1}} onClick={() => setPendingCdnMedia(null)}>{t('general.cancel')}</button>
              <button className="btn-primary" style={{flex: 1}} onClick={() => {
                const f = pendingCdnFile; setPendingCdnMedia(null); uploadAndSendCdnMedia(f);
              }}>Отправить</button>
            </div>
          </div>
        </div>
      )}

      {showWallpaper && <WallpaperPicker chatId={chatId} chatType={chatType} currentUrl={wallpaperUrl} onClose={() => setShowWallpaper(false)} />}
      
      {pendingImage && (
        <ImageEditor file={pendingImage.file} onConfirm={(editedFile, spoiler) => { setPendingImage(null); uploadAndSendImage(editedFile, spoiler); }} onCancel={() => setPendingImage(null)} />
      )}

      {pendingAlbum && (
        <MultiImageEditor initialFiles={pendingAlbumFiles} onConfirm={(items, caption) => { setPendingAlbum(false); setPendingAlbumFiles([]); uploadAndSendAlbum(items, caption); }} onCancel={() => { setPendingAlbum(false); setPendingAlbumFiles([]); }} />
      )}

      {showGroupSettings && (isGroup || isChannel) && <GroupSettingsModal chatId={chatId} chatData={chatData} onClose={() => setShowGroupSettings(false)} />}
      {commentsPost && isChannel && <CommentsSheet chatId={chatId} message={commentsPost} isAdmin={isAdminOrOwner()} onClose={() => setCommentsPost(null)} />}
    </div>
  );
}
</file>

</files>
