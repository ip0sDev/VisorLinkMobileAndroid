import { useEffect, useState } from 'react';
import { rtdb } from '../firebase/config';
import { ref, onValue } from 'firebase/database';
import { formatDistanceToNow } from 'date-fns';
import { useI18n } from '../contexts/I18nContext';

export default function OnlineStatus({ uid }) {
  const { t } = useI18n();
  const [status, setStatus] = useState(null);

  useEffect(() => {
    if (!uid) return;
    const presenceRef = ref(rtdb, `presence/${uid}`);
    const unsub = onValue(presenceRef, snap => {
      setStatus(snap.val());
    });
    return unsub;
  }, [uid]);

  if (!status) return <span className="online-status offline">{t('chat.offline')}</span>;

  if (status.online) {
    return (
      <span className="online-status online">
        <span className="online-dot" /> {t('chat.online')}
      </span>
    );
  }

  const lastSeen = status.lastSeen;
  return (
    <span className="online-status offline">
      {lastSeen
        ? `${t('chat.lastSeen')} ${formatDistanceToNow(new Date(lastSeen), { addSuffix: true })}`
        : t('chat.offline')}
    </span>
  );
}
</file>

