);

// ─────────────────────────────────────────────────────────
// BUMP DAILY STREAK
// ─────────────────────────────────────────────────────────
exports.bumpStreak = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const userRef = db.collection('users').doc(uid);

  let awardedBits = 0;
  let newStreak = 1;

  await db.runTransaction(async (tx) => {
    const doc = await tx.get(userRef);
    if (!doc.exists) throw new HttpsError('not-found', 'User not found');
    const data = doc.data();

    const now = Date.now();
    const lastUpdate = data.lastStreakUpdate?.toDate()?.getTime() || 0;
    const diffHours = (now - lastUpdate) / (1000 * 60 * 60);

    if (diffHours < 20) {
      throw new HttpsError('failed-precondition', 'Too early to bump streak');
    }

    const currentStreak = data.streak || 0;

    if (diffHours > 48) {
      newStreak = 1;
    } else {
      newStreak = currentStreak + 1;
    }

    const rewards =[10, 20, 40, 80, 160, 320];
    awardedBits = newStreak <= 6 ? rewards[newStreak - 1] : 500;

    tx.update(userRef, {
      streak: newStreak,
      bits: FieldValue.increment(awardedBits),
      lastStreakUpdate: FieldValue.serverTimestamp()
    });
  });

  return { success: true, awardedBits, newStreak };
});

// ─────────────────────────────────────────────────────────
// BUY PRO SUBSCRIPTION & TRIAL
// ─────────────────────────────────────────────────────────
exports.buyProSubscription = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { useTrial } = request.data || {};
  const userRef = db.collection('users').doc(uid);
  
  const PRO_COST = 1000;
  const PRO_DURATION_MS = 30 * 24 * 60 * 60 * 1000;
  const TRIAL_DURATION_MS = 24 * 60 * 60 * 1000;

  await db.runTransaction(async (tx) => {
    const doc = await tx.get(userRef);
    if (!doc.exists) throw new HttpsError('not-found', 'User not found');
    
    const data = doc.data();
    const now = Date.now();
    let newProUntil;

    if (useTrial) {
      if (data.trialUsed) throw new HttpsError('failed-precondition', 'Trial already used');
      
      newProUntil = (data.proUntil && data.proUntil.toDate().getTime() > now)
        ? new Date(data.proUntil.toDate().getTime() + TRIAL_DURATION_MS)
        : new Date(now + TRIAL_DURATION_MS);
        
      tx.update(userRef, {
        trialUsed: true,
        proUntil: newProUntil
      });
    } else {
      const currentBits = data.bits || 0;
      if (currentBits < PRO_COST) {
        throw new HttpsError('failed-precondition', 'Not enough bits');
      }

      newProUntil = (data.proUntil && data.proUntil.toDate().getTime() > now)
        ? new Date(data.proUntil.toDate().getTime() + PRO_DURATION_MS)
        : new Date(now + PRO_DURATION_MS);

      tx.update(userRef, {
        bits: FieldValue.increment(-PRO_COST),
        proUntil: newProUntil
      });
    }
  });

  return { success: true };
});

