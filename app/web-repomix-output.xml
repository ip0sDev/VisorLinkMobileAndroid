            <input type="password" placeholder={t('auth.password')} value={password}
              onChange={e => setPassword(e.target.value)} required />
            {error && <div className="auth-error">{error}</div>}
            <div className="add-account-btns">
              <button type="button" className="btn-ghost" onClick={() => goTo(MODES.list)}>
                {t('general.cancel')}
              </button>
              <button type="submit" className="btn-primary" style={{ width: 'auto', padding: '8px 20px' }} disabled={loading}>
                {loading ? t('auth.submitting') : t('auth.login')}
              </button>
            </div>
          </form>
        </>}

        {/* REGISTER */}
        {mode === MODES.register && <>
          <div className="modal-header">
            <button className="back-btn" onClick={() => goTo(MODES.list)}>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
              </svg>
            </button>
            <h3>{t('auth.register')}</h3>
            <button className="modal-close" onClick={onClose}>✕</button>
          </div>
          <form onSubmit={handleRegister} className="add-account-form">
            <div className="input-with-prefix">
              <span className="prefix">@</span>
              <input type="text" placeholder={t('auth.username')} value={username}
                onChange={e => setUsername(e.target.value)} required autoFocus />
            </div>
            <input type="email" placeholder={t('auth.email')} value={email}
              onChange={e => setEmail(e.target.value)} required />
            <input type="password" placeholder={t('auth.password')} value={password}
              onChange={e => setPassword(e.target.value)} required />
            {error && <div className="auth-error">{error}</div>}
            <div className="add-account-btns">
              <button type="button" className="btn-ghost" onClick={() => goTo(MODES.list)}>
                {t('general.cancel')}
              </button>
              <button type="submit" className="btn-primary" style={{ width: 'auto', padding: '8px 20px' }} disabled={loading}>
                {loading ? t('auth.submitting') : t('auth.register')}
              </button>
            </div>
          </form>
        </>}

      </div>
    </div>
  );
}
