                    </div>

                    {loadingMedia ? (
                      <p style={{ textAlign: 'center', fontSize: 13, color: 'var(--text3)', margin: '20px 0' }}>Загрузка файлов...</p>
                    ) : mediaList.length === 0 ? (
                      <p style={{ textAlign: 'center', fontSize: 13, color: 'var(--text3)', margin: '20px 0', border: '1px dashed var(--border)', padding: 20, borderRadius: 12 }}>У вас пока нет загруженных медиафайлов.</p>
                    ) : (
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 8, overflowY: 'auto', paddingRight: 4, paddingBottom: 20 }}>
                        {mediaList.map(m => {
                          let expireText = "";
                          if (m.pending_deletion && m.delete_after) {
                              expireText = `Удаление: ${new Date(m.delete_after).toLocaleString()}`;
                          } else if (m.zone === 'public') {
                              expireText = `Автоочистка при нехватке места`;
                          } else {
                              expireText = `Хранится бессрочно в Сейфе`;
                          }

                          const isImg = m.mime_type?.startsWith('image/');
                          const isVid = m.mime_type?.startsWith('video/');

                          return (
                            <div key={m.id} style={{ 
                                background: 'var(--surface2)', padding: 12, borderRadius: 12, 
                                display: 'flex', gap: 12, alignItems: 'center', 
                                border: m.pending_deletion ? '1px solid var(--danger)' : '1px solid transparent',
                                boxShadow: m.pending_deletion ? '0 0 10px rgba(192,57,43,0.1)' : 'var(--neo-shadow-sm)'
                            }}>
                              <div style={{ width: 50, height: 50, borderRadius: 8, overflow: 'hidden', background: 'var(--surface3)', flexShrink: 0, display: 'flex', alignItems: 'center', justifyContent: 'center', fontSize: 24 }}>
                                {isImg ? (
                                    <img src={`https://api.visorlink.org/f/${m.id}?token=${authToken}`} alt="" style={{ width: '100%', height: '100%', objectFit: 'cover' }} />
                                ) : isVid ? (
                                    <span title="Видео">🎥</span>
                                ) : (
                                    <span title="Файл">📄</span>
                                )}
                              </div>
                              
                              <div style={{ flex: 1, minWidth: 0 }}>
                                <div style={{ fontSize: 13, color: 'var(--text)', fontWeight: 600, whiteSpace: 'nowrap', overflow: 'hidden', textOverflow: 'ellipsis' }}>
                                   {m.original_name || 'Медиафайл'}
                                </div>
                                <div style={{ fontSize: 11, color: 'var(--text3)', fontFamily: 'var(--font-mono)', marginTop: 2 }}>
                                   {new Date(m.uploaded_at).toLocaleDateString()} • {formatBytes(m.size)}
                                </div>
                                <div style={{ display: 'flex', gap: 6, marginTop: 4, flexWrap: 'wrap' }}>
                                   <span style={{ fontSize: 10, padding: '2px 6px', borderRadius: 4, background: 'var(--surface3)', color: 'var(--text2)' }}>
                                      {m.zone === 'vault' ? '🔒 Сейф' : '🌐 Общий чат'}
                                   </span>
                                   <span style={{ fontSize: 10, padding: '2px 6px', borderRadius: 4, background: m.is_read ? 'rgba(39,174,96,0.1)' : 'rgba(230,126,34,0.1)', color: m.is_read ? 'var(--success)' : 'var(--warn)' }}>
                                      {m.is_read ? '👁️ Прочитан' : '🙈 Не прочитан'}
                                   </span>
                                </div>
                                <div style={{ fontSize: 10, marginTop: 6, fontWeight: 500, color: m.pending_deletion ? 'var(--danger)' : 'var(--text3)' }}>
                                   {expireText}
                                </div>
                              </div>

                              <div style={{ display: 'flex', flexDirection: 'column', gap: 6, flexShrink: 0 }}>
                                <button className="icon-btn" style={{ width: 28, height: 28 }} onClick={() => handleDownloadSingle(m.id, m.original_name)} title="Скачать">
                                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                </button>
                                <button className="icon-btn" style={{ width: 28, height: 28, color: 'var(--danger)', borderColor: 'transparent' }} onClick={() => handleDeleteMedia(m.id)} title="Удалить">
                                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                                </button>
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    )}
                  </div>
                ) : (
                  <div className="pro-card" style={{ border: '1px solid var(--accent)' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 6 }}>
                      <h3 style={{ color: 'var(--text)', margin: 0, fontSize: 18, fontWeight: 700 }}>Облачное хранилище</h3>
                      {cdnStats ? (
                        <span style={{ fontSize: 11, fontWeight: 700, padding: '3px 8px', borderRadius: 6, background: cdnStats.status === 'online' ? 'rgba(39,174,96,0.1)' : 'rgba(192,57,43,0.1)', color: cdnStats.status === 'online' ? 'var(--success)' : 'var(--danger)', textTransform: 'uppercase', letterSpacing: '0.05em' }}>
                          {cdnStats.status === 'online' ? '🟢 Online' : '🔴 Offline'}
                        </span>
                      ) : (
                        <span style={{ fontSize: 11, color: 'var(--text3)' }}>Проверка...</span>
                      )}
                    </div>
                    
                    <p style={{ fontSize: 13, color: 'var(--text2)', marginBottom: 20 }}>
                      Все отправленные вами медиафайлы хранятся здесь.
                    </p>

                    {cdnStats && cdnStats.status === 'online' ? (
                      <div style={{ background: 'var(--surface2)', padding: '16px', borderRadius: '12px', border: '1px solid var(--border)' }}>
                        <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 8, fontSize: 13, fontWeight: 600 }}>
                          <span style={{ color: 'var(--text)' }}>
                            Использовано: {formatBytes(cdnStats.used_bytes)} / {formatBytes(cdnStats.quota_bytes)}
                          </span>
                          <span style={{ color: 'var(--accent)' }}>
                            {cdnStats.is_pro ? 'PRO (10 ГБ)' : 'Free (2 ГБ)'}
                          </span>
                        </div>
                        
                        <div style={{ width: '100%', height: 8, background: 'var(--surface4)', borderRadius: 4, overflow: 'hidden', boxShadow: 'var(--neo-shadow-in)' }}>
                          <div style={{ 
                            width: `${Math.min((cdnStats.used_bytes / cdnStats.quota_bytes) * 100, 100)}%`, 
                            height: '100%', 
                            background: 'linear-gradient(90deg, var(--accent-light), var(--accent))', 
                            borderRadius: 4 
                          }} />
                        </div>
                        
                        <div style={{ display: 'flex', justifyContent: 'space-between', marginTop: 12, alignItems: 'center' }}>
                          <span style={{ fontSize: 12, color: 'var(--text3)', fontFamily: 'var(--font-mono)' }}>
                            Файлов в облаке: {cdnStats.files_count}
                          </span>
                          <button className="btn-ghost" style={{ padding: '6px 12px', fontSize: 12 }} onClick={handleOpenStorageManager}>
                            Управление файлами
                          </button>
                        </div>
                      </div>
                    ) : cdnStats && cdnStats.status === 'offline' ? (
                      <div className="auth-error" style={{ textAlign: 'center', background: 'rgba(192,57,43,0.1)', borderColor: 'rgba(192,57,43,0.2)' }}>
                        Сервер хранилища в данный момент недоступен.<br/>Проверьте подключение к сети.
                      </div>
                    ) : (
                      <div style={{ textAlign: 'center', padding: '20px 0', color: 'var(--text3)', fontSize: 13 }}>
                        Синхронизация с сервером...
                      </div>
                    )}
                  </div>
                )}
              </div>
            )}

            {/* ADMIN TAB */}
            {tab === 'admin' && isAdminUser && (
              <div className="settings-body" style={{ maxHeight: '70vh', overflowY: 'auto', paddingRight: 8 }}>
                
                <div className="pro-card" style={{ border: '1px solid var(--danger)', marginBottom: 16 }}>
                  <h3 style={{ color: 'var(--danger)', marginBottom: 16 }}>🤖 Управление DM ботами</h3>
                  <div className="input-group">
                    <label>UID бота (botUid)</label>
                    <input 
                      type="text" 
                      placeholder="Вставьте UID бота сюда" 
                      value={adminBotUid}
                      onChange={(e) => setAdminBotUid(e.target.value)}
                    />
                  </div>
                  
                  <div style={{ background: 'var(--surface2)', padding: '12px 14px', borderRadius: 12, marginBottom: 12 }}>
                    <p style={{ fontSize: 11, fontWeight: 600, color: 'var(--text3)', textTransform: 'uppercase', letterSpacing: '0.05em', margin: '0 0 10px' }}>Верификация</p>
                    <select 
                      style={{ width: '100%', padding: '10px 14px', borderRadius: 8, background: 'var(--surface3)', color: 'var(--text)', border: '1px solid var(--border)', marginBottom: 10 }}
                      value={adminBadge}
                      onChange={(e) => setAdminBadge(e.target.value)}
                    >
                      <option value="unverified">Unverified (Default)</option>
                      <option value="official">Official (Blue tick)</option>
                      <option value="visorlink">VisorLink (System)</option>
                    </select>
                    <label style={{ display: 'flex', alignItems: 'center', gap: 10, fontSize: 13, marginBottom: 10, color: 'var(--text)' }}>
                      <input 
                        type="checkbox" 
                        checked={adminGenAuth}
                        onChange={(e) => setAdminGenAuth(e.target.checked)}
                      /> 
                      Сгенерировать новый Authorization Token
                    </label>
                    <button className="btn-primary" onClick={handleAdminUpdateBot} disabled={saving}>
                      {saving ? '...' : 'Установить бейдж и токен'}
                    </button>
                  </div>

                  <div style={{ display: 'flex', gap: 8, flexWrap: 'wrap' }}>
                    <button className="btn-ghost" style={{ color: 'var(--warn)', borderColor: 'var(--warn)', flex: 1, padding: '10px' }} onClick={handleAdminRevokeAuth} disabled={saving}>
                      Отозвать Auth Token
                    </button>
                    <button className="btn-ghost" style={{ color: 'var(--danger)', borderColor: 'var(--danger)', flex: 1, padding: '10px' }} onClick={() => handleAdminBanBot(true)} disabled={saving}>
                      Забанить
                    </button>
                    <button className="btn-ghost" style={{ flex: 1, padding: '10px' }} onClick={() => handleAdminBanBot(false)} disabled={saving}>
                      Разбанить
                    </button>
                  </div>
                </div>

                <div className="pro-card" style={{ border: '1px solid var(--accent)', marginBottom: 16 }}>
                  <h3 style={{ color: 'var(--accent)', marginBottom: 16 }}>📢 Верификация Каналов</h3>
                  <div className="input-group">
                    <label>Chat ID</label>
                    <input 
                      type="text" 
                      placeholder="Вставьте Chat ID канала" 
                      value={adminChannelId}
                      onChange={(e) => setAdminChannelId(e.target.value)}
                    />
                  </div>
                  <select 
                      style={{ width: '100%', padding: '10px 14px', borderRadius: 8, background: 'var(--surface3)', color: 'var(--text)', border: '1px solid var(--border)', marginBottom: 10 }}
                      value={adminChannelBadge}
                      onChange={(e) => setAdminChannelBadge(e.target.value)}
                    >
                      <option value="unverified">Unverified</option>
                      <option value="official">Official</option>
                      <option value="visorlink">VisorLink</option>
                  </select>
                  <button className="btn-primary" onClick={handleAdminVerifyChannel} disabled={saving || !adminChannelId}>
                    {saving ? '...' : 'Установить бейдж каналу'}
                  </button>
                </div>

                <div className="pro-card" style={{ border: '1px solid var(--warn)', marginBottom: 16 }}>
                  <h3 style={{ color: 'var(--warn)', marginBottom: 16 }}>🤖 Канальные Боты (Webhooks)</h3>
                  <div className="input-group">
                    <label>Chat ID</label>
                    <input type="text" placeholder="Chat ID" value={adminChannelBotChatId} onChange={(e) => setAdminChannelBotChatId(e.target.value)} />
                  </div>
                  <div className="input-group">
                    <label>Key ID</label>
                    <input type="text" placeholder="Key ID" value={adminChannelBotKeyId} onChange={(e) => setAdminChannelBotKeyId(e.target.value)} />
                  </div>
                  <select 
                      style={{ width: '100%', padding: '10px 14px', borderRadius: 8, background: 'var(--surface3)', color: 'var(--text)', border: '1px solid var(--border)', marginBottom: 10 }}
                      value={adminChannelBotBadge}
                      onChange={(e) => setAdminChannelBotBadge(e.target.value)}
                    >
                      <option value="unverified">Unverified</option>
                      <option value="official">Official</option>
                      <option value="visorlink">VisorLink</option>
                  </select>
                  <button className="btn-primary" onClick={handleAdminVerifyChannelBot} disabled={saving || !adminChannelBotChatId || !adminChannelBotKeyId}>
                    {saving ? '...' : 'Установить бейдж канальному боту'}
                  </button>
                </div>

                <div className="pro-card" style={{ border: '1px solid var(--text3)' }}>
                  <h3 style={{ color: 'var(--text3)', marginBottom: 16 }}>👤 Пользователи</h3>
                  <div className="input-group">
                    <label>User UID</label>
                    <input 
                      type="text" 
                      placeholder="Вставьте UID пользователя" 
                      value={adminUserUid}
                      onChange={(e) => setAdminUserUid(e.target.value)}
                    />
                  </div>
                  <button className="btn-primary" onClick={handleAdminVerifyEmail} disabled={saving || !adminUserUid}>
                    {saving ? '...' : 'Верифицировать Email'}
                  </button>
                  <button className="btn-ghost" style={{ marginTop: 8, width: '100%', color: 'var(--warn)', borderColor: 'var(--warn)' }} onClick={handleAdminGrantEternalPro} disabled={saving}>
                    {saving ? '...' : 'Выдать Вечный PRO (пустое = себе)'}
                  </button>
                </div>

              </div>
            )}

          </div>
        </div>

      </div>
    </div>
  );
}
