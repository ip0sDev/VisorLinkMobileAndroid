// src/components/FeedWindow.jsx
import { useState, useEffect, useMemo, useCallback } from 'react';
import { db } from '../firebase/config';
import { useAuth } from '../contexts/AuthContext';
import { useI18n } from '../contexts/I18nContext';
import { collection, query, where, orderBy, limit, onSnapshot } from 'firebase/firestore';
import { getFunctions, httpsCallable } from 'firebase/functions';
import MessageBubble from './MessageBubble';
import CommentsSheet from './CommentsSheet';
import ForwardPickerModal from './ForwardPickerModal';

const fn = getFunctions(undefined, 'europe-west1');
const toggleLikeFn = httpsCallable(fn, 'toggleLike');

export default function FeedWindow({ onViewProfile, onSelectChat }) {
  const { user, userData } = useAuth();
  const { t } = useI18n();
  const [authToken, setAuthToken] = useState('');

  const [feedTab, setFeedTab] = useState('discover');

  const [channels, setChannels] = useState([]);
  const [followingMessages, setFollowingMessages] = useState({});
  const [loadingFollowing, setLoadingFollowing] = useState(true);

  const [discoverMessages, setDiscoverMessages] = useState([]);
  const [loadingDiscover, setLoadingDiscover] = useState(true);

  const [commentsPost, setCommentsPost] = useState(null);
  const [forwardMsg, setForwardMsg] = useState(null);
  const [revealedIds, setRevealedIds] = useState(new Set());

  useEffect(() => {
    user?.getIdToken().then(setAuthToken);
  }, [user]);

  useEffect(() => {
    if (!user?.uid) return;
    const q = query(
      collection(db, 'chats'),
      where('memberIds', 'array-contains', user.uid),
      where('type', '==', 'channel')
    );
    const unsub = onSnapshot(q, snap => {
      setChannels(snap.docs.map(d => ({ id: d.id, ...d.data() })));
      setLoadingFollowing(false);
    });
    return unsub;
  }, [user?.uid]);

  useEffect(() => {
    if (channels.length === 0) {
      setFollowingMessages({});
      return;
    }
    const unsubs = channels.map(channel => {
      const q = query(collection(db, 'chats', channel.id, 'messages'), orderBy('createdAt', 'desc'), limit(5));
      return onSnapshot(q, snap => {
        const msgs = snap.docs.map(d => ({ 
            id: d.id, chatId: channel.id, channelData: { name: channel.name, avatarUrl: channel.avatarUrl },
            ...d.data({ serverTimestamps: 'estimate' }) 
        }));
        setFollowingMessages(prev => ({ ...prev, [channel.id]: msgs }));
      });
    });
    return () => unsubs.forEach(u => u());
  }, [channels]);

  useEffect(() => {
    if (feedTab !== 'discover') return;
    setLoadingDiscover(true);
    
    const weights = userData?.interestWeights || {};
    const topInterests = Object.entries(weights)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 10)
      .map(entry => entry[0]);

    let q;
    if (topInterests.length > 0) {
      q = query(
        collection(db, 'discover_feed'), 
        where('tags', 'array-contains-any', topInterests), 
        orderBy('createdAt', 'desc'), 
        limit(30)
      );
    } else {
      q = query(collection(db, 'discover_feed'), orderBy('createdAt', 'desc'), limit(30));
    }

    const unsub = onSnapshot(q, snap => {
      const msgs = snap.docs.map(d => ({
        id: d.data().messageId,
        discoverId: d.id,
        ...d.data({ serverTimestamps: 'estimate' })
      }));
      setDiscoverMessages(msgs);
      setLoadingDiscover(false);
    });

    return unsub;
  }, [feedTab, userData?.interestWeights]);

  const followingItems = useMemo(() => {
    return Object.values(followingMessages).flat().filter(m => !m.deleted).sort((a, b) => {
      return (b.createdAt?.toMillis?.() || 0) - (a.createdAt?.toMillis?.() || 0);
    });
  }, [followingMessages]);

  const activeItems = feedTab === 'following' ? followingItems : discoverMessages;
  const isLoading = feedTab === 'following' ? loadingFollowing : loadingDiscover;

  const handleLikeToggle = useCallback(async (msg, isNowLiked) => {
    if (feedTab !== 'discover') return;
    
    setDiscoverMessages(prev => prev.map(m => {
      if (m.discoverId === msg.discoverId) {
        const likers = m.likers || [];
        const newLikers = isNowLiked ? [...likers, user.uid] : likers.filter(u => u !== user.uid);
        return { ...m, likers: newLikers, likeCount: newLikers.length };
      }
      return m;
    }));

    try {
      await toggleLikeFn({ chatId: msg.chatId, messageId: msg.messageId, isLiked: isNowLiked });
    } catch (e) {
      console.error("Like failed:", e);
    }
  }, [feedTab, user?.uid]);

  function handleRevealSpoiler(id) {
    setRevealedIds(prev => new Set([...prev, id]));
  }

  return (
    <div className="chat-window feed-window">
      <div className="chat-topbar" style={{ flexDirection: 'column', alignItems: 'stretch', padding: 0, height: 'auto' }}>
        <div style={{ padding: '16px 20px 0', textAlign: 'center' }}>
          <h2 style={{ margin: 0, fontSize: 20, fontFamily: 'var(--font-brand)', color: 'var(--text)' }}>
            {t('feed.title')}
          </h2>
        </div>
        <div className="feed-tabs">
          <button 
            className={`feed-tab ${feedTab === 'discover' ? 'active' : ''}`}
            onClick={() => setFeedTab('discover')}
          >
            {t('feed.tab.discover')}
          </button>
          <button 
            className={`feed-tab ${feedTab === 'following' ? 'active' : ''}`}
            onClick={() => setFeedTab('following')}
          >
            {t('feed.tab.following')}
          </button>
        </div>
      </div>

      <div className="messages-area feed-area">
        {isLoading ? (
          <div className="chat-empty-state"><p>{t('general.loading')}</p></div>
        ) : activeItems.length === 0 ? (
          <div className="chat-empty-state" style={{ padding: '60px 20px', textAlign: 'center' }}>
            <div style={{ fontSize: 48, marginBottom: 12 }}>📰</div>
            <p style={{ color: 'var(--text2)', fontSize: 14 }}>{t('feed.empty')}</p>
          </div>
        ) : (
          <div style={{ maxWidth: 680, width: '100%', margin: '0 auto', display: 'flex', flexDirection: 'column' }}>
            {activeItems.map(msg => (
              <MessageBubble
                key={msg.discoverId || `${msg.chatId}-${msg.id}`}
                message={msg}
                isOwn={msg.senderId === user?.uid}
                onReply={() => {}} 
                chatId={msg.chatId}
                chatName={msg.channelData.name}
                noForwards={false} 
                otherUid={null}
                showReadReceipt={false}
                reactionsEnabled={false}
                isChannel={true}
                onOpenComments={() => setCommentsPost(msg)}
                revealedIds={revealedIds}
                onRevealSpoiler={handleRevealSpoiler}
                onViewProfile={onViewProfile}
                onSelectChat={onSelectChat}
                feedChannelData={msg.channelData}
                isFeedMode={feedTab === 'discover'}
                onLikeToggle={handleLikeToggle}
                authToken={authToken}
              />
            ))}
          </div>
        )}
      </div>

      {commentsPost && (
        <CommentsSheet
          chatId={commentsPost.chatId}
          message={commentsPost}
          isAdmin={false}
          onClose={() => setCommentsPost(null)}
        />
      )}

      {forwardMsg && (
        <ForwardPickerModal
          message={forwardMsg}
          sourceChatId={forwardMsg.chatId}
          sourceChatName={forwardMsg.channelData.name}
          onClose={() => setForwardMsg(null)}
        />
      )}
    </div>
  );
}
</file>

<file path="src/components/JoinByTagModal.jsx">
import { useState } from 'react';
import { getFunctions, httpsCallable } from 'firebase/functions';
import { useI18n } from '../contexts/I18nContext';

const fn = getFunctions(undefined, 'europe-west1');
const findByTagFn    = httpsCallable(fn, 'findByTag');
const joinByTagFn    = httpsCallable(fn, 'joinByTag');
const joinByInviteFn = httpsCallable(fn, 'joinByInvite');

export default function JoinByTagModal({ onClose, onJoined }) {
  const { t } = useI18n();
  const [input, setInput] = useState('');
  const [found, setFound] = useState(null);
  const [loading, setLoading] = useState(false);
  const [joining, setJoining] = useState(false);
  const [error, setError] = useState('');

  const isInviteToken =
    input.length > 10 &&
    !input.startsWith('@') &&
    !/^[a-zA-Z0-9_]+$/.test(input.replace('@', ''));

  async function handleSearch(e) {
    e.preventDefault();
    setError('');
    setFound(null);
    setLoading(true);
    try {
      if (isInviteToken) {
        const res = await joinByInviteFn({ token: input.trim() });
        onJoined(res.data.chatId, res.data.chatType);
        onClose();
      } else {
        const res = await findByTagFn({ tag: input });
        if (res.data.found) setFound(res.data);
        else setError(t('join.notFound'));
      }
    } catch (err) {
      setError(err.message);
    }
    setLoading(false);
  }

  async function handleJoin() {
    if (!found) return;
    setJoining(true);
    setError('');
    try {
      const res = await joinByTagFn({ tag: found.tag });
      onJoined(res.data.chatId, 'channel');
      onClose();
    } catch (err) {
      setError(err.message);
    }
    setJoining(false);
  }

  return (
    <div className="modal-overlay" onClick={onClose}>
      <div className="modal" onClick={e => e.stopPropagation()}>
        <div className="modal-header">
          <h3>{t('join.title')}</h3>
          <button className="modal-close" onClick={onClose}>✕</button>
        </div>

        <form onSubmit={handleSearch}>
          <div className="input-group">
            <label>{t('join.placeholder')}</label>
            <input
              type="text"
              placeholder={t('join.placeholder')}
              value={input}
              onChange={e => setInput(e.target.value)}
              autoFocus
              required
            />
          </div>
          <button type="submit" className="btn-primary" disabled={loading}>
            {loading ? t('join.searching') : t('join.search')}
          </button>
        </form>

        {found && (
          <div className="found-chat-card">
            <div className="found-avatar">
              {found.avatarUrl
                ? <img src={found.avatarUrl} alt={found.name} />
                : found.name?.[0]?.toUpperCase()
              }
            </div>
            <div className="found-info">
              <div className="found-name">{found.name}</div>
              <div className="found-tag">@{found.tag}</div>
              {found.description && <div className="found-desc">{found.description}</div>}
              <div className="found-meta">
                {found.memberCount} {t('join.members')} · {found.type}
              </div>
            </div>
            <button
              className="btn-primary"
              style={{ marginTop: 12 }}
              onClick={handleJoin}
              disabled={joining || !found.joinByTag}
            >
              {joining
                ? t('join.joining')
                : found.joinByTag
                  ? t('join.join')
                  : t('join.disabled')
              }
            </button>
          </div>
        )}

        {error && <div className="auth-error" style={{ marginTop: 10 }}>{error}</div>}
      </div>
    </div>
  );
}
</file>

<file path="src/components/StickerPicker.jsx">
import { useRef, useState } from 'react';
import { useI18n } from '../contexts/I18nContext';
import { useStickers } from '../hooks/useStickers';

export default function StickerPicker({ onSelect, onClose }) {
  const { t } = useI18n();

  const {
    packs, loading,
    createPack, addStickerToPack, removeStickerFromPack, deletePack
  } = useStickers();

  const fileRef       = useRef();
  const [activePack, setActivePack]   = useState(null); // packId currently viewed
  const [showCreate, setShowCreate]   = useState(false);
  const [newPackName, setNewPackName] = useState('');
  const [newPackEmoji, setNewPackEmoji] = useState('📦');

  // For adding a sticker to a pack
  const [pendingFile, setPendingFile]       = useState(null);
  const [pendingEmoji, setPendingEmoji]     = useState('');
  const [addingSticker, setAddingSticker]   = useState(false);

  const currentPack = packs.find(p => p.id === activePack) || null;

  // ── Create pack ──────────────────────────────────────────
  async function handleCreatePack() {
    if (!newPackName.trim()) return;
    const id = await createPack({ name: newPackName.trim(), emoji: newPackEmoji });
    setNewPackName('');
    setNewPackEmoji('📦');
    setShowCreate(false);
    setActivePack(id);
  }

  // ── Add sticker flow ─────────────────────────────────────
  function handleFileChosen(e) {
    const file = e.target.files[0];
    if (!file || !activePack) return;
    setPendingFile(file);
    e.target.value = '';
  }

  async function confirmAddSticker() {
    if (!pendingFile || !activePack) return;
    setAddingSticker(true);
    await addStickerToPack(activePack, pendingFile, { emoji: pendingEmoji });
    setPendingFile(null);
    setPendingEmoji('');
    setAddingSticker(false);
  }

  // ── Select sticker to send ───────────────────────────────
  function handleSelect(sticker) {
    onSelect({ ...sticker, packId: activePack });
    onClose();
  }

  return (
    <div className="sticker-picker" onClick={e => e.stopPropagation()}>

      {/* ── Header ── */}
      <div className="sticker-picker-header">
        {currentPack ? (
          <>
            <button className="icon-btn sp-back" onClick={() => setActivePack(null)}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" strokeWidth="2.5">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
            </button>
            <span className="sp-pack-title">
              {currentPack.emoji} {currentPack.name}
            </span>
            <div className="sp-header-actions">
              <button className="icon-btn" title={t('addStickerTooltip')}
                onClick={() => fileRef.current.click()}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" strokeWidth="2">
                  <path d="M12 5v14M5 12h14"/>
                </svg>
              </button>
              <button className="icon-btn sp-delete-pack"
                title={t('deletePackTooltip')}
                onClick={async () => {
                  if (window.confirm(t('deletePackConfirm', { name: currentPack.name }))) {
                    await deletePack(activePack);
                    setActivePack(null);
                  }
                }}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" strokeWidth="2">
                  <polyline points="3 6 5 6 21 6"/>
                  <path d="M19 6l-1 14H6L5 6M10 11v6M14 11v6M9 6V4h6v2"/>
                </svg>
              </button>
            </div>
          </>
        ) : (
          <>
            <span>{t('title')}</span>
            <button className="icon-btn" title={t('newPackTooltip')}
              onClick={() => setShowCreate(true)}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" strokeWidth="2">
                <path d="M12 5v14M5 12h14"/>
              </svg>
            </button>
          </>
        )}
      </div>

      <input ref={fileRef} type="file" accept="image/*,.gif,.webp"
        style={{ display: 'none' }} onChange={handleFileChosen} />

      {/* ── Create pack modal ── */}
      {showCreate && (
        <div className="sp-create-overlay" onClick={() => setShowCreate(false)}>
          <div className="sp-create-box" onClick={e => e.stopPropagation()}>
            <p className="sp-create-title">{t('newPackTitle')}</p>
            <div className="sp-create-row">
              <input
                className="sp-emoji-input"
                value={newPackEmoji}
                onChange={e => setNewPackEmoji(e.target.value)}
                maxLength={2}
              />
              <input
                className="sp-name-input"
                placeholder={t('packNamePlaceholder')}
                value={newPackName}
                onChange={e => setNewPackName(e.target.value)}
                onKeyDown={e => e.key === 'Enter' && handleCreatePack()}
                autoFocus
              />
            </div>
            <div className="sp-create-actions">
              <button className="btn-ghost" onClick={() => setShowCreate(false)}>
                {t('cancel')}
              </button>
              <button className="btn-primary" onClick={handleCreatePack}
                disabled={!newPackName.trim()}>
                {t('create')}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ── Pending sticker confirmation ── */}
      {pendingFile && (
        <div className="sp-create-overlay" onClick={() => setPendingFile(null)}>
          <div className="sp-create-box" onClick={e => e.stopPropagation()}>
            <p className="sp-create-title">{t('addStickerTitle')}</p>
            <img src={URL.createObjectURL(pendingFile)}
              alt="preview" className="sp-sticker-preview" />
            <input
              className="sp-emoji-input sp-emoji-centered"
              placeholder={t('emojiPlaceholder')}
              value={pendingEmoji}
              onChange={e => setPendingEmoji(e.target.value)}
              maxLength={2}
            />
            <p className="sp-hint">{t('attachEmojiHint')}</p>
            <div className="sp-create-actions">
              <button className="btn-ghost" onClick={() => setPendingFile(null)}>
                {t('cancel')}
              </button>
              <button className="btn-primary" onClick={confirmAddSticker}
                disabled={addingSticker}>
                {addingSticker ? t('addingButton') : t('addButton')}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ── Loading ── */}
      {loading && <div className="sticker-empty">{t('loading')}</div>}

      {/* ── Pack list ── */}
      {!loading && !currentPack && (
        <>
          {packs.length === 0 && (
            <div className="sticker-empty">
              <p>{t('noPacksYet')}</p>
              <button className="btn-ghost" onClick={() => setShowCreate(true)}>
                {t('createFirstPack')}
              </button>
            </div>
          )}
          <div className="sp-pack-list">
            {packs.map(pack => (
              <div key={pack.id} className="sp-pack-row"
                onClick={() => setActivePack(pack.id)}>
                <span className="sp-pack-icon">{pack.emoji}</span>
                <div className="sp-pack-info">
                  <span className="sp-pack-name">{pack.name}</span>
                  <span className="sp-pack-count">
                    {t('stickersCount', { count: pack.stickers?.length ?? 0 })}
                  </span>
                </div>
                {/* Preview strip */}
                <div className="sp-pack-preview">
                  {(pack.stickers || []).slice(0, 3).map(s => (
                    <img key={s.id} src={s.url} alt={s.emoji || s.name}
                      className="sp-preview-thumb" />
                  ))}
                </div>
                <svg className="sp-chevron" width="14" height="14"
                  viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" strokeWidth="2">
                  <path d="M9 18l6-6-6-6"/>
                </svg>
              </div>
            ))}
          </div>
        </>
      )}

      {/* ── Sticker grid inside pack ── */}
      {!loading && currentPack && (
        <>
          {currentPack.stickers.length === 0 && (
            <div className="sticker-empty">
              <p>{t('packIsEmpty')}</p>
              <button className="btn-ghost" onClick={() => fileRef.current.click()}>
                {t('addFirstSticker')}
              </button>
            </div>
          )}
          <div className="sticker-grid">
            {currentPack.stickers.map(s => (
              <div key={s.id} className="sticker-item"
                onClick={() => handleSelect(s)}>
                <img src={s.url} alt={s.emoji || s.name} draggable={false} />
                {s.emoji && <span className="sp-sticker-emoji">{s.emoji}</span>}
                <button className="sticker-remove"
                  onClick={e => {
                    e.stopPropagation();
                    removeStickerFromPack(activePack, s);
                  }}
                  title={t('removeTooltip')}>✕</button>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
  );
}
