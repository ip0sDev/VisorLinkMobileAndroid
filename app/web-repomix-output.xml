import { createContext, useContext, useEffect, useState } from 'react';

const DesignStyleContext = createContext();

export const DESIGN_STYLES = ['biolume', 'forge', 'material'];
export const ACCENT_PRESETS = ['default', 'purple', 'blue', 'emerald', 'crimson'];

export function DesignStyleProvider({ children }) {
  const [style, setStyleState] = useState(() => {
    const saved = localStorage.getItem('vl_style');
    return DESIGN_STYLES.includes(saved) ? saved : 'biolume';
  });

  const [accent, setAccentState] = useState(() => {
    const saved = localStorage.getItem('vl_accent');
    return ACCENT_PRESETS.includes(saved) ? saved : 'default';
  });

  useEffect(() => {
    document.documentElement.setAttribute('data-style', style);
    localStorage.setItem('vl_style', style);
  }, [style]);

  useEffect(() => {
    document.documentElement.setAttribute('data-accent', accent);
    localStorage.setItem('vl_accent', accent);
  }, [accent]);

  const setStyle = (value) => {
    if (DESIGN_STYLES.includes(value)) setStyleState(value);
  };

  const setAccent = (value) => {
    if (ACCENT_PRESETS.includes(value)) setAccentState(value);
  };

  return (
    <DesignStyleContext.Provider value={{ style, setStyle, accent, setAccent }}>
      {children}
    </DesignStyleContext.Provider>
  );
}

export const useDesignStyle = () => useContext(DesignStyleContext);
