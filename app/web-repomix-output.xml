.app-layout { display: flex; height: 100dvh; overflow: hidden; background: var(--bg); position: relative; }
.app-layout::before, .app-layout::after { content: ''; position: absolute; border-radius: 50%; filter: blur(100px); z-index: 0; pointer-events: none; animation: ambient-drift 15s infinite alternate ease-in-out; opacity: 0.6; }
.app-layout::before { width: 40vw; height: 40vw; background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%); top: -10vw; left: -10vw; animation-delay: 0s; }
.app-layout::after { width: 50vw; height: 50vw; background: radial-gradient(circle, var(--accent-glow2) 0%, transparent 70%); bottom: -15vw; right: -10vw; animation-delay: -5s; }
@keyframes ambient-drift { 0% { transform: translate(0, 0) scale(1); opacity: 0.5; } 33% { transform: translate(5vw, 8vh) scale(1.1); opacity: 0.7; } 66% { transform: translate(-3vw, 12vh) scale(0.9); opacity: 0.6; } 100% { transform: translate(-8vw, -5vh) scale(1.05); opacity: 0.5; } }

/* UI Elements */
.btn-primary { width: 100%; background: linear-gradient(135deg, var(--accent-light), var(--accent-dark)); border: none; border-radius: 12px; color: white; font-family: var(--font-ui); font-size: 14px; font-weight: 700; padding: 12px; cursor: pointer; box-shadow: 4px 4px 8px rgba(0,0,0,0.40), -2px -2px 6px rgba(255,255,255,0.08), 0 0 20px var(--accent-glow); transition: opacity 0.2s, box-shadow 0.2s, transform 0.1s; position: relative; overflow: hidden; }
.btn-primary::before { content: ''; position: absolute; top: 0; left: -100%; width: 60%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent); transform: skewX(-15deg); transition: left 0s; }
.btn-primary:hover:not(:disabled)::before { left: 160%; transition: left 0.55s ease; }
.btn-primary:hover:not(:disabled) { opacity: 0.9; box-shadow: 4px 4px 8px rgba(0,0,0,0.40), -2px -2px 6px rgba(255,255,255,0.08), 0 0 28px var(--accent-glow); animation: btn-pulse 1.5s infinite alternate ease-in-out; }
@keyframes btn-pulse { from { box-shadow: 4px 4px 8px rgba(0,0,0,0.40), -2px -2px 6px rgba(255,255,255,0.08), 0 0 28px var(--accent-glow); } to { box-shadow: 4px 4px 8px rgba(0,0,0,0.40), -2px -2px 6px rgba(255,255,255,0.08), 0 0 40px var(--accent-light); } }
.btn-primary:active:not(:disabled) { transform: scale(0.97); }
.btn-primary:disabled { opacity: 0.35; cursor: not-allowed; box-shadow: none; }
.btn-ghost { background: none; border: 1px solid var(--border2); color: var(--text2); font-family: var(--font-ui); font-size: 13px; padding: 7px 14px; border-radius: 10px; cursor: pointer; transition: all 0.15s; }
.btn-ghost:hover { background: var(--surface3); color: var(--text); border-color: var(--accent); }

.avatar { width: 38px; height: 38px; background: linear-gradient(135deg, var(--accent-dark), var(--accent)); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; color: white; flex-shrink: 0; box-shadow: var(--neo-shadow-btn); overflow: hidden; transition: box-shadow 0.3s ease; animation: avatar-appear 0.4s cubic-bezier(0.16, 1, 0.3, 1) both; }
@keyframes avatar-appear { from { opacity: 0; transform: scale(0.8); } to { opacity: 1; transform: scale(1); } }
.avatar.sm { width: 32px; height: 32px; font-size: 13px; }
