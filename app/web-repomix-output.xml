// functions/src/guards.js
// ─────────────────────────────────────────────────────────────────────────────
// Reusable guard helpers for Cloud Functions.
// Import and call at the top of every onCall handler.
// ─────────────────────────────────────────────────────────────────────────────

const { HttpsError } = require('firebase-functions/v2/https');
const admin = require('firebase-admin');

// Убедись, что admin.initializeApp() уже вызван в твоем главном index.js

/**
 * Throws if the caller is not authenticated AND has a verified email.
 * Checks App Check attestation and writes the client status to RTDB.
 *
 * Usage:
 * const { uid, isOfficial } = await requireVerified(request); // Не забудь await!
 */
async function requireVerified(request) {
  // 1. Базовые проверки аутентификации
  if (!request.auth) {
    throw new HttpsError('unauthenticated', 'Not authenticated.');
  }
  if (!request.auth.token.email_verified) {
    throw new HttpsError(
      'permission-denied',
      'Email address is not verified. Please verify your email before using this feature.'
    );
  }

  const uid = request.auth.uid;

  // 2. Проверка App Check
  // Если request.app определен, значит токен прошел проверку серверами Google.
  // Если undefined — запрос пришел без токена или с недействительным (модифицированный клиент).
  const isOfficial = request.app !== undefined;

  // 3. Запись статуса в Realtime Database
  // Путь: /users/{uid}/clientStatus
  try {
    await admin.database().ref(`users/${uid}/clientStatus`).update({
      isOfficial: isOfficial,
      lastActive: admin.database.ServerValue.TIMESTAMP
    });
  } catch (error) {
    // Оборачиваем в try-catch, чтобы сбой в RTDB (например, таймаут)
    // не "уронил" основную функцию (например, отправку сообщения)
    console.error(`Failed to update RTDB client status for user ${uid}`, error);
  }

  // Возвращаем isOfficial вместе с остальными данными, вдруг понадобится в самой функции
  return { uid, token: request.auth.token, isOfficial };
}

module.exports = { requireVerified };
</file>

<file path="functions/onNewMessage.js">
// functions/onNewMessage.js
const { onDocumentCreated } = require('firebase-functions/v2/firestore');
const { getFirestore, FieldValue } = require('firebase-admin/firestore');
const { getMessaging } = require('firebase-admin/messaging');
const https = require('https'); // Встроенный модуль Node.js

const NTFY_HOST = 'ntfy.envs.net'; 

exports.onNewMessage = onDocumentCreated(
  { document: 'chats/{chatId}/messages/{messageId}', region: 'europe-west1' },
  async (event) => {
    console.log('=== onNewMessage START ===');

    const snap = event.data;
    if (!snap) return;

    const message = snap.data();
    const { chatId } = event.params;

    if (message.deleted) return;

    const senderId = message.senderId;
    if (!senderId) return;

    const db = getFirestore();
    const chatDoc = await db.collection('chats').doc(chatId).get();
    if (!chatDoc.exists) return;

    const chat = chatDoc.data();
    const isDirect = chat.type === 'direct' || (!chat.type && Array.isArray(chat.participants) && chat.participants.length === 2);

    let recipientUids = [];

    if (isDirect) {
      const other = (chat.participants || []).find(uid => uid !== senderId);
      if (other) recipientUids = [other];
    } else {
      const membersSnap = await db.collection('chats').doc(chatId).collection('members').where('banned', '==', false).get();
      recipientUids = membersSnap.docs.map(d => d.id).filter(uid => uid !== senderId);
    }

    if (recipientUids.length === 0) return;

    let rawSenderName = 'Unknown';
    let isSenderBot = false;

    if (message.isBot && message.botLabel) {
      rawSenderName = message.botLabel;
      isSenderBot = true;
    } else {
      const senderDoc = await db.collection('users').doc(senderId).get();
      if (senderDoc.exists) {
        rawSenderName = senderDoc.data().displayName || message.senderUsername || 'Unknown';
        isSenderBot = senderDoc.data().isBot === true;
      } else {
        rawSenderName = message.senderUsername || 'Unknown';
      }
    }

    const displaySenderName = isSenderBot ? `🤖 ${rawSenderName}` : rawSenderName;
    const title = isDirect ? displaySenderName : (chat.name || 'Группа');
    const prefix = isDirect ? '' : `${displaySenderName}: `;

    let bodyText = '';
    switch (message.type) {
      case 'text':    bodyText = message.text?.substring(0, 100) || ''; break;
      case 'image':   bodyText = '📷 Фото'; break;
      case 'voice':   bodyText = '🎤 Голосовое сообщение'; break;
      case 'sticker': bodyText = '🎭 Стикер'; break;
      case 'album':   bodyText = message.caption?.substring(0, 100) || '🖼️ Альбом'; break;
      case 'gift':    bodyText = '🎁 Подарок: VisorLink PRO'; break;
      default:        bodyText = 'Новое сообщение';
    }
    const body = `${prefix}${bodyText}`;

    const messaging = getMessaging();

    for (const recipientUid of recipientUids) {
      const recipientDoc = await db.collection('users').doc(recipientUid).get();
      if (!recipientDoc.exists) continue;
      
      const recipient = recipientDoc.data();
      if (recipient.isBot) continue;

      // 1. FCM (Mobile/Web)
      const fcmTokens = recipient.fcmTokens || [];
      if (fcmTokens.length > 0) {
        const sendPromises = fcmTokens.map(async (token) => {
          try {
            await messaging.send({ token, data: { chatId, senderUid: senderId, title, body }, android: { priority: 'high' } });
          } catch (err) {
            if (err.code === 'messaging/registration-token-not-registered' || err.code === 'messaging/invalid-registration-token') {
              return db.collection('users').doc(recipientUid).update({ fcmTokens: FieldValue.arrayRemove(token) });
            }
          }
        });
        await Promise.all(sendPromises);
      }

      // 2. Ntfy (ОБНОВЛЕННАЯ ВЕРСИЯ ЧЕРЕЗ JSON API - 100% обход ошибок кодировки)
      const ntfyTopics = recipient.ntfyTopics || [];
      if (ntfyTopics.length > 0) {
        console.log(`🔔 Sending Ntfy to ${ntfyTopics.length} topics on ${NTFY_HOST} for ${recipientUid}`);
        
        // Пакуем реальные данные чата для Flutter в текстовое поле message
        const flutterPayload = JSON.stringify({ chatId, title, body });
        
        for (const topic of ntfyTopics) {
          try {
            // Формируем строгий JSON-запрос для Ntfy, чтобы не зависеть от заголовков HTTP
            const payloadData = JSON.stringify({
              topic: topic,
              message: flutterPayload,
              title: title,
              cache: "no"
            });
            const data = Buffer.from(payloadData, 'utf8');

            const options = {
              hostname: NTFY_HOST,
              port: 443,
              path: '/', // API Ntfy требует POST на корень (/) при отправке JSON
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Content-Length': data.length
              }
            };

            await new Promise((resolve, reject) => {
              const req = https.request(options, (res) => {
                if (res.statusCode === 200) {
                  console.log(`✅ Ntfy push success for topic: ${topic}`);
                  resolve();
                } else {
                  console.error(`❌ Ntfy push failed for topic ${topic} with status ${res.statusCode}`);
                  resolve();
                }
              });
              req.on('error', (e) => {
                console.error(`❌ Ntfy network error for ${topic}:`, e);
                resolve(); 
              });
              req.write(data);
              req.end();
            });
          } catch (err) {
            console.error(`❌ Ntfy execution error for ${topic}:`, err);
          }
        }
      }
    }

    console.log('=== onNewMessage END ===');
  }
);
</file>

