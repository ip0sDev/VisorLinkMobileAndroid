@keyframes bubble-in { from { opacity: 0; transform: translateX(-14px) scale(0.95); } 60% { transform: translateX(4px) scale(1.03); } to { opacity: 1; transform: none; } }
@keyframes bubble-in-own { from { opacity: 0; transform: translateX(14px) scale(0.95); } 60% { transform: translateX(-4px) scale(1.03); } to { opacity: 1; transform: none; } }
