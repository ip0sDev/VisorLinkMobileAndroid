import { useState, useEffect, useMemo, useCallback } from 'react';
import { auth } from '../firebase/config';
import { useAuth } from './AuthContext';
import { StickersContext } from './StickersContext';

const CDN_URL = 'https://api.visorlink.org';

export function StickersProvider({ children }) {
  const { user } = useAuth();
  const [packs, setPacks] = useState([]);
  const [loading, setLoading] = useState(true);

  // Отслеживаем смену пользователя, чтобы очищать кэш
  const [currentUid, setCurrentUid] = useState(null);

  useEffect(() => {
    if (user?.uid !== currentUid) {
      setCurrentUid(user?.uid || null);
      setPacks([]);
      setLoading(!!user);
    }
  }, [user?.uid, currentUid]);

  // Загрузка всех паков пользователя
  const fetchPacks = useCallback(async () => {
    if (!user) return;
    try {
      const token = await user.getIdToken();
      const res = await fetch(`${CDN_URL}/stickerpacks/my`, {
        headers: { Authorization: `Bearer ${token}` }
      });
      if (res.ok) {
        const data = await res.json();
        setPacks(data.packs || []);
      }
    } catch (e) {
      console.error("Failed to fetch sticker packs", e);
    } finally {
      setLoading(false);
    }
  }, [user]);

  useEffect(() => {
    fetchPacks();
  }, [fetchPacks]);

  // Создание нового пака
  const createPack = useCallback(async ({ name, emoji }) => {
    const token = await auth.currentUser.getIdToken();
    const res = await fetch(`${CDN_URL}/stickerpacks/create`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: `Bearer ${token}`
      },
      body: JSON.stringify({ 
        name, 
        emoji, 
        author_name: user.displayName || user.username 
      })
    });
    
    const data = await res.json();
    if (!res.ok) throw new Error(data.error);
    
    const newPack = { id: data.pack_id, name, emoji, stickers: [] };
    setPacks(prev => [newPack, ...prev]);
    
    return data.pack_id;
  }, [user]);

  // Загрузка стикера в пак
  const addStickerToPack = useCallback(async (packId, file, { emoji = '', name = '' } = {}) => {
    if (!file || !user) return;
    const token = await auth.currentUser.getIdToken();
    
    const formData = new FormData();
    formData.append('file', file);
    formData.append('emoji', emoji);
    formData.append('name', name || file.name.replace(/\.[^/.]+$/, ''));

    const res = await fetch(`${CDN_URL}/stickerpacks/${packId}/add_sticker`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${token}` },
      body: formData
    });
    
    const data = await res.json();
    if (!res.ok) throw new Error(data.error);

    setPacks(prev => prev.map(p => 
      p.id === packId 
        ? { ...p, stickers: [...(p.stickers || []), data.sticker] }
        : p
    ));
  }, [user]);

  // Удаление стикера
  const removeStickerFromPack = useCallback(async (packId, sticker) => {
    const token = await auth.currentUser.getIdToken();
    
    // Оптимистичное обновление UI
    setPacks(prev => prev.map(p => 
      p.id === packId 
        ? { ...p, stickers: p.stickers.filter(s => s.id !== sticker.id) }
        : p
    ));

    await fetch(`${CDN_URL}/stickerpacks/${packId}/stickers/${sticker.id}`, {
      method: 'DELETE',
      headers: { Authorization: `Bearer ${token}` }
    });
  }, []);

  // Удаление всего пака
  const deletePack = useCallback(async (packId) => {
    const token = await auth.currentUser.getIdToken();
    
    // Оптимистичное обновление UI
    setPacks(prev => prev.filter(p => p.id !== packId));

    await fetch(`${CDN_URL}/stickerpacks/${packId}`, {
      method: 'DELETE',
      headers: { Authorization: `Bearer ${token}` }
    });
  }, []);

  // Добавление чужого пака к себе в библиотеку
  const addPackById = useCallback(async (packId) => {
    const token = await auth.currentUser.getIdToken();
    const res = await fetch(`${CDN_URL}/stickerpacks/${packId}/library`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${token}` }
    });
    if (!res.ok) throw new Error('Failed to add pack');
    
    // Перезапрашиваем паки, чтобы подтянуть добавленный со всеми стикерами
    await fetchPacks();
  }, [fetchPacks]);

  // Проверка наличия пака у пользователя
  const hasPack = useCallback((packId) => {
    return packs.some(p => p.id === packId);
  }, [packs]);

  // Плоский список всех стикеров для удобства (если понадобится)
  const allStickers = useMemo(() => packs.flatMap(p => 
    (p.stickers || []).map(s => ({
      ...s,
      packId:    p.id,
      packName:  p.name,
      packEmoji: p.emoji,
    }))
  ), [packs]);

  const value = useMemo(() => ({
    packs,
    allStickers,
    loading,
    createPack,
    addStickerToPack,
    removeStickerFromPack,
    deletePack,
    addPackById,
    hasPack
  }), [
    packs, allStickers, loading, createPack, addStickerToPack,
    removeStickerFromPack, deletePack, addPackById, hasPack
  ]);

  return (
    <StickersContext.Provider value={value}>
      {children}
    </StickersContext.Provider>
  );
}
</file>

