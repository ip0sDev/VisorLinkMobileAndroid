// src/components/MessageBubble.jsx
import { useState, useRef, memo, useEffect, useMemo } from 'react';
import { format } from 'date-fns';
import { db } from '../firebase/config';
import { useAuth } from '../contexts/AuthContext';
import { useI18n } from '../contexts/I18nContext';
import { doc, updateDoc } from 'firebase/firestore';
import { getFunctions, httpsCallable } from 'firebase/functions';
import SpoilerImage from './SpoilerImage';
import AlbumMessage from './AlbumMessage';
import RichText from './RichText';
import AddStickerPackBanner from './AddStickerPackBanner';
import ForwardPickerModal from './ForwardPickerModal';
import { CDN_URL } from '../hooks/useCdn';

const EMOJI_LIST = [
  '👍','❤️','😂','😮','😢','🔥',
  '🎉','👏','🥰','😍','🤩','😭',
  '🤔','👀','💯','✅','🙏','😎',
  '🤣','😅','😡','💀','🎊','⚡',
];

function GiftMessage({ message, chatId }) {
  const { user } = useAuth();
  const [opening, setOpening] = useState(false);
  const [justOpened, setJustOpened] = useState(false);
  const [error, setError] = useState('');
  
  const isRedeemed = message.redeemed;
  const wasRedeemed = useRef(isRedeemed);

  useEffect(() => {
    if (!wasRedeemed.current && isRedeemed) {
      setOpening(false);
      setJustOpened(true);
      const t = setTimeout(() => setJustOpened(false), 4000); 
      return () => clearTimeout(t);
    }
    wasRedeemed.current = isRedeemed;
  }, [isRedeemed]);

  const sparks = useMemo(() => [...Array(40)].map((_, i) => {
    const angle = Math.random() * Math.PI * 2;
    const velocity = 60 + Math.random() * 140; 
    const tx = Math.cos(angle) * velocity;
    const ty = Math.sin(angle) * velocity;
    const scale = 0.4 + Math.random() * 1.2;
    const duration = 1.2 + Math.random() * 1.5; 
    return { tx, ty, scale, duration };
  }), []);

  async function handleOpen(e) {
    e.stopPropagation();
    if (isRedeemed || opening) return;
    setOpening(true); 
    setError('');
    try {
      const fn = getFunctions(undefined, 'europe-west1');
      const redeemGiftFn = httpsCallable(fn, 'redeemGift');
      await redeemGiftFn({ chatId, messageId: message.id });
    } catch (err) {
      setError(err.message);
      setOpening(false);
    }
  }

  return (
    <div className={`gift-box-wrap ${isRedeemed && !justOpened ? 'redeemed' : ''} ${opening ? 'opening' : ''} ${justOpened ? 'epic-reveal' : ''}`}>
      {justOpened && (
        <div className="gift-fx-container">
          <div className="gift-shockwave"></div>
          {sparks.map((s, i) => (
            <div 
              key={i} 
              className="gift-spark" 
              style={{ '--tx': `${s.tx}px`, '--ty': `${s.ty}px`, '--s': s.scale, '--dur': `${s.duration}s` }} 
            />
          ))}
        </div>
      )}

      <div className="gift-icon-container">
        <div className="gift-icon">{isRedeemed ? '💎' : '🎁'}</div>
      </div>
      
      <div className="gift-info">
        <strong>VisorLink PRO</strong>
        {isRedeemed ? (
          <span className="gift-status">
            {justOpened ? 'Открыто!' : 'Открыто'} @{message.redeemedByUsername}
          </span>
        ) : (
          <span className="gift-status">30 дней премиума</span>
        )}
      </div>
      
      {!isRedeemed && (
        <button className="gift-open-btn" onClick={handleOpen} disabled={opening}>
          {opening ? 'Активация...' : 'Открыть подарок'}
        </button>
      )}
      
      {error && <div className="gift-error">{error}</div>}
    </div>
  );
}

function VoiceMessage({ url, duration }) {
  const { t } = useI18n();
  const [playing,     setPlaying]     = useState(false);
  const [progress,    setProgress]    = useState(0);
  const [currentTime, setCurrentTime] = useState(0);
  const audioRef = useRef(null);

  function togglePlay() {
    const a = audioRef.current;
    if (!a) return;
    if (playing) { a.pause(); setPlaying(false); }
    else         { a.play();  setPlaying(true);  }
  }
  function handleTimeUpdate() {
    const a = audioRef.current;
    if (!a) return;
    setCurrentTime(Math.floor(a.currentTime));
    setProgress((a.currentTime / a.duration) * 100 || 0);
  }
  function handleEnded() { setPlaying(false); setProgress(0); setCurrentTime(0); }
  function handleSeek(e) {
    const a = audioRef.current;
    if (!a) return;
    const rect = e.currentTarget.getBoundingClientRect();
    a.currentTime = ((e.clientX - rect.left) / rect.width) * a.duration;
  }
  function fmt(s) { return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; }

  return (
    <div className="voice-msg">
      <audio ref={audioRef} src={url} onTimeUpdate={handleTimeUpdate} onEnded={handleEnded} />
      <button
        className="voice-play-btn"
        onClick={togglePlay}
        aria-label={playing ? t('voice.pause') : t('voice.play')}
      >
        {playing
          ? <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6"  y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          : <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>
        }
      </button>
      <div className="voice-progress-wrap" onClick={handleSeek}>
        <div className="voice-progress-track">
          <div className="voice-progress-fill" style={{ width: `${progress}%` }} />
        </div>
      </div>
      <span className="voice-time">{fmt(currentTime || duration)}</span>
    </div>
  );
}

function ForwardBanner({ message }) {
  const { t } = useI18n();

  if (message.tg_forwarded) {
    const name = message.tg_forwarded_from_fallback || message.tg_forwarded_from || t('general.unknown');
    const username = message.tg_forwarded_from ? `(@${message.tg_forwarded_from})` : '';
    return (
      <div className="tg-forward-badge" title="Переслано из Telegram">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.04.01.12 0 .2z"/>
        </svg>
        <span className="tg-forward-name">{t('forward.from')} <strong>{name}</strong> {username}</span>
      </div>
    );
  }

  const { forwardFrom } = message;
  if (!forwardFrom) return null;

  let label;
  if (!forwardFrom.chatId)        label = t('saved.forwardFromSaved');
  else if (forwardFrom.chatName)  label = `${t('forward.from')} @${forwardFrom.senderUsername} · ${forwardFrom.chatName}`;
  else                            label = `${t('forward.from')} @${forwardFrom.senderUsername}`;
  
  return (
    <div className="forward-banner">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
      <span>{label}</span>
    </div>
  );
}

function ReplyPreview({ replyTo, isOwn, onScrollTo, authToken }) {
  const { t } = useI18n();
  if (!replyTo) return null;

  let text = replyTo.text || '';
  if (replyTo.type === 'image')   text = t('msg.image');
  if (replyTo.type === 'voice')   text = t('msg.voice');
  if (replyTo.type === 'sticker') text = t('msg.sticker');
  if (replyTo.type === 'video')   text = '🎥 Видео';
  if (replyTo.type === 'gif')     text = '🖼️ GIF';
  if (replyTo.type === 'gift')    text = '🎁 Подарок';
  if (replyTo.type === 'album') {
    const n = replyTo.images?.length || 0;
    text = replyTo.caption || `📷 ${n} photo${n !== 1 ? 's' : ''}`;
  }

  let thumbUrl = null;
  let thumbSpoiler = false;

  if (replyTo.type === 'album' && replyTo.images?.[0]) {
    const img = replyTo.images[0];
    thumbUrl = img.cdnMediaId && authToken ? `${CDN_URL}/f/${img.cdnMediaId}?token=${authToken}` : img.url;
    thumbSpoiler = img.spoiler;
  } else if (replyTo.type === 'image' || replyTo.type === 'video' || replyTo.type === 'gif') {
    thumbUrl = replyTo.cdnMediaId && authToken ? `${CDN_URL}/f/${replyTo.cdnMediaId}?token=${authToken}` : replyTo.url;
    thumbSpoiler = replyTo.spoiler;
  }

  return (
    <div
      className={`reply-preview ${isOwn ? 'reply-own' : 'reply-other'}`}
      onClick={e => { e.stopPropagation(); onScrollTo?.(replyTo.id); }}
    >
      <div className="reply-bar" />
      <div className="reply-content">
        <span className="reply-name">@{replyTo.senderUsername}</span>
        <span className="reply-text">{text}</span>
      </div>
      {thumbUrl && (
        <img
          src={thumbUrl}
          className="reply-thumb"
          alt=""
          style={{ opacity: thumbSpoiler ? 0.35 : 1 }}
        />
      )}
    </div>
  );
}

function ReadReceipt({ message, isOwn, otherUid, show }) {
  const { t } = useI18n();
  if (!isOwn || !message.createdAt || !show) return null;
  const isRead = message.readBy?.includes(otherUid);
  return (
    <span className="read-receipt" title={isRead ? t('msg.read') : t('msg.sent')}>
      {isRead ? (
        <svg width="18" height="11" viewBox="0 0 18 11" fill="none">
          <path d="M1 5.5L4.5 9 10 2"  stroke="var(--accent)" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"/>
          <path d="M7 5.5L10.5 9 16 2" stroke="var(--accent)" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"/>
        </svg>
      ) : (
        <svg width="14" height="11" viewBox="0 0 14 11" fill="none">
          <path d="M1 5.5L4.5 9 13 1" stroke="var(--text3)" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round"/>
        </svg>
      )}
    </span>
  );
}

function ReactionsRow({ reactions, currentUid, onToggle }) {
  const visible = (reactions || []).filter(r => r.count > 0);
  if (visible.length === 0) return null;
  return (
    <>
      {visible.map(r => (
        <button
          key={r.emoji}
