const MessageBubble = memo(function MessageBubble({
  message,
  isOwn,
  onReply,
  chatId,
  chatName,
  noForwards,
  onScrollTo,
  otherUid,
  showReadReceipt  = true,
  reactionsEnabled = true,
  isChannel        = false,
  onOpenComments,
  revealedIds,
  onRevealSpoiler,
  onViewProfile,
  onSelectChat,
  feedChannelData,
  isFeedMode,
  onLikeToggle,
  authToken
}) {
  const { user } = useAuth();
  const { t }    = useI18n();

  const [imgOpen,         setImgOpen]         = useState(false);
  const [showActions,     setShowActions]     = useState(false);
  const [showEmojiPicker, setShowEmojiPicker] = useState(false);
  const [deleting,        setDeleting]        = useState(false);
  const [showForward,     setShowForward]     = useState(false);
  const [stickerError,    setStickerError]    = useState(false);

  const ts        = message.createdAt?.toDate?.();
  const timeStr   = ts ? format(ts, 'HH:mm') : '';
  const isSticker = message.type === 'sticker';
  const isAlbum   = message.type === 'album';
  const isGift    = message.type === 'gift';
  const isDeleted = message.deleted;
  const isBot     = message.isBot === true;

  const resolvedUrl = message.cdnMediaId && authToken ? `${CDN_URL}/f/${message.cdnMediaId}?token=${authToken}` : message.url;

  const resolvedMessage = useMemo(() => {
    if (message.type !== 'album') return message;
    return {
      ...message,
      images: message.images?.map(img => ({
        ...img,
        url: img.cdnMediaId && authToken ? `${CDN_URL}/f/${img.cdnMediaId}?token=${authToken}` : img.url
      }))
    };
  }, [message, authToken]);

  async function handleReaction(emoji) {
    const msgRef    = doc(db, 'chats', chatId, 'messages', message.id);
    const reactions = message.reactions || [];
    const existing  = reactions.find(r => r.emoji === emoji);
    let updated;

    if (existing) {
      const hasMe = existing.uids?.includes(user.uid);
      if (hasMe) {
        updated = reactions
          .map(r => r.emoji === emoji
            ? { ...r, uids: r.uids.filter(u => u !== user.uid), count: r.count - 1 }
            : r)
          .filter(r => r.count > 0);
      } else {
        updated = reactions.map(r => r.emoji === emoji
          ? { ...r, uids: [...(r.uids || []), user.uid], count: r.count + 1 }
          : r);
      }
    } else {
      updated = [...reactions, { emoji, uids: [user.uid], count: 1 }];
    }

    await updateDoc(msgRef, { reactions: updated });
    setShowEmojiPicker(false);
  }

  async function handleDelete() {
    if (!isOwn) return;
    if (!window.confirm(t('msg.delete.confirm'))) return;
    setDeleting(true);
    try {
      await updateDoc(doc(db, 'chats', chatId, 'messages', message.id), {
        deleted:   true,
        deletedAt: new Date(),
      });
    } catch (e) { console.error(e); }
    setDeleting(false);
  }

  if (isDeleted) {
    if (feedChannelData) return null;
    return (
      <div className={`bubble-wrap ${isOwn ? 'own' : 'other'} bubble-wrap-anim`}>
        <div className={`bubble bubble-deleted ${isOwn ? 'bubble-own' : 'bubble-other'}`}>
          <span className="deleted-icon">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <polyline points="3 6 5 6 21 6"/>
