// ─────────────────────────────────────────────────────────
// ACCEPT / DECLINE INVITE
// ─────────────────────────────────────────────────────────
exports.respondToInvite = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { inviteId, accept } = request.data;

  const inviteDoc = await db.collection('invites').doc(inviteId).get();
  if (!inviteDoc.exists) throw new HttpsError('not-found', 'Invite not found');
  const invite = inviteDoc.data();

  if (invite.invitedUid !== uid) throw new HttpsError('permission-denied', 'Not your invite');
  if (invite.status !== 'pending') throw new HttpsError('failed-precondition', 'Invite already used');

  const batch = db.batch();
  batch.update(db.collection('invites').doc(inviteId), {
    status: accept ? 'accepted' : 'declined',
    respondedAt: FieldValue.serverTimestamp(),
  });

  if (accept) {
    batch.set(
      db.collection('chats').doc(invite.chatId).collection('members').doc(uid),
      {
        uid, role: 'member',
        joinedAt: FieldValue.serverTimestamp(),
        muted: false, mutedUntil: null,
        mediaRestricted: false,
        banned: false, bannedAt: null, bannedBy: null,
      }
    );
    batch.update(db.collection('chats').doc(invite.chatId), {
      memberCount: FieldValue.increment(1),
      memberIds: FieldValue.arrayUnion(uid),
    });
  }

  await batch.commit();
  return { success: true, chatId: accept ? invite.chatId : null };
});

