@keyframes highlight-flash { 0% { box-shadow: 0 0 0 2px var(--accent), 0 0 16px var(--accent-glow), var(--neo-shadow-out); } 60% { box-shadow: 0 0 0 2px rgba(45,168,154,0.3), var(--neo-shadow-out); } 100% { box-shadow: var(--neo-shadow-out); } }

.bubble { width: fit-content; max-width: 260px; padding: 7px 10px 4px; border-radius: 18px; font-size: 14px; box-sizing: border-box; word-wrap: break-word; word-break: break-word; display: flex; flex-direction: column; position: relative; transition: transform 0.1s; }
.bubble p { margin: 0; display: block; width: 100%; white-space: pre-wrap; line-height: 1.4; }
.bubble::after { content: ''; position: absolute; top: 4px; left: 12px; right: 12px; height: 1.2px; background: var(--divider-light); border-radius: 4px; pointer-events: none; }
.bubble-own { background: color-mix(in srgb, var(--own-bubble) 88%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: var(--text); border-radius: 18px 18px 4px 18px; box-shadow: var(--neo-shadow-out); border: 0.5px solid color-mix(in srgb, var(--own-bubble2) 70%, transparent); }
.bubble-other { background: color-mix(in srgb, var(--other-bubble) 84%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); color: var(--text); border-radius: 4px 18px 18px 18px; box-shadow: var(--neo-shadow-out); border: 0.5px solid color-mix(in srgb, var(--border) 70%, transparent); }
.bubble-deleted { flex-direction: row !important; align-items: center; gap: 6px; opacity: 0.45; font-style: italic; }
.deleted-icon { opacity: 0.7; display: flex; }
.deleted-text { font-size: 13px; flex: 1; color: var(--text3); }
.bubble-time { font-size: 10px; opacity: 0.55; font-family: var(--font-mono); flex-shrink: 0; }
.bubble-own .bubble-time { color: var(--text2); }
.bubble-other .bubble-time { color: var(--text3); }

.msg-actions { display: flex; align-items: center; gap: 4px; opacity: 0; transition: opacity 0.2s; flex-shrink: 0; height: fit-content; align-self: center; }
.bubble-wrap:hover .msg-actions { opacity: 1; }
.msg-actions.visible { opacity: 1; }
.msg-actions-left { order: -1; }
.msg-actions-right { order: 1; }
.msg-action-btn { background: var(--surface); box-shadow: var(--neo-shadow-btn); border: 0.5px solid var(--divider-light); color: var(--text2); width: 28px; height: 28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: color 0.15s, border-color 0.15s, box-shadow 0.15s, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1); }
.msg-action-btn:hover:not(:disabled) { color: var(--accent); border-color: var(--accent); box-shadow: 0 0 8px var(--accent-glow), var(--neo-shadow-btn); transform: scale(1.15) translateY(-1px); }
.msg-action-btn:active:not(:disabled) { box-shadow: var(--neo-shadow-in); transform: scale(0.92); }
