import { useState, useCallback } from 'react';
import { createPortal } from 'react-dom';
import { db } from '../firebase/config';
import { doc, getDoc } from 'firebase/firestore';
import { useI18n } from '../contexts/I18nContext';

// ── Not Found modal — rendered via portal so it's always centered ──
function NotFoundModal({ handle, onClose }) {
  const { t } = useI18n();
  return createPortal(
    <div
      className="modal-overlay"
      onClick={onClose}
    >
      <div
        className="modal"
        style={{ maxWidth: 320, width: '90%' }}
        onClick={e => e.stopPropagation()}
      >
        <div className="modal-header">
          <h3>{t('mention.notFound') || 'Не найдено'}</h3>
          <button className="modal-close" onClick={onClose}>✕</button>
        </div>
        <div style={{
          padding: '4px 0 8px',
          display: 'flex', flexDirection: 'column', alignItems: 'center', gap: 12,
        }}>
          <div style={{
            width: 56, height: 56, borderRadius: '50%',
            background: 'var(--surface3)',
            display: 'flex', alignItems: 'center', justifyContent: 'center',
            fontSize: 24,
          }}>❓</div>
          <div style={{ textAlign: 'center' }}>
            <div style={{ fontSize: 15, fontWeight: 700, color: 'var(--text)', marginBottom: 4 }}>
              @{handle}
            </div>
            <div style={{ fontSize: 13, color: 'var(--text2)' }}>
              {t('mention.notFoundDesc') || 'Пользователь или канал с таким тегом не найдены'}
            </div>
          </div>
          <button
            className="btn-primary"
            style={{ marginTop: 4, width: '100%' }}
            onClick={onClose}
          >
            {t('general.close') || 'Закрыть'}
          </button>
        </div>
      </div>
    </div>,
    document.body
  );
}

// ── Tokenizer ─────────────────────────────────────────────
function tokenize(text) {
  if (!text) return [];
  const COMBINED = /https?:\/\/[^\s<>"']+[^\s<>"'.,:;!?)]|@[a-zA-Z0-9_]{3,24}/gi;
  const tokens = [];
  let lastIndex = 0;
  let match;

  while ((match = COMBINED.exec(text)) !== null) {
    if (match.index > lastIndex) {
      tokens.push({ type: 'text', value: text.slice(lastIndex, match.index) });
    }
    const raw = match[0];
    if (raw.startsWith('@')) {
      tokens.push({ type: 'mention', value: raw.slice(1), display: raw });
    } else {
      const display = raw.length > 50
        ? raw.slice(0, 30) + '…' + raw.slice(raw.lastIndexOf('/'))
        : raw;
      tokens.push({ type: 'url', value: raw, display });
    }
    lastIndex = COMBINED.lastIndex;
  }

  if (lastIndex < text.length) {
    tokens.push({ type: 'text', value: text.slice(lastIndex) });
  }
  return tokens;
}

// ── Main component ────────────────────────────────────────
export default function RichText({ text, onViewProfile, onSelectChat }) {
  const [notFound, setNotFound] = useState(null);

  const handleMentionClick = useCallback(async (handle) => {
    const lower = handle.toLowerCase().trim();
    try {
      // 1. Try users: usernames/{username} → { uid }
      const userSnap = await getDoc(doc(db, 'usernames', lower));
      if (userSnap.exists()) {
        onViewProfile?.(userSnap.data().uid);
        return;
      }

      // 2. Try channels/groups: tags/{tag} → { chatId, type }
      const tagSnap = await getDoc(doc(db, 'tags', lower));
      if (tagSnap.exists()) {
        onSelectChat?.(tagSnap.data().chatId);
        return;
      }

      // 3. Not found
      setNotFound(handle);
    } catch (err) {
      console.error('mention lookup error', err);
      setNotFound(handle);
    }
  }, [onViewProfile, onSelectChat]);

  const tokens = tokenize(text);

  return (
    <>
      <p>
        {tokens.map((tok, i) => {
          if (tok.type === 'text') return <span key={i}>{tok.value}</span>;

          if (tok.type === 'url') {
            return (
              <a
                key={i}
                href={tok.value}
                target="_blank"
                rel="noopener noreferrer"
                className="msg-link"
                onClick={e => e.stopPropagation()}
              >
                {tok.display}
              </a>
            );
          }

          if (tok.type === 'mention') {
            return (
              <button
                key={i}
                className="msg-mention"
                onClick={e => { e.stopPropagation(); handleMentionClick(tok.value); }}
              >
                @{tok.value}
              </button>
            );
          }

          return null;
        })}
      </p>

      {notFound && (
        <NotFoundModal handle={notFound} onClose={() => setNotFound(null)} />
      )}
    </>
  );
}
