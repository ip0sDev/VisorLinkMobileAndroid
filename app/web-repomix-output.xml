// src/components/WallpaperPicker.jsx
import { useRef, useState } from 'react';
import { saveWallpaper, removeWallpaper } from '../hooks/useWallpaper';
import { useAuth } from '../contexts/AuthContext';
import { useI18n } from '../contexts/I18nContext';
import { uploadToCdn, getPublicCdnUrl } from '../hooks/useCdn';

export default function WallpaperPicker({ chatId, chatType, currentUrl, onClose }) {
  const { user } = useAuth();
  const { t } = useI18n();
  const fileInputRef = useRef(null);
  const [uploading, setUploading] = useState(false);
  const [error, setError] = useState('');

  async function handleFileSelect(e) {
    const file = e.target.files[0];
    if (!file) return;
    if (!file.type.startsWith('image/')) {
      setError('Please select an image file.');
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      setError('Image must be under 10 MB.');
      return;
    }
    setUploading(true);
    setError('');
    try {
      const mediaId = await uploadToCdn(file, false, `wallpaper_${Date.now()}_${file.name}`);
      const url = getPublicCdnUrl(mediaId);
      
      await saveWallpaper(chatId, user.uid, chatType, url, mediaId);
      onClose();
    } catch (err) {
      setError(err.message);
    }
    setUploading(false);
    e.target.value = '';
  }

  async function handleRemove() {
    setUploading(true);
    try {
      await removeWallpaper(chatId, user.uid, chatType);
      onClose();
    } catch (err) {
      setError(err.message);
    }
    setUploading(false);
  }

  return (
    <div className="modal-overlay" onClick={onClose}>
      <div className="modal wallpaper-modal" onClick={e => e.stopPropagation()}>
        <div className="modal-header">
          <h3>{t('wallpaper.title')}</h3>
          <button className="modal-close" onClick={onClose}>✕</button>
        </div>

        <div className="wallpaper-body">
          <div
            className="wallpaper-preview"
            style={currentUrl ? { backgroundImage: `url(${currentUrl})` } : {}}
          >
            {!currentUrl && (
              <span className="wallpaper-preview-empty">{t('wallpaper.noSet')}</span>
            )}
          </div>

          {error && <div className="auth-error">{error}</div>}

          <input
            ref={fileInputRef}
            type="file"
            accept="image/*"
            style={{ display: 'none' }}
            onChange={handleFileSelect}
          />

          <button
            className="btn-primary"
            onClick={() => fileInputRef.current?.click()}
            disabled={uploading}
          >
            {uploading ? t('wallpaper.uploading') : t('wallpaper.choose')}
          </button>

          {currentUrl && (
            <button
              className="account-action-btn danger"
              onClick={handleRemove}
              disabled={uploading}
              style={{ justifyContent: 'center', color: 'var(--danger)', marginTop: 4 }}
            >
              {t('wallpaper.remove')}
            </button>
          )}

          <p className="wallpaper-hint">
            {chatType === 'direct'
              ? t('wallpaper.hint.direct')
              : t('wallpaper.hint.group')}
          </p>
        </div>
      </div>
    </div>
  );
}
</file>

