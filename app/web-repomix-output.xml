<file path="src/components/AddStickerPackBanner.jsx">
import { useState } from 'react';
import { useStickers } from '../hooks/useStickers';
import { useI18n } from '../contexts/I18nContext';

/**
 * Баннер «Добавить пак» — отображается под стикером от другого пользователя.
 * Вызывает Cloud Function addStickerPack через useStickers.addPackById().
 */
export default function AddStickerPackBanner({ packId, packName, packEmoji }) {
  const { addPackById, hasPack } = useStickers();
  const { t } = useI18n();
  const [state, setState] = useState('idle'); // idle | loading | done | error

  const already = hasPack(packId);

  async function handleAdd() {
    setState('loading');
    try {
      await addPackById(packId);
      setState('done');
    } catch (err) {
      console.error('addStickerPack error:', err);
      setState('error');
      // Сброс через 2 секунды чтобы можно было попробовать снова
      setTimeout(() => setState('idle'), 2000);
    }
  }

  // PERFORMANCE: Handle visibility here instead of in MessageBubble to avoid
  // invalidating the bubble's memo when owned packs list updates.
  if (already && state === 'idle') {
    return null;
  }

  if (state === 'done') {
    return (
      <div className="sp-add-banner sp-add-banner--done">
        {t('packAdded')}
      </div>
    );
  }

  if (state === 'error') {
    return (
      <div className="sp-add-banner sp-add-banner--error">
        {t('packUnavailable')}
      </div>
    );
  }

  return (
    <button
      className="sp-add-banner"
      onClick={handleAdd}
      disabled={state === 'loading'}
    >
      <span className="sp-add-pack-icon">{packEmoji || '📦'}</span>
      <span className="sp-add-pack-text">
        {state === 'loading'
          ? t('packAdding')
          : t('addPackName', { name: packName || t('title') })}
      </span>
      {state === 'idle' && (
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" strokeWidth="2.5" className="sp-add-icon">
          <path d="M12 5v14M5 12h14"/>
        </svg>
      )}
    </button>
  );
}
</file>

<file path="src/components/ForwardPickerModal.jsx">
// src/components/ForwardPickerModal.jsx
import { useState, useEffect } from 'react';
import { db } from '../firebase/config';
import { useAuth } from '../contexts/AuthContext';
import { useI18n } from '../contexts/I18nContext';
import {
  collection, query, where, orderBy, onSnapshot,
  doc, writeBatch, serverTimestamp
} from 'firebase/firestore';

// ── Build forwardFrom from original message ───────────────────────────────
function buildForwardFrom(message, sourceChatId, sourceChatName) {
  // If already forwarded — take the original forwardFrom (one level only)
  if (message.forwardFrom) return message.forwardFrom;
  return {
    senderId:        message.senderId  || '',
    senderUsername:  message.senderUsername || '',
    chatId:          sourceChatId || null,
    chatName:        sourceChatName || null,
    messageId:       message.id || null,
  };
}

// ── Copy message content fields ───────────────────────────────────────────
function copyMessageFields(message) {
  const fields = {};
  const COPY_KEYS = ['type', 'text', 'url', 'caption', 'storagePath', 'fileName',
                     'spoiler', 'voiceUrl', 'duration', 'stickerId', 'packId',
                     'packName', 'packEmoji', 'images', 'albumItems',
                     // encrypted fields
                     'encryptedText', 'encryptedCaption', 'iv', 'encrypted', 'mimeType'];
  for (const k of COPY_KEYS) {
    if (message[k] !== undefined) fields[k] = message[k];
  }
  return fields;
}

export default function ForwardPickerModal({ message, sourceChatId, sourceChatName, onClose }) {
  const { user, userData } = useAuth();
  const { t } = useI18n();

  const [directChats, setDirectChats] = useState([]);
  const [groupChats,  setGroupChats]  = useState([]);
  const [search,      setSearch]      = useState('');
  const [sending,     setSending]     = useState(false);
  const [sent,        setSent]        = useState(null); // chatId | 'saved'

  // ── Load chats ────────────────────────────────────────────────────────
  useEffect(() => {
    if (!userData?.uid) return;
    const q1 = query(
      collection(db, 'chats'),
      where('participants', 'array-contains', userData.uid),
      orderBy('lastMessageAt', 'desc')
    );
    const unsub1 = onSnapshot(q1, snap => {
      setDirectChats(snap.docs.map(d => ({ id: d.id, ...d.data({ serverTimestamps: 'estimate' }) })));
    });

    const q2 = query(
      collection(db, 'chats'),
      where('memberIds', 'array-contains', userData.uid),
      orderBy('lastMessageAt', 'desc')
    );
    const unsub2 = onSnapshot(q2, snap => {
      setGroupChats(snap.docs.map(d => ({ id: d.id, ...d.data({ serverTimestamps: 'estimate' }) })));
    });

    return () => { unsub1(); unsub2(); };
  }, [userData?.uid]);

  const allChats = [...directChats, ...groupChats]
    .filter((c, i, arr) => arr.findIndex(x => x.id === c.id) === i)
    .sort((a, b) => (b.lastMessageAt?.toMillis?.() || 0) - (a.lastMessageAt?.toMillis?.() || 0));

  function getChatName(chat) {
    if (chat.type === 'direct' || !chat.type) {
      const otherId = chat.participants?.find(p => p !== userData.uid);
      const other = chat.participantData?.[otherId];
      return other?.displayName || t('general.unknown');
    }
    return chat.name || t('general.unknown');
  }

  const filtered = allChats.filter(c => {
    if (!search) return true;
    return getChatName(c).toLowerCase().includes(search.toLowerCase());
  });

  // ── Forward to Saved Messages ─────────────────────────────────────────
  async function forwardToSaved() {
    setSending(true);
    try {
      const forwardFrom = buildForwardFrom(message, sourceChatId, sourceChatName);
      const batch = writeBatch(db);
      const msgRef = doc(collection(db, 'savedMessages', user.uid, 'messages'));
      batch.set(msgRef, {
        senderId: user.uid,
        createdAt: serverTimestamp(),
        forwardFrom,
        ...copyMessageFields(message),
      });
      // Update user cooldown
      batch.update(doc(db, 'users', user.uid), { lastMessageAt: serverTimestamp() });
      await batch.commit();
      setSent('saved');
      setTimeout(onClose, 900);
    } catch (err) { console.error('forwardToSaved error:', err); }
    setSending(false);
  }

  // ── Forward to a chat ─────────────────────────────────────────────────
  async function forwardToChat(chat) {
    setSending(true);
    try {
      const forwardFrom = buildForwardFrom(message, sourceChatId, sourceChatName);
      const batch = writeBatch(db);
      const msgRef = doc(collection(db, 'chats', chat.id, 'messages'));

      // Build a text preview for lastMessage
      let preview = '';
      if (message.type === 'text') {
        const txt = message.encryptedText ? '🔒 …' : (message.text || '');
        preview = `↩ ${txt.slice(0, 60)}`;
      } else if (message.type === 'image') {
        preview = `↩ 🖼 ${t('msg.photo')}`;
      } else if (message.type === 'voice') {
        preview = `↩ 🎙 ${t('msg.voice')}`;
      } else if (message.type === 'sticker') {
        preview = `↩ ${message.packEmoji || '😊'} ${t('msg.sticker')}`;
      } else if (message.type === 'album') {
        preview = `↩ 🖼 Album`;
      } else {
        preview = `↩ ${t('forward.title')}`;
      }

      batch.set(msgRef, {
        senderId:        user.uid,
        senderUsername:  userData.username,
        createdAt:       serverTimestamp(),
        forwardFrom,
        readBy:          [user.uid],
        deleted:         false,
        reactions:       [],
        ...copyMessageFields(message),
      });

      // Update chat's lastMessage preview so it surfaces in sidebar
      batch.update(doc(db, 'chats', chat.id), {
        lastMessage:   preview,
        lastMessageAt: serverTimestamp(),
      });

      // Update user cooldown (required by Firestore rules)
      batch.update(doc(db, 'users', user.uid), { lastMessageAt: serverTimestamp() });

      await batch.commit();
      setSent(chat.id);
      setTimeout(onClose, 900);
    } catch (err) { console.error('forwardToChat error:', err); }
    setSending(false);
  }

  return (
    <div className="modal-overlay" onClick={onClose}>
      <div className="modal forward-picker-modal" onClick={e => e.stopPropagation()}>
        <div className="modal-header">
          <h3>{t('forward.title')}</h3>
          <button className="modal-close" onClick={onClose}>✕</button>
        </div>

        {/* Search */}
        <div style={{ padding: '0 12px 8px' }}>
          <input
            className="message-input"
            style={{ width: '100%', boxSizing: 'border-box', borderRadius: 8, padding: '8px 12px', fontSize: 14 }}
            placeholder={t('forward.search')}
            value={search}
            onChange={e => setSearch(e.target.value)}
            autoFocus
          />
        </div>

        <div className="forward-list">
          {/* Saved Messages — always show when no search */}
          {!search && (
            <div
              className={`forward-item ${sent === 'saved' ? 'forward-item-sent' : ''}`}
              onClick={!sending ? forwardToSaved : undefined}
            >
              <div className="avatar sm" style={{ background: 'linear-gradient(135deg, var(--accent), #7c3aed)', color: '#fff', fontWeight: 700, fontSize: 15, flexShrink: 0 }}>⭐</div>
              <span className="forward-item-name">{t('saved.title')}</span>
              {sent === 'saved' && <span style={{ marginLeft: 'auto', color: 'var(--accent)', fontSize: 18 }}>✓</span>}
            </div>
          )}

          {filtered.map(chat => (
            <div
              key={chat.id}
              className={`forward-item ${sent === chat.id ? 'forward-item-sent' : ''}`}
              onClick={!sending ? () => forwardToChat(chat) : undefined}
            >
              <div className="avatar sm" style={{ background: 'var(--bg3)', color: 'var(--text1)', fontWeight: 600, fontSize: 13, flexShrink: 0 }}>
                {getChatName(chat).slice(0, 1).toUpperCase()}
              </div>
              <span className="forward-item-name">{getChatName(chat)}</span>
              {/* ИСПРАВЛЕНО: замена шаблонной строки на конкатенацию */}
              {chat.type && chat.type !== 'direct' && (
                <span className="forward-item-type">{t('general.' + chat.type) || chat.type}</span>
              )}
              {sent === chat.id && <span style={{ marginLeft: 'auto', color: 'var(--accent)', fontSize: 18 }}>✓</span>}
            </div>
          ))}

          {filtered.length === 0 && search && (
            <div style={{ padding: '20px', textAlign: 'center', color: 'var(--text3)', fontSize: 13 }}>
              {t('forward.notFound')}
            </div>
          )}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="src/components/ImageEditor.jsx">
import { useEffect, useRef, useState, useCallback } from 'react';
import { useI18n } from '../contexts/I18nContext';

const MIN_CROP_PX = 20;
function clamp(v, min, max) { return Math.max(min, Math.min(max, v)); }

function Slider({ label, value, min, max, step, onChange, resetValue, unit = '' }) {
  const isDefault = value === resetValue;
  return (
    <div className="ie-slider-row">
      <span className="ie-slider-label">{label}</span>
      <input
        type="range" className="ie-slider"
        min={min} max={max} step={step} value={value}
        onChange={e => onChange(Number(e.target.value))}
      />
      <span className={`ie-slider-val ${!isDefault ? 'changed' : ''}`}>
        {value}{unit}
      </span>
      {!isDefault && (
        <button className="ie-reset-btn" onClick={() => onChange(resetValue)} title="Reset">↺</button>
      )}
    </div>
  );
}

export default function ImageEditor({ file, onConfirm, onCancel }) {
  const { t } = useI18n();
  const canvasRef    = useRef(null);
  const overlayRef   = useRef(null);
  const imgRef       = useRef(null);
  const animFrameRef = useRef(null);

  const [rotation, setRotation] = useState(0);
  const [blur,     setBlur]     = useState(0);
  const [spoiler,  setSpoiler]  = useState(false);
  const [crop, setCrop] = useState({ x: 0, y: 0, w: 1, h: 1 });
  const dragRef = useRef(null);

  useEffect(() => {
    const url = URL.createObjectURL(file);
    const img = new Image();
    img.onload = () => { imgRef.current = img; draw(); };
    img.src = url;
    return () => URL.revokeObjectURL(url);
  }, [file]);

  const draw = useCallback(() => {
    const img    = imgRef.current;
    const canvas = canvasRef.current;
    if (!img || !canvas) return;

    const is90 = rotation === 90 || rotation === 270;
    const natW = is90 ? img.height : img.width;
    const natH = is90 ? img.width  : img.height;

    const cropX = crop.x * natW;
    const cropY = crop.y * natH;
    const cropW = crop.w * natW;
    const cropH = crop.h * natH;

    canvas.width  = cropW;
    canvas.height = cropH;

    const ctx = canvas.getContext('2d');
    ctx.clearRect(0, 0, cropW, cropH);
    ctx.filter = blur > 0 ? `blur(${blur}px)` : 'none';

    ctx.save();
    ctx.translate(cropW / 2, cropH / 2);
    ctx.rotate((rotation * Math.PI) / 180);

    if (rotation === 0) {
      ctx.drawImage(img, -(cropW / 2) - cropX, -(cropH / 2) - cropY, img.width, img.height);
    } else if (rotation === 90) {
      ctx.drawImage(img, -(cropH / 2) - cropY, -(cropW / 2) + cropX, img.height, img.width);
    } else if (rotation === 180) {
      ctx.drawImage(img, -(cropW / 2) + cropX, -(cropH / 2) + cropY, img.width, img.height);
    } else if (rotation === 270) {
      ctx.drawImage(img, -(cropH / 2) + cropY, -(cropW / 2) - cropX, img.height, img.width);
    }

    ctx.restore();
  }, [rotation, blur, crop]);

  useEffect(() => {
    cancelAnimationFrame(animFrameRef.current);
    animFrameRef.current = requestAnimationFrame(draw);
  }, [draw]);

  function handleRotate() {
    setRotation(r => (r + 90) % 360);
    setCrop({ x: 0, y: 0, w: 1, h: 1 });
  }

  function getRelPos(e) {
    const rect = overlayRef.current.getBoundingClientRect();
    return {
      x: clamp((e.clientX - rect.left)  / rect.width,  0, 1),
      y: clamp((e.clientY - rect.top) / rect.height, 0, 1),
    };
  }

  function onHandleDown(e, handle) {
    e.preventDefault();
    e.stopPropagation();
    const { x, y } = getRelPos(e);
    dragRef.current = { handle, startX: x, startY: y, startCrop: { ...crop } };
  }

  function onBoxDown(e) {
    e.preventDefault();
    const { x, y } = getRelPos(e);
    dragRef.current = { handle: 'move', startX: x, startY: y, startCrop: { ...crop } };
  }

  const onMouseMove = useCallback((e) => {
    if (!dragRef.current || !overlayRef.current) return;
    const { x: mx, y: my } = getRelPos(e);
    const dx = mx - dragRef.current.startX;
    const dy = my - dragRef.current.startY;
    const sc = dragRef.current.startCrop;
    const rect = overlayRef.current.getBoundingClientRect();
    const minW = MIN_CROP_PX / rect.width;
    const minH = MIN_CROP_PX / rect.height;

    setCrop(() => {
      let { x, y, w, h } = { ...sc };
      switch (dragRef.current.handle) {
        case 'move':
          x = clamp(sc.x + dx, 0, 1 - sc.w);
          y = clamp(sc.y + dy, 0, 1 - sc.h);
          break;
        case 'nw':
          x = clamp(sc.x + dx, 0, sc.x + sc.w - minW);
          y = clamp(sc.y + dy, 0, sc.y + sc.h - minH);
          w = sc.w - (x - sc.x);
          h = sc.h - (y - sc.y);
          break;
        case 'ne':
          y = clamp(sc.y + dy, 0, sc.y + sc.h - minH);
          w = clamp(sc.w + dx, minW, 1 - sc.x);
          h = sc.h - (y - sc.y);
          break;
        case 'sw':
          x = clamp(sc.x + dx, 0, sc.x + sc.w - minW);
          w = sc.w - (x - sc.x);
          h = clamp(sc.h + dy, minH, 1 - sc.y);
          break;
        case 'se':
          w = clamp(sc.w + dx, minW, 1 - sc.x);
          h = clamp(sc.h + dy, minH, 1 - sc.y);
          break;
      }
      return { x, y, w: clamp(w, minW, 1), h: clamp(h, minH, 1) };
    });
  }, []);

  const onMouseUp = useCallback(() => { dragRef.current = null; }, []);

  useEffect(() => {
    window.addEventListener('mousemove', onMouseMove);
    window.addEventListener('mouseup',   onMouseUp);
    return () => {
      window.removeEventListener('mousemove', onMouseMove);
      window.removeEventListener('mouseup',   onMouseUp);
    };
  }, [onMouseMove, onMouseUp]);

  async function handleConfirm() {
    draw();
    const canvas = canvasRef.current;
    if (!canvas) return;
    const blob = await new Promise(res => canvas.toBlob(res, 'image/jpeg', 0.92));
    if (!blob) return;
    const ext    = file.name.replace(/\.[^.]+$/, '.jpg');
    const edited = new File([blob], ext, { type: 'image/jpeg' });
    onConfirm(edited, spoiler);
  }

  const cropStyle = {
    left:   `${crop.x * 100}%`,
    top:    `${crop.y * 100}%`,
    width:  `${crop.w * 100}%`,
    height: `${crop.h * 100}%`,
  };

  return (
    <div className="ie-overlay">
      <div className="ie-modal">
        <div className="ie-header">
          <h3>{t('editor.title')}</h3>
          <button className="modal-close" onClick={onCancel}>✕</button>
        </div>

        <div className="ie-preview-wrap">
          <canvas ref={canvasRef} className="ie-canvas" />
          <div ref={overlayRef} className="ie-crop-overlay">
            <div className="ie-shade ie-shade-t" style={{ height: `${crop.y * 100}%` }} />
            <div className="ie-shade ie-shade-b" style={{ height: `${(1 - crop.y - crop.h) * 100}%` }} />
            <div className="ie-shade ie-shade-l" style={{ top: `${crop.y * 100}%`, height: `${crop.h * 100}%`, width: `${crop.x * 100}%` }} />
            <div className="ie-shade ie-shade-r" style={{ top: `${crop.y * 100}%`, height: `${crop.h * 100}%`, width: `${(1 - crop.x - crop.w) * 100}%` }} />
            <div className="ie-crop-box" style={cropStyle} onMouseDown={onBoxDown}>
              <div className="ie-crop-grid" />
              {['nw','ne','sw','se'].map(h => (
                <div key={h} className={`ie-handle ie-handle-${h}`}
                  onMouseDown={e => onHandleDown(e, h)} />
              ))}
            </div>
          </div>
        </div>

        <div className="ie-controls">
          <div className="ie-actions">
            <button className="ie-action-btn" onClick={handleRotate}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <polyline points="23 4 23 10 17 10"/>
                <path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/>
              </svg>
              {t('editor.rotate')}
            </button>
            <button className="ie-action-btn" onClick={() => setCrop({ x: 0, y: 0, w: 1, h: 1 })}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/>
              </svg>
              {t('editor.resetCrop')}
            </button>
            <button
              className={`ie-action-btn ${spoiler ? 'ie-action-active' : ''}`}
              onClick={() => setSpoiler(v => !v)}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                {spoiler
