// ── Main component ────────────────────────────────────────────────────────────
export default function ChannelBotKeys({ chatId }) {
  const [keys, setKeys]           = useState([]);
  const [loading, setLoading]     = useState(true);
  const [creating, setCreating]   = useState(false);
  const [label, setLabel]         = useState('');
  const [error, setError]         = useState('');
  const [newKey, setNewKey]       = useState(null);   // { apiKey, keyId }
  const [revoking, setRevoking]   = useState(null);   // keyId being revoked
  const [regenerating, setRegenerating] = useState(null);

  // Load keys on mount
  useEffect(() => {
    loadKeys();
  }, [chatId]);  

  async function loadKeys() {
    setLoading(true);
    try {
      const res = await listKeysFn({ chatId });
      setKeys(res.data.keys || []);
    } catch (e) {
      setError(e.message);
    }
    setLoading(false);
  }

  async function handleCreate() {
    if (!label.trim()) return;
    setCreating(true);
    setError('');
    try {
      const res = await createKeyFn({ chatId, label: label.trim() });
      setLabel('');
      setNewKey({ apiKey: res.data.apiKey, keyId: res.data.keyId });
      await loadKeys();
    } catch (e) {
      setError(e.message);
    }
    setCreating(false);
  }

  async function handleRevoke(keyId) {
    if (!window.confirm('Отозвать этот ключ? Бот сразу потеряет доступ.')) return;
    setRevoking(keyId);
    setError('');
    try {
      await revokeKeyFn({ chatId, keyId });
      setKeys(prev => prev.map(k => k.keyId === keyId ? { ...k, active: false } : k));
    } catch (e) {
      setError(e.message);
    }
    setRevoking(null);
  }

  async function handleRegenerate(keyId) {
    if (!window.confirm('Сгенерировать новый ключ? Старый перестанет работать немедленно.')) return;
    setRegenerating(keyId);
    setError('');
    try {
      const res = await regenKeyFn({ chatId, keyId });
      setNewKey({ apiKey: res.data.apiKey, keyId });
    } catch (e) {
      setError(e.message);
    }
    setRegenerating(null);
  }

  function fmt(iso) {
    if (!iso) return '—';
    return new Date(iso).toLocaleString('ru-RU', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' });
  }

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>

      {/* Description */}
      <div style={{
        background: 'var(--surface2)', border: '1px solid var(--border)',
        borderRadius: 10, padding: '10px 14px',
        fontSize: 12, color: 'var(--text2)', lineHeight: 1.55,
      }}>
        🤖 Создайте API-ключ, чтобы отправлять сообщения в канал через HTTP-вебхук.
        Ключ работает от вашего имени. Медиа запрещены. Лимит: 12 сообщений в минуту.
      </div>

      {/* Create new key */}
      <div className="input-group" style={{ margin: 0 }}>
        <label style={{ fontSize: 12, color: 'var(--text3)', fontFamily: 'var(--font-mono)', textTransform: 'uppercase', letterSpacing: '0.06em' }}>
          Метка нового бота
        </label>
        <div style={{ display: 'flex', gap: 8 }}>
          <input
            type="text"
            placeholder="Например: Weather Bot"
            value={label}
            onChange={e => setLabel(e.target.value)}
            maxLength={48}
            style={{ flex: 1 }}
          />
          <button
            className="btn-primary"
            style={{ width: 'auto', padding: '8px 16px', flexShrink: 0 }}
            onClick={handleCreate}
            disabled={creating || !label.trim()}
          >
            {creating ? '…' : '+ Создать'}
          </button>
        </div>
      </div>

      {error && (
        <div className="auth-error" style={{ marginTop: 0 }}>{error}</div>
      )}

      {/* Key list */}
      {loading ? (
        <div style={{ fontSize: 13, color: 'var(--text3)', textAlign: 'center', padding: '16px 0' }}>
          Загрузка…
        </div>
      ) : keys.length === 0 ? (
        <div style={{ fontSize: 13, color: 'var(--text3)', textAlign: 'center', padding: '16px 0' }}>
          Нет API-ключей. Создайте первый выше.
        </div>
      ) : (
        <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
          {keys.map(k => (
            <div
              key={k.keyId}
              style={{
                background: k.active ? 'var(--surface2)' : 'var(--surface)',
                border: `1px solid ${k.active ? 'var(--border)' : 'var(--border)'}`,
                borderRadius: 10, padding: '10px 14px',
                display: 'flex', alignItems: 'center', gap: 10,
                opacity: k.active ? 1 : 0.5,
              }}
            >
              {/* Status dot */}
              <div style={{
                width: 8, height: 8, borderRadius: '50%', flexShrink: 0,
                background: k.active ? 'var(--accent)' : 'var(--text3)',
                boxShadow: k.active ? '0 0 6px var(--accent-glow)' : 'none',
              }} />

              {/* Info */}
              <div style={{ flex: 1, minWidth: 0 }}>
                <div style={{ fontSize: 14, fontWeight: 600, color: 'var(--text)', display: 'flex', alignItems: 'center', gap: 8 }}>
                  {k.label}
                  <span style={{ fontSize: 10, padding: '2px 6px', background: 'var(--surface3)', borderRadius: 4, color: 'var(--text3)', border: '1px solid var(--border)', textTransform: 'uppercase' }}>
                    {k.badge}
                  </span>
                  {!k.active && (
                    <span style={{ fontSize: 10, fontFamily: 'var(--font-mono)', color: 'var(--text3)', fontWeight: 400 }}>
                      отозван
                    </span>
                  )}
                </div>
                <div style={{ fontSize: 11, color: 'var(--text3)', fontFamily: 'var(--font-mono)', marginTop: 4 }}>
                  создан {fmt(k.createdAt)} · {k.messagesTotal} сообщ.
                  {k.lastUsedAt && ` · последний раз ${fmt(k.lastUsedAt)}`}
                </div>
                <div style={{ fontSize: 10, color: 'var(--text3)', fontFamily: 'var(--font-mono)', marginTop: 2 }}>
                  ID: {k.keyId}
                </div>
              </div>

              {/* Action buttons */}
              {k.active && (
                <div style={{ display: 'flex', gap: 6, flexShrink: 0 }}>
                  <button
                    onClick={() => handleRegenerate(k.keyId)}
                    disabled={regenerating === k.keyId}
                    style={{
                      background: 'none', border: '1px solid var(--border)',
                      color: 'var(--text)', borderRadius: 7, padding: '4px 10px',
                      fontSize: 12, cursor: 'pointer',
                      opacity: regenerating === k.keyId ? 0.5 : 1,
                    }}
                  >
                    {regenerating === k.keyId ? '…' : 'Сбросить ключ'}
                  </button>
                  <button
                    onClick={() => handleRevoke(k.keyId)}
                    disabled={revoking === k.keyId}
                    style={{
                      background: 'none', border: '1px solid var(--danger)',
                      color: 'var(--danger)', borderRadius: 7, padding: '4px 10px',
                      fontSize: 12, cursor: 'pointer',
                      opacity: revoking === k.keyId ? 0.5 : 1,
                    }}
                  >
                    {revoking === k.keyId ? '…' : 'Отозвать'}
                  </button>
                </div>
              )}
            </div>
          ))}
        </div>
      )}

      {/* One-time secret modal */}
      {newKey && (
        <SecretModal
          chatId={chatId}
          apiKey={newKey.apiKey}
          keyId={newKey.keyId}
          onClose={() => setNewKey(null)}
        />
      )}
    </div>
  );
}
</file>

<file path="src/components/CreateChatModal.jsx">
import { getFunctions, httpsCallable } from 'firebase/functions';
import { useState } from 'react';
import { useI18n } from '../contexts/I18nContext';

const fn = getFunctions(undefined, 'europe-west1');
const createChatFn = httpsCallable(fn, 'createChat');

export default function CreateChatModal({ onClose, onCreated }) {
  const { t } = useI18n();
  const [type, setType] = useState('group');
  const [name, setName] = useState('');
  const [tag, setTag] = useState('');
  const [description, setDescription] = useState('');
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  async function handleCreate(e) {
    e.preventDefault();
    setError('');
    setLoading(true);
    try {
      const res = await createChatFn({ type, name, tag, description });
      onCreated(res.data.chatId, type);
      onClose();
    } catch (err) {
      setError(err.message);
    }
    setLoading(false);
  }

  return (
    <div className="modal-overlay" onClick={onClose}>
      <div className="modal" onClick={e => e.stopPropagation()}>
        <div className="modal-header">
          <h3>{t('new.group')} / {t('new.channel')}</h3>
          <button className="modal-close" onClick={onClose}>✕</button>
        </div>

        {/* Type selector */}
        <div className="settings-tabs" style={{ marginBottom: 18 }}>
          <button
            className={`settings-tab ${type === 'group' ? 'active' : ''}`}
            onClick={() => setType('group')}
          >
            {t('new.group')}
          </button>
          <button
            className={`settings-tab ${type === 'channel' ? 'active' : ''}`}
            onClick={() => setType('channel')}
          >
            {t('new.channel')}
          </button>
        </div>

        <form onSubmit={handleCreate}>
          <div className="input-group">
            <label>{type === 'group' ? t('new.group.name') : t('new.channel.name')}</label>
            <input
              type="text"
              placeholder={type === 'group' ? t('new.placeholder.group') : t('new.placeholder.channel')}
              value={name}
              onChange={e => setName(e.target.value)}
              maxLength={48}
              required
              autoFocus
            />
          </div>

          <div className="input-group">
            <label>{t('new.tag')}</label>
            <div className="input-with-prefix">
              <span className="prefix">@</span>
              <input
                type="text"
                placeholder="my_tag"
                value={tag}
                onChange={e => setTag(e.target.value.replace(/[^a-zA-Z0-9_]/g, ''))}
                maxLength={24}
                required
              />
            </div>
          </div>

          <div className="input-group">
            <label>
              {t('new.description')}{' '}
              <span style={{ color: 'var(--text3)', fontWeight: 400 }}>
                {t('new.optional')}
              </span>
            </label>
            <textarea
              className="settings-bio"
              placeholder="What is this about?"
              value={description}
              onChange={e => setDescription(e.target.value)}
              maxLength={160}
              rows={2}
            />
          </div>

          {type === 'group' && (
            <p style={{ fontSize: 12, color: 'var(--text3)', marginBottom: 12 }}>
              {t('new.group.hint')}
            </p>
          )}
          {type === 'channel' && (
            <p style={{ fontSize: 12, color: 'var(--text3)', marginBottom: 12 }}>
              {t('new.channel.hint')}
            </p>
          )}

          {error && <div className="auth-error">{error}</div>}

          <button type="submit" className="btn-primary" disabled={loading}>
            {loading
              ? t('new.creating')
              : type === 'group'
                ? t('new.create.group')
                : t('new.create.channel')
            }
          </button>
        </form>
      </div>
    </div>
  );
}
</file>

