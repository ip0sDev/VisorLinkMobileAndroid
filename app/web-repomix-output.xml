<file path="scripts/backfill-discover.cjs">
#!/usr/bin/env node
/**
 * Скрипт миграции: копирует старые сообщения из публичных каналов в `discover_feed`.
 * Запуск: node scripts/backfill-discover.cjs
 */

const { initializeApp, cert } = require('firebase-admin/app');
const { getFirestore, FieldValue } = require('firebase-admin/firestore');
const path = require('path');
const fs = require('fs');

// ── Инициализация ──────────────────────────────────────────────────
let credential;
const localSA = path.join(__dirname, 'serviceAccount.json');
if (fs.existsSync(localSA)) {
  credential = cert(require(localSA));
} else if (process.env.GOOGLE_APPLICATION_CREDENTIALS) {
  credential = cert(require(process.env.GOOGLE_APPLICATION_CREDENTIALS));
} else {
  console.error('ОШИБКА: Не найден serviceAccount.json.');
  process.exit(1);
}

initializeApp({ credential });
const db = getFirestore();

// ── Вспомогательная функция извлечения хэштегов ────────────────────
function extractTags(text) {
  if (!text) return [];
  const match = text.match(/(?:^|\s)#([a-zA-Zа-яА-ЯёЁ0-9_]+)/g);
  if (!match) return [];
  return [...new Set(match.map(t => t.trim().slice(1).toLowerCase()))];
}

// ── Главная функция ────────────────────────────────────────────────
async function main() {
  console.log('🚀 Начинаем миграцию постов в discover_feed...\n');

  // 1. Ищем все публичные каналы
  const channelsSnap = await db.collection('chats')
    .where('type', '==', 'channel')
    .where('settings.joinByTag', '==', true)
    .get();

  if (channelsSnap.empty) {
    console.log('Публичных каналов не найдено. Миграция окончена.');
    return;
  }

  console.log(`Найдено публичных каналов: ${channelsSnap.size}`);

  let totalCopied = 0;
  let totalUpdatedTags = 0;

  for (const channelDoc of channelsSnap.docs) {
    const chatData = channelDoc.data();
    const chatId = channelDoc.id;

    console.log(`\nОбработка канала: ${chatData.name} (ID: ${chatId})`);

    // 2. Берем последние 100 сообщений (чтобы не забить ленту слишком старым мусором)
    const messagesSnap = await db.collection('chats')
      .doc(chatId)
      .collection('messages')
      .where('deleted', '==', false)
      .orderBy('createdAt', 'desc')
      .limit(100)
      .get();

    if (messagesSnap.empty) {
      console.log(`  └ Нет сообщений.`);
      continue;
    }

    console.log(`  └ Найдено ${messagesSnap.size} сообщений. Начинаем копирование...`);

    // Обрабатываем батчами по 500 операций
    let batch = db.batch();
    let opsCount = 0;

    for (const msgDoc of messagesSnap.docs) {
      const msg = msgDoc.data();
      const messageId = msgDoc.id;

      // Извлекаем теги
      const textToParse = msg.text || msg.caption || '';
      const tags = extractTags(textToParse);

      // Добавляем документ в discover_feed
      const discoverRef = db.collection('discover_feed').doc(messageId);
      batch.set(discoverRef, {
        chatId: chatId,
        messageId: messageId,
        channelData: {
          name: chatData.name,
          avatarUrl: chatData.avatarUrl || null,
          tag: chatData.tag || null
        },
        senderId: msg.senderId,
        senderUsername: msg.senderUsername,
        type: msg.type,
        text: msg.text || null,
        caption: msg.caption || null,
        url: msg.url || null,
        cdnMediaId: msg.cdnMediaId || null,
        images: msg.images || null,
        duration: msg.duration || null,
        createdAt: msg.createdAt || FieldValue.serverTimestamp(),
        tags: tags,
        likeCount: 0,
        likers: []
      });
      opsCount++;
      totalCopied++;

      // Опционально: если у старого сообщения в самом канале нет поля tags, добавим его
      if (!msg.tags && tags.length > 0) {
        batch.update(msgDoc.ref, { tags: tags });
        opsCount++;
        totalUpdatedTags++;
      }

      // Если достигли лимита батча — коммитим и создаем новый
      if (opsCount >= 450) {
        await batch.commit();
        batch = db.batch();
        opsCount = 0;
      }
    }

    // Коммитим остатки для текущего канала
    if (opsCount > 0) {
      await batch.commit();
    }
  }

  console.log('\n✅ Миграция успешно завершена!');
  console.log(`✨ Скопировано постов в ленту: ${totalCopied}`);
  console.log(`🏷️ Обновлено тегов в оригинальных постах: ${totalUpdatedTags}`);
}

main().catch(console.error);
</file>

