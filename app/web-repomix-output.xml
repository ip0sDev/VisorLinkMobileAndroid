          cursor: pointer;
          transition: opacity 0.15s, transform 0.1s;
          border: none;
          outline: none;
        }
        .verify-btn:active { transform: scale(0.98); }
        .verify-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
        .verify-btn--primary {
          background: var(--accent);
          color: #fff;
        }
        .verify-btn--primary:not(:disabled):hover { opacity: 0.88; }
        .verify-btn--ghost {
