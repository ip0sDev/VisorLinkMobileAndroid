// functions/createUserProfile.js
// ─────────────────────────────────────────────────────────────────────────────
// Creates the /users/{uid} and /usernames/{username} documents for a brand-new
// user immediately after Firebase Auth account creation.
// ─────────────────────────────────────────────────────────────────────────────

const { onCall, HttpsError } = require('firebase-functions/v2/https');
const { getFirestore, FieldValue } = require('firebase-admin/firestore');
const { getAuth }   = require('firebase-admin/auth');
const { getDatabase } = require('firebase-admin/database'); // ДОБАВЛЕНО ДЛЯ RTDB

const CORS   = true;
const REGION = 'europe-west1';

// Username constraints
const USERNAME_MIN    = 3;
const USERNAME_MAX    = 32;
const USERNAME_REGEX  = /^[a-zA-Z0-9_]+$/;

exports.createUserProfile = onCall({ cors: CORS, region: REGION }, async (request) => {
  // ── 1. Caller must be authenticated (not necessarily verified) ──────────
  if (!request.auth) {
    throw new HttpsError('unauthenticated', 'Not authenticated.');
  }

  // ── ДОБАВЛЕНО: Проверка App Check ───────────────────────────────────────
  // Проверяем, пришел ли запрос с официального приложения
  const isOfficial = request.app !== undefined;

  const uid   = request.auth.uid;
  const email = request.auth.token.email ?? '';
  const { username } = request.data ?? {};

  // ── 2. Validate username ─────────────────────────────────────────────────
  if (typeof username !== 'string' || username.length < USERNAME_MIN) {
    throw new HttpsError('invalid-argument', `Username must be at least ${USERNAME_MIN} characters.`);
  }
  if (username.length > USERNAME_MAX) {
    throw new HttpsError('invalid-argument', `Username must be at most ${USERNAME_MAX} characters.`);
  }
  if (!USERNAME_REGEX.test(username)) {
    throw new HttpsError('invalid-argument', 'Username can only contain letters, numbers, and underscores.');
  }

  const lower = username.toLowerCase();
  const db    = getFirestore();

  // ── 3. Check username availability ──────────────────────────────────────
  const usernameRef = db.doc(`usernames/${lower}`);
  const usernameSnap = await usernameRef.get();

  if (usernameSnap.exists) {
    try { await getAuth().deleteUser(uid); } catch (_) { /* best-effort */ }
    throw new HttpsError('already-exists', 'Username already taken.');
  }

  // ── 4. Check that no /users doc exists yet (idempotency guard) ───────────
  const userRef  = db.doc(`users/${uid}`);
  const userSnap = await userRef.get();

  if (userSnap.exists) {
    return { success: true, uid };
  }

  // ── 5. Write atomically ──────────────────────────────────────────────────
  const now = FieldValue.serverTimestamp();
  const batch = db.batch();

  batch.set(userRef, {
    uid,
    email,
    username:    lower,
    displayName: username,
    bio:         '',
    avatarUrl:   '',
    online:      false,
    lastSeen:    now,
    createdAt:   now,
    updatedAt:   now,
    fcmTokens:   [],
    // ДОБАВЛЕНО: Клеймим профиль, если он создан с левого клиента
    registeredViaOfficialClient: isOfficial
  });

  batch.set(usernameRef, { uid });

  await batch.commit();

  // ── 6. ДОБАВЛЕНО: Инициализация статуса в RTDB ─────────────────────────
  try {
    const rtdb = getDatabase();
    await rtdb.ref(`users/${uid}/clientStatus`).set({
      isOfficial: isOfficial,
      lastActive: require('firebase-admin').database.ServerValue.TIMESTAMP
    });
  } catch (error) {
    console.error(`Failed to initialize RTDB client status for user ${uid}`, error);
  }

  return { success: true, uid };
});
