.mobile-banner-btn { display: flex; align-items: center; gap: 7px; white-space: nowrap; flex-shrink: 0; background: linear-gradient(135deg, var(--accent-light), var(--accent-dark)); color: white; font-family: var(--font-ui); font-size: 13px; font-weight: 700; text-decoration: none; padding: 8px 14px; border-radius: 10px; border: none; cursor: pointer; box-shadow: 0 0 16px var(--accent-glow), var(--neo-shadow-btn); transition: opacity 0.2s, box-shadow 0.2s, transform 0.1s; }
.mobile-banner-btn:hover { opacity: 0.9; box-shadow: 0 0 28px var(--accent-glow), var(--neo-shadow-btn); }
.mobile-banner-btn:active { transform: scale(0.96); }
.mobile-banner-close { background: none; border: none; color: var(--text3); cursor: pointer; padding: 6px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: color 0.15s, background 0.15s; }
.mobile-banner-close:hover { color: var(--text); background: var(--surface3); }

.saved-pin-screen { flex: 1; display: flex; align-items: center; justify-content: center; background: var(--surface2); }
.saved-pin-inner { display: flex; flex-direction: column; align-items: center; gap: 16px; width: 100%; max-width: 280px; padding: 0 24px; }
.saved-pin-icon { font-size: 48px; filter: drop-shadow(0 0 16px var(--accent-glow)); }
.saved-pin-inner h3 { font-size: 18px; font-weight: 700; color: var(--text); margin: 0; text-align: center; }
