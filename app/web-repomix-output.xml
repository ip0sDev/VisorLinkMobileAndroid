          margin: 0 0 10px;
          color: var(--text);
        }
        .verify-subtitle {
          font-size: 14px;
          color: var(--text-secondary);
          margin: 0 0 8px;
          line-height: 1.5;
        }
        .verify-email {
          color: var(--accent);
          font-weight: 500;
          word-break: break-all;
        }
        .verify-hint {
          font-size: 13px;
