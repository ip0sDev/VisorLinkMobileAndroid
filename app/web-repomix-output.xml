.theme-toggle { background: var(--surface2); box-shadow: var(--neo-shadow-btn); border: 0.5px solid var(--border); color: var(--text2); width: 34px; height: 34px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: color 0.15s, border-color 0.15s, box-shadow 0.15s; font-size: 15px; }
.theme-toggle:hover { color: var(--accent); border-color: var(--accent); box-shadow: 0 0 10px var(--accent-glow), var(--neo-shadow-btn); animation: icon-spin 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
