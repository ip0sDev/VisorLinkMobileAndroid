// functions/dmBots.js
const { onRequest, onCall, HttpsError } = require('firebase-functions/v2/https');
const { getFirestore, FieldValue } = require('firebase-admin/firestore');
const crypto = require('crypto');

// ДОБАВЛЕНО: Подключаем CORS и разрешаем запросы с любых доменов
const cors = require('cors')({ origin: true });

function generateToken() {
  return crypto.randomBytes(32).toString('hex');
}

function hashToken(token) {
  return crypto.createHash('sha256').update(token).digest('hex');
}

async function verifyAdmin(uid, db) {
  const userSnap = await db.collection('users').doc(uid).get();
  if (!userSnap.exists || userSnap.data().isAdmin !== true) {
    throw new HttpsError('permission-denied', 'Admin privileges required.');
  }
}

// ── 1. Создание бота ──
exports.createDmBot = onCall({ cors: true, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
  const ownerId = request.auth.uid;
  const { name, username } = request.data;

  if (!username || username.length < 3 || username.length > 24) {
    throw new HttpsError('invalid-argument', 'Username must be 3-24 chars.');
  }

  const cleanUsername = username.toLowerCase().trim();
  const db = getFirestore();

  const usernameSnap = await db.collection('usernames').doc(cleanUsername).get();
  if (usernameSnap.exists) throw new HttpsError('already-exists', 'Username taken.');

  const botUid = db.collection('users').doc().id;
  const botToken = `vldm_${generateToken()}`;
  const botTokenHash = hashToken(botToken);

  const batch = db.batch();

  batch.set(db.collection('usernames').doc(cleanUsername), { uid: botUid });
  batch.set(db.collection('users').doc(botUid), {
    uid: botUid,
    username: cleanUsername,
    displayName: name.trim(),
    avatarUrl: null,
    isBot: true,
    botBadge: 'unverified',
    ownerId: ownerId,
    banned: false,
    createdAt: FieldValue.serverTimestamp(),
    online: true,
  });

  batch.set(db.collection('dmBots').doc(botUid), {
    botUid,
    ownerId,
    tokenHash: botTokenHash,
    authHash: null,
    badge: 'unverified',
    createdAt: FieldValue.serverTimestamp(),
  });

  await batch.commit();
  return { botUid, botToken };
});

// ── 2. Получение списка ботов пользователя ──
exports.getUserBots = onCall({ cors: true, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
  const db = getFirestore();
  
  const snap = await db.collection('dmBots').where('ownerId', '==', request.auth.uid).get();
  const bots = [];
  
  for (const doc of snap.docs) {
    const botData = doc.data();
    const userSnap = await db.collection('users').doc(botData.botUid).get();
    if (userSnap.exists) {
      bots.push({
        botUid: botData.botUid,
        username: userSnap.data().username,
        name: userSnap.data().displayName,
        avatarUrl: userSnap.data().avatarUrl || null,
        badge: botData.badge,
        banned: userSnap.data().banned || false,
        createdAt: botData.createdAt?.toDate?.()?.toISOString() || null
      });
    }
  }
  
  bots.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
  return { bots };
});

// ── 3. Редактирование бота ──
exports.editDmBot = onCall({ cors: true, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
  const { botUid, name, avatarUrl } = request.data;
  
  if (!name || name.trim().length < 1) throw new HttpsError('invalid-argument', 'Name required.');
  
  const db = getFirestore();
  const botRef = db.collection('dmBots').doc(botUid);
  const botSnap = await botRef.get();
  
  if (!botSnap.exists || botSnap.data().ownerId !== request.auth.uid) {
    throw new HttpsError('permission-denied', 'Not your bot.');
  }
  
  const batch = db.batch();
  batch.update(botRef, { badge: 'unverified' }); 
  
  const userUpdates = {
    displayName: name.trim(),
    botBadge: 'unverified'
  };
  
  if (avatarUrl !== undefined) {
    userUpdates.avatarUrl = avatarUrl;
  }
  
  batch.update(db.collection('users').doc(botUid), userUpdates);
  
  await batch.commit();
  return { success: true };
});

// ── 4. Удаление бота ──
exports.deleteDmBot = onCall({ cors: true, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
  const { botUid } = request.data;
  
  const db = getFirestore();
  const botRef = db.collection('dmBots').doc(botUid);
  const botSnap = await botRef.get();
  
  if (!botSnap.exists || botSnap.data().ownerId !== request.auth.uid) {
    throw new HttpsError('permission-denied', 'Not your bot.');
  }
  
  const userRef = db.collection('users').doc(botUid);
  const userSnap = await userRef.get();
  
  const batch = db.batch();
  batch.delete(botRef);
  batch.delete(userRef);
  if (userSnap.exists) {
    batch.delete(db.collection('usernames').doc(userSnap.data().username));
  }
  
  await batch.commit();
  return { success: true };
});

// ── 5. Админка: Выдача авторизации и бейджа ──
exports.adminUpdateBot = onCall({ cors: true, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
  const db = getFirestore();
  
  await verifyAdmin(request.auth.uid, db);

  const { botUid, badge, generateAuth } = request.data;
  const batch = db.batch();

  const updates = { badge };
  let newAuthToken = null;

  if (generateAuth) {
    newAuthToken = `vlauth_${generateToken()}`;
    updates.authHash = hashToken(newAuthToken);
  }

  batch.update(db.collection('dmBots').doc(botUid), updates);
  batch.update(db.collection('users').doc(botUid), { botBadge: badge });

  await batch.commit();
  return { success: true, authToken: newAuthToken };
});

// ── 5.1 Админка: Отзыв токена авторизации ──
exports.adminRevokeBotAuth = onCall({ cors: true, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
  const db = getFirestore();
  
  await verifyAdmin(request.auth.uid, db);

  const { botUid } = request.data;
  const batch = db.batch();

  batch.update(db.collection('dmBots').doc(botUid), { authHash: null, badge: 'unverified' });
  batch.update(db.collection('users').doc(botUid), { botBadge: 'unverified' });

  await batch.commit();
  return { success: true };
});

// ── 5.2 Админка: Бан / Разбан бота ──
exports.adminBanBot = onCall({ cors: true, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
  const db = getFirestore();
  
  await verifyAdmin(request.auth.uid, db);

  const { botUid, banned } = request.data;
  await db.collection('users').doc(botUid).update({ banned: banned === true });

  return { success: true };
});

// ── 6. Разрешение пользователем на отправку сообщений (Unverified) ──
exports.allowBotMessages = onCall({ cors: true, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
  const { chatId } = request.data;
  const db = getFirestore();
  await db.collection('chats').doc(chatId).update({ botAllowed: true });
  return { success: true };
});

// ── 7. Перегенерация токена бота ──
exports.regenerateDmBotToken = onCall({ cors: true, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
  const { botUid } = request.data;
  const db = getFirestore();
  
  const botRef = db.collection('dmBots').doc(botUid);
  const botSnap = await botRef.get();
  
  if (!botSnap.exists || botSnap.data().ownerId !== request.auth.uid) {
    throw new HttpsError('permission-denied', 'Not your bot.');
  }
  
  const newToken = `vldm_${generateToken()}`;
  await botRef.update({ tokenHash: hashToken(newToken) });
  
  return { success: true, botToken: newToken };
});

// ── 8. Webhook для приема сообщений от ботов ──
exports.dmBotWebhook = onRequest({ region: 'europe-west1' }, (req, res) => {
  // ИСПРАВЛЕНО: Оборачиваем логику в cors()
  cors(req, res, async () => {
    if (req.method !== 'POST') return res.status(405).json({ error: 'Use POST' });

    const botTokenHeader = req.headers['x-bot-token'];
    const authHeader = req.headers['authorization']; 

    if (!botTokenHeader) return res.status(401).json({ error: 'Missing X-Bot-Token' });

    const { targetUsername, text } = req.body;
    if (!targetUsername || !text) return res.status(400).json({ error: 'Missing targetUsername or text' });

    const db = getFirestore();
    
    try {
      const botSnap = await db.collection('dmBots')
        .where('tokenHash', '==', hashToken(botTokenHeader))
        .limit(1).get();

      if (botSnap.empty) return res.status(403).json({ error: 'Invalid Bot Token' });
      const botData = botSnap.docs[0].data();

      const botUserDoc = await db.collection('users').doc(botData.botUid).get();
      if (botUserDoc.exists && botUserDoc.data().banned) {
        return res.status(403).json({ error: 'Bot is banned by administration' });
      }

      if (botData.badge === 'official' || botData.badge === 'visorlink') {
        if (!authHeader || !authHeader.startsWith('Bearer ')) {
          return res.status(403).json({ error: 'Missing Authorization Bearer token' });
        }
        const providedAuthHash = hashToken(authHeader.split(' ')[1]);
        if (providedAuthHash !== botData.authHash) {
          return res.status(403).json({ error: 'Invalid Authorization token' });
        }
      }

      const userSnap = await db.collection('usernames').doc(targetUsername.toLowerCase()).get();
      if (!userSnap.exists) return res.status(404).json({ error: 'Target user not found' });
      const targetUid = userSnap.data().uid;

      const targetUserDoc = await db.collection('users').doc(targetUid).get();

      const chatId = [botData.botUid, targetUid].sort().join('_');
      const chatRef = db.collection('chats').doc(chatId);
      
      await db.runTransaction(async (tx) => {
        const chatDoc = await tx.get(chatRef);
        
        let isAllowed = false;
        if (!chatDoc.exists) {
          tx.set(chatRef, {
            participants: [botData.botUid, targetUid],
            participantData: {
              [botData.botUid]: { username: botUserDoc.data().username, displayName: botUserDoc.data().displayName },
              [targetUid]: { username: targetUserDoc.data().username, displayName: targetUserDoc.data().displayName }
            },
            createdAt: FieldValue.serverTimestamp(),
            lastMessage: null,
            lastMessageAt: FieldValue.serverTimestamp(),
            botAllowed: false
          });
        } else {
          isAllowed = chatDoc.data().botAllowed === true;
        }

        if (botData.badge === 'unverified' && !isAllowed) {
          const msgsSnap = await tx.get(
            chatRef.collection('messages')
              .where('senderId', '==', botData.botUid)
              .limit(1)
          );
          if (!msgsSnap.empty) {
            throw new Error('UNVERIFIED_LIMIT');
          }
        }

        const msgRef = chatRef.collection('messages').doc();
        tx.set(msgRef, {
          senderId: botData.botUid,
          senderUsername: botUserDoc.data().username,
          type: 'text',
          text: text.substring(0, 2000),
          createdAt: FieldValue.serverTimestamp(),
          readBy: [botData.botUid],
          deleted: false,
        });

        tx.update(chatRef, {
          lastMessage: text.substring(0, 80),
          lastMessageAt: FieldValue.serverTimestamp()
        });
      });

      return res.json({ success: true });

    } catch (error) {
      if (error.message === 'UNVERIFIED_LIMIT') {
        return res.status(403).json({ error: 'Unverified bot limit reached. User must click "Allow" in UI.' });
      }
      console.error(error);
      return res.status(500).json({ error: 'Internal server error' });
    }
  });
});
