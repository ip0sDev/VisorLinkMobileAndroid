/* Form */
.message-form { display: flex; align-items: flex-end; gap: 8px; padding: 10px 14px 14px; background: var(--acrylic-panel); backdrop-filter: var(--acrylic-blur); -webkit-backdrop-filter: var(--acrylic-blur); box-shadow: 0 -1.2px 0 var(--divider-light), 0 -2px 0 var(--divider-dark), 0 -4px 12px rgba(0,0,0,0.20); position: relative; overflow: visible; flex-shrink: 0; z-index: 20; }
.message-input { flex: 1; min-width: 0; background: var(--surface2); box-shadow: var(--neo-shadow-in); border: 0.5px solid var(--border); color: var(--text); font-family: var(--font-ui); font-size: 14px; padding: 10px 14px; border-radius: 12px; outline: none; resize: none; max-height: 120px; overflow-y: auto; transition: border-color 0.25s ease, box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1); line-height: 1.5; }
.message-input:focus { border-color: var(--accent); box-shadow: var(--neo-shadow-in), 0 0 0 3px var(--accent-glow), 0 0 20px rgba(45,168,154,0.06); }
.message-input::placeholder { color: var(--text3); }
.send-btn { width: 40px; height: 40px; background: linear-gradient(135deg, var(--accent-light), var(--accent-dark)); border: none; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; box-shadow: 4px 4px 8px rgba(0,0,0,0.45), -2px -2px 6px rgba(255,255,255,0.08), 0 0 16px var(--accent-glow); transition: opacity 0.2s, box-shadow 0.2s, transform 0.1s; position: relative; overflow: hidden; }
.send-btn:hover:not(:disabled) { opacity: 0.9; box-shadow: 4px 4px 8px rgba(0,0,0,0.45), -2px -2px 6px rgba(255,255,255,0.08), 0 0 24px var(--accent-glow); }
.send-btn:active:not(:disabled) { transform: scale(0.95); box-shadow: var(--neo-shadow-in), 0 0 12px var(--accent-glow); }
.send-btn-mic { background: var(--surface2) !important; box-shadow: var(--neo-shadow-btn) !important; color: var(--text2) !important; }
.send-btn-mic:hover:not(:disabled) { color: var(--accent) !important; box-shadow: 0 0 12px var(--accent-glow), var(--neo-shadow-btn) !important; }
.tool-btn { background: none; border: none; color: var(--text3); width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: color 0.15s, background 0.15s, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1); }
.tool-btn:hover { color: var(--accent); background: var(--surface3); transform: scale(1.1); }

/* Voice & Media */
.voice-recording-bar { display: flex; align-items: center; gap: 10px; padding: 10px 16px; background: var(--surface2); box-shadow: 0 -1.2px 0 var(--divider-light), 0 -2px 0 var(--divider-dark); flex-shrink: 0; animation: slide-up 0.2s ease; }
.voice-rec-dot { width: 8px; height: 8px; background: var(--danger); border-radius: 50%; box-shadow: 0 0 8px rgba(192,57,43,0.6); animation: pulse-dot 1s ease-in-out infinite; flex-shrink: 0; }
.voice-rec-label { font-size: 13px; color: var(--danger); font-weight: 600; }
.voice-rec-timer { font-family: var(--font-mono); font-size: 13px; color: var(--text2); min-width: 36px; }
.voice-cancel-btn { display: flex; align-items: center; gap: 5px; background: none; border: none; color: var(--text2); font-family: var(--font-ui); font-size: 12px; cursor: pointer; margin-left: auto; padding: 5px 10px; border-radius: 8px; }
.voice-cancel-btn:hover { color: var(--danger); background: rgba(192,57,43,0.1); }
.voice-send-btn-bar { display: flex; align-items: center; gap: 5px; background: linear-gradient(135deg, var(--accent-light), var(--accent-dark)); border: none; color: white; font-family: var(--font-ui); font-size: 12px; font-weight: 700; cursor: pointer; padding: 5px 12px; border-radius: 8px; box-shadow: 0 0 12px var(--accent-glow); }
.voice-msg { display: flex; align-items: center; gap: 8px; min-width: 180px; max-width: 240px; }
.voice-play-btn { width: 30px; height: 30px; background: rgba(255,255,255,0.10); box-shadow: var(--neo-shadow-sm); border: none; border-radius: 50%; color: currentColor; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; transition: background 0.15s, transform 0.1s; }
.voice-play-btn:hover { background: rgba(255,255,255,0.20); transform: scale(1.1); }
.bubble-other .voice-play-btn { background: var(--surface3); color: var(--text); }
.voice-progress-wrap { flex: 1; padding: 8px 0; cursor: pointer; }
.voice-progress-track { height: 3px; background: var(--surface2); box-shadow: inset 1px 1px 3px rgba(0,0,0,0.4); border-radius: 3px; overflow: hidden; }
.voice-progress-fill { height: 100%; background: var(--accent); border-radius: 3px; transition: width 0.1s linear; }
.voice-time { font-size: 11px; font-family: var(--font-mono); color: var(--text3); }

.msg-image-wrap { cursor: zoom-in; border-radius: 10px; overflow: hidden; max-width: 280px; }
.msg-image { display: block; width: 100%; max-width: 280px; max-height: 320px; object-fit: cover; border-radius: 10px; }
.img-lightbox { position: fixed; inset: 0; z-index: 200; background: rgba(0,0,0,0.90); backdrop-filter: blur(12px); display: flex; align-items: center; justify-content: center; cursor: zoom-out; animation: overlay-in 0.2s ease; }
.img-lightbox img { max-width: 90vw; max-height: 90vh; border-radius: 12px; box-shadow: var(--neo-shadow-out), 0 20px 80px rgba(0,0,0,0.6); animation: modal-in 0.25s cubic-bezier(0.16,1,0.3,1); }

.msg-link { color: var(--accent); text-decoration: underline; text-decoration-color: rgba(45,168,154,0.4); text-underline-offset: 2px; word-break: break-all; transition: color 0.15s, text-decoration-color 0.15s; cursor: pointer; }
.msg-link:hover { color: var(--accent-light); text-decoration-color: var(--accent); }
.msg-mention { display: inline; background: none; border: none; padding: 0; margin: 0; font-family: var(--font-mono); font-size: 0.92em; font-weight: 600; color: var(--accent); cursor: pointer; border-radius: 4px; transition: background 0.12s, color 0.12s; }
.msg-mention:hover { background: rgba(45,168,154,0.12); color: var(--accent-light); }
.bot-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-family: var(--font-mono); font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent); background: rgba(45,168,154,0.10); border: 1px solid rgba(45,168,154,0.25); border-radius: 5px; padding: 2px 7px; margin-bottom: 3px; align-self: flex-start; pointer-events: none; }

.bubble-footer { display: flex; align-items: center; justify-content: flex-end; gap: 4px; font-size: 10px; opacity: 0.7; margin-top: 4px; }
.read-receipt { display: flex; align-items: center; flex-shrink: 0; opacity: 0.85; }
.forward-banner { display: flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; color: var(--accent); opacity: 0.9; margin-bottom: 5px; padding-bottom: 5px; border-bottom: 1px solid var(--border); font-family: var(--font-mono); letter-spacing: 0.02em; }
.no-forwards-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-weight: 600; color: var(--text3); background: var(--surface3); border-radius: 6px; padding: 2px 6px; font-family: var(--font-mono); }

/* Albums */
.album-grid { display: grid; gap: 2px; border-radius: 10px; overflow: hidden; max-width: 320px; width: 100%; }
.album-1 { grid-template-columns: 1fr; } .album-1 .album-cell { aspect-ratio: 4/3; }
.album-2 { grid-template-columns: 1fr 1fr; } .album-2 .album-cell { aspect-ratio: 1; }
.album-3 { grid-template-columns: 2fr 1fr; grid-template-rows: auto; } .album-3 > .album-cell { aspect-ratio: 3/4; }
.album-col { display: flex; flex-direction: column; gap: 2px; } .album-col .album-cell { flex: 1; aspect-ratio: 1; }
.album-4 { grid-template-columns: 1fr 1fr; } .album-4 .album-cell { aspect-ratio: 1; }
.album-n { grid-template-columns: repeat(3, 1fr); } .album-n .album-cell-wrap, .album-n .album-cell { aspect-ratio: 1; }
.album-cell-wrap { position: relative; }
.album-cell { position: relative; overflow: hidden; cursor: pointer; background: var(--surface2); }
.album-cell img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.18s; }
.album-cell:hover img { transform: scale(1.03); }
.album-cell-hidden img { filter: blur(10px) brightness(0.6); }
.album-cell-spoiler { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; color: #fff; font-size: 18px; pointer-events: none; }
.album-cell-hint { font-size: 9px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; opacity: 0.8; }
.album-cell-badge { position: absolute; top: 4px; left: 4px; background: rgba(0,0,0,0.5); color: #fff; font-size: 8px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 2px 4px; border-radius: 3px; }
.album-more-overlay { position: absolute; inset: 0; background: rgba(0,0,0,0.55); color: #fff; font-size: 20px; font-weight: 700; display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(2px); }
.album-caption { margin: 4px 0 0; font-size: 13.5px; line-height: 1.45; color: var(--text); word-break: break-word; }
.album-lightbox { position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.92); display: flex; align-items: center; justify-content: center; outline: none; }
.album-lb-close { position: absolute; top: 16px; right: 16px; width: 36px; height: 36px; border-radius: 50%; background: rgba(255,255,255,0.12); border: none; color: #fff; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 2; transition: background 0.15s; }
.album-lb-close:hover { background: rgba(255,255,255,0.22); }
.album-lb-img-wrap img { max-width: 90vw; max-height: 80vh; object-fit: contain; border-radius: 6px; user-select: none; }
.album-lb-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.12); border: none; color: #fff; font-size: 28px; width: 44px; height: 44px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; z-index: 2; }
.album-lb-prev { left: 16px; } .album-lb-next { right: 16px; }
.album-lb-counter { position: absolute; top: 18px; left: 50%; transform: translateX(-50%); color: rgba(255,255,255,0.7); font-size: 13px; pointer-events: none; }
.album-lb-strip { position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%); display: flex; gap: 6px; max-width: 90vw; overflow-x: auto; padding: 4px; }
.album-lb-thumb { width: 44px; height: 44px; border-radius: 6px; overflow: hidden; cursor: pointer; opacity: 0.55; border: 2px solid transparent; flex-shrink: 0; }
.album-lb-thumb.active { opacity: 1; border-color: #fff; }
.album-lb-thumb img { width: 100%; height: 100%; object-fit: cover; }

/* Spoilers */
.spoiler-badge { display: inline-flex; align-items: center; gap: 4px; font-size: 10px; font-family: var(--font-mono); background: rgba(45,168,154,0.10); color: var(--accent); border: 1px solid rgba(45,168,154,0.25); border-radius: 4px; padding: 2px 6px; }
.spoiler-wrap { position: relative; cursor: pointer; border-radius: 10px; overflow: hidden; display: block; max-width: 280px; user-select: none; }
.spoiler-img { display: block; width: 100%; max-width: 280px; max-height: 320px; object-fit: cover; border-radius: 10px; filter: blur(22px) brightness(0.35); transform: scale(1.06); transition: filter 0.35s ease, transform 0.35s ease; pointer-events: none; }
.spoiler-wrap.revealed .spoiler-img { filter: none; transform: scale(1); cursor: zoom-in; pointer-events: auto; }
.spoiler-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; transition: opacity 0.3s ease; }
.spoiler-wrap.revealed .spoiler-overlay { opacity: 0; pointer-events: none; }
.spoiler-icon { font-size: 26px; }
.spoiler-label { font-size: 12px; font-weight: 700; color: white; font-family: var(--font-mono); letter-spacing: 0.1em; text-shadow: 0 1px 4px rgba(0,0,0,0.7); }
.spoiler-hint { font-size: 10px; color: rgba(255,255,255,0.6); font-family: var(--font-mono); }

/* Wallpapers */
.messages-area[style*="backgroundImage"] .bubble-own { background: rgba(28, 64, 62, 0.88); backdrop-filter: blur(8px); }
.messages-area[style*="backgroundImage"] .bubble-other { background: rgba(21, 48, 47, 0.84); backdrop-filter: blur(8px); }
[data-theme="light"] .messages-area[style*="backgroundImage"] .bubble-own { background: rgba(194, 219, 216, 0.88); backdrop-filter: blur(8px); }
[data-theme="light"] .messages-area[style*="backgroundImage"] .bubble-other { background: rgba(205, 228, 226, 0.88); backdrop-filter: blur(8px); }

/* DM Bot Badges */
.bot-badge-inline {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 10px;
  font-family: var(--font-brand);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 2px 7px;
  border-radius: 6px;
  margin-left: 8px;
  vertical-align: middle;
  line-height: 1;
  user-select: none;
}
.bot-badge-official {
  background: linear-gradient(135deg, #3B82F6, #2563EB);
  color: #fff;
  box-shadow: 0 0 10px rgba(59,130,246,0.4);
  border: 1px solid rgba(255,255,255,0.2);
}
.bot-badge-visorlink {
  background: linear-gradient(135deg, var(--accent-light), var(--accent-dark));
  color: #fff;
  box-shadow: 0 0 10px var(--accent-glow);
  border: 1px solid rgba(255,255,255,0.2);
}
.bot-badge-unverified {
  background: var(--surface3);
  color: var(--text3);
  border: 1px solid var(--border);
}
.bot-badge-icon {
  width: 12px;
  height: 12px;
  flex-shrink: 0;
}

.bot-info-banner {
  margin: 16px 20px;
  background: var(--surface2);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 12px 16px;
  text-align: center;
  font-size: 13px;
  color: var(--text2);
}
.bot-info-banner.unverified {
  border-color: var(--warn);
  background: rgba(230,126,34,0.05);
}
.bot-allow-btn {
  width: 100%;
  margin-top: 10px;
  background: var(--accent);
  color: white;
  border: none;
  padding: 10px;
  border-radius: 10px;
  font-family: var(--font-ui);
  font-weight: 600;
  cursor: pointer;
}

/* ── PREMIUM GIFTS ── */
.bubble-gift {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  overflow: visible !important;
}
.bubble-gift::after {
  display: none !important;
}

.gift-box-wrap {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center; 
  gap: 12px;
  background: linear-gradient(135deg, rgba(20,20,22,0.85), rgba(40,40,45,0.95));
  border: 1px solid rgba(255, 215, 0, 0.2);
  padding: 24px 32px;
  border-radius: 20px;
  min-width: 240px;
  min-height: 160px; 
  text-align: center;
  box-shadow: 0 10px 30px rgba(0,0,0,0.5), inset 0 0 20px rgba(255,215,0,0.03);
  transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  backdrop-filter: blur(12px);
  z-index: 10;
  overflow: visible; 
}

.gift-icon-container {
  position: relative;
  z-index: 2;
}

.gift-icon {
  font-size: 56px;
  line-height: 1;
  filter: drop-shadow(0 4px 12px rgba(255, 215, 0, 0.3));
  transition: transform 0.3s;
}

/* Нагнетание (Тряска) */
.gift-box-wrap.opening {
  border-color: rgba(255, 215, 0, 0.8);
  box-shadow: 0 0 40px rgba(255, 215, 0, 0.2), inset 0 0 30px rgba(255,215,0,0.1);
  animation: premium-rumble 0.1s linear infinite;
}
.gift-box-wrap.opening .gift-icon {
  animation: premium-icon-pulse 0.5s ease-in-out infinite alternate;
}

/* Открытый вид */
.gift-box-wrap.redeemed {
  background: rgba(45, 168, 154, 0.05);
  border-color: rgba(45, 168, 154, 0.3);
  box-shadow: none;
}
.gift-box-wrap.redeemed .gift-icon {
  font-size: 52px;
  filter: drop-shadow(0 0 15px rgba(45,168,154,0.5));
  animation: float-premium 4s ease-in-out infinite;
}

/* UI elements */
.gift-info {
  z-index: 2;
}
.gift-info strong {
  display: block;
  color: #FFD700;
  font-size: 16px;
  font-family: var(--font-brand);
  letter-spacing: 0.05em;
  margin-bottom: 4px;
  text-shadow: 0 2px 8px rgba(255,215,0,0.3);
}
.gift-status {
  font-size: 13px;
  color: rgba(255,255,255,0.6);
}
.gift-open-btn {
  background: linear-gradient(135deg, #FFD700, #F39C12);
  border: none;
  color: #000;
  font-family: var(--font-brand);
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  padding: 12px 32px;
  border-radius: 24px;
  cursor: pointer;
  box-shadow: 0 4px 16px rgba(243,156,18,0.4);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  margin-top: 8px;
  z-index: 2;
}
.gift-open-btn:hover:not(:disabled) {
  transform: scale(1.05) translateY(-2px);
  box-shadow: 0 8px 24px rgba(243,156,18,0.6);
}
.gift-open-btn:active:not(:disabled) {
  transform: scale(0.95);
}
.gift-open-btn:disabled {
  opacity: 0.6;
  cursor: wait;
}

/* ВЗРЫВ! */
.gift-box-wrap.epic-reveal {
  animation: premium-pop 4.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  z-index: 50;
}

.gift-fx-container {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  pointer-events: none;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: visible;
}

.gift-shockwave {
  position: absolute;
  top: -150px;
  left: -150px;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  border: 2px solid #FFD700;
  opacity: 0;
  transform: scale(0);
  animation: shockwave-expand 1.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  box-shadow: 0 0 20px #FFD700, inset 0 0 20px #FFD700;
}

.gift-spark {
  position: absolute;
  top: -2px; 
  left: -2px;
  width: 4px;
  height: 4px;
  background: #FFF;
  border-radius: 50%;
  box-shadow: 0 0 10px 2px #FFD700;
  opacity: 0;
  animation: spark-fly var(--dur) cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

/* Ключевые кадры */
@keyframes premium-rumble {
  0% { transform: translate(0, 0); }
  25% { transform: translate(-1px, 1px); }
  50% { transform: translate(1px, -1px); }
  75% { transform: translate(-1px, -1px); }
  100% { transform: translate(1px, 1px); }
}

@keyframes premium-icon-pulse {
  0% { transform: scale(1); filter: drop-shadow(0 0 10px rgba(255,215,0,0.5)); }
  100% { transform: scale(1.1); filter: drop-shadow(0 0 25px rgba(255,215,0,0.9)); }
}

@keyframes float-premium {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}

@keyframes premium-pop {
  0% { transform: scale(1); }
  10% { transform: scale(1.05); }
  100% { transform: scale(1); }
}

@keyframes shockwave-expand {
  0% { transform: scale(0); opacity: 1; border-width: 10px; }
  100% { transform: scale(1); opacity: 0; border-width: 0px; }
}

@keyframes spark-fly {
  0% { transform: translate(0, 0) scale(0); opacity: 1; }
  20% { transform: translate(calc(var(--tx) * 0.5), calc(var(--ty) * 0.5)) scale(var(--s)); opacity: 1; }
  100% { transform: translate(var(--tx), var(--ty)) scale(0); opacity: 0; }
}

/* ── VISORLINK ADMIN BADGE ── */
.vl-admin-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: linear-gradient(135deg, #FF0055, #FF4B2B);
  color: white;
  font-family: var(--font-brand);
  font-size: 10px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  padding: 3px 8px;
  border-radius: 6px;
  box-shadow: 0 2px 10px rgba(255, 75, 43, 0.4);
  vertical-align: middle;
  line-height: 1;
  user-select: none;
}
.vl-admin-badge svg {
  width: 12px;
  height: 12px;
  flex-shrink: 0;
}


/* --- Стили для Вкладок Сайдбара --- */
.sidebar-nav-tabs {
  display: flex;
  padding: 10px 14px;
  gap: 8px;
  border-bottom: 1px solid var(--border);
  flex-shrink: 0;
}
.sidebar-nav-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 8px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text2);
  background: var(--surface2);
  border: 1px solid transparent;
  cursor: pointer;
  transition: all 0.15s;
}
.sidebar-nav-tab:hover {
  background: var(--surface3);
  color: var(--text);
}
.sidebar-nav-tab.active {
  background: color-mix(in srgb, var(--accent) 12%, transparent);
  color: var(--accent);
  border-color: color-mix(in srgb, var(--accent) 30%, transparent);
  box-shadow: 0 0 8px var(--accent-glow);
}

/* --- Стили для Ленты новостей (Feed Twitter Style) --- */
.feed-window {
  background: var(--bg2);
}
.feed-area {
  padding: 24px !important;
  align-items: stretch;
}
.feed-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 16px 20px;
  margin-bottom: 20px;
  box-shadow: var(--neo-shadow-sm);
  transition: box-shadow 0.2s, transform 0.2s;
  width: 100%;
}
.feed-card:hover {
  box-shadow: var(--neo-shadow-btn);
}
.feed-card-header {
