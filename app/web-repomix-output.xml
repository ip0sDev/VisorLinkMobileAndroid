    { id: 'pro',        label: t('settings.pro') },
    { id: 'bots',       label: t('settings.bots') },
    ...(isNewServiceEnabled ? [{ id: 'storage', label: 'Хранилище' }] : []),
    ...(isAdminUser ? [{ id: 'admin', label: 'Admin' }] : []),
  ];

  const fontMap = {
    default: undefined,
    mono: 'var(--font-mono)',
    serif: 'Georgia, "Times New Roman", serif',
    rounded: '"Nunito", "Varela Round", system-ui, sans-serif'
