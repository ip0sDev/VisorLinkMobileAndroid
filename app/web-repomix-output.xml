<file path="src/hooks/useTyping.js">
import { useRef, useCallback, useEffect } from 'react';
import { rtdb } from '../firebase/config';
import { ref, set, remove, onValue } from 'firebase/database';

export function useTyping(chatId, uid) {
  const timer = useRef(null);

  const onTyping = useCallback(() => {
    if (!chatId || !uid) return;
    set(ref(rtdb, `typing/${chatId}/${uid}`), {
      uid,
      ts: Date.now()
    });
    clearTimeout(timer.current);
    timer.current = setTimeout(() => {
      remove(ref(rtdb, `typing/${chatId}/${uid}`));
    }, 3000);
  }, [chatId, uid]);

  const onStopTyping = useCallback(() => {
    if (!chatId || !uid) return;
    clearTimeout(timer.current);
    remove(ref(rtdb, `typing/${chatId}/${uid}`));
  }, [chatId, uid]);

  // Cleanup on unmount
  useEffect(() => {
    return () => {
      clearTimeout(timer.current);
      if (chatId && uid) remove(ref(rtdb, `typing/${chatId}/${uid}`));
    };
  }, [chatId, uid]);

  return { onTyping, onStopTyping };
}

export function useTypingListener(chatId, currentUid) {
  const subscribe = useCallback((setTypingUsers) => {
    if (!chatId) return () => {};

    const typingRef = ref(rtdb, `typing/${chatId}`);
    const unsub = onValue(typingRef, (snap) => {
      const data = snap.val() || {};
      const users = Object.values(data).filter(
        u => u.uid !== currentUid && Date.now() - u.ts < 4000
      );
      setTypingUsers(users);
    });

    return unsub;
  }, [chatId, currentUid]);

  return { subscribe };
}
</file>

<file path="src/pages/VerifyEmail.jsx">
import { useState, useEffect, useRef } from 'react';
import { useAuth } from '../contexts/AuthContext';
import { useI18n } from '../contexts/I18nContext';
import { auth } from '../firebase/config';
import {
  sendEmailVerification,
  verifyBeforeUpdateEmail,
  reauthenticateWithCredential,
  EmailAuthProvider,
  reload,
} from 'firebase/auth';

export default function VerifyEmail() {
  const { user, logout } = useAuth();
  const { t } = useI18n();
  const [sending, setSending] = useState(false);
  const [sent, setSent] = useState(false);
  const [cooldown, setCooldown] = useState(0);
  const [checking, setChecking] = useState(false);
  const [error, setError] = useState('');
  const intervalRef = useRef(null);
  const cooldownRef = useRef(null);

  // Change-email form state
  const [showChangeEmail, setShowChangeEmail] = useState(false);
  const [newEmail, setNewEmail] = useState('');
  const [password, setPassword] = useState('');
  const [changingEmail, setChangingEmail] = useState(false);
  const [emailChanged, setEmailChanged] = useState(false);

  // Poll for email verification every 4s
  useEffect(() => {
    intervalRef.current = setInterval(async () => {
      try {
        await reload(auth.currentUser);
        if (auth.currentUser?.emailVerified) {
          // Force token refresh so Firestore/Storage rules see email_verified=true
          await auth.currentUser.getIdToken(true);
          window.location.reload();
        }
      } catch {
        // silent
      }
    }, 4000);
    return () => clearInterval(intervalRef.current);
  }, []);

  const isCoolingDown = cooldown > 0;
  // Cooldown timer
  useEffect(() => {
    if (!isCoolingDown) return;
    cooldownRef.current = setInterval(() => {
      setCooldown(c => {
        if (c <= 1) { clearInterval(cooldownRef.current); return 0; }
        return c - 1;
      });
    }, 1000);
    return () => clearInterval(cooldownRef.current);
  }, [isCoolingDown]);

  async function handleResend() {
    if (sending || cooldown > 0) return;
    setSending(true);
    setError('');
    try {
      await sendEmailVerification(auth.currentUser);
      setSent(true);
      setCooldown(60);
    } catch (e) {
      if (e.code === 'auth/too-many-requests') {
        setError(t('verify.tooManyRequests'));
        setCooldown(60);
      } else {
        setError(t('verify.sendError'));
      }
    } finally {
      setSending(false);
    }
  }

  async function handleCheckNow() {
    setChecking(true);
    try {
      await reload(auth.currentUser);
      if (auth.currentUser?.emailVerified) {
        await auth.currentUser.getIdToken(true);
        window.location.reload();
      } else {
        setError(t('verify.notYet'));
        setTimeout(() => setError(''), 3000);
      }
    } catch {
      setError(t('verify.checkError'));
    } finally {
      setChecking(false);
    }
  }

  async function handleChangeEmail() {
    if (!newEmail.trim() || newEmail.trim() === user?.email) return;
    setChangingEmail(true);
    setError('');
    try {
      // Re-authenticate first — Firebase requires recent login for email change
      const credential = EmailAuthProvider.credential(user.email, password);
      await reauthenticateWithCredential(auth.currentUser, credential);

      await verifyBeforeUpdateEmail(auth.currentUser, newEmail.trim());
      setEmailChanged(true);
      setShowChangeEmail(false);
      setNewEmail('');
      setPassword('');
      setSent(false);
    } catch (e) {
      console.error('changeEmail error:', e.code, e.message);
      if (e.code === 'auth/wrong-password' || e.code === 'auth/invalid-credential') {
        setError(t('verify.changeEmailWrongPassword'));
      } else if (e.code === 'auth/invalid-email') {
        setError(t('verify.changeEmailInvalid'));
      } else if (e.code === 'auth/email-already-in-use') {
        setError(t('verify.changeEmailInUse'));
      } else if (e.code === 'auth/too-many-requests') {
        setError(t('verify.tooManyRequests'));
      } else {
        setError(t('verify.changeEmailError'));
      }
    } finally {
      setChangingEmail(false);
    }
  }

  function handleCancelChange() {
    setShowChangeEmail(false);
    setNewEmail('');
    setPassword('');
    setError('');
  }

  return (
    <div className="verify-email-page">
      <div className="verify-card">
        <div className="verify-icon-wrap">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
            <rect width="48" height="48" rx="14" fill="currentColor" fillOpacity=".08"/>
            <path d="M8 16a4 4 0 0 1 4-4h24a4 4 0 0 1 4 4v16a4 4 0 0 1-4 4H12a4 4 0 0 1-4-4V16Z" stroke="currentColor" strokeWidth="1.5" fill="none"/>
            <path d="M8 17l14.586 9.757a2 2 0 0 0 2.828 0L40 17" stroke="currentColor" strokeWidth="1.5" strokeLinecap="round" fill="none"/>
          </svg>
        </div>

        <h1 className="verify-title">{t('verify.title')}</h1>
        <p className="verify-subtitle">
          {t('verify.sentTo')}{' '}
          <span className="verify-email">{user?.email}</span>
        </p>
        <p className="verify-hint">{t('verify.hint')}</p>

        {emailChanged && !error && (
          <div className="verify-banner verify-banner--success">
            {t('verify.changeEmailSent')}
          </div>
        )}
        {sent && !error && !emailChanged && (
          <div className="verify-banner verify-banner--success">
            {t('verify.resent')}
          </div>
        )}
        {error && (
          <div className="verify-banner verify-banner--error">
            {error}
          </div>
        )}

        {/* Change email form */}
        {showChangeEmail ? (
          <div className="verify-change-email">
            <p className="verify-change-label">{t('verify.changeEmailLabel')}</p>
            <input
              className="verify-input"
              type="email"
              value={newEmail}
              onChange={e => setNewEmail(e.target.value)}
              placeholder={t('verify.changeEmailPlaceholder')}
              autoFocus
              disabled={changingEmail}
            />
            <input
              className="verify-input"
              type="password"
              value={password}
              onChange={e => setPassword(e.target.value)}
              onKeyDown={e => e.key === 'Enter' && handleChangeEmail()}
              placeholder={t('verify.changeEmailPasswordPlaceholder')}
              disabled={changingEmail}
            />
            <div className="verify-change-actions">
              <button
                className="verify-btn verify-btn--primary"
                onClick={handleChangeEmail}
                disabled={changingEmail || !newEmail.trim() || !password || newEmail.trim() === user?.email}
              >
                {changingEmail ? t('verify.sending') : t('verify.changeEmailConfirm')}
              </button>
              <button
                className="verify-btn verify-btn--ghost"
                onClick={handleCancelChange}
                disabled={changingEmail}
              >
                {t('verify.changeEmailCancel')}
              </button>
            </div>
          </div>
        ) : (
          <div className="verify-actions">
            <button
              className="verify-btn verify-btn--primary"
              onClick={handleCheckNow}
              disabled={checking}
            >
              {checking ? t('verify.checking') : t('verify.checkBtn')}
            </button>

            <button
              className="verify-btn verify-btn--ghost"
              onClick={handleResend}
              disabled={sending || cooldown > 0}
            >
              {cooldown > 0
                ? `${t('verify.resendIn')} ${cooldown}s`
                : sending
                  ? t('verify.sending')
                  : t('verify.resendBtn')}
            </button>

            <button
              className="verify-btn verify-btn--ghost verify-btn--change"
              onClick={() => { setShowChangeEmail(true); setError(''); setSent(false); setEmailChanged(false); }}
            >
              {t('verify.changeEmailBtn')}
            </button>
          </div>
        )}

        <div className="verify-divider"/>

        <button className="verify-logout" onClick={logout}>
          {t('verify.logout')}
        </button>
      </div>

      <style>{`
        .verify-email-page {
          min-height: 100dvh;
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 24px;
          background: var(--bg);
        }
        .verify-card {
