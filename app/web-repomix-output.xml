exports.deleteStickerPack = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { packId } = request.data;

  if (!packId) throw new HttpsError('invalid-argument', 'packId required');

  const packDoc = await db.collection('stickerPacks').doc(packId).get();
  if (!packDoc.exists) throw new HttpsError('not-found', 'Pack not found');
  if (packDoc.data().authorId !== uid)
    throw new HttpsError('permission-denied', 'Only the author can delete this pack');

  const batch = db.batch();
  batch.delete(db.collection('stickerPacks').doc(packId));
  batch.set(
    db.collection('users').doc(uid).collection('stickerData').doc('packs'),
    { packIds: FieldValue.arrayRemove(packId) },
    { merge: true }
  );
  await batch.commit();

  return { success: true };
});

