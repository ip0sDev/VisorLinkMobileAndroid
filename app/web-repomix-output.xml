<file path="functions/index.js">
// functions/index.js
const { onCall, HttpsError } = require('firebase-functions/v2/https');
const { onDocumentDeleted } = require('firebase-functions/v2/firestore');
const { initializeApp, getApps } = require('firebase-admin/app');
const { getFirestore, FieldValue } = require('firebase-admin/firestore');
const { getMessaging } = require('firebase-admin/messaging');
const { getStorage } = require('firebase-admin/storage');
const { getDatabase } = require('firebase-admin/database');
const { getAuth } = require('firebase-admin/auth');
const crypto = require('crypto');

// Инициализация Firebase Admin (должна быть до использования сервисов)
if (!getApps().length) initializeApp();

const db = getFirestore();
const rtdb = getDatabase();
const CORS = true;

const sendAlbum = require('./sendAlbum');
const { createUserProfile } = require('./createUserProfile');
const { onNewMessage } = require('./onNewMessage'); // Импортируем наш выделенный модуль

// ─────────────────────────────────────────────────────────
// HELPERS
// ─────────────────────────────────────────────────────────
function genInviteToken() {
  return crypto.randomBytes(6).toString('base64url');
}

/**
 * Throws if the caller is not authenticated OR has an unverified email.
 * Returns { uid, token, isOfficial } for convenience.
 */
async function requireVerified(request) {
  if (!request.auth) {
    throw new HttpsError('unauthenticated', 'Not authenticated.');
  }
  if (!request.auth.token.email_verified) {
    throw new HttpsError(
      'permission-denied',
      'Email address is not verified. Please verify your email before using this feature.'
    );
  }

  const uid = request.auth.uid;
  const isOfficial = request.app !== undefined;

  // Fire-and-forget — never await RTDB writes in the hot path.
  try {
    rtdb.ref(`users/${uid}/clientStatus`).update({
      isOfficial,
      lastActive: require('firebase-admin').database.ServerValue.TIMESTAMP,
    });
  } catch (error) {
    console.error(`RTDB clientStatus update failed for ${uid}:`, error);
  }

  return { uid, token: request.auth.token, isOfficial };
}

async function assertMember(chatId, uid, minRole = 'member') {
  const memberDoc = await db
    .collection('chats').doc(chatId)
    .collection('members').doc(uid).get();
  if (!memberDoc.exists) throw new HttpsError('permission-denied', 'Not a member');
  const role = memberDoc.data().role;
  if (minRole === 'admin' && !['admin', 'owner'].includes(role))
    throw new HttpsError('permission-denied', 'Admin only');
  if (minRole === 'owner' && role !== 'owner')
    throw new HttpsError('permission-denied', 'Owner only');
  return memberDoc.data();
}

// ─────────────────────────────────────────────────────────
// EXTERNAL MODULE EXPORTS
// ─────────────────────────────────────────────────────────
const {
  createChannelBotKey,
  revokeChannelBotKey,
  regenerateChannelBotKey,
  listChannelBotKeys,
  channelBotWebhook,
} = require('./channelBot');

const {
  deactivateBotKeysOnChannelDeleteV2,
} = require('./channelBotCleanup');

const {
  createDmBot,
  getUserBots,
  editDmBot,
  deleteDmBot,
  adminUpdateBot,
  adminRevokeBotAuth,
  adminBanBot,
  allowBotMessages,
  regenerateDmBotToken,
  dmBotWebhook
} = require('./dmBots');

exports.createChannelBotKey           = createChannelBotKey;
exports.revokeChannelBotKey           = revokeChannelBotKey;
exports.regenerateChannelBotKey       = regenerateChannelBotKey;
exports.listChannelBotKeys            = listChannelBotKeys;
exports.channelBotWebhook             = channelBotWebhook;
exports.deactivateBotKeysOnChannelDeleteV2 = deactivateBotKeysOnChannelDeleteV2;

exports.createDmBot          = createDmBot;
exports.getUserBots          = getUserBots;
exports.editDmBot            = editDmBot;
exports.deleteDmBot          = deleteDmBot;
exports.adminUpdateBot       = adminUpdateBot;
exports.adminRevokeBotAuth   = adminRevokeBotAuth;
exports.adminBanBot          = adminBanBot;
exports.allowBotMessages     = allowBotMessages;
exports.regenerateDmBotToken = regenerateDmBotToken;
exports.dmBotWebhook         = dmBotWebhook;

exports.sendAlbum = sendAlbum.sendAlbum;
exports.createUserProfile = createUserProfile;
exports.onNewMessage = onNewMessage; // Экспортируем функцию триггера

// ─────────────────────────────────────────────────────────
// CHECK USERNAME
// ─────────────────────────────────────────────────────────
exports.checkUsername = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { username } = request.data;
  if (!username) throw new HttpsError('invalid-argument', 'Username required');
  const clean = username.toLowerCase().trim();
  if (clean.length < 3) return { available: false, reason: 'Too short' };
  if (clean.length > 24) return { available: false, reason: 'Too long' };
  if (!/^[a-zA-Z0-9_]+$/.test(clean)) return { available: false, reason: 'Invalid characters' };
  const snap = await db.collection('usernames').doc(clean).get();
  if (snap.exists && snap.data().uid !== uid) return { available: false, reason: 'Already taken' };
  return { available: true };
});

// ─────────────────────────────────────────────────────────
// CHANGE USERNAME
// ─────────────────────────────────────────────────────────
exports.changeUsername = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { newUsername, displayName } = request.data;
  if (!newUsername) throw new HttpsError('invalid-argument', 'Username required');
  const clean = newUsername.toLowerCase().trim();
  if (clean.length < 3 || clean.length > 24)
    throw new HttpsError('invalid-argument', 'Username must be 3–24 characters');
  if (!/^[a-zA-Z0-9_]+$/.test(clean))
    throw new HttpsError('invalid-argument', 'Letters, numbers and underscores only');
  const existingDoc = await db.collection('usernames').doc(clean).get();
  if (existingDoc.exists && existingDoc.data().uid !== uid)
    throw new HttpsError('already-exists', 'Username already taken');
  const userDoc = await db.collection('users').doc(uid).get();
  if (!userDoc.exists) throw new HttpsError('not-found', 'User not found');
  const oldUsername = userDoc.data().username;
  const batch = db.batch();
  if (oldUsername && oldUsername !== clean) batch.delete(db.collection('usernames').doc(oldUsername));
  batch.set(db.collection('usernames').doc(clean), { uid });
  const userUpdate = { username: clean, updatedAt: new Date() };
  if (displayName && displayName.trim()) userUpdate.displayName = displayName.trim();
  batch.update(db.collection('users').doc(uid), userUpdate);
  await batch.commit();
  return { success: true, username: clean };
});

// ─────────────────────────────────────────────────────────
// UPDATE PROFILE
// ─────────────────────────────────────────────────────────
exports.updateProfile = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { bio, displayName } = request.data;
  const updates = { updatedAt: new Date() };
  if (typeof bio === 'string') {
    if (bio.length > 160) throw new HttpsError('invalid-argument', 'Bio max 160 characters');
    updates.bio = bio.trim();
  }
  if (typeof displayName === 'string') {
    const trimmed = displayName.trim();
    if (trimmed.length < 1) throw new HttpsError('invalid-argument', 'Display name required');
    if (trimmed.length > 32) throw new HttpsError('invalid-argument', 'Display name max 32 characters');
    updates.displayName = trimmed;
  }
  await db.collection('users').doc(uid).update(updates);
  return { success: true };
});

// ─────────────────────────────────────────────────────────
// GENERATE TELEGRAM BINDING CODE
// ─────────────────────────────────────────────────────────
exports.generateTgCode = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);

  const bindingsRef = db.collection('tg_bindings');
  const existingSnap = await bindingsRef.where('uid', '==', uid).get();
  
  if (!existingSnap.empty) {
    const batch = db.batch();
    existingSnap.docs.forEach(doc => batch.delete(doc.ref));
    await batch.commit();
  }

  // 6 цифр (от 100000 до 999999)
  const code = Math.floor(100000 + Math.random() * 900000).toString();
  const expiresAt = new Date(Date.now() + 5 * 60 * 1000); // 5 минут

  await bindingsRef.doc(code).set({
    uid,
    createdAt: FieldValue.serverTimestamp(),
    expiresAt: expiresAt
  });

  return { success: true, code };
});

// ─────────────────────────────────────────────────────────
// SAVE FCM TOKEN
// ─────────────────────────────────────────────────────────
exports.saveFcmToken = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Not authenticated.');
  const uid = request.auth.uid;
  const { token } = request.data;
  
  if (!token) throw new HttpsError('invalid-argument', 'Token required');

  const userRef = db.collection('users').doc(uid);
  const userDoc = await userRef.get();
  
  if (!userDoc.exists) throw new HttpsError('not-found', 'User not found');

  let currentTokens = userDoc.data().fcmTokens || [];
  
  currentTokens = [...new Set(currentTokens)].filter(t => t !== token);
  currentTokens.push(token);

  const messaging = getMessaging();

  const checkPromises = currentTokens.map(async (t) => {
    try {
      await messaging.send({ token: t, data: { verify: '1' } }, true);
      return t;
    } catch (error) {
      if (
        error.code === 'messaging/registration-token-not-registered' ||
        error.code === 'messaging/invalid-registration-token' ||
        error.code === 'messaging/invalid-argument'
      ) {
        return null;
      }
      console.warn(`Warning checking FCM token ${t}:`, error);
      return t;
    }
  });

  const results = await Promise.all(checkPromises);
  
  let validTokens = results.filter(t => t !== null);

  if (validTokens.length > 10) {
    validTokens = validTokens.slice(-10);
  }

  await userRef.update({
    fcmTokens: validTokens,
    updatedAt: new Date()
  });

  return { success: true };
});

