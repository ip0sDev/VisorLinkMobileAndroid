  --bg:  color-mix(in srgb, var(--accent) 6%, #0D0E10 94%);
  --bg2: color-mix(in srgb, var(--accent) 6%, #0D0E10 94%);
  --surface:  color-mix(in srgb, var(--accent) 9%, #1A1B1E 91%);
  --surface2: color-mix(in srgb, var(--accent) 9%, #1A1B1E 91%);
  --surface3: color-mix(in srgb, var(--accent) 12%, #212226 88%);
  --surface4: color-mix(in srgb, var(--accent) 16%, #292A2F 84%);

