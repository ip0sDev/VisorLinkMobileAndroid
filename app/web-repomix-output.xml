          margin: 0 0 24px;
          line-height: 1.6;
        }
        .verify-banner {
          width: 100%;
          padding: 10px 14px;
          border-radius: 10px;
          font-size: 13px;
          margin-bottom: 16px;
          text-align: left;
        }
        .verify-banner--success {
          background: color-mix(in srgb, var(--accent) 12%, transparent);
          color: var(--accent);
          border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
        }
        .verify-banner--error {
          background: color-mix(in srgb, #e24b4a 10%, transparent);
          color: #e24b4a;
          border: 1px solid color-mix(in srgb, #e24b4a 25%, transparent);
        }
        .verify-actions {
          width: 100%;
          display: flex;
          flex-direction: column;
          gap: 10px;
          margin-bottom: 28px;
        }
        .verify-btn {
          width: 100%;
          padding: 12px 20px;
          border-radius: 12px;
          font-size: 14px;
