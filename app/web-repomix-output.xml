// src/contexts/AuthContext.jsx
import { createContext, useContext, useState, useEffect } from 'react';
import { auth, db } from '../firebase/config';
import {
  createUserWithEmailAndPassword,
  signInWithEmailAndPassword,
  signOut,
  onAuthStateChanged,
  sendEmailVerification,
  sendPasswordResetEmail,
  updatePassword,
  reauthenticateWithCredential,
  EmailAuthProvider
} from 'firebase/auth';
import { doc, getDoc, onSnapshot } from 'firebase/firestore';
import { getFunctions, httpsCallable } from 'firebase/functions';
import { usePresence } from '../hooks/usePresence';

const AuthContext = createContext();
const fn = getFunctions(undefined, 'europe-west1');

export function AuthProvider({ children }) {
  const [user, setUser]         = useState(null);
  const [userData, setUserData] = useState(null);
  const [loading, setLoading]   = useState(true);

  usePresence(user?.emailVerified ? user.uid : null);

  // ── Register ──────────────────────────────────────────────────────────────
  async function register(email, password, username) {
    const cred = await createUserWithEmailAndPassword(auth, email, password);
    const createUserProfile = httpsCallable(fn, 'createUserProfile');
    try {
      await createUserProfile({ username });
    } catch (err) {
      try { await cred.user.delete(); } catch (_) { /* best-effort */ }
      throw new Error(err.message ?? 'Registration failed. Please try again.');
    }
    await sendEmailVerification(cred.user);
    return cred;
  }

  // ── Login ─────────────────────────────────────────────────────────────────
  async function login(email, password) {
    const cred = await signInWithEmailAndPassword(auth, email, password);
    await cred.user.getIdToken(true);
    return cred;
  }

  // ── Reset Password ────────────────────────────────────────────────────────
  async function resetPassword(email) {
    await sendPasswordResetEmail(auth, email);
  }

  // ── Change Password (Settings) ────────────────────────────────────────────
  async function changeUserPassword(currentPassword, newPassword) {
    if (!auth.currentUser || !auth.currentUser.email) {
      throw new Error('Not authenticated');
    }
    const credential = EmailAuthProvider.credential(auth.currentUser.email, currentPassword);
    await reauthenticateWithCredential(auth.currentUser, credential);
    await updatePassword(auth.currentUser, newPassword);
  }

  // ── Logout ────────────────────────────────────────────────────────────────
  async function logout() {
    await signOut(auth);
  }

  // ── Auth state listener ───────────────────────────────────────────────────
  useEffect(() => {
    let unsubUser = () => {};

    const unsubAuth = onAuthStateChanged(auth, (firebaseUser) => {
      setUser(firebaseUser);
      if (firebaseUser) {
        unsubUser = onSnapshot(doc(db, 'users', firebaseUser.uid), snap => {
          if (snap.exists()) setUserData(snap.data());
        });
      } else {
        setUserData(null);
        unsubUser();
      }
      setLoading(false);
    });

    return () => {
      unsubAuth();
      unsubUser();
    };
  },[]);

  return (
    <AuthContext.Provider value={{
      user, userData, register, login, logout, resetPassword, changeUserPassword, loading
    }}>
      {!loading && children}
    </AuthContext.Provider>
  );
}

export function useAuth() {
  return useContext(AuthContext);
}
