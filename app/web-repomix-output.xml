import { useState, useRef, useCallback } from 'react';
import { useI18n } from '../contexts/I18nContext';

const MAX_IMAGES = 10;

// ── Single image card ─────────────────────────────────────
function ImageCard({ item, index, total, onRemove, onToggleSpoiler, onMoveLeft, onMoveRight }) {
  const { t } = useI18n();
  const previewUrl = URL.createObjectURL(item.file);

  return (
    <div className="mie-card">
      {/* Image preview */}
      <div className={`mie-card-preview ${item.spoiler ? 'mie-card-spoiler' : ''}`}>
        <img src={previewUrl} alt="" draggable={false} onLoad={() => URL.revokeObjectURL(previewUrl)} />
        {item.spoiler && (
          <div className="mie-card-spoiler-overlay">
            <span>🙈</span>
            <span className="mie-card-spoiler-label">{t('spoiler.label')}</span>
          </div>
        )}
      </div>

      {/* Controls row */}
      <div className="mie-card-controls">
        <button
          className="mie-card-btn mie-reorder-btn"
          onClick={() => onMoveLeft(index)}
          disabled={index === 0}
          title="Move left"
        >‹</button>

        <button
          className={`mie-card-btn mie-spoiler-btn ${item.spoiler ? 'active' : ''}`}
          onClick={() => onToggleSpoiler(index)}
          title={item.spoiler ? t('editor.spoiler.on') : t('editor.spoiler.off')}
        >
          {item.spoiler ? '🙈' : '👁'}
        </button>

        <button
          className="mie-card-btn mie-remove-btn"
          onClick={() => onRemove(index)}
          title="Remove"
        >✕</button>

        <button
          className="mie-card-btn mie-reorder-btn"
          onClick={() => onMoveRight(index)}
          disabled={index === total - 1}
          title="Move right"
        >›</button>
      </div>

      {/* Spoiler badge */}
      {item.spoiler && (
        <div className="mie-card-badge">{t('spoiler.badge')}</div>
      )}

      {/* Index pill */}
      <div className="mie-card-index">{index + 1}</div>
    </div>
  );
}

// ── Drop zone ─────────────────────────────────────────────
function DropZone({ onFiles, disabled }) {
  const { t } = useI18n();
  const [dragOver, setDragOver] = useState(false);
  const fileRef = useRef(null);

  function handleDrop(e) {
    e.preventDefault();
    setDragOver(false);
    if (disabled) return;
    const files = Array.from(e.dataTransfer.files).filter(f => f.type.startsWith('image/'));
    if (files.length) onFiles(files);
  }

  function handleFileInput(e) {
    const files = Array.from(e.target.files);
    if (files.length) onFiles(files);
    e.target.value = '';
  }

  return (
    <div
      className={`mie-dropzone ${dragOver ? 'drag-over' : ''} ${disabled ? 'disabled' : ''}`}
      onDragOver={e => { e.preventDefault(); if (!disabled) setDragOver(true); }}
      onDragLeave={() => setDragOver(false)}
      onDrop={handleDrop}
      onClick={() => !disabled && fileRef.current?.click()}
    >
      <input
        ref={fileRef}
        type="file"
        accept="image/*"
        multiple
        style={{ display: 'none' }}
        onChange={handleFileInput}
      />
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.5">
        <rect x="3" y="3" width="18" height="18" rx="3"/>
        <circle cx="8.5" cy="8.5" r="1.5"/>
        <path d="M21 15l-5-5L5 21"/>
        <path d="M12 7v6M9 10h6"/>
      </svg>
      <span>
        {disabled
          ? `Max ${MAX_IMAGES} photos`
          : `Add photos (drag & drop or click)`
        }
      </span>
    </div>
  );
}

// ── Main MultiImageEditor ──────────────────────────────────
export default function MultiImageEditor({ onConfirm, onCancel }) {
  const { t } = useI18n();
  const [items, setItems] = useState([]); // [{ file, spoiler }]
  const [caption, setCaption] = useState('');

  // Add files (deduplication by name+size)
  const handleFiles = useCallback((newFiles) => {
    setItems(prev => {
      const existing = new Set(prev.map(i => `${i.file.name}_${i.file.size}`));
      const fresh = newFiles
        .filter(f => !existing.has(`${f.name}_${f.size}`))
        .map(f => ({ file: f, spoiler: false }));
      const combined = [...prev, ...fresh];
      return combined.slice(0, MAX_IMAGES);
    });
  }, []);

  function handleRemove(index) {
    setItems(prev => prev.filter((_, i) => i !== index));
  }

  function handleToggleSpoiler(index) {
    setItems(prev => prev.map((item, i) =>
      i === index ? { ...item, spoiler: !item.spoiler } : item
    ));
  }

  function handleMoveLeft(index) {
    if (index === 0) return;
    setItems(prev => {
      const arr = [...prev];
      [arr[index - 1], arr[index]] = [arr[index], arr[index - 1]];
      return arr;
    });
  }

  function handleMoveRight(index) {
    setItems(prev => {
      if (index === prev.length - 1) return prev;
      const arr = [...prev];
      [arr[index], arr[index + 1]] = [arr[index + 1], arr[index]];
      return arr;
    });
  }

  // Toggle ALL spoilers at once
  function handleToggleAllSpoilers() {
    const allOn = items.every(i => i.spoiler);
    setItems(prev => prev.map(i => ({ ...i, spoiler: !allOn })));
  }

  function handleConfirm() {
    if (items.length === 0) return;
    onConfirm(items, caption.trim());
  }

  const allSpoiler = items.length > 0 && items.every(i => i.spoiler);
  const someSpiler = items.some(i => i.spoiler);

  return (
    <div className="ie-overlay">
      <div className="ie-modal mie-modal">

        {/* Header */}
        <div className="ie-header">
          <h3>
            {items.length === 0
              ? 'Send photos'
              : `Send ${items.length} photo${items.length > 1 ? 's' : ''}`
            }
          </h3>
          <button className="modal-close" onClick={onCancel}>✕</button>
        </div>

        {/* Grid / Drop zone */}
        <div className="mie-body">
          {items.length > 0 && (
            <div className="mie-grid">
              {items.map((item, idx) => (
                <ImageCard
                  key={`${item.file.name}_${item.file.size}_${idx}`}
                  item={item}
                  index={idx}
                  total={items.length}
                  onRemove={handleRemove}
                  onToggleSpoiler={handleToggleSpoiler}
                  onMoveLeft={handleMoveLeft}
                  onMoveRight={handleMoveRight}
                />
              ))}

              {items.length < MAX_IMAGES && (
                <DropZone onFiles={handleFiles} disabled={false} />
              )}
            </div>
          )}

          {items.length === 0 && (
            <DropZone onFiles={handleFiles} disabled={false} />
          )}
        </div>

        {/* Caption input */}
        {items.length > 0 && (
          <div className="mie-caption-row">
            <textarea
              className="mie-caption"
              placeholder="Add a caption (optional)…"
              value={caption}
              onChange={e => setCaption(e.target.value)}
              maxLength={500}
              rows={2}
            />
          </div>
        )}

        {/* Bulk spoiler toggle */}
        {items.length > 1 && (
          <div className="mie-bulk-row">
            <button
              className={`mie-bulk-spoiler-btn ${allSpoiler ? 'active' : someSpiler ? 'partial' : ''}`}
              onClick={handleToggleAllSpoilers}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                {allSpoiler
                  ? <><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94"/><path d="M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19"/><line x1="1" y1="1" x2="23" y2="23"/></>
                  : <><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></>
                }
              </svg>
              {allSpoiler ? 'Remove all spoilers' : 'Mark all as spoiler'}
            </button>
            <span className="mie-counter">{items.length} / {MAX_IMAGES}</span>
          </div>
        )}

        {/* Footer */}
        <div className="ie-footer">
          <button className="btn-ghost" onClick={onCancel}>{t('general.cancel')}</button>
          <button
            className="btn-primary"
            style={{ width: 'auto', padding: '10px 28px' }}
            onClick={handleConfirm}
            disabled={items.length === 0}
          >
            {someSpiler
              ? `🙈 Send ${items.length} photo${items.length > 1 ? 's' : ''}`
              : `Send ${items.length} photo${items.length > 1 ? 's' : ''}`
            }
          </button>
        </div>
      </div>
    </div>
  );
}
