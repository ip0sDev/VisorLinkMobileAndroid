#!/usr/bin/env node
/**
 * VisorLink — Storage Cleanup Script
 *
 * Finds and deletes files in Firebase Storage that are no longer
 * referenced in Firestore (orphaned media from deleted messages,
 * comments, old avatars, etc.)
 *
 * Usage:
 *   node cleanup-storage.js [--dry-run] [--verbose]
 *
 * Options:
 *   --dry-run   List orphaned files without deleting them
 *   --verbose   Log every file checked
 *
 * Prerequisites:
 *   npm install firebase-admin
 *   Set GOOGLE_APPLICATION_CREDENTIALS env var to your service account JSON
 *   OR place serviceAccount.json in the same directory
 */

const { initializeApp, cert } = require('firebase-admin/app');
const { getFirestore }        = require('firebase-admin/firestore');
const { getStorage }          = require('firebase-admin/storage');
const path  = require('path');
const fs    = require('fs');

// ── Config ────────────────────────────────────────────────
const PROJECT_ID   = 'visorlink-f9484';
const STORAGE_BUCKET = `${PROJECT_ID}.firebasestorage.app`;
const DRY_RUN  = process.argv.includes('--dry-run');
const VERBOSE  = process.argv.includes('--verbose');

// Paths that should NEVER be deleted even if not found in Firestore
// (e.g. default assets, public images)
const PROTECTED_PREFIXES = [
  'public/',
  'defaults/',
];

// ── Init ──────────────────────────────────────────────────
let credential;
const localSA = path.join(__dirname, 'serviceAccount.json');
if (fs.existsSync(localSA)) {
  credential = cert(require(localSA));
} else if (process.env.GOOGLE_APPLICATION_CREDENTIALS) {
  credential = cert(require(process.env.GOOGLE_APPLICATION_CREDENTIALS));
} else {
  console.error('ERROR: No credentials found.');
  console.error('  Place serviceAccount.json here or set GOOGLE_APPLICATION_CREDENTIALS.');
  process.exit(1);
}

initializeApp({ credential, storageBucket: STORAGE_BUCKET });

const db      = getFirestore();
const bucket  = getStorage().bucket();

// ── Helpers ───────────────────────────────────────────────
function log(...args)    { console.log('[cleanup]', ...args); }
function verbose(...args){ if (VERBOSE) console.log('[verbose]', ...args); }
function warn(...args)   { console.warn('[WARN]', ...args); }

function isProtected(filePath) {
  return PROTECTED_PREFIXES.some(p => filePath.startsWith(p));
}

function sizeStr(bytes) {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / 1024 / 1024).toFixed(2)} MB`;
}

// ── Step 1: collect all referenced URLs from Firestore ────
async function collectReferencedUrls() {
  const urls = new Set();

  log('Collecting referenced URLs from Firestore...');

  // ── Users: avatarUrl ──────────────────────────────────
  const usersSnap = await db.collection('users').get();
  for (const doc of usersSnap.docs) {
    const { avatarUrl } = doc.data();
    if (avatarUrl) urls.add(avatarUrl);
  }
  log(`  Users: ${usersSnap.size} docs`);

  // ── User stickers ─────────────────────────────────────
  const userStickersSnap = await db.collectionGroup('stickers').get();
  for (const doc of userStickersSnap.docs) {
    const { url } = doc.data();
    if (url) urls.add(url);
  }
  log(`  Stickers: ${userStickersSnap.size} docs`);

  // ── Messages (url field for image/voice/sticker) ──────
  const messagesSnap = await db.collectionGroup('messages').get();
  for (const doc of messagesSnap.docs) {
    const { url } = doc.data();
    if (url) urls.add(url);
  }
  log(`  Messages: ${messagesSnap.size} docs`);

  // ── Comments ──────────────────────────────────────────
  const commentsSnap = await db.collectionGroup('comments').get();
  for (const doc of commentsSnap.docs) {
    const { url } = doc.data();
    if (url) urls.add(url);
  }
  log(`  Comments: ${commentsSnap.size} docs`);

  // ── Chat avatars (groups/channels) ────────────────────
  const chatsSnap = await db.collection('chats').get();
  for (const doc of chatsSnap.docs) {
    const { avatarUrl } = doc.data();
    if (avatarUrl) urls.add(avatarUrl);
  }
  log(`  Chats: ${chatsSnap.size} docs`);

  // ── Wallpapers ────────────────────────────────────────
  const wallpapersSnap = await db.collectionGroup('wallpapers').get();
  for (const doc of wallpapersSnap.docs) {
    const { url } = doc.data();
    if (url) urls.add(url);
  }
  log(`  Wallpapers: ${wallpapersSnap.size} docs`);

  log(`Total referenced URLs: ${urls.size}`);
  return urls;
}

// ── Step 2: list all files in Storage ────────────────────
async function listAllStorageFiles() {
  log('Listing all files in Storage...');
  const [files] = await bucket.getFiles({ autoPaginate: true });
  log(`Total files in Storage: ${files.length}`);
  return files;
}

// ── Step 3: extract path from download URL ────────────────
// Firebase Storage download URLs look like:
// https://firebasestorage.googleapis.com/v0/b/{bucket}/o/{encoded-path}?alt=media&token=...
function extractPathFromUrl(url) {
  try {
    const u = new URL(url);
    const oPath = u.pathname; // /v0/b/{bucket}/o/{encoded-path}
    const parts = oPath.split('/o/');
    if (parts.length < 2) return null;
    return decodeURIComponent(parts[1].split('?')[0]);
  } catch {
    return null;
  }
}

// ── Main ──────────────────────────────────────────────────
async function main() {
  console.log('');
  console.log('╔═══════════════════════════════════════╗');
  console.log('║  VisorLink Storage Cleanup            ║');
  console.log(`║  Project: ${PROJECT_ID.padEnd(27)}║`);
  console.log(`║  Mode: ${DRY_RUN ? 'DRY RUN (no deletions)   ' : 'LIVE (will delete files) '} ║`);
  console.log('╚═══════════════════════════════════════╝');
  console.log('');

  if (DRY_RUN) {
    warn('DRY RUN mode — no files will be deleted.');
  }

  const startTime = Date.now();

  // Collect data
  const [referencedUrls, storageFiles] = await Promise.all([
    collectReferencedUrls(),
    listAllStorageFiles(),
  ]);

  // Build set of referenced paths
  const referencedPaths = new Set();
  for (const url of referencedUrls) {
    const p = extractPathFromUrl(url);
    if (p) referencedPaths.add(p);
    else warn(`Could not extract path from URL: ${url.substring(0, 80)}...`);
  }

  // Find orphans
  log('\nAnalyzing files...');
  const orphans = [];
  let totalSize = 0;

  for (const file of storageFiles) {
    const filePath = file.name;

    if (isProtected(filePath)) {
      verbose(`PROTECTED: ${filePath}`);
      continue;
    }

    if (referencedPaths.has(filePath)) {
      verbose(`OK: ${filePath}`);
    } else {
      const [metadata] = await file.getMetadata();
      const size = parseInt(metadata.size || '0', 10);
      totalSize += size;
      orphans.push({ file, filePath, size, updated: metadata.updated });
      if (VERBOSE) {
        console.log(`[orphan] ${filePath} (${sizeStr(size)})`);
      }
    }
  }

  // Report
  console.log('');
  console.log('══════════════════════════════════════');
  console.log(`Orphaned files found: ${orphans.length}`);
  console.log(`Total reclaimable:    ${sizeStr(totalSize)}`);
  console.log('══════════════════════════════════════');

  if (orphans.length === 0) {
    log('Storage is clean! No orphaned files found.');
    return;
  }

  // Group orphans by prefix for readable output
  const byPrefix = {};
  for (const o of orphans) {
    const prefix = o.filePath.split('/')[0];
    if (!byPrefix[prefix]) byPrefix[prefix] = [];
    byPrefix[prefix].push(o);
  }

  for (const [prefix, files] of Object.entries(byPrefix)) {
    const prefixSize = files.reduce((s, f) => s + f.size, 0);
    console.log(`\n  ${prefix}/ — ${files.length} files, ${sizeStr(prefixSize)}`);
    for (const o of files) {
      const age = o.updated
        ? `(last modified ${new Date(o.updated).toISOString().split('T')[0]})`
        : '';
      console.log(`    ${o.filePath.replace(`${prefix}/`, '')} — ${sizeStr(o.size)} ${age}`);
    }
  }

  if (DRY_RUN) {
    console.log('\n[DRY RUN] No files were deleted. Run without --dry-run to delete.');
    return;
  }

  // Confirm before deleting
  if (!process.argv.includes('--force')) {
    const readline = require('readline');
    const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
    await new Promise(resolve => {
      rl.question(`\nDelete ${orphans.length} files? (yes/no): `, answer => {
        rl.close();
        if (answer.toLowerCase() !== 'yes') {
          console.log('Aborted.');
          process.exit(0);
        }
        resolve();
      });
    });
  }

  // Delete
  log(`\nDeleting ${orphans.length} orphaned files...`);
  let deleted = 0;
  let failed  = 0;
  let deletedSize = 0;

  for (const o of orphans) {
    try {
      await o.file.delete();
      deleted++;
      deletedSize += o.size;
      verbose(`Deleted: ${o.filePath}`);
    } catch (err) {
      failed++;
      warn(`Failed to delete ${o.filePath}: ${err.message}`);
    }
  }

  const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);

  console.log('');
  console.log('══════════════════════════════════════');
  console.log(`Done in ${elapsed}s`);
  console.log(`Deleted:  ${deleted} files (${sizeStr(deletedSize)} freed)`);
  if (failed > 0) console.log(`Failed:   ${failed} files`);
  console.log('══════════════════════════════════════');
}

main().catch(err => {
  console.error('Fatal error:', err);
  process.exit(1);
});
