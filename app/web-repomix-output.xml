// functions/channelBotCleanup.js
const { onDocumentDeleted } = require('firebase-functions/v2/firestore');
const { getFirestore, FieldValue } = require('firebase-admin/firestore');

exports.deactivateBotKeysOnChannelDeleteV2 = onDocumentDeleted(
  {
    document: 'chats/{chatId}',
    region: 'europe-west1',
  },
  async (event) => {
    // Инициализируем БД только в момент вызова функции!
    const db = getFirestore();

    const chatId   = event.params.chatId;
    const chatData = event.data?.data();

    if (!chatData || chatData.type !== 'channel') return;

    const keysSnap = await db
      .collection('chats').doc(chatId)
      .collection('botKeys')
      .where('active', '==', true)
      .get();

    if (keysSnap.empty) return;

    const batch = db.batch();
    keysSnap.forEach(doc => {
      batch.update(doc.ref, {
        active:      false,
        revokedAt:   FieldValue.serverTimestamp(),
        revokedReason: 'channel_deleted',
      });
    });

    await batch.commit();
    console.log(`[channelBotCleanup] Deactivated ${keysSnap.size} bot key(s) for deleted channel ${chatId}`);
  }
);
</file>

<file path="functions/feed.js">
// functions/feed.js
const { onDocumentCreated } = require('firebase-functions/v2/firestore');
const { onCall, HttpsError } = require('firebase-functions/v2/https');
const { getFirestore, FieldValue } = require('firebase-admin/firestore');

const CORS = true;

// Извлекаем хэштеги из текста
function extractTags(text) {
  if (!text) return [];
  const match = text.match(/(?:^|\s)#([a-zA-Zа-яА-ЯёЁ0-9_]+)/g);
  if (!match) return [];
  return [...new Set(match.map(t => t.trim().slice(1).toLowerCase()))];
}

// 1. Копируем публичные посты в discover_feed
exports.publishToDiscover = onDocumentCreated(
  { document: 'chats/{chatId}/messages/{messageId}', region: 'europe-west1' },
  async (event) => {
    const message = event.data?.data();
    if (!message || message.deleted) return;

    const { chatId, messageId } = event.params;
    const db = getFirestore();

    const chatDoc = await db.collection('chats').doc(chatId).get();
    if (!chatDoc.exists) return;
    const chatData = chatDoc.data();

    if (chatData.type !== 'channel' || chatData.settings?.joinByTag !== true) return;

    const textToParse = message.text || message.caption || '';
    const tags = extractTags(textToParse);

    const discoverRef = db.collection('discover_feed').doc(messageId);
    
    await discoverRef.set({
      chatId: chatId,
      messageId: messageId,
      channelData: {
        name: chatData.name,
        avatarUrl: chatData.avatarUrl || null,
        tag: chatData.tag || null
      },
      senderId: message.senderId,
      senderUsername: message.senderUsername,
      type: message.type,
      text: message.text || null,
      caption: message.caption || null,
      url: message.url || null,
      cdnMediaId: message.cdnMediaId || null,
      images: message.images || null,
      duration: message.duration || null,
      createdAt: message.createdAt || FieldValue.serverTimestamp(),
      tags: tags,
      likeCount: 0,
      likers: []
    });
  }
);

// 2. Обработка лайка и обучение профиля (interestWeights)
exports.toggleLike = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
  const uid = request.auth.uid;
  const { messageId, isLiked } = request.data;

  if (!messageId) throw new HttpsError('invalid-argument', 'messageId required.');

  const db = getFirestore();
  const discoverRef = db.collection('discover_feed').doc(messageId);
  const userRef = db.collection('users').doc(uid);

  await db.runTransaction(async (tx) => {
    const discoverDoc = await tx.get(discoverRef);
    if (!discoverDoc.exists) return;

    const data = discoverDoc.data();
    const tags = data.tags || [];

    if (isLiked) {
      tx.update(discoverRef, {
        likeCount: FieldValue.increment(1),
        likers: FieldValue.arrayUnion(uid)
      });
      // Обучаем профиль: повышаем вес тегов
      if (tags.length > 0) {
        const userDoc = await tx.get(userRef);
        if (userDoc.exists) {
          const currentWeights = userDoc.data().interestWeights || {};
          tags.forEach(tag => {
            currentWeights[tag] = (currentWeights[tag] || 0) + 1;
          });
          tx.update(userRef, { interestWeights: currentWeights });
        }
      }
    } else {
      tx.update(discoverRef, {
        likeCount: FieldValue.increment(-1),
        likers: FieldValue.arrayRemove(uid)
      });
    }
  });

  return { success: true };
});
</file>

