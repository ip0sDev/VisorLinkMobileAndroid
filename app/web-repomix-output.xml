<file path="functions/sendAlbum.js">
// functions/sendAlbum.js
const { onCall, HttpsError } = require('firebase-functions/v2/https');
const { getFirestore, FieldValue } = require('firebase-admin/firestore');
const { getDatabase } = require('firebase-admin/database'); // ДОБАВЛЕНО ДЛЯ RTDB

const db = getFirestore();
const CORS = true;
const MAX_IMAGES = 10;

/**
 * Throws if the caller is not authenticated OR has an unverified email.
 * Defined locally so sendAlbum.js stays self-contained and doesn't need
 * a cross-file import while still enforcing the same policy.
 */
// ── ИЗМЕНЕНО: теперь функция асинхронная ──────────────────────────────────
async function requireVerified(request) {
  if (!request.auth) {
    throw new HttpsError('unauthenticated', 'Not authenticated.');
  }
  if (!request.auth.token.email_verified) {
    throw new HttpsError(
      'permission-denied',
      'Email address is not verified. Please verify your email before using this feature.'
    );
  }

  const uid = request.auth.uid;
  // Проверяем App Check
  const isOfficial = request.app !== undefined;

  // Обновляем статус в RTDB
  try {
    const rtdb = getDatabase();
    await rtdb.ref(`users/${uid}/clientStatus`).update({
      isOfficial: isOfficial,
      lastActive: require('firebase-admin').database.ServerValue.TIMESTAMP
    });
  } catch (error) {
    console.error(`Failed to update RTDB client status for user ${uid}`, error);
  }

  // Возвращаем isOfficial
  return { uid, token: request.auth.token, isOfficial };
}

exports.sendAlbum = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  // ── ИЗМЕНЕНО: добавили await и вытащили isOfficial ───────────────────────
  const { uid, isOfficial } = await requireVerified(request);

  const { chatId, images, caption = '', replyTo = null } = request.data;

  // ── 1. Basic arg validation ──────────────────────────────
  if (!chatId) throw new HttpsError('invalid-argument', 'chatId required');
  if (!Array.isArray(images) || images.length === 0)
    throw new HttpsError('invalid-argument', 'images array required');
  if (images.length > MAX_IMAGES)
    throw new HttpsError('invalid-argument', `Max ${MAX_IMAGES} images per message`);
  if (typeof caption === 'string' && caption.length > 500)
    throw new HttpsError('invalid-argument', 'Caption max 500 characters');

  for (const img of images) {
    if (typeof img.url !== 'string' || !img.url.startsWith('https://'))
      throw new HttpsError('invalid-argument', 'Each image must have a valid https url');
  }

  // ── 2. Fetch chat & member docs ──────────────────────────
  const [chatDoc, memberDoc, userDoc] = await Promise.all([
    db.collection('chats').doc(chatId).get(),
    db.collection('chats').doc(chatId).collection('members').doc(uid).get(),
    db.collection('users').doc(uid).get(),
  ]);

  if (!chatDoc.exists) throw new HttpsError('not-found', 'Chat not found');
  if (!userDoc.exists)  throw new HttpsError('not-found', 'User not found');

  const chat = chatDoc.data();
  const chatType = chat.type || 'direct';

  // ── 3. Permission checks ─────────────────────────────────
  if (chatType === 'direct') {
    if (!Array.isArray(chat.participants) || !chat.participants.includes(uid))
      throw new HttpsError('permission-denied', 'Not a participant');
  } else {
    if (!memberDoc.exists || memberDoc.data().banned)
      throw new HttpsError('permission-denied', 'Not a member or banned');

    if (chatType === 'channel') {
      const role = memberDoc.data().role;
      if (!['admin', 'owner'].includes(role))
        throw new HttpsError('permission-denied', 'Only admins can post in channels');
    }

    if (chatType === 'group') {
      const { muted, mutedUntil, mediaRestricted, role } = memberDoc.data();
      const isAdmin = ['admin', 'owner'].includes(role);
      if (!isAdmin) {
        const nowMs = Date.now();
        const stillMuted = muted && (!mutedUntil || mutedUntil.toMillis() > nowMs);
        if (stillMuted)
          throw new HttpsError('permission-denied', 'You are muted');
        if (mediaRestricted)
          throw new HttpsError('permission-denied', 'Media sending is restricted');
      }
    }
  }

  // ── 4. Build & write message ─────────────────────────────
  const username = userDoc.data().username || uid;

  const messageData = {
    senderId: uid,
    senderUsername: username,
    type: 'album',
    images: images.map(img => ({
      url: img.url,
      fileName: img.fileName || '',
      spoiler: img.spoiler === true,
    })),
    caption: caption.trim(),
    replyTo,
    createdAt: FieldValue.serverTimestamp(),
    readBy: [],
    reactions: [],
    deleted: false,
    commentsCount: 0,
    commentsEnabled: true,
    // ── ИЗМЕНЕНО: Клеймим сообщение, если оно отправлено с неофициального клиента
    isUnofficialClient: !isOfficial
  };

  const messagesRef = db.collection('chats').doc(chatId).collection('messages');
  const msgRef = messagesRef.doc();

  const captionPreview = caption.trim()
    ? caption.trim().substring(0, 60)
    : `📷 ${images.length} image${images.length > 1 ? 's' : ''}`;

  await db.runTransaction(async (tx) => {
    tx.set(msgRef, messageData);
    tx.update(db.collection('chats').doc(chatId), {
      lastMessage: { type: 'album', text: captionPreview, senderId: uid },
      lastMessageAt: FieldValue.serverTimestamp(),
    });
  });

  return { success: true, messageId: msgRef.id };
});
</file>

