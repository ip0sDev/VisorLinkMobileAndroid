// ─────────────────────────────────────────────────────────
// JOIN BY TAG
// ─────────────────────────────────────────────────────────
exports.joinByTag = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { tag } = request.data;
  if (!tag) throw new HttpsError('invalid-argument', 'Tag required');

  const cleanTag = tag.toLowerCase().replace('@', '').trim();
  const tagDoc = await db.collection('tags').doc(cleanTag).get();
  if (!tagDoc.exists) throw new HttpsError('not-found', 'Channel not found');

  const { chatId, type } = tagDoc.data();
  if (type !== 'channel') throw new HttpsError('permission-denied', 'Groups require an invite link');

  const chatDoc = await db.collection('chats').doc(chatId).get();
  if (!chatDoc.exists) throw new HttpsError('not-found', 'Chat not found');
  const chat = chatDoc.data();

  if (!chat.settings?.joinByTag)
    throw new HttpsError('permission-denied', 'This channel is not joinable by tag');

  const memberDoc = await db.collection('chats').doc(chatId).collection('members').doc(uid).get();
  if (memberDoc.exists && !memberDoc.data().banned) return { success: true, chatId };
  if (memberDoc.exists && memberDoc.data().banned)
    throw new HttpsError('permission-denied', 'You are banned from this channel');

  const userDoc = await db.collection('users').doc(uid).get();
  if (!userDoc.exists) throw new HttpsError('not-found', 'User not found');

  const batch = db.batch();
  batch.set(
    db.collection('chats').doc(chatId).collection('members').doc(uid),
    {
      uid, role: 'member',
      joinedAt: FieldValue.serverTimestamp(),
      muted: false, mutedUntil: null,
      mediaRestricted: false,
      banned: false, bannedAt: null, bannedBy: null,
    }
  );
  batch.update(db.collection('chats').doc(chatId), {
    memberCount: FieldValue.increment(1),
    memberIds: FieldValue.arrayUnion(uid),
  });
  await batch.commit();
  return { success: true, chatId };
});

