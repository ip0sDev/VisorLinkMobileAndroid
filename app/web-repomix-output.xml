/* Emoji / Reactions */
.emoji-picker { position: absolute; bottom: calc(100% + 6px); display: flex; gap: 2px; background: var(--acrylic-panel); backdrop-filter: var(--acrylic-blur); -webkit-backdrop-filter: var(--acrylic-blur); box-shadow: var(--neo-shadow-out), 0 0 20px rgba(0,0,0,0.3); border: 0.5px solid var(--border2); border-radius: 14px; padding: 6px 8px; z-index: 60; animation: picker-in 0.15s cubic-bezier(0.16,1,0.3,1); white-space: nowrap; }
