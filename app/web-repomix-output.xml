<file path="scripts/migrate-storage-to-cdn.cjs">
// scripts/migrate-storage-to-cdn.cjs
const { initializeApp, cert } = require('firebase-admin/app');
const { getStorage } = require('firebase-admin/storage');
const fs = require('fs');
const path = require('path');

const serviceAccount = require('./serviceAccount.json');

initializeApp({
  credential: cert(serviceAccount),
  storageBucket: "visorlink-f9484.firebasestorage.app" // Твой бакет
});

const bucket = getStorage().bucket();
const OUT_DIR = path.join(__dirname, '../cdn_migration_out');
const FILES_DIR = path.join(OUT_DIR, 'files');

if (!fs.existsSync(FILES_DIR)) {
  fs.mkdirSync(FILES_DIR, { recursive: true });
}

async function run() {
  console.log('🚀 Начинаем дамп Firebase Storage...');
  const [files] = await bucket.getFiles();
  const manifest = [];

  let count = 0;
  for (const file of files) {
    const filePath = file.name;
    
    // Пропускаем дефолтные ассеты Firebase
    if (filePath.startsWith('defaults/') || filePath.startsWith('public/')) continue;

    const fileName = path.basename(filePath);
    // Делаем уникальное имя для локального сохранения, чтобы избежать коллизий
    const localFileName = `${Date.now()}_${count}_${fileName}`;
    const localFilePath = path.join(FILES_DIR, localFileName);

    console.log(`Скачиваем [${count + 1}/${files.length}]: ${filePath}`);
    
    await file.download({ destination: localFilePath });
    const [metadata] = await file.getMetadata();

    manifest.push({
      original_storage_path: filePath,
      local_file: localFileName,
      content_type: metadata.contentType || 'application/octet-stream',
      size: metadata.size,
      created_at: metadata.timeCreated
    });

    count++;
  }

  fs.writeFileSync(
    path.join(OUT_DIR, 'manifest.json'),
    JSON.stringify(manifest, null, 2)
  );

  console.log(`✅ Дамп завершен! Скачано файлов: ${count}`);
  console.log(`📁 Папка с данными: ${OUT_DIR}`);
}

run().catch(console.error);
</file>

<file path="scripts/patch-avatars.cjs">
const { initializeApp, cert, getApps } = require('firebase-admin/app');
const { getFirestore } = require('firebase-admin/firestore');
const fs = require('fs');
const path = require('path');

const serviceAccount = require('./serviceAccount.json');

// Правильная проверка инициализации
if (getApps().length === 0) {
  initializeApp({ credential: cert(serviceAccount) });
}

const db = getFirestore();
const mappingPath = path.join(__dirname, 'mapping.json');
const mapping = JSON.parse(fs.readFileSync(mappingPath, 'utf8'));

function extractStoragePath(url) {
  if (!url || !url.includes('firebasestorage.googleapis.com')) return null;
  try {
    const oPath = new URL(url).pathname; 
    const parts = oPath.split('/o/');
    if (parts.length < 2) return null;
    return decodeURIComponent(parts[1].split('?')[0]);
  } catch { return null; }
}

async function run() {
  console.log('🛠 Начинаем патч закэшированных аватарок...');
  let updatedCount = 0;

  // 1. Патчим participantData в чатах
  const chats = await db.collection('chats').get();
  for (const chatDoc of chats.docs) {
    const chatData = chatDoc.data();
    if (chatData.participantData) {
      let changed = false;
      const newPData = { ...chatData.participantData };
      
      for (const [uid, p] of Object.entries(newPData)) {
        if (p.avatarUrl) {
          const sp = extractStoragePath(p.avatarUrl);
          if (sp && mapping[sp]) {
            newPData[uid] = { ...p, avatarUrl: mapping[sp].publicUrl };
            changed = true;
          }
        }
      }
      
      if (changed) {
        await chatDoc.ref.update({ participantData: newPData });
        updatedCount++;
      }
    }
  }

  // 2. Патчим channelData в discover_feed
  const feedDocs = await db.collection('discover_feed').get();
  for (const doc of feedDocs.docs) {
    const data = doc.data();
    if (data.channelData?.avatarUrl) {
      const sp = extractStoragePath(data.channelData.avatarUrl);
      if (sp && mapping[sp]) {
        await doc.ref.update({ 'channelData.avatarUrl': mapping[sp].publicUrl });
        updatedCount++;
      }
    }
  }

  console.log(`✅ Патч завершен! Обновлено документов: ${updatedCount}`);
}

run().catch(console.error);
</file>

<file path="scripts/update-firestore-cdn.cjs">
// scripts/update-firestore-cdn.cjs
const { initializeApp, cert } = require('firebase-admin/app');
const { getFirestore } = require('firebase-admin/firestore');
const fs = require('fs');
const path = require('path');

const serviceAccount = require('./serviceAccount.json');
initializeApp({ credential: cert(serviceAccount) });

const db = getFirestore();
const mappingPath = path.join(__dirname, 'mapping.json');
const mapping = JSON.parse(fs.readFileSync(mappingPath, 'utf8'));

// Хелпер: достает storagePath из URL Firebase Storage, если его нет в документе
function extractStoragePath(url) {
  if (!url || !url.includes('firebasestorage.googleapis.com')) return null;
  try {
    const oPath = new URL(url).pathname; 
    const parts = oPath.split('/o/');
    if (parts.length < 2) return null;
    return decodeURIComponent(parts[1].split('?')[0]);
  } catch { return null; }
}

async function run() {
  console.log('🚀 Начинаем обновление Firestore...');
  let updatedCount = 0;

  // 1. Обновляем Users (Аватары и Кастомизация)
  console.log('Обновляем коллекцию users...');
  const users = await db.collection('users').get();
  for (const doc of users.docs) {
    const data = doc.data();
    let updates = {};

    // Аватар
    if (data.avatarUrl) {
      const sp = extractStoragePath(data.avatarUrl);
      if (sp && mapping[sp]) updates.avatarUrl = mapping[sp].publicUrl;
    }
    // Кастомизация
    if (data.customization) {
      if (data.customization.bgUrl) {
        const sp = extractStoragePath(data.customization.bgUrl);
        if (sp && mapping[sp]) updates['customization.bgUrl'] = mapping[sp].publicUrl;
      }
      if (data.customization.gifUrl) {
        const sp = extractStoragePath(data.customization.gifUrl);
        if (sp && mapping[sp]) updates['customization.gifUrl'] = mapping[sp].publicUrl;
      }
    }
    if (Object.keys(updates).length > 0) {
      await doc.ref.update(updates);
      updatedCount++;
    }
  }

  // 2. Обновляем Chats (Аватары) и вложенные коллекции
  console.log('Обновляем чаты, обои, сообщения и комментарии...');
  const chats = await db.collection('chats').get();
  
  for (const chatDoc of chats.docs) {
    const chatData = chatDoc.data();
    
    // Аватар чата
    if (chatData.avatarUrl) {
      const sp = extractStoragePath(chatData.avatarUrl);
      if (sp && mapping[sp]) {
        await chatDoc.ref.update({ avatarUrl: mapping[sp].publicUrl });
        updatedCount++;
      }
    }

    // Обои чата
    const wallpapers = await chatDoc.ref.collection('wallpapers').get();
    for (const wpDoc of wallpapers.docs) {
      const wpData = wpDoc.data();
      const sp = wpData.storagePath || extractStoragePath(wpData.url);
      if (sp && mapping[sp]) {
        await wpDoc.ref.update({
          url: mapping[sp].publicUrl,
          storagePath: mapping[sp].mediaId // Заменяем storagePath на mediaId для единообразия
        });
        updatedCount++;
      }
    }

    // Сообщения чата
    const messages = await chatDoc.ref.collection('messages').get();
    for (const msgDoc of messages.docs) {
      const msgData = msgDoc.data();
      let msgUpdates = {};

      // Одиночные медиа (фото, видео, гс)
      const sp = msgData.storagePath || extractStoragePath(msgData.url);
      if (sp && mapping[sp]) {
        msgUpdates.cdnMediaId = mapping[sp].mediaId;
        // Опционально: можно удалить старый url/storagePath:
        // msgUpdates.url = FieldValue.delete();
      }

      // Альбомы
      if (msgData.type === 'album' && Array.isArray(msgData.images)) {
        let changed = false;
        const newImages = msgData.images.map(img => {
          const imgSp = img.storagePath || extractStoragePath(img.url);
          if (imgSp && mapping[imgSp]) {
            changed = true;
            return { ...img, cdnMediaId: mapping[imgSp].mediaId };
          }
          return img;
        });
        if (changed) msgUpdates.images = newImages;
      }

      if (Object.keys(msgUpdates).length > 0) {
        await msgDoc.ref.update(msgUpdates);
        updatedCount++;
      }

      // Комментарии к сообщению
      const comments = await msgDoc.ref.collection('comments').get();
      for (const cmtDoc of comments.docs) {
        const cmtData = cmtDoc.data();
        const csp = cmtData.storagePath || extractStoragePath(cmtData.url);
        if (csp && mapping[csp]) {
          await cmtDoc.ref.update({ cdnMediaId: mapping[csp].mediaId });
          updatedCount++;
        }
      }
    }
  }

  // 3. Обновляем Saved Messages
  console.log('Обновляем Избранное (Saved Messages)...');
  const savedUsers = await db.collection('savedMessages').get();
  for (const userDoc of savedUsers.docs) {
    const savedMsgs = await userDoc.ref.collection('messages').get();
    for (const msgDoc of savedMsgs.docs) {
      const msgData = msgDoc.data();
      const sp = msgData.storagePath || extractStoragePath(msgData.url);
      if (sp && mapping[sp]) {
        await msgDoc.ref.update({ cdnMediaId: mapping[sp].mediaId });
        updatedCount++;
      }
    }
  }

  console.log(`✅ Firestore обновлен! Изменено документов: ${updatedCount}`);
}

run().catch(console.error);
</file>

