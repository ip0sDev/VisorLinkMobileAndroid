<file path="src/components/GroupSettingsModal.jsx">
// src/components/GroupSettingsModal.jsx
import { useState, useEffect, useRef } from 'react';
import { db } from '../firebase/config';
import { useAuth } from '../contexts/AuthContext';
import { useI18n } from '../contexts/I18nContext';
import { doc,collection, onSnapshot, updateDoc } from 'firebase/firestore';
import { getFunctions, httpsCallable } from 'firebase/functions';
import ChannelBotKeys from './ChannelBotKeys';
import { uploadToCdn, getPublicCdnUrl } from '../hooks/useCdn';

const fn = getFunctions(undefined, 'europe-west1');
const moderateFn   = httpsCallable(fn, 'moderateUser');
const setRoleFn    = httpsCallable(fn, 'setMemberRole');
const updateChatFn = httpsCallable(fn, 'updateChatSettings');
const regenLinkFn  = httpsCallable(fn, 'regenerateInviteLink');
const inviteUserFn = httpsCallable(fn, 'inviteUser');
const leaveChatFn  = httpsCallable(fn, 'leaveChat');

export default function GroupSettingsModal({ chatId, chatData, onClose }) {
  const { user } = useAuth();
  const { t } = useI18n();
  const [tab, setTab] = useState('info');
  const [members, setMembers] = useState([]);
  const [myRole, setMyRole] = useState('member');

  const [name, setName] = useState(chatData?.name || '');
  const [tag, setTag] = useState(chatData?.tag || '');
  const [description, setDescription] = useState(chatData?.description || '');
  const [avatarUrl, setAvatarUrl] = useState(chatData?.avatarUrl || null);
  const [settings, setSettings] = useState(chatData?.settings || {});

  const [inviteUsername, setInviteUsername] = useState('');
  const [saving, setSaving] = useState(false);
  const [avatarUploading, setAvatarUploading] = useState(false);
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');
  const avatarInputRef = useRef();

  const isChannel = chatData?.type === 'channel';
  const isAdmin   = ['admin', 'owner'].includes(myRole);
  const isOwner   = myRole === 'owner';

  useEffect(() => {
    if (!chatId) return;
    const unsub = onSnapshot(
      collection(db, 'chats', chatId, 'members'),
      snap => {
        const list = snap.docs.map(d => ({ uid: d.id, ...d.data() }));
        setMembers(list);
        const me = list.find(m => m.uid === user.uid);
        setMyRole(me?.role || 'member');
      }
    );
    return unsub;
  }, [chatId]);

  async function handleSaveInfo() {
    setSaving(true); setError(''); setSuccess('');
    try {
      await updateChatFn({ chatId, name, tag, description, settings });
      setSuccess(t('group.save'));
      setTimeout(() => setSuccess(''), 3000);
    } catch (e) { setError(e.message); }
    setSaving(false);
  }

  async function handleAvatarUpload(e) {
    const file = e.target.files[0];
    if (!file) return;
    setAvatarUploading(true);
    setError('');
    try {
      const mediaId = await uploadToCdn(file, false, `group_avatar_${chatId}_${Date.now()}`);
      const url = getPublicCdnUrl(mediaId);
      setAvatarUrl(url);
      await updateChatFn({ chatId, avatarUrl: url });
      setSuccess('Аватар обновлён');
      setTimeout(() => setSuccess(''), 3000);
    } catch (err) { setError(err.message); }
    setAvatarUploading(false);
    e.target.value = '';
  }

  async function handleRemoveAvatar() {
    if (!window.confirm('Удалить аватар?')) return;
    setAvatarUploading(true);
    setError('');
    try {
      await updateChatFn({ chatId, avatarUrl: null });
      setAvatarUrl(null);
      setSuccess('Аватар удалён');
      setTimeout(() => setSuccess(''), 3000);
    } catch (err) { setError(err.message); }
    setAvatarUploading(false);
  }

  async function handleRegenLink() {
    try {
      const res = await regenLinkFn({ chatId });
      setSettings(prev => ({ ...prev, inviteLink: res.data.inviteLink }));
      setSuccess(t('general.copied'));
      setTimeout(() => setSuccess(''), 3000);
    } catch (e) { setError(e.message); }
  }

  async function handleInvite(e) {
    e.preventDefault();
    setError(''); setSaving(true);
    try {
      await inviteUserFn({ chatId, targetUsername: inviteUsername });
      setInviteUsername('');
      setTimeout(() => setSuccess(''), 3000);
    } catch (e) { setError(e.message); }
    setSaving(false);
  }

  async function handleModerate(targetUid, action, durationMinutes) {
    setError('');
    try { await moderateFn({ chatId, targetUid, action, durationMinutes }); }
    catch (e) { setError(e.message); }
  }

  async function handleSetRole(targetUid, role) {
    setError('');
    try { await setRoleFn({ chatId, targetUid, role }); }
    catch (e) { setError(e.message); }
  }

  async function handleLeave() {
    if (!window.confirm('Leave this chat?')) return;
    try { await leaveChatFn({ chatId }); onClose(); }
    catch (e) { setError(e.message); }
  }

  const inviteUrl = settings.inviteLink
    ? `${window.location.origin}/join/${settings.inviteLink}`
    : '';

  return (
    <div className="modal-overlay" onClick={onClose}>
      <div className="modal settings-modal group-settings-modal" onClick={e => e.stopPropagation()}>
        <div className="modal-header">
          <h3>{isChannel ? t('channel.settings') : t('group.settings')}</h3>
          <button className="modal-close" onClick={onClose}>✕</button>
        </div>

        <div className="settings-tabs">
          <button className={`settings-tab ${tab === 'info' ? 'active' : ''}`} onClick={() => setTab('info')}>
            {t('group.tab.info')}
          </button>
          <button className={`settings-tab ${tab === 'members' ? 'active' : ''}`} onClick={() => setTab('members')}>
            {t('group.tab.members')} ({members.length})
          </button>
          {isAdmin && !isChannel && (
            <button className={`settings-tab ${tab === 'moderation' ? 'active' : ''}`} onClick={() => setTab('moderation')}>
              {t('group.tab.moderate')}
            </button>
          )}
          {isChannel && isOwner && (
            <button className={`settings-tab ${tab === 'automation' ? 'active' : ''}`} onClick={() => setTab('automation')}>
              🤖 Автоматизация
            </button>
          )}
        </div>

        {tab === 'info' && (
          <div className="settings-body">

            <div className="avatar-section">
              <div className="settings-avatar-wrap">
                <div
                  className="settings-avatar"
                  onClick={() => isAdmin && !avatarUploading && avatarInputRef.current?.click()}
                  style={{ cursor: isAdmin ? 'pointer' : 'default' }}
                >
                  {avatarUploading ? (
                    <div className="avatar-uploading-spinner" />
                  ) : avatarUrl ? (
                    <img src={avatarUrl} alt="" className="settings-avatar-img" />
                  ) : (
                    <span>{name?.[0]?.toUpperCase()}</span>
                  )}
                  {isAdmin && !avatarUploading && (
                    <div className="settings-avatar-overlay">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                        <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
                        <polyline points="17 8 12 3 7 8"/>
                        <line x1="12" y1="3" x2="12" y2="15"/>
                      </svg>
                    </div>
                  )}
                </div>

                {isAdmin && (
                  <div className="avatar-btn-group">
                    <button
                      type="button"
                      className="avatar-change-btn"
                      onClick={() => avatarInputRef.current?.click()}
                      disabled={avatarUploading}
                    >
                      {avatarUploading ? 'Загрузка…' : 'Сменить фото'}
                    </button>
                    {avatarUrl && (
                      <button
                        type="button"
                        className="avatar-remove-btn"
                        onClick={handleRemoveAvatar}
                        disabled={avatarUploading}
                        title="Удалить аватар"
                      >
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.2" strokeLinecap="round">
                          <polyline points="3 6 5 6 21 6"/>
                          <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                        </svg>
                      </button>
                    )}
                  </div>
                )}
              </div>

              <div className="avatar-section-info">
                <div className="avatar-hint">{name}</div>
                <div className="found-meta">{chatData?.memberCount} {t('chat.members')} · {chatData?.type}</div>
                {isAdmin && (
                  <div className="avatar-hint-sub">
                    {avatarUrl ? 'Нажмите на аватар или кнопку для замены' : 'Добавьте фото группы/канала'}
                  </div>
                )}
              </div>
            </div>

            <input
              ref={avatarInputRef}
              type="file"
              accept="image/*"
              style={{ display: 'none' }}
              onChange={handleAvatarUpload}
            />

            <div className="input-group">
              <label>{t('group.name')}</label>
              <input type="text" value={name} onChange={e => setName(e.target.value)} disabled={!isAdmin} maxLength={48} />
            </div>

            <div className="input-group">
              <label>{t('group.tag')}</label>
              <div className="input-with-prefix">
                <span className="prefix">@</span>
                <input type="text" value={tag} onChange={e => setTag(e.target.value.replace(/[^a-zA-Z0-9_]/g, ''))} disabled={!isAdmin} maxLength={24} />
              </div>
            </div>

            <div className="input-group">
              <label>{t('group.description')}</label>
              <textarea className="settings-bio" value={description} onChange={e => setDescription(e.target.value)} disabled={!isAdmin} maxLength={160} rows={2} />
            </div>

            {isChannel && isAdmin && (
              <div className="settings-toggles">
                <div className="settings-toggle-row">
                  <div>
                    <div className="settings-toggle-label">{t('group.join.tag')}</div>
                    <div className="settings-toggle-sub">{t('group.join.tag.sub')}</div>
                  </div>
                  <label className="toggle-switch">
                    <input type="checkbox" checked={settings.joinByTag || false}
                      onChange={e => setSettings(p => ({ ...p, joinByTag: e.target.checked }))} />
                    <span className="toggle-track" />
                  </label>
                </div>
                <div className="settings-toggle-row">
                  <div>
                    <div className="settings-toggle-label">{t('group.reactions')}</div>
                    <div className="settings-toggle-sub">{t('group.reactions.sub')}</div>
                  </div>
                  <label className="toggle-switch">
                    <input type="checkbox" checked={settings.allowReactions !== false}
                      onChange={e => setSettings(p => ({ ...p, allowReactions: e.target.checked }))} />
                    <span className="toggle-track" />
                  </label>
                </div>
                <div className="settings-toggle-row">
                  <div>
                    <div className="settings-toggle-label">{t('group.comments')}</div>
                    <div className="settings-toggle-sub">{t('group.comments.sub')}</div>
                  </div>
                  <label className="toggle-switch">
                    <input type="checkbox" checked={settings.allowComments !== false}
                      onChange={e => setSettings(p => ({ ...p, allowComments: e.target.checked }))} />
                    <span className="toggle-track" />
                  </label>
                </div>
                <div className="settings-row">
                  <div>
                    <div className="settings-row-label">{t('group.noForwards')}</div>
                    <div className="settings-row-sub">{t('group.noForwards.sub')}</div>
                  </div>
                  <button
                      className={`toggle-btn ${chatData?.settings?.noForwards ? 'on' : ''}`}
                      onClick={async () => {
                        const newVal = !chatData?.settings?.noForwards;
                        await updateDoc(doc(db, 'chats', chatId), {
                          'settings.noForwards': newVal,
                        });
                      }}
                  >
                    <span className="toggle-knob" />
                  </button>
                </div>
              </div>
            )}

            {!isChannel && isAdmin && (
              <div className="settings-toggles">
                <div className="settings-toggle-row">
                  <div>
                    <div className="settings-toggle-label">{t('group.invite.active')}</div>
                    <div className="settings-toggle-sub">{t('group.invite.sub')}</div>
                  </div>
                  <label className="toggle-switch">
                    <input type="checkbox" checked={settings.joinByLink !== false}
                      onChange={e => setSettings(p => ({ ...p, joinByLink: e.target.checked }))} />
                    <span className="toggle-track" />
                  </label>
                </div>
              </div>
            )}

            {isAdmin && inviteUrl && (
              <div className="invite-link-box">
                <div className="invite-link-label">{t('group.invite.label')}</div>
                <div className="invite-link-row">
                  <input className="invite-link-input" value={inviteUrl} readOnly onClick={e => e.target.select()} />
                  <button type="button" className="icon-btn" onClick={() => navigator.clipboard.writeText(inviteUrl)} title={t('group.invite.copy')}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                      <rect x="9" y="9" width="13" height="13" rx="2"/>
                      <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                    </svg>
                  </button>
                  <button type="button" className="icon-btn" onClick={handleRegenLink} title={t('group.invite.reset')} style={{ color: 'var(--danger)' }}>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                      <polyline points="1 4 1 10 7 10"/>
                      <path d="M3.51 15a9 9 0 102.13-9.36L1 10"/>
                    </svg>
                  </button>
                </div>
              </div>
            )}

            {error && <div className="auth-error">{error}</div>}
            {success && <div className="settings-success">{success}</div>}

            {isAdmin && (
              <button className="btn-primary" onClick={handleSaveInfo} disabled={saving}>
                {saving ? t('group.saving') : t('group.save')}
              </button>
            )}

            {myRole !== 'owner' && (
              <button
                className="account-action-btn danger"
                onClick={handleLeave}
                style={{ marginTop: 8, justifyContent: 'center', color: 'var(--danger)' }}
              >
                {isChannel ? t('channel.leave') : t('group.leave')}
              </button>
            )}
          </div>
        )}

        {tab === 'members' && (
          <div className="settings-body">
            {!isChannel && isAdmin && (
              <form onSubmit={handleInvite} className="add-account-form" style={{ marginBottom: 16 }}>
                <div style={{ fontSize: 11, fontWeight: 600, letterSpacing: '0.06em', textTransform: 'uppercase', color: 'var(--text3)', fontFamily: 'var(--font-mono)', marginBottom: 6 }}>
                  {t('member.invite')}
                </div>
                <div className="input-with-prefix">
                  <span className="prefix">@</span>
                  <input type="text" placeholder={t('auth.username')} value={inviteUsername}
                    onChange={e => setInviteUsername(e.target.value)} />
                </div>
                <button type="submit" className="btn-primary" disabled={saving || !inviteUsername}>
                  {saving ? t('member.sending') : t('member.send.invite')}
                </button>
              </form>
            )}

            {error && <div className="auth-error">{error}</div>}
            {success && <div className="settings-success">{success}</div>}

            <div className="member-list">
              {members
                .filter(m => !m.banned)
                .sort((a, b) => {
                  const order = { owner: 0, admin: 1, member: 2 };
                  return (order[a.role] || 2) - (order[b.role] || 2);
                })
                .map(member => (
                  <MemberRow
                    key={member.uid}
                    member={member}
                    isMe={member.uid === user.uid}
                    myRole={myRole}
                    onModerate={handleModerate}
                    onSetRole={handleSetRole}
                  />
                ))}
            </div>
          </div>
        )}

        {tab === 'moderation' && isAdmin && !isChannel && (
          <div className="settings-body">
            <p style={{ fontSize: 13, color: 'var(--text2)', marginBottom: 12 }}>
              {t('group.tab.moderate')}
            </p>
            {error && <div className="auth-error">{error}</div>}
            <div className="member-list">
              {members
                .filter(m => m.muted || m.mediaRestricted || m.banned)
                .map(member => (
                  <MemberRow
                    key={member.uid}
                    member={member}
                    isMe={false}
                    myRole={myRole}
                    showModActions
                    onModerate={handleModerate}
                    onSetRole={handleSetRole}
                  />
                ))}
              {members.filter(m => m.muted || m.mediaRestricted || m.banned).length === 0 && (
                <p style={{ fontSize: 13, color: 'var(--text3)', textAlign: 'center', padding: '20px 0' }}>
                  {t('member.noRestricted')}
                </p>
              )}
            </div>
          </div>
        )}

        {tab === 'automation' && isChannel && isOwner && (
          <div className="settings-body">
            <ChannelBotKeys chatId={chatId} />
          </div>
        )}

      </div>
    </div>
  );
}

function MemberRow({ member, isMe, myRole, onModerate, onSetRole }) {
  const { t } = useI18n();
  const [showMenu, setShowMenu] = useState(false);
  const canModerate = ['admin', 'owner'].includes(myRole) && !isMe && member.role !== 'owner';
  const canSetRole  = myRole === 'owner' && !isMe && member.role !== 'owner';

  const roleBadge = {
    owner:  { label: t('member.role.owner'), color: 'var(--warn)' },
    admin:  { label: t('member.role.admin'), color: 'var(--accent)' },
    member: null,
  };

  return (
    <div className="member-row">
      <div className="avatar sm" style={{ flexShrink: 0 }}>
        {member.avatarUrl
          ? <img src={member.avatarUrl} alt="" style={{ width: '100%', height: '100%', borderRadius: '50%', objectFit: 'cover' }} />
          : member.displayName?.[0]?.toUpperCase() || member.uid[0].toUpperCase()
        }
      </div>
      <div className="member-info">
        <div className="member-name">
          {member.displayName || member.uid}
          {roleBadge[member.role] && (
            <span className="member-role-badge" style={{ color: roleBadge[member.role].color }}>
              {roleBadge[member.role].label}
            </span>
          )}
          {isMe && <span className="member-role-badge" style={{ color: 'var(--text3)' }}>{t('member.role.you')}</span>}
        </div>
        <div className="member-status">
          {member.muted          && <span className="mod-tag muted">{t('member.muted')}</span>}
          {member.mediaRestricted && <span className="mod-tag restricted">{t('member.restricted')}</span>}
          {member.banned         && <span className="mod-tag banned">{t('member.banned')}</span>}
        </div>
      </div>

      {(canModerate || canSetRole) && (
        <div className="member-actions">
          <button className="icon-btn" onClick={() => setShowMenu(v => !v)} title="Actions">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <circle cx="12" cy="5" r="1" fill="currentColor"/>
              <circle cx="12" cy="12" r="1" fill="currentColor"/>
              <circle cx="12" cy="19" r="1" fill="currentColor"/>
            </svg>
          </button>

          {showMenu && (
            <div className="member-menu" onClick={() => setShowMenu(false)}>
              {canSetRole && !['admin', 'owner'].includes(member.role) && (
                <button onClick={() => onSetRole(member.uid, 'admin')}>{t('member.promote')}</button>
              )}
              {canSetRole && member.role === 'admin' && (
                <button onClick={() => onSetRole(member.uid, 'member')}>{t('member.demote')}</button>
              )}
              {canModerate && !member.muted && (
                <>
                  <button onClick={() => onModerate(member.uid, 'mute', 60)}>{t('member.mute.1h')}</button>
                  <button onClick={() => onModerate(member.uid, 'mute', 1440)}>{t('member.mute.24h')}</button>
                  <button onClick={() => onModerate(member.uid, 'mute', null)}>{t('member.mute.forever')}</button>
                </>
              )}
              {canModerate && member.muted && (
                <button onClick={() => onModerate(member.uid, 'unmute')}>{t('member.unmute')}</button>
              )}
              {canModerate && !member.mediaRestricted && (
                <button onClick={() => onModerate(member.uid, 'restrictMedia')}>{t('member.restrict')}</button>
              )}
              {canModerate && member.mediaRestricted && (
                <button onClick={() => onModerate(member.uid, 'unrestrictMedia')}>{t('member.unrestrict')}</button>
              )}
              {canModerate && !member.banned && (
                <button className="danger" onClick={() => onModerate(member.uid, 'ban')}>{t('member.ban')}</button>
              )}
              {canModerate && member.banned && (
                <button onClick={() => onModerate(member.uid, 'unban')}>{t('member.unban')}</button>
              )}
            </div>
          )}
        </div>
      )}
    </div>
  );
}
