// src/components/ChannelBotKeys.jsx
import { useState, useEffect } from 'react';
import { getFunctions, httpsCallable } from 'firebase/functions';

const fn = getFunctions(undefined, 'europe-west1');
const listKeysFn   = httpsCallable(fn, 'listChannelBotKeys');
const createKeyFn  = httpsCallable(fn, 'createChannelBotKey');
const revokeKeyFn  = httpsCallable(fn, 'revokeChannelBotKey');
const regenKeyFn   = httpsCallable(fn, 'regenerateChannelBotKey');

// ── One-time secret reveal modal ─────────────────────────────────────────────
function SecretModal({ chatId, apiKey, keyId, onClose }) {
  const [copied, setCopied] = useState(false);

  const webhookUrl =
    `https://europe-west1-visorlink-f9484.cloudfunctions.net/channelBotWebhook`;

