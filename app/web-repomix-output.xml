  const handleDownloadSingle = async (mediaId, fileName) => {
    try {
        const url = await getCdnUrl(mediaId);
        const a = document.createElement('a');
        a.href = url;
        a.download = fileName || mediaId;
        a.target = '_blank';
        document.body.appendChild(a);
        a.click();
        a.remove();
    } catch (e) { alert("Ошибка скачивания: " + e.message); }
  };

  const handleDeleteMedia = async (id) => {
    if (!window.confirm('Удалить этот файл навсегда? Он исчезнет из всех чатов, а место вернется в вашу квоту.')) return;
    setMediaList(prev => prev.filter(m => m.id !== id));
    try {
        await deleteCdnMedia(id);
        getCdnStats().then(setCdnStats);
    } catch (e) {
        alert(`Ошибка удаления файла: ${e.message}`);
        getUserMediaList().then(setMediaList);
    }
  };

