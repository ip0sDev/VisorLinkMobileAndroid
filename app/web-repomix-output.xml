// ─────────────────────────────────────────────────────────
// MODERATION
// ─────────────────────────────────────────────────────────
exports.moderateUser = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { chatId, targetUid, action, durationMinutes } = request.data;

  if (durationMinutes !== undefined && (typeof durationMinutes !== 'number' || durationMinutes < 0 || durationMinutes > 525600)) {
    throw new HttpsError('invalid-argument', 'durationMinutes must be a positive number <= 525600 (1 year)');
  }

  if (!chatId || !targetUid || !action)
    throw new HttpsError('invalid-argument', 'chatId, targetUid and action required');

  await assertMember(chatId, uid, 'admin');

  const myData = await db.collection('chats').doc(chatId).collection('members').doc(uid).get();
  const targetData = await db.collection('chats').doc(chatId).collection('members').doc(targetUid).get();

  if (!targetData.exists) throw new HttpsError('not-found', 'Target user not found');

  const targetRole = targetData.data().role;
  const myRole = myData.data().role;

  if (targetRole === 'owner') throw new HttpsError('permission-denied', 'Cannot moderate owner');
  if (targetRole === 'admin' && myRole !== 'owner')
    throw new HttpsError('permission-denied', 'Only owner can moderate admins');

  const updates = {};
  const now = new Date();

  switch (action) {
    case 'mute':
      updates.muted = true;
      updates.mutedUntil = durationMinutes ? new Date(now.getTime() + durationMinutes * 60000) : null;
      break;
    case 'unmute':
      updates.muted = false;
      updates.mutedUntil = null;
      break;
    case 'restrictMedia':
      updates.mediaRestricted = true;
      break;
    case 'unrestrictMedia':
      updates.mediaRestricted = false;
      break;
    case 'ban':
      updates.banned = true;
      updates.bannedAt = now;
      updates.bannedBy = uid;
      break;
    case 'unban':
      updates.banned = false;
      updates.bannedAt = null;
      updates.bannedBy = null;
      break;
    default:
      throw new HttpsError('invalid-argument', `Unknown action: ${action}`);
  }

  await db.collection('chats').doc(chatId).collection('members').doc(targetUid).update(updates);

  if (action === 'ban') {
    await db.collection('chats').doc(chatId).update({
      memberCount: FieldValue.increment(-1),
      memberIds: FieldValue.arrayRemove(targetUid),
    });
  }
  if (action === 'unban') {
    await db.collection('chats').doc(chatId).update({
      memberCount: FieldValue.increment(1),
      memberIds: FieldValue.arrayUnion(targetUid),
    });
  }

  return { success: true };
});

