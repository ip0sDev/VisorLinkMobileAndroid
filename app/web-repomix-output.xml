      await loadBots();
    } catch (e) { alert(e.message); setBotsLoading(false); }
  }

  async function handleRegenBotToken(botUid) {
    if (!window.confirm('Вы уверены, что хотите сгенерировать новый токен? Старый перестанет работать немедленно.')) return;
    setSaving(true);
    try {
