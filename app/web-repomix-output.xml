exports.redeemGift = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { chatId, messageId } = request.data;

  const msgRef = db.collection('chats').doc(chatId).collection('messages').doc(messageId);
  
  await db.runTransaction(async (tx) => {
    const msgDoc = await tx.get(msgRef);
    if (!msgDoc.exists) throw new HttpsError('not-found', 'Message not found');
    const msgData = msgDoc.data();
    
    if (msgData.type !== 'gift') throw new HttpsError('invalid-argument', 'Not a gift');
    if (msgData.redeemed) throw new HttpsError('failed-precondition', 'Подарок уже открыт!');

    const userRef = db.collection('users').doc(uid);
    const userDoc = await tx.get(userRef);
    const userData = userDoc.data();

    const now = Date.now();
    const PRO_DURATION_MS = 30 * 24 * 60 * 60 * 1000;
    
    const ETERNAL_YEAR = 2090;
    const isEternal = userData.proUntil && userData.proUntil.toDate().getFullYear() > ETERNAL_YEAR;
    
    let newProUntil = userData.proUntil?.toDate() || new Date();
    if (!isEternal) {
      newProUntil = (userData.proUntil && userData.proUntil.toDate().getTime() > now)
        ? new Date(userData.proUntil.toDate().getTime() + PRO_DURATION_MS)
        : new Date(now + PRO_DURATION_MS);
      tx.update(userRef, { proUntil: newProUntil });
    }

    tx.update(msgRef, { 
      redeemed: true, 
      redeemedByUid: uid, 
      redeemedByUsername: userData.username,
      redeemedAt: FieldValue.serverTimestamp()
    });
  });

  return { success: true };
});
