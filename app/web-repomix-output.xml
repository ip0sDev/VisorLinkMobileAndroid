import { useState } from 'react';
import { useAuth } from '../contexts/AuthContext';
import { useAccounts } from '../contexts/AccountsContext';
import { useI18n } from '../contexts/I18nContext';

const MODES = { list: 'list', login: 'login', register: 'register' };

export default function AccountSwitcher({ onClose }) {
  const { user, switchAccount, logout, login, register } = useAuth();
  const { accounts, removeAccount } = useAccounts();
  const { t } = useI18n();
  const [mode, setMode] = useState(MODES.list);
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [username, setUsername] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  function resetForm() {
    setEmail(''); setPassword(''); setUsername(''); setError('');
  }
  function goTo(m) { resetForm(); setMode(m); }

  async function handleSwitch(uid) {
    if (uid === user?.uid || loading) return;
    setLoading(true);
    try { await switchAccount(uid); onClose(); }
    catch (e) { setError(e.message); }
    setLoading(false);
  }

  async function handleLogin(e) {
    e.preventDefault();
    setError(''); setLoading(true);
    try { await login(email, password); onClose(); }
    catch (e) { setError(e.message); }
    setLoading(false);
  }

  async function handleRegister(e) {
    e.preventDefault();
    setError(''); setLoading(true);
    try {
      if (username.length < 3) throw new Error('Username must be at least 3 characters');
      if (!/^[a-zA-Z0-9_]+$/.test(username)) throw new Error('Letters, numbers and underscores only');
      await register(email, password, username);
      onClose();
    } catch (e) { setError(e.message); }
    setLoading(false);
  }

  function handleRemove(e, uid) {
    e.stopPropagation();
    removeAccount(uid);
  }

  return (
    <div className="modal-overlay" onClick={onClose}>
      <div className="modal accounts-modal" onClick={e => e.stopPropagation()}>

        {/* LIST */}
        {mode === MODES.list && <>
          <div className="modal-header">
            <h3>Accounts</h3>
            <button className="modal-close" onClick={onClose}>✕</button>
          </div>

          <div className="accounts-list">
            {accounts.map(acc => {
              const isActive = acc.uid === user?.uid;
              return (
                <div
                  key={acc.uid}
                  className={`account-item ${isActive ? 'active' : ''} ${loading ? 'disabled' : ''}`}
                  onClick={() => handleSwitch(acc.uid)}
                >
                  <div className="avatar sm acc-avatar">
                    {acc.displayName?.[0]?.toUpperCase()}
                  </div>
                  <div className="account-info">
                    <div className="account-name">
                      {acc.displayName}
                      {isActive && <span className="active-badge">active</span>}
                    </div>
                    <div className="account-handle">@{acc.username}</div>
                  </div>
                  {!isActive && (
                    <button className="remove-account-btn" onClick={e => handleRemove(e, acc.uid)} title="Remove">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                        <path d="M18 6L6 18M6 6l12 12"/>
                      </svg>
                    </button>
                  )}
                </div>
              );
            })}
          </div>

          <div className="accounts-divider" />

          <div className="accounts-actions">
            <button className="account-action-btn" onClick={() => goTo(MODES.login)}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/>
              </svg>
              {t('auth.login')}
            </button>
            <button className="account-action-btn" onClick={() => goTo(MODES.register)}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
