// src/components/SavedMessagesWindow.jsx
import { useState, useEffect, useRef, useCallback } from 'react';
import { db } from '../firebase/config';
import { useAuth } from '../contexts/AuthContext';
import { useI18n } from '../contexts/I18nContext';
import {
  collection, query, orderBy, onSnapshot, limit,
  addDoc, serverTimestamp, doc, updateDoc, writeBatch,
  getDoc, setDoc
} from 'firebase/firestore';
import { format, isToday, isYesterday } from 'date-fns';
import RichText from './RichText';
import ImageEditor from './ImageEditor';
import ForwardPickerModal from './ForwardPickerModal';
import { uploadToCdn, CDN_URL } from '../hooks/useCdn';

const PAGE_SIZE = 30;

async function hashPin(pin, uid) {
  const input = `${pin}:${uid}`;
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(input));
  return Array.from(new Uint8Array(buf)).map(b => b.toString(16).padStart(2, '0')).join('');
}

async function deriveKey(pin, uid) {
  const rawKey = await crypto.subtle.importKey(
    'raw',
    new TextEncoder().encode(`${pin}:${uid}`),
    { name: 'PBKDF2' },
    false,
    ['deriveKey']
  );
  const salt = new TextEncoder().encode(uid.padEnd(16, '0').slice(0, 16));
  return crypto.subtle.deriveKey(
    { name: 'PBKDF2', salt, iterations: 200_000, hash: 'SHA-256' },
    rawKey,
    { name: 'AES-GCM', length: 256 },
    false,
    ['encrypt', 'decrypt']
  );
}

async function encryptText(plaintext, cryptoKey) {
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const cipherBuf = await crypto.subtle.encrypt(
    { name: 'AES-GCM', iv },
    cryptoKey,
    new TextEncoder().encode(plaintext)
  );
  const toB64 = buf => btoa(String.fromCharCode(...new Uint8Array(buf)));
  return {
    encryptedText: toB64(cipherBuf),
    iv: toB64(iv),
  };
}

async function decryptText(encryptedB64, ivB64, cryptoKey) {
  try {
    const fromB64 = b64 => Uint8Array.from(atob(b64), c => c.charCodeAt(0));
    const plainBuf = await crypto.subtle.decrypt(
      { name: 'AES-GCM', iv: fromB64(ivB64) },
      cryptoKey,
      fromB64(encryptedB64)
    );
    return new TextDecoder().decode(plainBuf);
  } catch {
    return null;
  }
}

async function encryptFile(blob, cryptoKey) {
  const arrayBuffer = await blob.arrayBuffer();
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const encryptedBuffer = await crypto.subtle.encrypt(
    { name: 'AES-GCM', iv },
    cryptoKey,
    arrayBuffer
  );
  const toB64 = buf => btoa(String.fromCharCode(...new Uint8Array(buf)));
  return {
    encryptedBlob: new Blob([encryptedBuffer], { type: 'application/octet-stream' }),
    iv: toB64(iv)
  };
}

async function decryptFile(blob, ivB64, cryptoKey, mimeType) {
  const arrayBuffer = await blob.arrayBuffer();
  const fromB64 = b64 => Uint8Array.from(atob(b64), c => c.charCodeAt(0));
  const decryptedBuffer = await crypto.subtle.decrypt(
    { name: 'AES-GCM', iv: fromB64(ivB64) },
    cryptoKey,
    arrayBuffer
  );
  return new Blob([decryptedBuffer], { type: mimeType });
}

function EncryptedImage({ cdnMediaId, authToken, iv, cryptoKey, mimeType = 'image/jpeg', className }) {
  const [localUrl, setLocalUrl] = useState(null);
  const [error, setError] = useState(false);

  useEffect(() => {
    if (!cryptoKey || !cdnMediaId || !iv || !authToken) return;
    let objectUrl = null;
    let isMounted = true;

    fetch(`${CDN_URL}/f/${cdnMediaId}?token=${authToken}`)
      .then(res => {
        if (!res.ok) throw new Error('Fetch failed');
        return res.blob();
      })
      .then(blob => decryptFile(blob, iv, cryptoKey, mimeType))
      .then(decryptedBlob => {
        if (!isMounted) return;
        objectUrl = URL.createObjectURL(decryptedBlob);
        setLocalUrl(objectUrl);
      })
      .catch(err => {
        console.error('Image decryption failed:', err);
        if (isMounted) setError(true);
      });

    return () => {
      isMounted = false;
      if (objectUrl) URL.revokeObjectURL(objectUrl);
    };
  }, [cdnMediaId, authToken, iv, cryptoKey, mimeType]);

  if (error) return <div style={{ height: 160, display:'flex',alignItems:'center',justifyContent:'center',background:'rgba(192,57,43,0.1)',color:'var(--danger)',fontSize:12,textAlign:'center' }} className={className}>Ошибка расшифровки</div>;
  if (!localUrl) return <div style={{ height: 160, display:'flex',alignItems:'center',justifyContent:'center',background:'var(--surface3)',color:'var(--text3)',fontSize:12 }} className={className}>Расшифровка...</div>;

  return <img src={localUrl} className={className} alt="decrypted" />;
}

function EncryptedVoice({ cdnMediaId, authToken, iv, cryptoKey, mimeType = 'audio/webm' }) {
  const [localUrl, setLocalUrl] = useState(null);
  const [error, setError] = useState(false);

  useEffect(() => {
    if (!cryptoKey || !cdnMediaId || !iv || !authToken) return;
    let objectUrl = null;
    let isMounted = true;

    fetch(`${CDN_URL}/f/${cdnMediaId}?token=${authToken}`)
      .then(res => {
        if (!res.ok) throw new Error('Fetch failed');
        return res.blob();
      })
      .then(blob => decryptFile(blob, iv, cryptoKey, mimeType))
      .then(decryptedBlob => {
        if (!isMounted) return;
        objectUrl = URL.createObjectURL(decryptedBlob);
        setLocalUrl(objectUrl);
      })
      .catch(err => {
        console.error('Voice decryption failed:', err);
        if (isMounted) setError(true);
      });

    return () => {
      isMounted = false;
      if (objectUrl) URL.revokeObjectURL(objectUrl);
    };
  }, [cdnMediaId, authToken, iv, cryptoKey, mimeType]);

  if (error) return <div style={{ fontSize:12, color:'var(--danger)' }}>Ошибка расшифровки ГС</div>;
  if (!localUrl) return <div style={{ fontSize:12, color:'var(--text3)' }}>Расшифровка ГС...</div>;

  return <audio controls src={localUrl} style={{ maxWidth: 240 }} />;
}

function DateSeparator({ date }) {
  const { t } = useI18n();
  let label;
  if (isToday(date))          label = t('date.today');
  else if (isYesterday(date)) label = t('date.yesterday');
  else                        label = format(date, 'MMMM d, yyyy');
  return <div className="date-separator"><span>{label}</span></div>;
}

function withDateSeparators(messages) {
  const result = [];
  let lastDate = null;
  for (const msg of messages) {
    const ts = msg.createdAt?.toDate?.();
    if (ts) {
      const dayStr = format(ts, 'yyyy-MM-dd');
      if (dayStr !== lastDate) {
        result.push({ _type: 'separator', date: ts, key: `sep-${dayStr}` });
        lastDate = dayStr;
      }
    }
    result.push(msg);
  }
  return result;
}

function ForwardBanner({ message }) {
  const { t } = useI18n();

  if (message.tg_forwarded) {
    const name = message.tg_forwarded_from_fallback || message.tg_forwarded_from || t('general.unknown');
    const username = message.tg_forwarded_from ? `(@${message.tg_forwarded_from})` : '';
    return (
      <div className="tg-forward-badge" title="Переслано из Telegram">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.04.01.12 0 .2z"/>
        </svg>
        <span className="tg-forward-name">{t('forward.from')} <strong>{name}</strong> {username}</span>
      </div>
    );
  }

  const { forwardFrom } = message;
  if (!forwardFrom) return null;

  let label;
  if (!forwardFrom.chatId)        label = t('saved.forwardFromSaved');
  else if (forwardFrom.chatName)  label = `${t('forward.from')} @${forwardFrom.senderUsername} · ${forwardFrom.chatName}`;
  else                            label = `${t('forward.from')} @${forwardFrom.senderUsername}`;
  
  return (
    <div className="forward-banner">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
      <span>{label}</span>
    </div>
  );
}

function EncBadge() {
  return (
    <span title="End-to-End Encrypted" style={{ display: 'inline-flex', verticalAlign: 'middle', marginLeft: 4, opacity: 0.65 }}>
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0110 0v4"/>
      </svg>
    </span>
  );
}

function SavedMessageBubble({ message, decryptedTexts, cryptoKey, authToken, onForward, onDelete, onViewProfile, onSelectChat }) {
  const { t } = useI18n();
  const [showActions, setShowActions] = useState(false);
  const ts = message.createdAt?.toDate?.();
  const timeStr = ts ? format(ts, 'HH:mm') : '';

  if (message.deleted) {
    return (
      <div className="bubble-wrap own bubble-wrap-anim">
        <div className="bubble bubble-own bubble-deleted">
          <span className="deleted-text">{t('msg.deleted')}</span>
          <span className="bubble-time">{timeStr}</span>
        </div>
      </div>
    );
  }

  const resolveText = () => {
    if (message.encrypted && message.encryptedText) {
      const dec = decryptedTexts?.[message.id];
      if (dec === undefined) return { text: '⏳', placeholder: true };
      if (dec === null) return { text: 'ОШИБКА РАСШИФРОВКИ', placeholder: true };
      return { text: dec, placeholder: false };
    }
    return { text: message.text || '', placeholder: false };
  };

  const resolveCaption = () => {
    if (message.encrypted && message.encryptedCaption) {
      const dec = decryptedTexts?.[`${message.id}_cap`];
      if (dec === undefined || dec === null) return null;
      return dec;
    }
    return message.caption || null;
  };

  const { text: displayText, placeholder } = resolveText();
  const displayCaption = resolveCaption();
  
  const resolvedUrl = message.cdnMediaId && authToken ? `${CDN_URL}/f/${message.cdnMediaId}?token=${authToken}` : message.url;

  return (
    <div
      className="bubble-wrap own bubble-wrap-anim"
      onMouseEnter={() => setShowActions(true)}
      onMouseLeave={() => setShowActions(false)}
      id={`msg-${message.id}`}
    >
      <div className={`msg-actions msg-actions-left ${showActions ? 'visible' : ''}`}>
        <button className="msg-action-btn" title={t('forward.title')} onClick={() => onForward(message)}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <button className="msg-action-btn msg-action-danger" title={t('reaction.delete')} onClick={() => onDelete(message.id)}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
        </button>
      </div>

      <div className="bubble-and-reactions" style={{ margin: 0 }}>
        <div className="bubble bubble-own">
          
          {(message.forwardFrom || message.tg_forwarded) && (
            <ForwardBanner message={message} />
          )}

          {message.type === 'text' && (
            <span style={{ opacity: placeholder ? 0.5 : 1, fontStyle: placeholder ? 'italic' : 'normal' }}>
              {placeholder
                ? displayText
                : <RichText text={displayText} onViewProfile={onViewProfile} onSelectChat={onSelectChat} />
              }
              {message.encrypted && <EncBadge />}
            </span>
          )}

          {message.type === 'image' && (
            message.encrypted ? (
              <div className="msg-image-wrap" style={{ position: 'relative', marginTop: 4 }}>
                <EncryptedImage
                  cdnMediaId={message.cdnMediaId}
                  authToken={authToken}
                  iv={message.iv}
                  cryptoKey={cryptoKey}
                  mimeType={message.mimeType || 'image/jpeg'}
                  className="msg-image"
                />
                <div style={{ position: 'absolute', top: 6, right: 6, background: 'rgba(0,0,0,0.65)', backdropFilter: 'blur(4px)', padding: '3px 6px', borderRadius: 6, display: 'flex', alignItems: 'center', gap: 4, color: '#fff', fontSize: 10, fontWeight: 600, letterSpacing: '0.04em' }}>
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                  E2E
                </div>
              </div>
            ) : (
              <div className="msg-image-wrap" style={{ marginTop: 4 }}>
                <img src={resolvedUrl} alt="" className="msg-image" />
              </div>
            )
          )}

          {message.type === 'voice' && (
            <div style={{ display: 'flex', alignItems: 'center', gap: 6, marginTop: 4 }}>
              {message.encrypted ? (
                <EncryptedVoice cdnMediaId={message.cdnMediaId} authToken={authToken} iv={message.iv} cryptoKey={cryptoKey} mimeType={message.mimeType || 'audio/webm'} />
              ) : (
                <audio controls src={resolvedUrl} style={{ maxWidth: 240 }} />
              )}
              {message.encrypted && <EncBadge />}
            </div>
          )}

          {displayCaption && (
            <p style={{ margin: '4px 0 0', fontSize: 13 }}>
              {displayCaption}
              {message.encrypted && <EncBadge />}
            </p>
          )}

          <div className="bubble-footer">
            <span className="bubble-time">{timeStr}</span>
          </div>
        </div>
      </div>
    </div>
  );
}

function PinScreen({ uid, onUnlock }) {
  const { t } = useI18n();
  const [pin, setPin] = useState('');
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);

  async function handleVerify(e) {
    if (e && e.preventDefault) e.preventDefault();
    if (pin.length < 4) return;
    setLoading(true);
    setError('');
    try {
      const snap = await getDoc(doc(db, 'savedMessagesSettings', uid));
      const storedHash = snap.data()?.pinHash;
      const inputHash = await hashPin(pin, uid);
      if (inputHash === storedHash) {
        onUnlock(pin);
      } else {
        setError(t('saved.pin.wrong'));
      }
    } catch {
      setError(t('general.error'));
    }
    setLoading(false);
    setPin('');
  }

  function handleKeyDown(e) {
    if (e.key === 'Enter') handleVerify(e);
  }

  return (
    <div className="saved-pin-screen">
      <div className="saved-pin-inner">
        <div className="saved-pin-icon">🔒</div>
        <h3>{t('saved.pin.prompt')}</h3>
        <div style={{ display: 'flex', flexDirection: 'column', gap: 12, width: '100%' }}>
          <input
            type="password" inputMode="numeric" maxLength={8} placeholder="••••"
            value={pin} onChange={e => setPin(e.target.value.replace(/\D/g, ''))}
            onKeyDown={handleKeyDown} className="pin-input" autoComplete="new-password"
            data-lpignore="true" autoFocus
          />
          {error && <div className="auth-error">{error}</div>}
          <button type="button" className="btn-primary" onClick={handleVerify} disabled={pin.length < 4 || loading}>
            {loading ? t('general.loading') : t('saved.pin.unlock')}
          </button>
        </div>
      </div>
    </div>
  );
}

function PinSettingsModal({ uid, pinEnabled, onClose }) {
  const { t } = useI18n();
  const [mode, setMode]       = useState('menu');
  const [pin, setPin]         = useState('');
  const [confirm, setConfirm] = useState('');
  const [current, setCurrent] = useState('');
  const [error, setError]     = useState('');
  const [loading, setLoading] = useState(false);

  async function handleSetPin(e) {
    if (e && e.preventDefault) e.preventDefault();
    if (pin.length < 4)  return setError(t('saved.pin.tooShort'));
    if (pin !== confirm) return setError(t('saved.pin.mismatch'));
    setLoading(true);
    const hash = await hashPin(pin, uid);
    try {
      await setDoc(doc(db, 'savedMessagesSettings', uid), {
        pinEnabled: true,
        pinHash: hash,
        lockTimeout: 5,
        updatedAt: serverTimestamp(),
      });
      onClose(pin);
    } catch { setError(t('general.error')); }
    setLoading(false);
  }

  async function handleDisablePin(e) {
    if (e && e.preventDefault) e.preventDefault();
    setLoading(true);
    try {
      const snap = await getDoc(doc(db, 'savedMessagesSettings', uid));
      const storedHash = snap.data()?.pinHash;
      const inputHash  = await hashPin(current, uid);
      if (inputHash !== storedHash) {
        setLoading(false);
        return setError(t('saved.pin.wrong'));
      }
      await setDoc(doc(db, 'savedMessagesSettings', uid), {
        pinEnabled: false,
        pinHash: null,
        updatedAt: serverTimestamp(),
      });
      onClose(null);
    } catch { setError(t('general.error')); }
    setLoading(false);
    setCurrent('');
  }

  return (
    <div className="modal-overlay" onClick={() => onClose(null)}>
      <div className="modal" style={{ maxWidth: 340 }} onClick={e => e.stopPropagation()}>
        <div className="modal-header">
          <h3>{t('saved.pin.settings')}</h3>
          <button className="modal-close" onClick={() => onClose(null)}>✕</button>
        </div>

        {mode === 'menu' && (
          <div style={{ padding: '8px 16px 20px', display: 'flex', flexDirection: 'column', gap: 8 }}>
            {!pinEnabled ? (
              <>
                <div style={{ background: 'var(--bg3)', borderRadius: 10, padding: '10px 14px', fontSize: 13, color: 'var(--text2)', lineHeight: 1.5, marginBottom: 4 }}>
                  <div style={{ fontWeight: 600, marginBottom: 4, color: 'var(--text1)' }}>🔐 {t('saved.enc.title')}</div>
                  <div>{t('saved.enc.description')}</div>
                  <div style={{ marginTop: 8, color: 'var(--success)', fontWeight: 500 }}>
                    🛡️ Текст, фото и голосовые сообщения надежно шифруются!
                  </div>
                </div>
                <button className="btn-primary" onClick={() => setMode('set')}>🔒 {t('saved.pin.set')}</button>
              </>
            ) : (
              <>
                <div style={{ background: 'var(--bg3)', borderRadius: 10, padding: '10px 14px', fontSize: 13, color: 'var(--text2)', lineHeight: 1.5, marginBottom: 4 }}>
                  <div style={{ fontWeight: 600, marginBottom: 4, color: 'var(--text1)' }}>🔐 {t('saved.enc.active')}</div>
                  <div>{t('saved.enc.activeDesc')}</div>
                  <div style={{ marginTop: 8, color: 'var(--success)', fontWeight: 500 }}>
                    🛡️ Текст, фото и голосовые сообщения надежно шифруются!
                  </div>
                </div>
                <button className="account-action-btn danger" onClick={() => setMode('disable')}>🔓 {t('saved.pin.disable')}</button>
              </>
            )}
          </div>
        )}

        {mode === 'set' && (
          <div style={{ padding: '8px 16px 20px', display: 'flex', flexDirection: 'column', gap: 10 }}>
            <p style={{ fontSize: 13, color: 'var(--text2)', margin: 0 }}>{t('saved.enc.setupHint')}</p>
            <input
              type="password" inputMode="numeric" maxLength={8} placeholder={t('saved.pin.new')}
              value={pin} onChange={e => setPin(e.target.value.replace(/\D/g, ''))}
              onKeyDown={e => e.key === 'Enter' && document.getElementById('confirm-input').focus()}
              className="pin-input" autoComplete="new-password" data-lpignore="true" autoFocus
            />
            <input
              id="confirm-input"
              type="password" inputMode="numeric" maxLength={8} placeholder={t('saved.pin.confirm')}
              value={confirm} onChange={e => setConfirm(e.target.value.replace(/\D/g, ''))}
              onKeyDown={e => e.key === 'Enter' && handleSetPin(e)}
              className="pin-input" autoComplete="new-password" data-lpignore="true"
            />
            {error && <div className="auth-error">{error}</div>}
            <div style={{ display: 'flex', gap: 8 }}>
              <button type="button" className="btn-ghost" onClick={() => setMode('menu')}>{t('general.cancel')}</button>
              <button type="button" className="btn-primary" onClick={handleSetPin} style={{ flex: 1 }} disabled={loading}>{t('saved.pin.set')}</button>
            </div>
          </div>
        )}

        {mode === 'disable' && (
          <div style={{ padding: '8px 16px 20px', display: 'flex', flexDirection: 'column', gap: 10 }}>
            <p style={{ fontSize: 13, color: 'var(--text2)', margin: 0 }}>{t('saved.pin.enterCurrent')}</p>
            <input
              type="password" inputMode="numeric" maxLength={8} placeholder="••••"
              value={current} onChange={e => setCurrent(e.target.value.replace(/\D/g, ''))}
              onKeyDown={e => e.key === 'Enter' && handleDisablePin(e)}
              className="pin-input" autoComplete="new-password" data-lpignore="true" autoFocus
            />
            {error && <div className="auth-error">{error}</div>}
            <div style={{ display: 'flex', gap: 8 }}>
              <button type="button" className="btn-ghost" onClick={() => setMode('menu')}>{t('general.cancel')}</button>
              <button type="button" className="account-action-btn danger" onClick={handleDisablePin} style={{ flex: 1 }} disabled={loading}>{t('saved.pin.disable')}</button>
            </div>
          </div>
        )}
      </div>
    </div>
  );
}

export default function SavedMessagesWindow({ onViewProfile, onSelectChat }) {
  const { user } = useAuth();
  const { t } = useI18n();

  const [authToken,       setAuthToken]       = useState('');
  const [messages,        setMessages]        = useState([]);
  const [text,            setText]            = useState('');
  const [uploading,       setUploading]       = useState(false);
  const [unlocked,        setUnlocked]        = useState(false);
  const [pinEnabled,      setPinEnabled]      = useState(false);
  const [encEnabled,      setEncEnabled]      = useState(false);
  const [cryptoKey,       setCryptoKey]       = useState(null);
  const [decryptedTexts,  setDecryptedTexts]  = useState({});
  const [settingsLoading, setSettingsLoading] = useState(true);
  const [showPinSettings, setShowPinSettings] = useState(false);
  const [pendingImage,    setPendingImage]    = useState(null);
  const [forwardMsg,      setForwardMsg]      = useState(null);

  const bottomRef       = useRef(null);
  const messagesAreaRef = useRef(null);
  const textareaRef     = useRef(null);
  const imageInputRef   = useRef(null);
  const isFirstLoad     = useRef(true);

  useEffect(() => {
    user?.getIdToken().then(setAuthToken);
  }, [user]);

  useEffect(() => {
    if (!user?.uid) return;
    getDoc(doc(db, 'savedMessagesSettings', user.uid)).then(snap => {
      if (snap.exists()) {
        const d = snap.data();
        setPinEnabled(!!d.pinEnabled);
        setEncEnabled(!!d.pinEnabled);
        if (!d.pinEnabled) setUnlocked(true);
      } else {
        setUnlocked(true);
      }
      setSettingsLoading(false);
    });
  }, [user?.uid]);

  useEffect(() => {
    if (!cryptoKey || messages.length === 0) return;
    const pending = messages.filter(m => m.encrypted && m.encryptedText && decryptedTexts[m.id] === undefined);
    if (pending.length === 0) return;

    (async () => {
      const updates = {};
      await Promise.all(pending.map(async msg => {
        updates[msg.id] = await decryptText(msg.encryptedText, msg.iv, cryptoKey);
        if (msg.encryptedCaption) {
          updates[`${msg.id}_cap`] = await decryptText(msg.encryptedCaption, msg.iv, cryptoKey);
        }
      }));
      setDecryptedTexts(prev => ({ ...prev, ...updates }));
    })();
  }, [cryptoKey, messages]);

  useEffect(() => {
    if (!user?.uid || !unlocked) return;
    isFirstLoad.current = true;
    const q = query(
      collection(db, 'savedMessages', user.uid, 'messages'),
      orderBy('createdAt', 'desc'),
      limit(PAGE_SIZE)
    );
    const unsub = onSnapshot(q, snap => {
      const msgs = snap.docs.map(d => ({ id: d.id, ...d.data({ serverTimestamps: 'estimate' }) })).reverse();
      setMessages(msgs);
       if (isFirstLoad.current) {
        isFirstLoad.current = false;
        setTimeout(() => {
          if (messagesAreaRef.current) {
            messagesAreaRef.current.scrollTop = messagesAreaRef.current.scrollHeight;
          }
        }, 50);
      } else {
        setTimeout(() => {
          if (messagesAreaRef.current) {
            messagesAreaRef.current.scrollTo({ top: messagesAreaRef.current.scrollHeight, behavior: 'smooth' });
          }
        }, 30);
      }
    });
    return unsub;
  }, [user?.uid, unlocked]);

  async function handleUnlock(pin) {
    setUnlocked(true);
    if (pin && encEnabled) {
      try {
        const key = await deriveKey(pin, user.uid);
        setCryptoKey(key);
      } catch (err) {
        console.error('Key derivation failed:', err);
      }
    }
  }

  async function handleSend(e) {
    e.preventDefault();
    const trimmed = text.trim();
    if (!trimmed || uploading) return;
    setText('');

    const batch = writeBatch(db);
    const msgRef = doc(collection(db, 'savedMessages', user.uid, 'messages'));

    let msgData;
    if (encEnabled && cryptoKey) {
      const { encryptedText, iv } = await encryptText(trimmed, cryptoKey);
      msgData = {
        senderId: user.uid,
        type: 'text',
        encrypted: true,
        encryptedText,
        iv,
        createdAt: serverTimestamp(),
      };
    } else {
      msgData = {
        senderId: user.uid,
        type: 'text',
        text: trimmed,
        createdAt: serverTimestamp(),
      };
    }

    batch.set(msgRef, msgData);
    batch.update(doc(db, 'users', user.uid), { lastMessageAt: serverTimestamp() });
    await batch.commit();
  }

  function handleKeyDown(e) {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSend(e);
    }
  }

  async function uploadAndSaveImage(file, spoiler) {
    setUploading(true);
    try {
      const isEncrypted = Boolean(encEnabled && cryptoKey);
      let uploadBlob = file;
      let iv = null;

      if (isEncrypted) {
         const enc = await encryptFile(file, cryptoKey);
         uploadBlob = enc.encryptedBlob;
         iv = enc.iv;
      }

      const mediaId = await uploadToCdn(uploadBlob, true, file.name);

      const batch = writeBatch(db);
      const msgRef = doc(collection(db, 'savedMessages', user.uid, 'messages'));
      batch.set(msgRef, {
        senderId: user.uid,
        type: 'image',
        cdnMediaId: mediaId,
        spoiler: spoiler || false,
        encrypted: isEncrypted,
        iv: iv,
        mimeType: file.type,
        createdAt: serverTimestamp(),
      });
      batch.update(doc(db, 'users', user.uid), { lastMessageAt: serverTimestamp() });
      await batch.commit();
    } catch (err) { console.error(err); }
    setUploading(false);
  }

  async function handleDelete(msgId) {
    if (!window.confirm(t('msg.delete.confirm'))) return;
    await updateDoc(doc(db, 'savedMessages', user.uid, 'messages', msgId), {
      deleted: true,
      deletedAt: serverTimestamp(),
    });
  }

  async function handlePinSettingsClose(pinOrNull) {
    setShowPinSettings(false);
    const snap = await getDoc(doc(db, 'savedMessagesSettings', user.uid));
    const d = snap.data() || {};
    setPinEnabled(!!d.pinEnabled);
    setEncEnabled(!!d.pinEnabled);

    if (pinOrNull && d.pinEnabled) {
      window.location.reload();
      return;
    }

    if (!d.pinEnabled) {
      setCryptoKey(null);
      setDecryptedTexts({});
    }
  }

  if (settingsLoading) {
    return (
      <div className="chat-window" style={{ alignItems: 'center', justifyContent: 'center' }}>
        <span style={{ color: 'var(--text3)' }}>{t('general.loading')}</span>
      </div>
    );
  }

  if (pinEnabled && !unlocked) {
    return (
      <div className="chat-window">
        <div className="chat-topbar">
          <div className="avatar sm" style={{ background: 'var(--accent)', color: '#fff', fontWeight: 700, fontSize: 16 }}>⭐</div>
          <div className="chat-topbar-name">{t('saved.title')}</div>
        </div>
        <PinScreen uid={user.uid} onUnlock={handleUnlock} />
      </div>
    );
  }

  const items = withDateSeparators(messages);

  return (
    <div className="chat-window">
      <div className="chat-topbar">
        <div style={{ display: 'flex', alignItems: 'center', gap: 10, flex: 1 }}>
          <div
            className="avatar sm"
            style={{ background: 'linear-gradient(135deg, var(--accent), #7c3aed)', color: '#fff', fontWeight: 700, fontSize: 16, flexShrink: 0 }}
          >
            ⭐
          </div>
          <div>
            <div className="chat-topbar-name">
              {t('saved.title')}
              {encEnabled && (
                <span title={t('saved.enc.active')} style={{ marginLeft: 6, fontSize: 13, opacity: 0.7 }}>🔐</span>
              )}
            </div>
            <div className="chat-topbar-sub" style={{ color: 'var(--text3)', fontSize: 12 }}>
              {encEnabled ? t('saved.enc.activeShort') : t('saved.subtitle')}
            </div>
          </div>
        </div>
        <div className="topbar-actions">
          <button
            className="icon-btn"
            onClick={() => setShowPinSettings(true)}
            title={t('saved.pin.settings')}
          >
            {pinEnabled
              ? <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
              : <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 019.9-1"/></svg>
            }
          </button>
        </div>
      </div>

      {encEnabled && !cryptoKey && unlocked && (
        <div style={{
          background: 'var(--bg3)', padding: '8px 16px', fontSize: 12, color: 'var(--text3)',
          borderBottom: '1px solid var(--border)', display: 'flex', alignItems: 'center', gap: 6,
        }}>
          🔐 {t('saved.enc.keyMissing')}
        </div>
      )}

      <div className="messages-area" ref={messagesAreaRef}>
        {messages.length === 0 && (
          <div className="chat-empty-state" style={{ padding: '60px 20px', textAlign: 'center' }}>
            <div style={{ fontSize: 48, marginBottom: 12 }}>⭐</div>
            <p style={{ color: 'var(--text2)', fontSize: 14 }}>{t('saved.empty')}</p>
            {encEnabled && (
              <p style={{ color: 'var(--success)', fontSize: 12, marginTop: 8, fontWeight: 500 }}>
                🛡️ Текст, фото и голосовые сообщения надежно шифруются.
              </p>
            )}
          </div>
        )}

        {items.map(item => {
          if (item._type === 'separator') return <DateSeparator key={item.key} date={item.date} />;
          return (
            <SavedMessageBubble
              key={item.id}
              message={item}
              decryptedTexts={decryptedTexts}
              cryptoKey={cryptoKey}
              authToken={authToken}
              onForward={setForwardMsg}
              onDelete={handleDelete}
              onViewProfile={onViewProfile}
              onSelectChat={onSelectChat}
            />
          );
        })}
        <div ref={bottomRef} />
      </div>

      <form className="message-form" onSubmit={handleSend}>
        <input
          ref={imageInputRef}
          type="file"
          accept="image/*"
          style={{ display: 'none' }}
          onChange={e => {
            const file = e.target.files?.[0];
            if (file) setPendingImage(file);
            e.target.value = '';
          }}
        />
        <button type="button" className="tool-btn" onClick={() => imageInputRef.current?.click()} disabled={uploading}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8">
            <rect x="3" y="3" width="18" height="18" rx="3"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="M21 15l-5-5L5 21"/>
          </svg>
        </button>
        <textarea
          ref={textareaRef}
          className="message-input"
          placeholder={encEnabled ? `🔐 ${t('saved.placeholder')}` : t('saved.placeholder')}
          value={text}
          onChange={e => setText(e.target.value)}
          onKeyDown={handleKeyDown}
          rows={1}
          disabled={uploading}
        />
        {text.trim() && (
          <button type="submit" className="send-btn" disabled={uploading}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
              <path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/>
            </svg>
          </button>
        )}
      </form>

      {showPinSettings && (
        <PinSettingsModal uid={user.uid} pinEnabled={pinEnabled} onClose={handlePinSettingsClose} />
      )}

      {pendingImage && (
        <ImageEditor
          file={pendingImage}
          onConfirm={(editedFile, spoiler) => {
            setPendingImage(null);
            uploadAndSaveImage(editedFile, spoiler);
          }}
          onCancel={() => setPendingImage(null)}
        />
      )}

      {forwardMsg && (
        <ForwardPickerModal message={forwardMsg} sourceChatId={null} sourceChatName={t('saved.title')} onClose={() => setForwardMsg(null)} />
      )}
    </div>
  );
}
