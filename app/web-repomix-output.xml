// src/components/CommentsSheet.jsx
import { useEffect, useRef, useState, useCallback } from 'react';
import { db } from '../firebase/config';
import { useAuth } from '../contexts/AuthContext';
import { useI18n } from '../contexts/I18nContext';
import {
  collection, query, orderBy, onSnapshot,
  doc, updateDoc
} from 'firebase/firestore';
import { getFunctions, httpsCallable } from 'firebase/functions';
import { format } from 'date-fns';
import { useVoiceRecorder } from '../hooks/useVoiceRecorder';
import ImageEditor from './ImageEditor';
import SpoilerImage from './SpoilerImage';
import { uploadToCdn, CDN_URL } from '../hooks/useCdn';

const fn = getFunctions(undefined, 'europe-west1');
const addCommentFn     = httpsCallable(fn, 'addComment');
const toggleCommentsFn = httpsCallable(fn, 'togglePostComments');

const EMOJI_LIST = [
  '👍','❤️','😂','😮','😢','🔥',
  '🎉','👏','🥰','😍','🤩','😭',
  '🤔','👀','💯','✅','🙏','😎',
  '🤣','😅','😡','💀','🎊','⚡',
];

function VoicePlayer({ url, duration }) {
  const [playing, setPlaying] = useState(false);
  const [progress, setProgress] = useState(0);
  const [currentTime, setCurrentTime] = useState(0);
  const audioRef = useRef(null);

  function togglePlay() {
    const a = audioRef.current;
    if (!a) return;
    if (playing) { a.pause(); setPlaying(false); }
    else { a.play(); setPlaying(true); }
  }
  function handleTimeUpdate() {
    const a = audioRef.current;
    if (!a) return;
    setCurrentTime(Math.floor(a.currentTime));
    setProgress((a.currentTime / a.duration) * 100 || 0);
  }
  function handleEnded() { setPlaying(false); setProgress(0); setCurrentTime(0); }
  function handleSeek(e) {
    const a = audioRef.current;
    if (!a) return;
    const rect = e.currentTarget.getBoundingClientRect();
    a.currentTime = ((e.clientX - rect.left) / rect.width) * a.duration;
  }
  function fmt(s) { return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; }

  return (
    <div className="voice-msg">
      <audio ref={audioRef} src={url} onTimeUpdate={handleTimeUpdate} onEnded={handleEnded} />
      <button className="voice-play-btn" onClick={togglePlay}>
        {playing
          ? <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
          : <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5,3 19,12 5,21"/></svg>}
      </button>
      <div className="voice-progress-wrap" onClick={handleSeek}>
        <div className="voice-progress-track">
          <div className="voice-progress-fill" style={{ width: `${progress}%` }} />
        </div>
      </div>
      <span className="voice-time">{fmt(currentTime || duration)}</span>
    </div>
  );
}

function CommentBubble({ comment, isOwn, chatId, messageId, onReply, onScrollTo, revealedIds, onReveal, authToken }) {
  const { user } = useAuth();
  const { t } = useI18n();
  const [showActions, setShowActions] = useState(false);
  const [showEmojiPicker, setShowEmojiPicker] = useState(false);
  const [imgOpen, setImgOpen] = useState(false);
  const ts = comment.createdAt?.toDate?.();
  const timeStr = ts ? format(ts, 'HH:mm') : '';
  const isDeleted = comment.deleted;

  const resolvedUrl = comment.cdnMediaId && authToken ? `${CDN_URL}/f/${comment.cdnMediaId}?token=${authToken}` : comment.url;

  async function handleReaction(emoji) {
    const reactions = comment.reactions || [];
    const existing = reactions.find(r => r.emoji === emoji);
    let updated;
    if (existing) {
      const hasMe = existing.uids?.includes(user.uid);
      if (hasMe) {
        updated = reactions
          .map(r => r.emoji === emoji
            ? { ...r, uids: r.uids.filter(u => u !== user.uid), count: r.count - 1 }
            : r)
          .filter(r => r.count > 0);
      } else {
        updated = reactions.map(r => r.emoji === emoji
          ? { ...r, uids: [...(r.uids || []), user.uid], count: r.count + 1 }
          : r);
      }
    } else {
      updated = [...reactions, { emoji, uids: [user.uid], count: 1 }];
    }
    await updateDoc(
      doc(db, 'chats', chatId, 'messages', messageId, 'comments', comment.id),
      { reactions: updated }
    );
    setShowEmojiPicker(false);
    setShowActions(false);
  }

  async function handleDelete() {
    if (!isOwn) return;
    if (!window.confirm(t('comments.delete.confirm'))) return;
    await updateDoc(
      doc(db, 'chats', chatId, 'messages', messageId, 'comments', comment.id),
      { deleted: true, deletedAt: new Date() }
    );
  }

  function replyText(r) {
    if (!r) return '';
    if (r.type === 'image') return t('msg.image');
    if (r.type === 'voice') return t('msg.voice');
    return r.text || '';
  }

  if (isDeleted) {
    return (
      <div className={`bubble-wrap ${isOwn ? 'own' : 'other'}`}>
        <div className={`bubble bubble-deleted ${isOwn ? 'bubble-own' : 'bubble-other'}`}>
          <span className="deleted-icon">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <polyline points="3 6 5 6 21 6"/>
              <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
            </svg>
          </span>
          <span className="deleted-text">{t('comments.deleted')}</span>
          <span className="bubble-time">{timeStr}</span>
        </div>
      </div>
    );
  }

  return (
    <>
      <div
        className={`bubble-wrap ${isOwn ? 'own' : 'other'} bubble-wrap-anim`}
        onMouseEnter={() => setShowActions(true)}
        onMouseLeave={() => { setShowActions(false); setShowEmojiPicker(false); }}
        id={`comment-${comment.id}`}
      >
        <div className={`msg-actions ${isOwn ? 'msg-actions-left' : 'msg-actions-right'} ${showActions ? 'visible' : ''}`}>
          <div className="msg-action-wrap">
            <button
              className="msg-action-btn"
              title={t('reaction.react')}
              onClick={e => { e.stopPropagation(); setShowEmojiPicker(v => !v); }}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M8 13s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/>
              </svg>
            </button>
            {showEmojiPicker && (
              <div
                className={`emoji-picker ${isOwn ? 'picker-left' : 'picker-right'}`}
                onClick={e => e.stopPropagation()}
              >
                {EMOJI_LIST.map(e => (
                  <button key={e} className="emoji-option" onClick={() => handleReaction(e)}>{e}</button>
                ))}
              </div>
            )}
          </div>

          <button className="msg-action-btn" title={t('reaction.reply')} onClick={() => onReply?.(comment)}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <path d="M9 17H5a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3"/>
              <path d="M15 19l-4-4 4-4M11 15h6a2 2 0 002-2v-1"/>
            </svg>
          </button>

          {isOwn && (
            <button className="msg-action-btn msg-action-danger" title={t('reaction.delete')} onClick={handleDelete}>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <polyline points="3 6 5 6 21 6"/>
                <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
              </svg>
            </button>
          )}
        </div>

        <div className={`bubble ${isOwn ? 'bubble-own' : 'bubble-other'}`}>
          {!isOwn && <span className="comment-author">@{comment.senderUsername}</span>}

          {comment.replyTo && (
            <div
              className={`reply-preview ${isOwn ? 'reply-own' : 'reply-other'}`}
              onClick={() => onScrollTo?.(`comment-${comment.replyTo.id}`)}
            >
              <div className="reply-bar" />
              <div className="reply-content">
                <span className="reply-name">@{comment.replyTo.senderUsername}</span>
                <span className="reply-text">{replyText(comment.replyTo)}</span>
              </div>
            </div>
          )}

          {comment.type === 'text' && <p>{comment.text}</p>}
          {comment.type === 'image' && (
            <SpoilerImage
              url={resolvedUrl}
              fileName={comment.fileName}
              spoiler={comment.spoiler || false}
              revealedIds={revealedIds}
              onReveal={onReveal}
              onLightbox={() => setImgOpen(true)}
              itemId={comment.id}
            />
          )}
          {comment.type === 'video' && (
            <video src={resolvedUrl} controls style={{ maxWidth: '100%', maxHeight: 320, borderRadius: 10, display: 'block', background: '#000', marginTop: 4 }} />
          )}
          {comment.type === 'gif' && (
            <img src={resolvedUrl} alt="GIF" style={{ maxWidth: '100%', maxHeight: 320, borderRadius: 10, display: 'block', marginTop: 4 }} />
          )}
          {comment.type === 'voice' && (
            <VoicePlayer url={resolvedUrl} duration={comment.duration || 0} />
          )}

          <div className="bubble-footer">
            <span className="bubble-time">{timeStr}</span>
          </div>
        </div>
      </div>

      {comment.reactions?.filter(r => r.count > 0).length > 0 && (
        <div className={`reactions-under ${isOwn ? 'reactions-under-own' : 'reactions-under-other'}`}>
          <div className="reactions-inline-row">
            {comment.reactions.filter(r => r.count > 0).map(r => (
              <button
                key={r.emoji}
                className={`reaction-chip ${r.uids?.includes(user.uid) ? 'mine' : ''}`}
                onClick={() => handleReaction(r.emoji)}
              >
                <span>{r.emoji}</span>
                {r.count > 1 && <span className="reaction-count">{r.count}</span>}
              </button>
            ))}
          </div>
        </div>
      )}

      {imgOpen && (
        <div className="img-lightbox" onClick={() => setImgOpen(false)}>
          <img src={resolvedUrl} alt="full" />
        </div>
      )}
    </>
  );
}

export default function CommentsSheet({ chatId, message, isAdmin, onClose }) {
  const { user } = useAuth();
  const { t } = useI18n();
  const [authToken, setAuthToken] = useState('');
  const [comments, setComments] = useState([]);
  const [livePost, setLivePost] = useState(message);
  const [text, setText] = useState('');
  const [replyTo, setReplyTo] = useState(null);
  const [uploading, setUploading] = useState(false);
  const [loading, setLoading] = useState(false);
  const [pendingImage, setPendingImage] = useState(null);
  const [revealedIds, setRevealedIds] = useState(new Set());

  useEffect(() => {
    user?.getIdToken().then(setAuthToken);
  }, [user]);

  function handleReveal(id) {
    setRevealedIds(prev => new Set([...prev, id]));
  }

  const bottomRef       = useRef(null);
  const commentsListRef = useRef(null);
  const textareaRef     = useRef(null);
  const imageInputRef = useRef(null);
  const { recording, duration, startRecording, stopRecording, cancelRecording } = useVoiceRecorder();

  const commentsEnabled = livePost.commentsEnabled !== false;

  useEffect(() => {
    if (!chatId || !message?.id) return;
    const unsub = onSnapshot(
      doc(db, 'chats', chatId, 'messages', message.id),
      snap => { if (snap.exists()) setLivePost({ id: snap.id, ...snap.data() }); }
    );
    return unsub;
  }, [chatId, message?.id]);

  useEffect(() => {
    if (!chatId || !message?.id) return;
    const q = query(
      collection(db, 'chats', chatId, 'messages', message.id, 'comments'),
      orderBy('createdAt', 'asc')
    );
    const unsub = onSnapshot(q, snap => {
      setComments(snap.docs.map(d => ({ id: d.id, ...d.data() })));
      setTimeout(() => {
        if (commentsListRef.current) {
          commentsListRef.current.scrollTo({ top: commentsListRef.current.scrollHeight, behavior: 'smooth' });
        }
      }, 30);
    });
    return unsub;
  }, [chatId, message?.id]);

  useEffect(() => {
    if (replyTo) textareaRef.current?.focus();
  }, [replyTo]);

  function scrollToComment(elementId) {
    const el = document.getElementById(elementId);
    if (!el) return;
    el.scrollIntoView({ behavior: 'smooth', block: 'center' });
    el.classList.add('msg-highlight');
    setTimeout(() => el.classList.remove('msg-highlight'), 1500);
  }

  async function handleSend(e) {
    e.preventDefault();
    if (!text.trim() || loading) return;
    const textToSend = text.trim();
    setText('');
    setLoading(true);
    try {
      await addCommentFn({
        chatId,
        messageId: message.id,
        type: 'text',
        text: textToSend,
        replyTo: replyTo ? {
          id: replyTo.id,
          text: replyTo.text || null,
          type: replyTo.type,
          url: replyTo.url || null,
          cdnMediaId: replyTo.cdnMediaId || null,
          senderUsername: replyTo.senderUsername,
        } : null,
      });
      setReplyTo(null);
    } catch (e) { console.error(e); }
    setLoading(false);
  }

  async function handleImageSelect(e) {
    const file = e.target.files[0];
    if (!file) return;
    setPendingImage({ file });
    e.target.value = '';
  }

  async function uploadAndSendImage(file, spoiler) {
    setUploading(true);
    try {
      const mediaId = await uploadToCdn(file, false, file.name);
      await addCommentFn({
        chatId, messageId: message.id,
        type: 'image', cdnMediaId: mediaId, fileName: file.name,
        spoiler: spoiler || false,
        replyTo: null,
      });
    } catch (err) { console.error(err); }
    setUploading(false);
  }

  async function handleVoiceSend() {
    const result = await stopRecording();
    if (!result) return;
    setUploading(true);
    try {
      const mediaId = await uploadToCdn(result.blob, false, `voice_${Date.now()}.webm`);
      await addCommentFn({
        chatId, messageId: message.id,
        type: 'voice', cdnMediaId: mediaId, duration: result.duration,
        replyTo: null,
      });
    } catch (err) { console.error(err); }
    setUploading(false);
  }

  async function handleToggleComments() {
    try {
      await toggleCommentsFn({
        chatId,
        messageId: message.id,
        enabled: !commentsEnabled,
      });
    } catch (e) { console.error(e); }
  }

  function handleKeyDown(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); handleSend(e); }
    if (e.key === 'Escape' && replyTo) setReplyTo(null);
  }

  const nonDeletedCount = comments.filter(c => !c.deleted).length;

  return (
    <div className="comments-overlay" onClick={onClose}>
      <div className="comments-sheet" onClick={e => e.stopPropagation()}>
        <div className="comments-header">
          <div className="comments-header-left">
            <button className="comments-close" onClick={onClose}>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M19 12H5M12 5l-7 7 7 7"/>
              </svg>
            </button>
            <h3>
              {t('comments.title')}{' '}
              <span className="comments-count">{nonDeletedCount}</span>
            </h3>
          </div>
          {isAdmin && (
            <button
              className={`comments-toggle-btn ${commentsEnabled ? '' : 'disabled'}`}
              onClick={handleToggleComments}
              title={commentsEnabled ? t('comments.off') : t('comments.on')}
            >
              {commentsEnabled ? (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                </svg>
              ) : (
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                  <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                  <line x1="4" y1="4" x2="20" y2="20" stroke="var(--danger)"/>
                </svg>
              )}
              <span>{commentsEnabled ? t('comments.on') : t('comments.off')}</span>
            </button>
          )}
        </div>

        <div className="comments-post-preview">
          <p className="comments-post-text">
            {livePost.type === 'text' ? livePost.text :
             livePost.type === 'image' ? t('msg.image') :
             livePost.type === 'video' ? '🎥 Видео' :
             livePost.type === 'gif' ? '🖼️ GIF' :
             livePost.type === 'voice' ? t('msg.voice') : 'Post'}
          </p>
        </div>

        <div className="comments-list" ref={commentsListRef}>
          {comments.length === 0 && (
            <div className="comments-empty">
              <p>{t('comments.empty')}</p>
              {commentsEnabled && <span>{t('comments.beFirst')}</span>}
            </div>
          )}
          {comments.map(comment => (
            <CommentBubble
              key={comment.id}
              comment={comment}
              isOwn={comment.senderId === user.uid}
              chatId={chatId}
              messageId={message.id}
              onReply={setReplyTo}
              onScrollTo={scrollToComment}
              revealedIds={revealedIds}
              onReveal={handleReveal}
              authToken={authToken}
            />
          ))}
          <div ref={bottomRef} />
        </div>

        {replyTo && (
          <div className="reply-bar-active">
            <div className="reply-bar-line" />
            <div className="reply-bar-info">
              <span className="reply-bar-name">@{replyTo.senderUsername}</span>
              <span className="reply-bar-text">
                {replyTo.type === 'text' ? replyTo.text :
                 replyTo.type === 'image' ? t('msg.image') :
                 replyTo.type === 'video' ? '🎥 Видео' :
                 replyTo.type === 'gif' ? '🖼️ GIF' :
                 replyTo.type === 'voice' ? t('msg.voice') : 'Media'}
              </span>
            </div>
            <button className="reply-bar-close" onClick={() => setReplyTo(null)}>✕</button>
          </div>
        )}

        {commentsEnabled ? (
          <>
            {recording && (
              <div className="voice-recording-bar">
                <div className="voice-rec-dot" />
                <span className="voice-rec-label">{t('voice.recording')}</span>
                <span className="voice-rec-timer">
                  {Math.floor(duration / 60)}:{String(duration % 60).padStart(2, '0')}
                </span>
                <button className="voice-cancel-btn" onClick={cancelRecording}>{t('voice.cancel')}</button>
                <button className="voice-send-btn-bar" onClick={handleVoiceSend}>{t('voice.send')}</button>
              </div>
            )}
            <form className="comments-form" onSubmit={handleSend}>
              <input
                ref={imageInputRef}
                type="file"
                accept="image/*"
                style={{ display: 'none' }}
                onChange={handleImageSelect}
              />
              <button type="button" className="tool-btn" onClick={() => imageInputRef.current.click()} disabled={uploading}>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.8">
                  <rect x="3" y="3" width="18" height="18" rx="3"/>
                  <circle cx="8.5" cy="8.5" r="1.5"/>
                  <path d="M21 15l-5-5L5 21"/>
                </svg>
              </button>
              <textarea
                ref={textareaRef}
                className="message-input"
                placeholder={t('comments.placeholder')}
                value={text}
                onChange={e => setText(e.target.value)}
                onKeyDown={handleKeyDown}
                rows={1}
                disabled={uploading || recording || loading}
              />
              {!text.trim() && !recording && (
                <button type="button" className="send-btn send-btn-mic" onClick={startRecording} disabled={uploading}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                    <rect x="9" y="2" width="6" height="12" rx="3"/>
                    <path d="M5 10a7 7 0 0014 0M12 19v3M8 22h8"/>
                  </svg>
                </button>
              )}
              {text.trim() && (
                <button type="submit" className="send-btn" disabled={loading || uploading}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2.5">
                    <path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z"/>
                  </svg>
                </button>
              )}
            </form>
          </>
        ) : (
          <div className="comments-disabled-bar">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
              <circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
            </svg>
            {t('comments.disabled')}
          </div>
        )}
      </div>

      {pendingImage && (
        <ImageEditor
          file={pendingImage.file}
          onConfirm={(editedFile, spoiler) => {
            setPendingImage(null);
            uploadAndSendImage(editedFile, spoiler);
          }}
          onCancel={() => setPendingImage(null)}
        />
      )}
    </div>
  );
}
</file>

<file path="src/components/ProfileView.jsx">
// src/components/ProfileView.jsx
import { useEffect, useState } from 'react';
import { db } from '../firebase/config';
import { doc, onSnapshot } from 'firebase/firestore';
import { formatDistanceToNow } from 'date-fns';
import { useI18n } from '../contexts/I18nContext';
import { useAuth } from '../contexts/AuthContext';
import { useTheme } from '../contexts/ThemeContext';

export default function ProfileView({ uid, onClose, onStartChat }) {
  const { user, userData } = useAuth();
  const { t } = useI18n();
  const { theme } = useTheme();
  const [profile, setProfile] = useState(null);

  // Проверяем, наш ли это профиль
  const isMe = user?.uid === uid;

  useEffect(() => {
    if (!uid) return;
    const unsub = onSnapshot(doc(db, 'users', uid), snap => {
      if (snap.exists()) setProfile(snap.data());
    });
    return unsub;
  }, [uid]);

  if (!profile) return null;

  const lastSeen = profile.lastSeen?.toDate?.();

  // Customization Evaluation
  const isPro = profile.proUntil?.toDate()?.getTime() > Date.now() || profile.proUntil?.toDate()?.getFullYear() > 2090;
  const ignoreCust = !isMe && userData?.settings?.ignoreCustomizations === true;
  const applyCustom = isPro && (!ignoreCust || isMe) ? profile.customization : null;

  const pStyle = applyCustom?.style !== 'default' ? applyCustom?.style : undefined;
  const pAccent = applyCustom?.accent !== 'default' ? applyCustom?.accent : undefined;
  const pFont = applyCustom?.font === 'mono' ? 'var(--font-mono)' :
                applyCustom?.font === 'serif' ? 'Georgia, "Times New Roman", serif' :
                applyCustom?.font === 'rounded' ? '"Nunito", "Varela Round", system-ui, sans-serif' : undefined;

  const pLayout = applyCustom?.layout || 'default';
  const pEmojis = applyCustom?.emojis || '';
  const pGif = applyCustom?.gifUrl || '';

  return (
    <>
      <div className="profile-overlay" onClick={onClose} />
      <div 
        className="profile-panel"
        data-style={pStyle}
        data-accent={pAccent}
        data-theme={pStyle ? theme : undefined}
        style={{ fontFamily: pFont }}
      >
        <button className="profile-close" onClick={onClose} style={{ zIndex: 10 }}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>

        {/* Custom Banner Background */}
        {pLayout === 'banner' && (
          <div className="profile-banner" style={{ backgroundImage: `url(${pGif || applyCustom?.bgUrl || 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=2564&auto=format&fit=crop'})` }} />
        )}

        {/* Header */}
        <div className={`profile-header ${pLayout === 'banner' ? 'banner-mode' : pLayout === 'compact' ? 'compact-mode' : ''}`}>
          <div className="profile-avatar">
            {profile.avatarUrl
              ? <img src={profile.avatarUrl} alt={profile.displayName} />
              : <span>{profile.displayName?.[0]?.toUpperCase()}</span>
            }
            {profile.online && <span className="profile-online-dot" />}
           </div>
          
          <div className={pLayout === 'compact' ? 'compact-info' : ''}>
            <h2 className="profile-name" style={{ display: 'flex', alignItems: 'center', justifyContent: pLayout === 'compact' ? 'flex-start' : 'center', gap: '6px', flexWrap: 'wrap' }}>
              {profile.displayName}
              {pEmojis && <span className="profile-custom-emojis">{pEmojis}</span>}
            
            {/* Бейдж Админа */}
            {profile.isAdmin === true && (
              <span className="vl-admin-badge">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                </svg>
                VisorLink Admin
              </span>
            )}

            {/* Стрик показывается ТОЛЬКО если это наш профиль */}
            {isMe && profile.showStreak !== false && profile.streak > 0 && (
              <span className="streak-badge" style={{ fontSize: 11, padding: '3px 8px' }}>🔥 {profile.streak}</span>
            )}
            
            {/* PRO скрывается, если пользователь — админ */}
              {!profile.isAdmin && profile.proUntil && profile.proUntil.toDate().getTime() > Date.now() && (
                <span className="pro-badge" style={{ fontSize: 11, padding: '3px 8px' }}>PRO</span>
              )}
            </h2>
            <p className="profile-handle">@{profile.username}</p>
            <p className="profile-status-text">
              {profile.online
                ? <span className="profile-online-label">● {t('profile.online')}</span>
                : lastSeen
                  ? `${t('chat.lastSeen')} ${formatDistanceToNow(lastSeen, { addSuffix: true })}`
                  : t('chat.offline')
              }
            </p>
          </div>
        </div>

        {/* Custom GIF (My Vibe) */}
        {pGif && pLayout !== 'banner' && (
          <div className="profile-section" style={{ paddingBottom: 0, borderBottom: 'none' }}>
            <p className="profile-section-label">My Vibe</p>
            <img src={pGif} alt="vibe" className="profile-custom-gif" />
          </div>
        )}

        {/* Bio */}
        {profile.bio && (
          <div className="profile-section">
            <p className="profile-section-label">{t('profile.bio')}</p>
            <p className="profile-bio">{profile.bio}</p>
          </div>
        )}

        {/* Info */}
        <div className="profile-section">
          <p className="profile-section-label">{t('settings.joinedAt')}</p>
          <p className="profile-info-value">
            {profile.createdAt?.toDate?.()
              ? formatDistanceToNow(profile.createdAt.toDate(), { addSuffix: true })
              : '—'}
          </p>
        </div>

        {/* Action */}
        {onStartChat && (
          <div style={{ padding: '20px 20px 24px', boxSizing: 'border-box', width: '100%' }}>
            <button
              className="btn-primary profile-action"
              style={{
                width: '100%',
                boxSizing: 'border-box',
                margin: 0,
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                gap: 8,
              }}
              onClick={onStartChat}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
              </svg>
              {t('profile.message')}
            </button>
          </div>
        )}
      </div>
    </>
  );
}
</file>

<file path="src/styles/chat.css">
.chat-window { flex: 1; min-width: 0; display: flex; flex-direction: column; overflow: hidden; background: transparent; z-index: 1; position: relative; }
