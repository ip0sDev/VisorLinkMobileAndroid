// functions/channelBot.js
const { onRequest, onCall, HttpsError } = require('firebase-functions/v2/https');
const { getFirestore, FieldValue } = require('firebase-admin/firestore');
const crypto = require('crypto');

const MAX_MSG_LEN      = 2000;
const RATE_LIMIT       = 12;
const RATE_WINDOW_MS   = 60000;
const MAX_KEYS_PER_CHANNEL = 5;

function generateApiKey() {
  return `vlbot_${crypto.randomBytes(32).toString('hex')}`;
}

function hashKey(rawKey) {
  return crypto.createHash('sha256').update(rawKey).digest('hex');
}

exports.createChannelBotKey = onCall(
  { cors: true, region: 'europe-west1' },
  async (request) => {
    const db = getFirestore();

    if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');
    if (!request.auth.token.email_verified)
      throw new HttpsError('permission-denied', 'Email verification required.');

    const uid = request.auth.uid;
    const { chatId, label = 'Bot' } = request.data;

    if (!chatId || typeof chatId !== 'string')
      throw new HttpsError('invalid-argument', 'chatId required.');
    if (typeof label !== 'string' || label.length > 48)
      throw new HttpsError('invalid-argument', 'label must be ≤ 48 chars.');

    const [chatDoc, memberDoc] = await Promise.all([
      db.collection('chats').doc(chatId).get(),
      db.collection('chats').doc(chatId).collection('members').doc(uid).get(),
    ]);

    if (!chatDoc.exists) throw new HttpsError('not-found', 'Channel not found.');

    const chat = chatDoc.data();
    if (chat.type !== 'channel')
      throw new HttpsError('failed-precondition', 'Bot keys are only supported for channels.');

    if (!memberDoc.exists || memberDoc.data().role !== 'owner')
      throw new HttpsError('permission-denied', 'Only the channel owner can create bot keys.');

    const existingSnap = await db
      .collection('chats').doc(chatId)
      .collection('botKeys')
      .where('active', '==', true)
      .get();

    if (existingSnap.size >= MAX_KEYS_PER_CHANNEL)
      throw new HttpsError(
        'resource-exhausted',
        `Maximum ${MAX_KEYS_PER_CHANNEL} active bot keys per channel.`
      );

    const rawKey  = generateApiKey();
    const keyHash = hashKey(rawKey);

    const keyRef = db.collection('chats').doc(chatId).collection('botKeys').doc();
    await keyRef.set({
      keyHash,
      label: label.trim() || 'Bot',
      active: true,
      badge: 'unverified',
      channelId: chatId,
      ownerId: uid,
      createdAt: FieldValue.serverTimestamp(),
      lastUsedAt: null,
      messagesTotal: 0,
    });

    return { keyId: keyRef.id, apiKey: rawKey };
  }
);

exports.revokeChannelBotKey = onCall(
  { cors: true, region: 'europe-west1' },
  async (request) => {
    const db = getFirestore();

    if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');

    const uid = request.auth.uid;
    const { chatId, keyId } = request.data;

    if (!chatId || !keyId)
      throw new HttpsError('invalid-argument', 'chatId and keyId required.');

    const memberDoc = await db
      .collection('chats').doc(chatId)
      .collection('members').doc(uid)
      .get();

    if (!memberDoc.exists || memberDoc.data().role !== 'owner')
      throw new HttpsError('permission-denied', 'Only the channel owner can revoke bot keys.');

    const keyRef = db.collection('chats').doc(chatId).collection('botKeys').doc(keyId);
    const keyDoc = await keyRef.get();

    if (!keyDoc.exists) throw new HttpsError('not-found', 'Key not found.');

    await keyRef.update({ active: false, revokedAt: FieldValue.serverTimestamp() });

    return { success: true };
  }
);

// Перегенерация ключа канального бота
exports.regenerateChannelBotKey = onCall(
  { cors: true, region: 'europe-west1' },
  async (request) => {
    const db = getFirestore();

    if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');

    const uid = request.auth.uid;
    const { chatId, keyId } = request.data;

    if (!chatId || !keyId) throw new HttpsError('invalid-argument', 'chatId and keyId required.');

    const memberDoc = await db.collection('chats').doc(chatId).collection('members').doc(uid).get();
    if (!memberDoc.exists || memberDoc.data().role !== 'owner')
      throw new HttpsError('permission-denied', 'Only the channel owner can regenerate bot keys.');

    const keyRef = db.collection('chats').doc(chatId).collection('botKeys').doc(keyId);
    const keyDoc = await keyRef.get();

    if (!keyDoc.exists) throw new HttpsError('not-found', 'Key not found.');
    if (!keyDoc.data().active) throw new HttpsError('failed-precondition', 'Cannot regenerate revoked key.');

    const rawKey  = generateApiKey();
    const keyHash = hashKey(rawKey);

    await keyRef.update({ keyHash });

    return { keyId, apiKey: rawKey };
  }
);

exports.listChannelBotKeys = onCall(
  { cors: true, region: 'europe-west1' },
  async (request) => {
    const db = getFirestore();

    if (!request.auth) throw new HttpsError('unauthenticated', 'Login required.');

    const uid = request.auth.uid;
    const { chatId } = request.data;

    if (!chatId) throw new HttpsError('invalid-argument', 'chatId required.');

    const memberDoc = await db
      .collection('chats').doc(chatId)
      .collection('members').doc(uid)
      .get();

    if (!memberDoc.exists || memberDoc.data().role !== 'owner')
      throw new HttpsError('permission-denied', 'Only the channel owner can list bot keys.');

    const snap = await db
      .collection('chats').doc(chatId)
      .collection('botKeys')
      .orderBy('createdAt', 'desc')
      .get();

    const keys = snap.docs.map(d => ({
      keyId:         d.id,
      label:         d.data().label,
      active:        d.data().active,
      badge:         d.data().badge || 'unverified',
      createdAt:     d.data().createdAt?.toDate?.()?.toISOString() || null,
      lastUsedAt:    d.data().lastUsedAt?.toDate?.()?.toISOString() || null,
      messagesTotal: d.data().messagesTotal || 0,
    }));

    return { keys };
  }
);

exports.channelBotWebhook = onRequest(
  { region: 'europe-west1' },
  async (req, res) => {
    if (req.method !== 'POST') {
      return res.status(405).json({ error: 'Method not allowed. Use POST.' });
    }

    const authHeader = req.headers.authorization;
    if (!authHeader || !authHeader.startsWith('Bearer vlbot_')) {
      return res.status(401).json({ error: 'Missing or invalid API key.' });
    }

    const apiKey = authHeader.split(' ')[1];
    const { chatId, text } = req.body;

    if (!chatId || !text) {
      return res.status(400).json({ error: 'Missing chatId or text.' });
    }

    const db = getFirestore();

    try {
      const incomingKeyHash = hashKey(apiKey);

      const keySnap = await db
        .collection('chats')
        .doc(chatId)
        .collection('botKeys')
        .where('keyHash', '==', incomingKeyHash)
        .where('active', '==', true)
        .limit(1)
        .get();

      if (keySnap.empty) {
        return res.status(403).json({ error: 'Invalid key or wrong chatId.' });
      }

      const keyDoc = keySnap.docs[0];
      const keyData = keyDoc.data();
      const windowStart = Date.now() - RATE_WINDOW_MS;
      const rateRef = keyDoc.ref.collection('rateLimit');

      let resultMessageId = null;
      let isRateLimited = false;

      await db.runTransaction(async (tx) => {
        const [chatDoc, recentSnap, ownerDoc] = await Promise.all([
          tx.get(db.collection('chats').doc(chatId)),
          tx.get(rateRef.where('ts', '>', windowStart)),
          tx.get(db.collection('users').doc(keyData.ownerId))
        ]);

        if (!chatDoc.exists) throw new Error('NOT_FOUND');

        if (recentSnap.size >= RATE_LIMIT) {
          isRateLimited = true;
          return;
        }

        const chat = chatDoc.data();
        const ownerUsername = ownerDoc.exists ? (ownerDoc.data().username || 'Bot') : 'Bot';

        const msgRef = db.collection('chats').doc(chatId).collection('messages').doc();
        resultMessageId = msgRef.id;

        tx.set(msgRef, {
          senderId: keyData.ownerId,
          senderUsername: ownerUsername,
          type: 'text',
          text: text.trim().substring(0, MAX_MSG_LEN),
          createdAt: FieldValue.serverTimestamp(),
          readBy: [],
          reactions: [], 
          deleted: false,
          commentsCount: 0,
          commentsEnabled: chat.settings?.allowComments !== false,
          isBot: true,
          botKeyId: keyDoc.id,
          botLabel: keyData.label || 'Bot',
          botBadge: keyData.badge || 'unverified'
        });

        tx.update(db.collection('chats').doc(chatId), {
          lastMessage: { type: 'text', text: text.trim().substring(0, 80), senderId: keyData.ownerId },
          lastMessageAt: FieldValue.serverTimestamp(),
        });

        tx.update(keyDoc.ref, {
          lastUsedAt: FieldValue.serverTimestamp(),
          messagesTotal: FieldValue.increment(1),
        });

        tx.set(rateRef.doc(), { ts: Date.now() });
      });

      if (isRateLimited) {
        return res.status(429).json({ error: 'Rate limit exceeded.' });
      }

      return res.json({ success: true, messageId: resultMessageId });

    } catch (error) {
      console.error('CRITICAL ERROR:', error);
      if (error.message === 'NOT_FOUND') {
        return res.status(404).json({ error: 'Chat not found.' });
      }
      return res.status(500).json({
        error: 'Internal server error',
        details: error.message
      });
    }
  }
);
</file>

