import { useState } from 'react';
import { db } from '../firebase/config';
import { useAuth } from '../contexts/AuthContext';
import { doc, updateDoc } from 'firebase/firestore';

const EMOJI_LIST = [
  '👍','❤️','😂','😮','😢','🔥',
  '🎉','👏','🥰','😍','🤩','😭',
  '🤔','👀','💯','✅','🙏','😎',
  '🤣','😅','😡','💀','🎊','⚡',
];

export default function MessageReactions({ message, chatId, isOwn }) {
  const { user } = useAuth();
  const [showPicker, setShowPicker] = useState(false);

  const reactions = message.reactions || {};

  async function toggleReaction(emoji) {
    const msgRef = doc(db, 'chats', chatId, 'messages', message.id);
    const current = reactions[emoji] || [];
    const hasReacted = current.includes(user.uid);

    const updated = hasReacted
      ? current.filter(id => id !== user.uid)
      : [...current, user.uid];

    const newReactions = { ...reactions };
    if (updated.length === 0) delete newReactions[emoji];
    else newReactions[emoji] = updated;

    await updateDoc(msgRef, { reactions: newReactions });
    setShowPicker(false);
  }

  const activeEmojis = Object.entries(reactions).filter(([, uids]) => uids.length > 0);

  return (
    <div className={`reactions-wrap ${isOwn ? 'own' : 'other'}`}>
      {/* Existing reactions */}
      {activeEmojis.length > 0 && (
        <div className="reactions-row">
          {activeEmojis.map(([emoji, uids]) => (
            <button
              key={emoji}
              className={`reaction-chip ${uids.includes(user.uid) ? 'reacted' : ''}`}
              onClick={() => toggleReaction(emoji)}
              title={`${uids.length} reaction${uids.length > 1 ? 's' : ''}`}
            >
              {emoji} <span>{uids.length}</span>
            </button>
          ))}
          <button
            className="reaction-add-btn"
            onClick={() => setShowPicker(v => !v)}
          >+</button>
        </div>
      )}

      {/* Add reaction button on hover */}
      {activeEmojis.length === 0 && (
        <button
          className="reaction-hover-btn"
          onClick={() => setShowPicker(v => !v)}
          title="Add reaction"
        >
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M8 13s1.5 2 4 2 4-2 4-2"/>
            <line x1="9" y1="9" x2="9.01" y2="9"/>
            <line x1="15" y1="9" x2="15.01" y2="9"/>
          </svg>
        </button>
      )}

      {/* Emoji picker */}
      {showPicker && (
        <div className={`emoji-picker ${isOwn ? 'picker-left' : 'picker-right'}`}>
          {EMOJI_LIST.map(emoji => (
            <button
              key={emoji}
              className="emoji-option"
              onClick={() => toggleReaction(emoji)}
            >
              {emoji}
            </button>
          ))}
        </div>
      )}
    </div>
  );
}
