// ─────────────────────────────────────────────────────────
// ADD COMMENT
// ─────────────────────────────────────────────────────────
exports.addComment = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const {
    chatId, messageId,
    type = 'text', text, url, fileName, duration, stickerId, replyTo
  } = request.data;

  if (!chatId || !messageId) throw new HttpsError('invalid-argument', 'chatId and messageId required');

  const allowedTypes = ['text', 'image', 'voice', 'sticker'];
  if (!allowedTypes.includes(type)) throw new HttpsError('invalid-argument', 'Invalid comment type');

  if (type === 'text' && (!text || text.trim().length === 0))
    throw new HttpsError('invalid-argument', 'Text required for text comments');

  if (text && text.length > 2000) throw new HttpsError('invalid-argument', 'Text too long (max 2000)');
  if (url && url.length > 1000) throw new HttpsError('invalid-argument', 'URL too long (max 1000)');
  if (fileName && fileName.length > 255) throw new HttpsError('invalid-argument', 'File name too long (max 255)');
  if (stickerId && (typeof stickerId !== 'string' || stickerId.length > 64))
    throw new HttpsError('invalid-argument', 'stickerId must be a string <= 64 chars');
  if (duration !== undefined && duration !== null && (typeof duration !== 'number' || duration < 0))
    throw new HttpsError('invalid-argument', 'duration must be a positive number');

  let cleanReplyTo = null;
  if (replyTo && typeof replyTo === 'object' && replyTo.id) {
    cleanReplyTo = {
      id: String(replyTo.id).substring(0, 64),
      text: replyTo.text ? String(replyTo.text).substring(0, 200) : null,
      type: String(replyTo.type || 'text').substring(0, 20),
      url: replyTo.url ? String(replyTo.url).substring(0, 1000) : null,
      senderUsername: replyTo.senderUsername ? String(replyTo.senderUsername).substring(0, 32) : null,
    };
  }

  const memberDoc = await db.collection('chats').doc(chatId)
    .collection('members').doc(uid).get();
  if (!memberDoc.exists || memberDoc.data().banned)
    throw new HttpsError('permission-denied', 'Not a member');

  const member = memberDoc.data();
  const nowMs = Date.now();
  const stillMuted = member.muted && (!member.mutedUntil || member.mutedUntil.toMillis() > nowMs);
  if (stillMuted) throw new HttpsError('permission-denied', 'You are muted');

  if (member.mediaRestricted && type !== 'text')
    throw new HttpsError('permission-denied', 'Media comments are restricted for you');

  const chatDoc = await db.collection('chats').doc(chatId).get();
  const postDoc = await db.collection('chats').doc(chatId)
    .collection('messages').doc(messageId).get();

  if (!chatDoc.exists) throw new HttpsError('not-found', 'Chat not found');
  if (!postDoc.exists) throw new HttpsError('not-found', 'Post not found');

  const allowComments = chatDoc.data().settings?.allowComments !== false;
  const postCommentsEnabled = postDoc.data().commentsEnabled;

  if (!allowComments || postCommentsEnabled === false)
    throw new HttpsError('permission-denied', 'Comments are disabled');

  const userDoc = await db.collection('users').doc(uid).get();
  const username = userDoc.data()?.username || uid;

  const batch = db.batch();

  const commentRef = db.collection('chats').doc(chatId)
    .collection('messages').doc(messageId)
    .collection('comments').doc();

  batch.set(commentRef, {
    senderId: uid,
    senderUsername: username,
    type: type || 'text',
    text: text || null,
    url: url || null,
    fileName: fileName || null,
    duration: duration || null,
    stickerId: stickerId || null,
    replyTo: cleanReplyTo,
    createdAt: FieldValue.serverTimestamp(),
    reactions: [],
    deleted: false,
  });

  batch.update(
    db.collection('chats').doc(chatId).collection('messages').doc(messageId),
    { commentsCount: FieldValue.increment(1) }
  );

  await batch.commit();
  return { success: true, commentId: commentRef.id };
});

