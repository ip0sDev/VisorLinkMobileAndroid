.reaction-chip { display: flex; align-items: center; gap: 3px; background: var(--surface); box-shadow: var(--neo-shadow-sm); border: 0.5px solid var(--border); border-radius: 12px; padding: 2px 6px; font-size: 13px; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1); animation: chip-in 0.2s cubic-bezier(0.16,1,0.3,1); margin-bottom: 2px; }
.reaction-chip:hover { transform: scale(1.15) translateY(-1px); box-shadow: 0 0 8px var(--accent-glow), var(--neo-shadow-btn); }
.reaction-chip.mine { border-color: var(--accent); background: rgba(45,168,154,0.10); box-shadow: 0 0 8px var(--accent-glow), var(--neo-shadow-sm); }
.reaction-count { font-size: 11px; font-family: var(--font-mono); color: var(--text2); }

/* Reply & Typing */
.reply-preview { display: flex; align-items: stretch; width: 100%; min-width: 0; margin-bottom: 6px; border-radius: 8px; overflow: hidden; cursor: pointer; transition: opacity 0.15s; }
