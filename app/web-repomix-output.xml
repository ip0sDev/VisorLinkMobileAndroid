// ─────────────────────────────────────────────────────────
// CREATE GROUP / CHANNEL
// ─────────────────────────────────────────────────────────
exports.createChat = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { type, name, tag, description = '' } = request.data;

  if (!['group', 'channel'].includes(type))
    throw new HttpsError('invalid-argument', 'type must be group or channel');
  if (!name || name.trim().length < 2)
    throw new HttpsError('invalid-argument', 'Name must be at least 2 characters');
  if (name.trim().length > 64)
    throw new HttpsError('invalid-argument', 'Name must be at most 64 characters');
  if (!tag || tag.trim().length < 3)
    throw new HttpsError('invalid-argument', 'Tag must be at least 3 characters');
  if (tag.trim().length > 32)
    throw new HttpsError('invalid-argument', 'Tag must be at most 32 characters');
  if (description && description.trim().length > 500)
    throw new HttpsError('invalid-argument', 'Description must be at most 500 characters');

  const cleanTag = tag.toLowerCase().trim();
  if (!/^[a-zA-Z0-9_]+$/.test(cleanTag))
    throw new HttpsError('invalid-argument', 'Tag: letters, numbers, underscores only');

  const tagDoc = await db.collection('tags').doc(cleanTag).get();
  if (tagDoc.exists) throw new HttpsError('already-exists', 'Tag already taken');

  const chatRef = db.collection('chats').doc();
  const chatId = chatRef.id;
  const inviteToken = genInviteToken();

  const batch = db.batch();

  batch.set(chatRef, {
    type,
    name: name.trim(),
    tag: cleanTag,
    description: description.trim(),
    avatarUrl: null,
    createdAt: FieldValue.serverTimestamp(),
    createdBy: uid,
    lastMessage: null,
    lastMessageAt: FieldValue.serverTimestamp(),
    memberCount: 1,
    memberIds: [uid],
    settings: {
      joinByLink: true,
      joinByTag: type === 'channel',
      allowReactions: true,
      allowComments: true,
      inviteLink: inviteToken,
    }
  });

  batch.set(
    db.collection('chats').doc(chatId).collection('members').doc(uid),
    {
      uid,
      role: 'owner',
      joinedAt: FieldValue.serverTimestamp(),
      muted: false,
      mutedUntil: null,
      mediaRestricted: false,
      banned: false,
      bannedAt: null,
      bannedBy: null,
    }
  );

  batch.set(db.collection('tags').doc(cleanTag), { chatId, type });

  await batch.commit();
  return { success: true, chatId, inviteLink: inviteToken };
});

// ─────────────────────────────────────────────────────────
// UPDATE CHAT SETTINGS
// ─────────────────────────────────────────────────────────
exports.updateChatSettings = onCall({ cors: CORS, region: 'europe-west1' }, async (request) => {
  const { uid } = await requireVerified(request);
  const { chatId, name, tag, description, settings, avatarUrl } = request.data;

  if (!chatId) throw new HttpsError('invalid-argument', 'chatId required');

  await assertMember(chatId, uid, 'admin');

  const chatDoc = await db.collection('chats').doc(chatId).get();
  if (!chatDoc.exists) throw new HttpsError('not-found', 'Chat not found');
  const chat = chatDoc.data();

  const updates = { updatedAt: new Date() };
  const batch = db.batch();

  if (name) {
    const trimmed = name.trim();
    if (trimmed.length < 2 || trimmed.length > 64)
      throw new HttpsError('invalid-argument', 'Name must be 2–64 characters');
    updates.name = trimmed;
  }
  if (description !== undefined) {
    const trimmed = description.trim();
    if (trimmed.length > 500)
      throw new HttpsError('invalid-argument', 'Description max 500 characters');
    updates.description = trimmed;
  }
  if (avatarUrl !== undefined) {
    if (avatarUrl && avatarUrl.length > 1000)
      throw new HttpsError('invalid-argument', 'Avatar URL too long');
    updates.avatarUrl = avatarUrl;
  }

  if (tag && tag.toLowerCase().trim() !== chat.tag) {
    const cleanTag = tag.toLowerCase().trim();
    if (cleanTag.length < 3 || cleanTag.length > 32)
      throw new HttpsError('invalid-argument', 'Tag must be 3–32 characters');
    if (!/^[a-zA-Z0-9_]+$/.test(cleanTag))
      throw new HttpsError('invalid-argument', 'Tag: letters, numbers, underscores only');
    const tagDoc = await db.collection('tags').doc(cleanTag).get();
    if (tagDoc.exists) throw new HttpsError('already-exists', 'Tag already taken');
    batch.delete(db.collection('tags').doc(chat.tag));
    batch.set(db.collection('tags').doc(cleanTag), { chatId, type: chat.type });
    updates.tag = cleanTag;
  }

  if (settings) {
    const allowed = ['joinByLink', 'joinByTag', 'allowReactions', 'allowComments'];
    for (const key of allowed) {
      if (settings[key] !== undefined) updates[`settings.${key}`] = settings[key];
    }
  }

  batch.update(db.collection('chats').doc(chatId), updates);
  await batch.commit();
  return { success: true };
});

