import { createContext, useContext, useState, useEffect } from 'react';

const AccountsContext = createContext();

export function AccountsProvider({ children }) {
  const [accounts, setAccounts] = useState(() => {
    try {
      return JSON.parse(localStorage.getItem('vl_accounts') || '[]');
    } catch { return []; }
  });

  function saveAccounts(list) {
    setAccounts(list);
    localStorage.setItem('vl_accounts', JSON.stringify(list));
  }

  function addAccount(email, uid, username, displayName) {
    const exists = accounts.find(a => a.uid === uid);
    if (exists) return;
    saveAccounts([...accounts, { email, uid, username, displayName }]);
  }

  function removeAccount(uid) {
    saveAccounts(accounts.filter(a => a.uid !== uid));
  }

  function updateAccount(uid, data) {
    saveAccounts(accounts.map(a => a.uid === uid ? { ...a, ...data } : a));
  }

  return (
    <AccountsContext.Provider value={{ accounts, addAccount, removeAccount, updateAccount }}>
      {children}
    </AccountsContext.Provider>
  );
}

export const useAccounts = () => useContext(AccountsContext);
</file>

<file path="src/hooks/usePresence.js">
import { useEffect } from 'react';
import { rtdb, db } from '../firebase/config';
import { ref, set, onDisconnect, onValue, serverTimestamp } from 'firebase/database';
import { doc, updateDoc } from 'firebase/firestore';

export function usePresence(uid) {
  useEffect(() => {
    if (!uid) return;

    const presenceRef = ref(rtdb, `presence/${uid}`);
    const connectedRef = ref(rtdb, '.info/connected');

    // Слушаем подключение к RTDB
    const unsub = onValue(connectedRef, async (snap) => {
      if (!snap.val()) return;

      // Когда отключится — пишем offline автоматически
      await onDisconnect(presenceRef).set({
        online: false,
        lastSeen: serverTimestamp()
      });

      // Сейчас онлайн
      await set(presenceRef, {
        online: true,
        lastSeen: serverTimestamp()
      });
    });

    return () => {
      unsub();
      // Явно ставим offline при unmount
      set(presenceRef, {
        online: false,
        lastSeen: serverTimestamp()
      });
    };
  }, [uid]);
}
</file>

