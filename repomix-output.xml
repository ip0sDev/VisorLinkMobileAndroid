@Composable
private fun LimitsCard(
    imageLimitMb: Int,
    voiceLimitMb: Int,
    cacheDays: Int,
    onImageLimit: (Int) -> Unit,
    onVoiceLimit: (Int) -> Unit,
    onCacheDays:  (Int) -> Unit
