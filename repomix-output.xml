// ─── UI State ─────────────────────────────────────────────────────────────────

data class SavedMessagesUiState(
    val messages: List<SavedMessage> = emptyList(),
    val settings: SavedMessagesSettings? = null,
    val isUnlocked: Boolean = false,
    val isLoading: Boolean = true,
    val error: String? = null,
    val showPinInput: Boolean = false,
    val pinError: Boolean = false,
    val isSettingPin: Boolean = false,
    val isEncryptionEnabled: Boolean = false
)

sealed class BiometricResult {
    object Success : BiometricResult()
    data class Error(val message: String) : BiometricResult()
    object NotAvailable : BiometricResult()
}

class SavedMessagesViewModel(
    private val repository: SavedMessagesRepository,
    private val auth: FirebaseAuth,
    private val context: Context
) : ViewModel() {

    val currentUid: String get() = auth.currentUser!!.uid

    // AES-GCM ключ живёт только в памяти. Null = заблокировано.
    private var cryptoKey: SecretKey? = null

    // Опциональный кэш PIN — хранится только в памяти (не на диске)
    private var cachedPin: String? = null

    private val _uiState = MutableStateFlow(SavedMessagesUiState())
    val uiState: StateFlow<SavedMessagesUiState> = _uiState.asStateFlow()

    private var messagesJob: Job? = null
    private var autoLockJob: Job? = null

    init {
        // Загружаем настройки и подписываемся на их изменения
        viewModelScope.launch {
            repository.settingsFlow(currentUid).collect { settings ->
                val wasEnabled = _uiState.value.settings?.pinEnabled == true
                _uiState.update {
                    it.copy(
                        settings           = settings,
                        isEncryptionEnabled = settings?.pinEnabled == true,
                        // Если PIN только что включили — блокируем
                        isUnlocked = if (settings?.pinEnabled == true && !wasEnabled) false
                        else it.isUnlocked
                    )
                }
                // После загрузки настроек определяем нужно ли показать PIN
                checkLockState(settings)
            }
        }
    }

    // ─── Открытие экрана ──────────────────────────────────────────────────────

    private fun checkLockState(settings: SavedMessagesSettings?) {
        val pinEnabled = settings?.pinEnabled == true
        if (!pinEnabled) {
            // PIN не установлен — сразу открываем
            unlockWithoutPin()
        } else if (!_uiState.value.isUnlocked) {
            // Нужен PIN — пробуем биометрию или показываем диалог
            _uiState.update { it.copy(showPinInput = true, isLoading = false) }
        }
    }

    // ─── Разблокировка без PIN (для не-защищённого раздела) ───────────────────

    private fun unlockWithoutPin() {
        cryptoKey = null
        _uiState.update { it.copy(isUnlocked = true, showPinInput = false) }
        startListeningMessages()
    }

    // ─── Разблокировка по PIN ─────────────────────────────────────────────────

    fun onPinEntered(pin: String) {
        viewModelScope.launch {
            val valid = repository.verifyPin(currentUid, pin)
            if (valid) {
                cryptoKey = deriveKey(pin, currentUid)
                cachedPin = pin          // кэшируем для биометрии при следующем открытии
                _uiState.update {
                    it.copy(isUnlocked = true, showPinInput = false, pinError = false)
                }
                startListeningMessages()
                scheduleAutoLock()
            } else {
                _uiState.update { it.copy(pinError = true) }
            }
        }
    }

    // ─── Биометрическая разблокировка ─────────────────────────────────────────

    /**
     * Запускает биометрический промпт. Если биометрия проходит успешно —
     * восстанавливает ключ из кэша PIN (если PIN был введён ранее в этой сессии).
     *
     * Логика:
     *  1. Биометрия подтверждает личность пользователя.
     *  2. Если PIN был кэширован ранее — ключ восстанавливается без повторного ввода.
     *  3. Если кэша нет — просим ввести PIN (биометрия без PIN не может восстановить ключ).
     */
    fun launchBiometricUnlock(
        activity: FragmentActivity,
        onResult: (BiometricResult) -> Unit
    ) {
        val biometricManager = BiometricManager.from(activity)
        val canAuthenticate = biometricManager.canAuthenticate(
            BiometricManager.Authenticators.BIOMETRIC_STRONG or
                    BiometricManager.Authenticators.DEVICE_CREDENTIAL
        )

        if (canAuthenticate != BiometricManager.BIOMETRIC_SUCCESS) {
            onResult(BiometricResult.NotAvailable)
            return
        }

        val executor = ContextCompat.getMainExecutor(activity)
        val callback = object : BiometricPrompt.AuthenticationCallback() {
            override fun onAuthenticationSucceeded(result: BiometricPrompt.AuthenticationResult) {
                super.onAuthenticationSucceeded(result)
                val pin = cachedPin
                if (pin != null) {
                    // PIN кэширован — восстанавливаем ключ без диалога
                    cryptoKey = deriveKey(pin, currentUid)
                    _uiState.update { it.copy(isUnlocked = true, showPinInput = false) }
                    startListeningMessages()
                    scheduleAutoLock()
                    onResult(BiometricResult.Success)
                } else {
                    // Кэша нет (первый запуск / приложение было закрыто) — нужен PIN
                    onResult(BiometricResult.NotAvailable)
                    _uiState.update { it.copy(showPinInput = true) }
                }
            }

            override fun onAuthenticationError(errorCode: Int, errString: CharSequence) {
                super.onAuthenticationError(errorCode, errString)
                onResult(BiometricResult.Error(errString.toString()))
            }

            override fun onAuthenticationFailed() {
                super.onAuthenticationFailed()
                // Не вызываем onResult — система покажет своё сообщение об ошибке
            }
        }

        val promptInfo = BiometricPrompt.PromptInfo.Builder()
            .setTitle("Избранное")
            .setSubtitle("Подтвердите личность для доступа")
            .setAllowedAuthenticators(
                BiometricManager.Authenticators.BIOMETRIC_STRONG or
                        BiometricManager.Authenticators.DEVICE_CREDENTIAL
            )
            .build()

        BiometricPrompt(activity, executor, callback).authenticate(promptInfo)
    }

    // ─── Блокировка ───────────────────────────────────────────────────────────

    fun lock() {
        autoLockJob?.cancel()
        messagesJob?.cancel()
        cryptoKey = null
        // cachedPin НЕ обнуляем — он нужен для биометрии в той же сессии
        _uiState.update { it.copy(isUnlocked = false, messages = emptyList(), showPinInput = true) }
    }

    /** Вызывать из onStop() Activity чтобы заблокировать при уходе из приложения */
    fun lockIfConfigured() {
        val timeout = _uiState.value.settings?.lockTimeout ?: return
        val pinEnabled = _uiState.value.settings?.pinEnabled == true
        if (pinEnabled && timeout == 0) lock()
    }

    private fun scheduleAutoLock() {
        autoLockJob?.cancel()
        val timeoutMinutes = _uiState.value.settings?.lockTimeout ?: return
        if (timeoutMinutes <= 0) return
        autoLockJob = viewModelScope.launch {
            delay(timeoutMinutes * 60_000L)
            lock()
        }
    }

    // ─── PIN Management ───────────────────────────────────────────────────────

    fun setPin(pin: String) {
        viewModelScope.launch {
            try {
                repository.setPin(currentUid, pin)
                cryptoKey = deriveKey(pin, currentUid)
                cachedPin = pin
                _uiState.update { it.copy(isSettingPin = false, isEncryptionEnabled = true) }
            } catch (e: Exception) {
                _uiState.update { it.copy(error = e.message) }
            }
        }
    }

    fun disablePin() {
        viewModelScope.launch {
            try {
                repository.disablePin(currentUid)
                cryptoKey = null
                cachedPin = null
                _uiState.update { it.copy(isEncryptionEnabled = false) }
            } catch (e: Exception) {
                _uiState.update { it.copy(error = e.message) }
            }
        }
    }

    // ─── Messages subscription ────────────────────────────────────────────────

    private fun startListeningMessages() {
        messagesJob?.cancel()
        messagesJob = viewModelScope.launch {
            repository.messagesFlow(currentUid, cryptoKey)
                .catch { e -> _uiState.update { it.copy(error = e.message) } }
                .collect { messages ->
                    _uiState.update {
                        it.copy(messages = messages.filter { m -> !m.deleted }, isLoading = false)
                    }
                }
        }
    }

    // ─── Save actions ─────────────────────────────────────────────────────────

    fun saveText(text: String) {
        viewModelScope.launch {
            try { repository.saveText(currentUid, text, cryptoKey) }
            catch (e: Exception) { _uiState.update { it.copy(error = e.message) } }
        }
    }

    fun deleteMessage(messageId: String) {
        viewModelScope.launch {
            try { repository.deleteMessage(currentUid, messageId) }
            catch (e: Exception) { _uiState.update { it.copy(error = e.message) } }
        }
    }

    // ─── Getters for ForwardViewModel ─────────────────────────────────────────

    fun getCryptoKey(): SecretKey? = cryptoKey

    fun getIsEncryptionEnabled(): Boolean = _uiState.value.isEncryptionEnabled

    // ─── Error ────────────────────────────────────────────────────────────────

    fun clearError() = _uiState.update { it.copy(error = null) }
    fun clearPinError() = _uiState.update { it.copy(pinError = false) }

    override fun onCleared() {
        // Ключ уничтожается при уничтожении ViewModel
        cryptoKey = null
        cachedPin = null
        super.onCleared()
    }
}
</file>

<file path="app/src/main/java/by/iposdev/visorlink/utils/CryptoUtils.kt">
package by.iposdev.visorlink.utils

import android.util.Base64
import java.security.MessageDigest
import javax.crypto.Cipher
import javax.crypto.SecretKey
import javax.crypto.SecretKeyFactory
import javax.crypto.spec.GCMParameterSpec
import javax.crypto.spec.PBEKeySpec
import javax.crypto.spec.SecretKeySpec

// ─── PIN Hashing ──────────────────────────────────────────────────────────────

/**
 * SHA-256(pin + ":" + uid) → hex строка для хранения в Firestore.
 * Plaintext PIN никогда не сохраняется.
 */
fun hashPin(pin: String, uid: String): String {
    val input = "$pin:$uid"
    val digest = MessageDigest.getInstance("SHA-256")
    return digest.digest(input.toByteArray(Charsets.UTF_8))
        .joinToString("") { "%02x".format(it) }
}

// ─── Key Derivation (PBKDF2) ─────────────────────────────────────────────────

/**
 * Деривирует AES-256 ключ из PIN + uid через PBKDF2WithHmacSHA256.
 * uid используется как детерминированная соль (domain separation).
 * 200 000 итераций — рекомендуется OWASP для PIN/password.
 */
fun deriveKey(pin: String, uid: String): SecretKey {
    val salt = uid.padEnd(16, '0').substring(0, 16).toByteArray(Charsets.UTF_8)
    val spec = PBEKeySpec(pin.toCharArray(), salt, 200_000, 256)
    return try {
        val factory = SecretKeyFactory.getInstance("PBKDF2WithHmacSHA256")
        val keyBytes = factory.generateSecret(spec).encoded
        SecretKeySpec(keyBytes, "AES")
    } finally {
        spec.clearPassword()
    }
}

// ─── AES-GCM-256 Encrypt/Decrypt ─────────────────────────────────────────────

private const val GCM_TAG_LENGTH = 128   // бит
private const val GCM_IV_LENGTH  = 12    // байт — стандарт для GCM

/**
 * Шифрует текст ключом. Возвращает Pair(Base64(шифртекст), Base64(IV)).
 * IV генерируется случайно для каждого сообщения.
 */
fun encryptText(plaintext: String, key: SecretKey): Pair<String, String> {
    val iv = ByteArray(GCM_IV_LENGTH).also { java.security.SecureRandom().nextBytes(it) }
    val cipher = Cipher.getInstance("AES/GCM/NoPadding")
    cipher.init(Cipher.ENCRYPT_MODE, key, GCMParameterSpec(GCM_TAG_LENGTH, iv))
    val ciphertext = cipher.doFinal(plaintext.toByteArray(Charsets.UTF_8))
    return Pair(
        Base64.encodeToString(ciphertext, Base64.NO_WRAP),
        Base64.encodeToString(iv, Base64.NO_WRAP)
    )
}

/**
 * Расшифровывает текст ключом. Возвращает null если ключ неверный или данные повреждены.
 */
fun decryptText(ciphertextB64: String, ivB64: String, key: SecretKey): String? = try {
    val ciphertext = Base64.decode(ciphertextB64, Base64.NO_WRAP)
    val iv         = Base64.decode(ivB64, Base64.NO_WRAP)
    val cipher     = Cipher.getInstance("AES/GCM/NoPadding")
    cipher.init(Cipher.DECRYPT_MODE, key, GCMParameterSpec(GCM_TAG_LENGTH, iv))
    String(cipher.doFinal(ciphertext), Charsets.UTF_8)
} catch (_: Exception) { null }
