                        .padding(horizontal = 16.dp, vertical = 10.dp),
                    contentAlignment = Alignment.CenterStart
                ) {
                    BasicTextField(
                        value         = inputText,
                        onValueChange = onTextChange,
                        modifier      = Modifier.fillMaxWidth(),
                        maxLines      = 5,
                        textStyle     = TextStyle(
                            color    = textColor,
                            fontSize = 15.sp
                        ),
                        keyboardOptions = KeyboardOptions(
                            imeAction = ImeAction.Send
                        ),
                        keyboardActions = KeyboardActions(
                            onSend = { onSend() }
                        ),
                        decorationBox = { inner ->
                            if (inputText.isEmpty()) {
                                Text(
                                    "Написать заметку…",
                                    fontSize  = 15.sp,
                                    color     = hintColor
                                )
                            }
                            inner()
                        }
                    )
                }

                Spacer(Modifier.width(8.dp))

                // Кнопка отправки
                Box(
                    modifier = Modifier
                        .size(44.dp)
                        .scale(sendScale.value)
                        .clip(CircleShape)
                        .background(
                            color  = if (canSend) MaterialTheme.colorScheme.primary
                            else MaterialTheme.colorScheme.surfaceContainerHigh,
                            shape  = CircleShape
                        )
                        .clickable(
                            enabled           = canSend,
                            interactionSource = remember { MutableInteractionSource() },
                            indication        = null
                        ) {
                            scope.launch {
                                sendScale.animateTo(0.84f, spring(stiffness = Spring.StiffnessHigh))
                                sendScale.animateTo(1.06f, spring(Spring.DampingRatioLowBouncy))
                                sendScale.animateTo(1f, spring(Spring.DampingRatioMediumBouncy))
                            }
                            onSend()
                        },
                    contentAlignment = Alignment.Center
                ) {
                    Icon(
                        Icons.AutoMirrored.Filled.Send,
                        contentDescription = "Отправить",
                        tint     = if (canSend) Color.White
                        else MaterialTheme.colorScheme.onSurfaceVariant,
                        modifier = Modifier.size(20.dp)
                    )
                }
            }
        }
    }
}

// ─── SavedMessageItem ─────────────────────────────────────────────────────────

@Composable
private fun SavedMessageItem(
    message: SavedMessage,
    isDark: Boolean,
    isOneUi: Boolean,
    onDelete: () -> Unit
) {
    var showDeleteDialog by remember { mutableStateOf(false) }

    val bgColor = if (isOneUi)
        if (isDark) Color(0xFF2C2C2C) else Color.White
    else MaterialTheme.colorScheme.surfaceContainerLow

    val fwFrom = message.parsedForwardFrom

    Surface(
        modifier = Modifier
            .fillMaxWidth()
            .padding(horizontal = 12.dp, vertical = 4.dp),
        shape          = RoundedCornerShape(16.dp),
        color          = bgColor,
        shadowElevation = if (isOneUi) 0.dp else 1.dp
    ) {
        Column(
            modifier = Modifier
                .combinedClickable(
                    onLongClick = { showDeleteDialog = true },
                    onClick     = {}
                )
                .padding(12.dp)
        ) {
            // Forward banner
            if (fwFrom != null) {
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    modifier          = Modifier.padding(bottom = 4.dp)
                ) {
                    Box(
                        Modifier
                            .width(3.dp)
                            .height(16.dp)
                            .background(
                                MaterialTheme.colorScheme.primary,
                                RoundedCornerShape(2.dp)
                            )
                    )
                    Spacer(Modifier.width(6.dp))
                    Text(
                        "Переслано от @${fwFrom.senderUsername.ifEmpty { "…" }}" +
                                if (!fwFrom.chatName.isNullOrBlank()) " · ${fwFrom.chatName}" else "",
                        fontSize   = 11.sp,
                        color      = MaterialTheme.colorScheme.primary,
                        fontWeight = FontWeight.Medium,
                        maxLines   = 1,
                        overflow   = TextOverflow.Ellipsis
                    )
                }
            }

            // Content
            when {
                message.encrypted == true && message.text == null -> {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Icon(
                            Icons.Default.Lock,
                            null,
                            modifier = Modifier.size(14.dp),
                            tint     = MaterialTheme.colorScheme.error
                        )
                        Spacer(Modifier.width(4.dp))
                        Text(
                            "Не удалось расшифровать",
                            fontSize  = 13.sp,
                            color     = MaterialTheme.colorScheme.error,
                            fontStyle = androidx.compose.ui.text.font.FontStyle.Italic
                        )
                    }
                }

                message.type == MessageType.TEXT -> {
                    Row(verticalAlignment = Alignment.Top) {
                        if (message.encrypted == true) {
                            Icon(
                                Icons.Default.Lock,
                                null,
                                modifier = Modifier
                                    .size(12.dp)
                                    .padding(top = 2.dp),
                                tint = MaterialTheme.colorScheme.primary
                            )
                            Spacer(Modifier.width(4.dp))
                        }
                        Text(
                            message.text ?: "",
                            style = MaterialTheme.typography.bodyMedium,
                            color = MaterialTheme.colorScheme.onSurface
                        )
                    }
                }

                message.type == MessageType.IMAGE -> {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Icon(
                            Icons.Default.Image,
                            null,
                            modifier = Modifier.size(18.dp),
                            tint     = MaterialTheme.colorScheme.onSurfaceVariant
                        )
                        Spacer(Modifier.width(6.dp))
                        Text(
                            "Фото",
                            color    = MaterialTheme.colorScheme.onSurfaceVariant,
                            fontSize = 13.sp
                        )
                    }
                    if (!message.caption.isNullOrBlank()) {
                        Spacer(Modifier.height(4.dp))
                        Text(message.caption, style = MaterialTheme.typography.bodySmall)
                    }
                }

                message.type == MessageType.VOICE -> {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Icon(
                            Icons.Default.Mic,
                            null,
                            modifier = Modifier.size(18.dp),
                            tint     = MaterialTheme.colorScheme.onSurfaceVariant
                        )
                        Spacer(Modifier.width(6.dp))
                        Text(
                            "Голосовое · ${
                                message.duration?.let {
                                    "${it / 60}:${(it % 60).toString().padStart(2, '0')}"
                                } ?: ""
                            }",
                            color    = MaterialTheme.colorScheme.onSurfaceVariant,
                            fontSize = 13.sp
                        )
                    }
                }

                message.type == MessageType.STICKER -> {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Text(message.packEmoji ?: "🎭", fontSize = 18.sp)
                        Spacer(Modifier.width(6.dp))
                        Text(
                            "Стикер · ${message.packName ?: ""}",
                            color    = MaterialTheme.colorScheme.onSurfaceVariant,
                            fontSize = 13.sp
                        )
                    }
                }

                message.type == MessageType.ALBUM -> {
                    Row(verticalAlignment = Alignment.CenterVertically) {
                        Icon(
                            Icons.Default.PhotoLibrary,
                            null,
                            modifier = Modifier.size(18.dp),
                            tint     = MaterialTheme.colorScheme.onSurfaceVariant
                        )
                        Spacer(Modifier.width(6.dp))
                        Text(
                            "📷 ${message.images.size} фото",
                            color    = MaterialTheme.colorScheme.onSurfaceVariant,
                            fontSize = 13.sp
                        )
                    }
                    if (!message.caption.isNullOrBlank()) {
                        Spacer(Modifier.height(4.dp))
                        Text(message.caption, style = MaterialTheme.typography.bodySmall)
                    }
                }
            }

            // Timestamp
            message.createdAt?.let { ts ->
                Spacer(Modifier.height(4.dp))
                Text(
                    SimpleDateFormat("dd MMM, HH:mm", Locale.getDefault()).format(ts.toDate()),
                    fontSize = 10.sp,
                    color    = MaterialTheme.colorScheme.onSurfaceVariant.copy(alpha = 0.6f),
                    modifier = Modifier.align(Alignment.End)
                )
            }
        }
    }

    if (showDeleteDialog) {
        AlertDialog(
            onDismissRequest = { showDeleteDialog = false },
            title            = { Text("Удалить из Избранного?") },
            confirmButton    = {
                TextButton(onClick = { onDelete(); showDeleteDialog = false }) {
                    Text("Удалить", color = MaterialTheme.colorScheme.error)
                }
            },
            dismissButton = {
                TextButton(onClick = { showDeleteDialog = false }) { Text("Отмена") }
            }
        )
    }
}

// ─── PIN Input Dialog ─────────────────────────────────────────────────────────

@Composable
fun PinInputDialog(
    pinError: Boolean,
    onPinEntered: (String) -> Unit,
    onDismiss: () -> Unit,
    onBiometric: () -> Unit,
    clearError: () -> Unit
) {
    var pin by remember { mutableStateOf("") }

    AlertDialog(
        onDismissRequest = onDismiss,
        shape            = RoundedCornerShape(24.dp),
        title = {
            Column(
                horizontalAlignment = Alignment.CenterHorizontally,
                modifier            = Modifier.fillMaxWidth()
            ) {
                Text("⭐", fontSize = 32.sp)
                Spacer(Modifier.height(4.dp))
                Text("Избранное", fontWeight = FontWeight.Bold)
            }
        },
        text = {
            Column {
                OutlinedTextField(
                    value         = pin,
                    onValueChange = {
                        if (it.length <= 8 && it.all { c -> c.isDigit() }) {
                            pin = it
                            if (pinError) clearError()
                        }
                    },
                    label = { Text("PIN-код") },
                    isError = pinError,
                    supportingText = if (pinError) {
                        { Text("Неверный PIN", color = MaterialTheme.colorScheme.error) }
                    } else null,
                    visualTransformation = PasswordVisualTransformation(),
                    keyboardOptions = KeyboardOptions(keyboardType = KeyboardType.NumberPassword),
                    keyboardActions = KeyboardActions(onDone = {
                        if (pin.isNotEmpty()) onPinEntered(pin)
                    }),
                    singleLine = true,
                    modifier   = Modifier.fillMaxWidth()
                )
                Spacer(Modifier.height(8.dp))
                TextButton(
                    onClick  = onBiometric,
                    modifier = Modifier.align(Alignment.CenterHorizontally)
                ) {
                    Icon(Icons.Default.Fingerprint, null, modifier = Modifier.size(18.dp))
                    Spacer(Modifier.width(6.dp))
                    Text("Использовать биометрию")
                }
            }
        },
        confirmButton = {
            Button(
                onClick  = { if (pin.isNotEmpty()) onPinEntered(pin) },
                enabled  = pin.isNotEmpty()
            ) { Text("Войти") }
        },
        dismissButton = {
            TextButton(onClick = onDismiss) { Text("Отмена") }
        }
    )
}

