                    OutlinedButton(onClick = { viewModel.checkUsername() },
                        modifier = Modifier.fillMaxWidth(),
                        shape = MaterialTheme.shapes.medium) {
                        Text(stringResource(R.string.profile_check_username))
                    }
                }
            }
            Spacer(Modifier.height(32.dp))
