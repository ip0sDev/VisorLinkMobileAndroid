        if (isDark) Color(0xFF8E8E93) else Color(0xFFAAAAAA)
    else
        MaterialTheme.colorScheme.onSurfaceVariant

    val canSend = inputText.isNotBlank()
    val sendScale = remember { Animatable(1f) }
    val scope = rememberCoroutineScope()

    Surface(
        color          = barBg,
