        if (isDark) Color(0xFF2C2C2E) else Color(0xFFEEEEEE)
    else
        MaterialTheme.colorScheme.surfaceContainerHigh

    val textColor = if (isOneUi)
        if (isDark) Color.White else Color(0xFF1C1C1E)
    else
        MaterialTheme.colorScheme.onSurface

