            chatRepository = get(),
            userRepository = get(),
            auth           = get(),
            context        = androidContext()
        )
    }

    // ─── Search / Profile / Settings ──────────────────────────────────────────

    viewModel { SearchViewModel(get(), get(), get()) }
    viewModel { ProfileViewModel(get(), get()) }
    viewModel { parameters -> OtherProfileViewModel(get(), get(), get(), parameters.get()) }

    // ─── Sticker Packs ────────────────────────────────────────────────────────

    viewModel { StickerPackViewModel(get(), get()) }

    // ─── Chat Settings ────────────────────────────────────────────────────────

    viewModel { params ->
        ChatSettingsViewModel(
            chatRepository = get(),
            userRepository = get(),
            auth           = get(),
            db             = get(),
            chatId         = params.get()
        )
    }

    // ─── App Update / Cache ───────────────────────────────────────────────────

    viewModel { AppUpdateViewModel(androidApplication()) }
    viewModel { CacheViewModel(get(), androidContext()) }
    single { SavedMessagesRepository(get()) }
    single { ForwardRepository(get()) }

    viewModel {
        SavedMessagesViewModel(
            repository = get(),
            auth = get(),
            context = androidContext()
        )
    }
}
